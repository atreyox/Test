        </Item>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DumbbellStats</string>
          <string name="Source"><![CDATA[--[[
	DumbbellStats - the single source of truth for what a dumbbell does.

	Used by the server (real rewards), the Forge preview (what you'll get) and the
	inventory cards, so every screen shows exactly what the server will use.

	A dumbbell record (saved in player data):
	{
		Id = "123-17",                 -- unique: userId-counter
		Parts = { {Material, Refine, Mutation}, {...}, {...} },  -- Left plate, Handle, Right plate
		Size = 3,                      -- plate size (units of material per plate)
		Quality = "Perfect",
		Level = 1, Xp = 0,
		Created = os.time(), ForgedBy = userId, ForgedByName = "name",
		Tempered = true?, Knockoff = true?, Locked = true?, Favorite = true?,
	}
]]

local Config = script.Parent.Config
local Materials = require(Config.Materials)
local Mutations = require(Config.Mutations)
local Qualities = require(Config.Qualities)
local Refine = require(Config.Refine)
local Rarities = require(Config.Rarities)
local Recipes = require(Config.Recipes)
local Balance = require(Config.Balance)

export type Part = { Material: string, Refine: number?, Mutation: string? }

export type Stats = {
	Name: string,
	Power: number,
	Weight: number,
	RequiredStrength: number,
	Crit: number,
	CritPower: number,
	Super: number,
	Luck: number,
	Coins: number,
	Speed: number,
	Combo: number,
	ComboBonus: number,
	RarityRank: number,
	Rarity: string,
	Value: number,
	Balanced: boolean,
	Recipe: any?,
	Ability: any?,
	Special: string?,
	Size: number,
}

local DumbbellStats = {}

local TEMPERED_BONUS = 1.15

local function partPower(p: Part): number
	local m = Materials.ById[p.Material]
	if not m then
		return 0
	end
	return m.Power * Refine.Get(p.Refine or 0).Mult * Mutations.Mult(p.Mutation)
end

local function samePart(a: Part, b: Part): boolean
	return a.Material == b.Material and (a.Refine or 0) == (b.Refine or 0) and (a.Mutation or "") == (b.Mutation or "")
end

local function words(list: { string }): string
	local out = {}
	for _, w in list do
		if w ~= "" and out[#out] ~= w then
			table.insert(out, w)
		end
	end
	return table.concat(out, " ")
end

function DumbbellStats.Name(parts: { Part }, quality: string?, recipe: any?, knockoff: boolean?): string
	local left, handle, right = parts[1], parts[2], parts[3]
	local ml, mh, mr = Materials.ById[left.Material], Materials.ById[handle.Material], Materials.ById[right.Material]
	if not (ml and mh and mr) then
		return "Mystery Dumbbell"
	end
	local q = Qualities.Get(quality)
	local prefix = {}
	if knockoff then
		table.insert(prefix, "Knockoff")
	end
	if q.Id ~= "Normal" then
		table.insert(prefix, q.Name)
	end
	local sharedMutation = left.Mutation and left.Mutation == right.Mutation and Mutations.Get(left.Mutation)

	if recipe then
		if sharedMutation and recipe.Mutation == nil then
			table.insert(prefix, sharedMutation.Name)
		end
		table.insert(prefix, recipe.Name)
		return words(prefix)
	end

	if sharedMutation then
		table.insert(prefix, sharedMutation.Name)
	end

	local body: string
	if left.Material == right.Material and right.Material == handle.Material then
		if ml.Pure then
			body = ml.Pure .. " Dumbbell"
		elseif #prefix == 0 then
			body = "Pure " .. ml.Short .. " Dumbbell"
		else
			body = ml.Short .. " Dumbbell"
		end
	elseif left.Material == right.Material then
		body = ml.Short .. "-" .. mh.Short .. " Dumbbell"
	else
		body = ml.Adj .. " " .. mr.Short .. " Dumbbell"
	end
	table.insert(prefix, body)
	local name = words(prefix)
	if #name > 42 and sharedMutation then
		-- drop the mutation word first when names get too long
		local trimmed = {}
		for _, w in prefix do
			if w ~= sharedMutation.Name then
				table.insert(trimmed, w)
			end
		end
		name = words(trimmed)
	end
	return name
end

function DumbbellStats.Compute(record: any): Stats
	local parts: { Part } = record.Parts
	local size: number = math.max(1, math.floor(record.Size or 1))
	local q = Qualities.Get(record.Quality)
	local level = math.max(1, record.Level or 1)
	local left, handle, right = parts[1], parts[2], parts[3]

	local recipe = Recipes.Match(parts, size)
	local ability = recipe and Recipes.Abilities[recipe.Ability] or nil
	local balanced = samePart(left, right)

	-- Power ------------------------------------------------------------------------------
	local platePower = (partPower(left) + partPower(right)) * size ^ Balance.PlateSizeExponent
	local handlePower = partPower(handle) * Balance.HandlePowerFactor
	local power = (platePower + handlePower) * q.Mult
	if balanced then
		power *= Balance.BalancedBonus
	end
	if recipe then
		power *= recipe.Mult
	end

	-- Traits (handles count double) ---------------------------------------------------------
	local t = { Gains = 0, Crit = 0, CritPower = 0, Super = 0, Luck = 0, Coins = 0, Speed = 0, Combo = 0, Light = 0, ComboBonus = 0 }
	for i, p in parts do
		local m = Materials.ById[p.Material]
		if m and m.Trait then
			local mult = (i == 2) and 2 or 1
			t[m.Trait.Kind] = (t[m.Trait.Kind] or 0) + m.Trait.Amount * mult
		end
	end
	if ability then
		for k, v in ability.Stats do
			t[k] = (t[k] or 0) + v
		end
	end

	power *= 1 + t.Gains
	power *= 1 + (level - 1) * Balance.DumbbellLevelBonus
	if record.Tempered then
		power *= TEMPERED_BONUS
	end

	-- Weight --------------------------------------------------------------------------------
	local wl = Materials.ById[left.Material] and Materials.ById[left.Material].Weight or 0
	local wr = Materials.ById[right.Material] and Materials.ById[right.Material].Weight or 0
	local wh = Materials.ById[handle.Material] and Materials.ById[handle.Material].Weight or 0
	local weight = ((wl + wr) * size + wh * Balance.HandleWeightFactor) * (1 - math.clamp(t.Light, 0, 0.8))
	if ability and ability.Special == "Weightless" then
		weight = 0
	end
	local required = math.max(0, (weight - Balance.FreeLiftWeight) * Balance.StrengthPerKg)

	-- Rarity --------------------------------------------------------------------------------
	local rankSum = 0
	local bestMutationRank = 0
	for _, p in parts do
		local m = Materials.ById[p.Material]
		rankSum += m and Rarities.Rank(m.Rarity) or 1
		local mut = Mutations.Get(p.Mutation)
		if mut then
			bestMutationRank = math.max(bestMutationRank, Rarities.Rank(mut.Rarity))
		end
	end
	local rank = math.floor(rankSum / 3 + 0.5)
	if q.Rank >= 6 then
		rank += 1
	end
	if q.Rank >= 8 then
		rank += 1
	end
	if bestMutationRank >= 5 then
		rank += 1
	end
	if recipe then
		rank = math.max(rank, Rarities.Rank(recipe.Rarity))
	end
	rank = math.clamp(rank, 1, #Rarities.List)

	-- Value -----------------------------------------------------------------------------------
	local value = (partPower(left) + partPower(right)) * size + partPower(handle) * 0.5
	value = value * Balance.MaterialSellPerPower * Balance.DumbbellSellFactor * q.Mult
	if record.Knockoff then
		value *= 0.25
	end

	return {
		Name = DumbbellStats.Name(parts, record.Quality, recipe, record.Knockoff),
		Power = power,
		Weight = weight,
		RequiredStrength = required,
		Crit = t.Crit,
		CritPower = t.CritPower,
		Super = t.Super,
		Luck = t.Luck,
		Coins = t.Coins,
		Speed = math.clamp(t.Speed, 0, 0.5),
		Combo = t.Combo,
		ComboBonus = t.ComboBonus,
		RarityRank = rank,
		Rarity = Rarities.FromRank(rank).Id,
		Value = math.floor(value),
		Balanced = balanced,
		Recipe = recipe,
		Ability = ability,
		Special = ability and ability.Special or nil,
		Size = size,
	}
end

-- Visual scale of the plates, used by the 3D model (big plate sizes look huge on purpose).
function DumbbellStats.PlateScale(size: number): number
	return 1 + (math.max(1, size) - 1) ^ 0.55 * 0.28
end

return DumbbellStats
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Formulas</string>
          <string name="Source"><![CDATA[--[[
	Formulas - all the math of the game in one place (shared by server and client).

	The server uses these to decide rewards; the client uses the same functions to show
	costs, odds and previews, so what you see is exactly what you get.

	`rng` arguments are Random objects (anything with :NextNumber()).
]]

local Config = script.Parent.Config
local Balance = require(Config.Balance)
local Qualities = require(Config.Qualities)
local Mutations = require(Config.Mutations)
local Materials = require(Config.Materials)
local Rarities = require(Config.Rarities)
local Rebirths = require(Config.Rebirths)
local Zones = require(Config.Zones)

local Formulas = {}

-- Round to 2 significant digits so prices look clean (1234 -> 1200, 56789 -> 57000)
function Formulas.Nice(n: number): number
	if n < 100 then
		return math.floor(n + 0.5)
	end
	local magnitude = 10 ^ (math.floor(math.log10(n)) - 1)
	return math.floor(n / magnitude + 0.5) * magnitude
end

-- Upgrades -------------------------------------------------------------------------------

function Formulas.UpgradeCost(upgrade: any, level: number): number
	return Formulas.Nice(upgrade.Cost.Base * upgrade.Cost.Growth ^ level)
end

function Formulas.UpgradeValue(upgrade: any, level: number): number
	local values = upgrade.Values
	return values[math.clamp(level, 0, #values - 1) + 1]
end

-- Rebirth ----------------------------------------------------------------------------------

function Formulas.RebirthRequirement(rebirths: number): number
	local list = Rebirths.RequirementList
	if rebirths < #list then
		return list[rebirths + 1]
	end
	return Formulas.Nice(list[#list] * Rebirths.RequirementGrowth ^ (rebirths - #list + 1))
end

function Formulas.RebirthMult(rebirths: number): number
	return 1 + rebirths * Rebirths.GainsPerRebirth
end

function Formulas.RebirthTokens(rebirths: number): number
	-- tokens earned when going from `rebirths` to `rebirths + 1`
	return Rebirths.TokensBase + Rebirths.TokensPerRebirth * rebirths
end

-- Dumbbell leveling ---------------------------------------------------------------------------

function Formulas.XpToNext(level: number): number
	return math.floor(Balance.DumbbellXpBase * level ^ Balance.DumbbellXpExp + 0.5)
end

-- Training -----------------------------------------------------------------------------------

function Formulas.ComboBonus(combo: number, mastery: number?): number
	local bonus = 0
	for _, tier in Balance.ComboTiers do
		if combo >= tier.At then
			bonus = tier.Bonus
		end
	end
	return bonus * (1 + (mastery or 0))
end

function Formulas.NextComboTier(combo: number): number?
	for _, tier in Balance.ComboTiers do
		if combo < tier.At then
			return tier.At
		end
	end
	return nil
end

function Formulas.RequiredStrength(weight: number): number
	return math.max(0, (weight - Balance.FreeLiftWeight) * Balance.StrengthPerKg)
end

-- Smashing -----------------------------------------------------------------------------------

local RARITY_TOUGHNESS = { 1, 1.35, 1.8, 2.4, 3.2, 4.2, 6 }

function Formulas.SmashPower(strength: number, hammerMult: number): number
	return (10 + strength) * hammerMult
end

function Formulas.NodeToughness(zoneId: string, materialId: string, mutated: boolean?): number
	local zone = Zones.ById[zoneId]
	local material = Materials.ById[materialId]
	local base = zone and zone.Toughness or 10
	local rank = material and Rarities.Rank(material.Rarity) or 1
	local t = base * RARITY_TOUGHNESS[rank]
	if mutated then
		t *= Balance.MutatedNodeHealthMult
	end
	return t
end

-- Damage (out of Balance.NodeHealth) one hit does. 0 means "too tough".
function Formulas.SmashDamage(power: number, toughness: number): number
	local ratio = power / math.max(toughness, 1e-9)
	if ratio < Balance.SmashMinRatio then
		return 0
	end
	return Balance.SmashDamage * math.min(ratio, Balance.SmashMaxRatio)
end

function Formulas.HitsToBreak(power: number, toughness: number): number
	local dmg = Formulas.SmashDamage(power, toughness)
	if dmg <= 0 then
		return math.huge
	end
	return math.ceil(Balance.NodeHealth / dmg - 1e-9)
end

-- Strength needed to smash a node at all
function Formulas.MinSmashStrength(toughness: number, hammerMult: number): number
	return math.max(0, toughness * Balance.SmashMinRatio / hammerMult - 10)
end

-- Weighted rolls -------------------------------------------------------------------------------

local function weightedPick(rng: any, entries: { { any } }): any
	local total = 0
	for _, e in entries do
		total += e[2]
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, e in entries do
		roll -= e[2]
		if roll <= 0 then
			return e[1]
		end
	end
	return entries[#entries][1]
end
Formulas.WeightedPick = weightedPick

function Formulas.QualityWeights(luck: number, rebirths: number): { { any } }
	local entries = {}
	for _, q in Qualities.List do
		if rebirths >= q.RebirthReq then
			table.insert(entries, { q.Id, q.Weight * math.max(luck, 1) ^ q.LuckPower })
		end
	end
	return entries
end

function Formulas.QualityOdds(luck: number, rebirths: number): { [string]: number }
	local entries = Formulas.QualityWeights(luck, rebirths)
	local total = 0
	for _, e in entries do
		total += e[2]
	end
	local odds = {}
	for _, e in entries do
		odds[e[1]] = e[2] / total
	end
	return odds
end

function Formulas.RollQuality(rng: any, luck: number, rebirths: number): string
	return weightedPick(rng, Formulas.QualityWeights(luck, rebirths)) or "Normal"
end

-- Mutation roll. bias = zone/event multipliers, extra = extra weights for event mutations.
function Formulas.RollMutation(rng: any, luck: number, bias: { [string]: number }?, extra: { [string]: number }?): string
	local entries = {}
	for _, m in Mutations.List do
		local w = m.Weight
		if bias and bias[m.Id] then
			w *= bias[m.Id]
		end
		if extra and extra[m.Id] then
			w += extra[m.Id]
		end
		if w > 0 then
			-- luck helps the rarer mutations more than the common ones
			local rank = Rarities.Rank(m.Rarity)
			if rank >= 3 then
				w *= math.max(luck, 1) ^ math.min(1, (rank - 2) * 0.35)
			end
			table.insert(entries, { m.Id, w })
		end
	end
	return weightedPick(rng, entries) or "Shiny"
end

-- Which material a node in this zone spawns as. boost = per-material multipliers (events).
function Formulas.MaterialWeights(zoneId: string, luck: number, boost: { [string]: number }?): { { any } }
	local entries = {}
	for _, m in Materials.ByZone[zoneId] or {} do
		local w = m.Spawn
		local rank = Rarities.Rank(m.Rarity)
		local zoneRankOffset = rank - Rarities.Rank((Materials.ByZone[zoneId][1]).Rarity)
		if zoneRankOffset >= 1 then
			w *= math.max(luck, 1) ^ math.min(1, zoneRankOffset * 0.4)
		end
		if boost and boost[m.Id] then
			w *= boost[m.Id]
		end
		table.insert(entries, { m.Id, w })
	end
	return entries
end

function Formulas.RollMaterial(rng: any, zoneId: string, luck: number, boost: { [string]: number }?): string?
	return weightedPick(rng, Formulas.MaterialWeights(zoneId, luck, boost))
end

-- Selling ---------------------------------------------------------------------------------------

-- The dealer will not pay full price for materials from zones you haven't reached:
-- anything above your best zone sells as if it came from your best zone.
function Formulas.SellCap(highestTier: number): number
	local zone = Zones.ByTier[math.clamp(highestTier + 1, 1, Zones.Count)]
	local best = 0
	for _, m in Materials.ByZone[zone.Id] or {} do
		best = math.max(best, m.Power)
	end
	return best * Balance.MaterialSellPerPower * 50
end

return Formulas
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ItemKey</string>
          <string name="Source"><![CDATA[--[[
	ItemKey - materials are stored as stacks keyed by "Material|Refine|Mutation".

	"Iron|0|"         = raw Iron
	"Iron|2|Golden"   = Refined Golden Iron

	Keeping stacks as one string key keeps saves small and makes trading/selling simple.
]]

local Config = script.Parent.Config
local Materials = require(Config.Materials)
local Mutations = require(Config.Mutations)
local Refine = require(Config.Refine)
local Rarities = require(Config.Rarities)
local Balance = require(Config.Balance)

export type Parsed = { Material: string, Refine: number, Mutation: string? }

local ItemKey = {}

local cache: { [string]: Parsed } = {}

function ItemKey.Make(material: string, refine: number?, mutation: string?): string
	return material .. "|" .. tostring(refine or 0) .. "|" .. (mutation or "")
end

function ItemKey.Parse(key: string): Parsed?
	local hit = cache[key]
	if hit then
		return hit
	end
	if type(key) ~= "string" or #key > 64 then
		return nil
	end
	local material, refine, mutation = string.match(key, "^([%w]+)|(%d)|([%w]*)$")
	if not material then
		return nil
	end
	if not Materials.ById[material] then
		return nil
	end
	local r = tonumber(refine) :: number
	if r < 0 or r > Refine.Max then
		return nil
	end
	if mutation ~= "" and not Mutations.ById[mutation] then
		return nil
	end
	local parsed = { Material = material, Refine = r, Mutation = mutation ~= "" and mutation or nil }
	cache[key] = parsed
	return parsed
end

function ItemKey.IsValid(key: any): boolean
	return type(key) == "string" and ItemKey.Parse(key) ~= nil
end

function ItemKey.Material(key: string)
	local p = ItemKey.Parse(key)
	return p and Materials.ById[p.Material]
end

-- Power of one unit (material power x refine x mutation)
function ItemKey.UnitPower(key: string): number
	local p = ItemKey.Parse(key)
	if not p then
		return 0
	end
	local m = Materials.ById[p.Material]
	return m.Power * Refine.Get(p.Refine).Mult * Mutations.Mult(p.Mutation)
end

function ItemKey.UnitWeight(key: string): number
	local p = ItemKey.Parse(key)
	if not p then
		return 0
	end
	return Materials.ById[p.Material].Weight
end

function ItemKey.UnitValue(key: string): number
	return math.floor(ItemKey.UnitPower(key) * Balance.MaterialSellPerPower + 0.5)
end

-- Rarity of the stack: the material's rarity, bumped by a strong mutation.
function ItemKey.RarityRank(key: string): number
	local p = ItemKey.Parse(key)
	if not p then
		return 1
	end
	local rank = Rarities.Rank(Materials.ById[p.Material].Rarity)
	local mut = Mutations.Get(p.Mutation)
	if mut then
		rank = math.max(rank, math.min(Rarities.Rank(mut.Rarity), rank + 2))
	end
	return math.clamp(rank, 1, #Rarities.List)
end

function ItemKey.DisplayName(key: string): string
	local p = ItemKey.Parse(key)
	if not p then
		return "???"
	end
	local m = Materials.ById[p.Material]
	local base = m.Name
	local mut = Mutations.Get(p.Mutation)
	if mut then
		base = mut.Name .. " " .. base
	end
	return string.format(Refine.Get(p.Refine).Pattern, base)
end

return ItemKey
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">PlayerStats</string>
          <string name="Source"><![CDATA[--[[
	PlayerStats - turns a player's saved data into the numbers the game runs on
	(luck, gains multiplier, lift speed, backpack size...).

	Shared: the server uses it for real rewards, the client uses it for the HUD and
	upgrade screens. Pass `ctx` with extras that aren't in the save:
		ctx.Passes = { VIP = true, ... }     -- owned gamepasses
		ctx.Event  = { Gains = 2, Luck = 1.5, Crit = 2, Speed = 1.2 }   -- live event modifiers
		ctx.Now    = os.time()              -- for potion timers
]]

local Config = script.Parent.Config
local Balance = require(Config.Balance)
local Upgrades = require(Config.Upgrades)
local Rebirths = require(Config.Rebirths)
local Formulas = require(script.Parent.Formulas)

local PlayerStats = {}

local function upgrade(data: any, id: string): number
	local u = Upgrades.ById[id]
	return Formulas.UpgradeValue(u, (data.Upgrades and data.Upgrades[id]) or 0)
end

local function perk(data: any, id: string): number
	local p = Rebirths.PerkById[id]
	local level = (data.Perks and data.Perks[id]) or 0
	return level * p.Per
end

local function boostActive(data: any, name: string, now: number): boolean
	local t = data.Boosts and data.Boosts[name]
	return t ~= nil and t > now
end

export type Stats = { [string]: number }

function PlayerStats.Compute(data: any, ctx: any?): Stats
	ctx = ctx or {}
	local passes = ctx.Passes or {}
	local event = ctx.Event or {}
	local now = ctx.Now or os.time()
	local rebirths = data.Rebirths or 0

	-- Luck ------------------------------------------------------------------------------------
	local luck = 1 + rebirths * Rebirths.LuckPerRebirth + perk(data, "LuckyGenes") + (data.BonusLuck or 0)
	if boostActive(data, "Luck", now) then
		luck *= 2
	end
	if boostActive(data, "MegaLuck", now) then
		luck *= 3
	end
	if passes.VIP then
		luck *= 1.1
	end
	luck *= event.Luck or 1

	-- Gains & coins -----------------------------------------------------------------------------
	local gains = Formulas.RebirthMult(rebirths) * (1 + perk(data, "MuscleMemory"))
	if boostActive(data, "Gains", now) then
		gains *= 2
	end
	if passes.VIP then
		gains *= 1.1
	end
	gains *= event.Gains or 1

	local coins = gains * (1 + upgrade(data, "CoinBoost"))
	if passes.VIP then
		coins *= 1.1
	end
	coins *= event.Coins or 1

	-- Training ---------------------------------------------------------------------------------
	local liftCooldown = Balance.LiftCooldown * upgrade(data, "LiftSpeed") * (1 - perk(data, "QuickHands"))
	liftCooldown /= event.Speed or 1

	local stats: Stats = {
		Luck = luck,
		MaterialLuck = luck * (1 + upgrade(data, "MaterialLuck")),
		CraftLuck = luck * (1 + upgrade(data, "CraftLuck")),
		MutationLuck = luck * (1 + upgrade(data, "MutationLuck")),
		Gains = gains,
		Coins = coins,
		LiftCooldown = liftCooldown,
		CritChance = Balance.CritChance + upgrade(data, "CritChance") + perk(data, "CritInstinct"),
		CritMult = (Balance.CritMult + upgrade(data, "CritPower")) * (event.Crit or 1),
		SuperChance = Balance.SuperCritChance,
		SuperMult = Balance.SuperCritMult,
		ComboWindow = Balance.ComboWindow + upgrade(data, "ComboMastery") * 1.5 + perk(data, "StickyCombo"),
		ComboMastery = upgrade(data, "ComboMastery"),
		Backpack = math.floor(upgrade(data, "Backpack") * (1 + perk(data, "PocketSpace")) * (passes.Backpack and 2 or 1)),
		WalkSpeed = upgrade(data, "WalkSpeed"),
		JumpHeight = upgrade(data, "JumpPower"),
		Hammer = upgrade(data, "Hammer"),
		SmashCooldown = Balance.SmashCooldown * upgrade(data, "SmashSpeed"),
		Yield = upgrade(data, "Yield"),
		ForgeTime = Balance.ForgeTime * upgrade(data, "ForgeSpeed") * (passes.FastForge and 0.5 or 1),
		MaxPlateSize = upgrade(data, "ForgeLevel") + perk(data, "BigForge"),
		ProcessSpeed = upgrade(data, "ProcessSpeed") * (passes.AutoProcess and 0.6 or 1),
		ProcessSlots = upgrade(data, "ProcessSlots") + (passes.AutoProcess and 2 or 0),
		BossDamage = 1 + upgrade(data, "BossDamage"),
		EquipSlots = Rebirths.EquipSlots(rebirths, passes.ExtraSlot == true),
		AutoDeposit = upgrade(data, "AutoDeposit"),
		Yield2 = boostActive(data, "Yield", now) and 1 or 0,
	}
	if stats.AutoDeposit == 0 and ((data.Perks and data.Perks.ForeverTeleporter) or 0) > 0 then
		stats.AutoDeposit = Upgrades.ById.AutoDeposit.Values[2]
	end
	return stats
end

-- Combine player stats with the equipped dumbbell's stats for one rep.
function PlayerStats.ForLift(stats: Stats, db: any?): { [string]: number }
	local crit = stats.CritChance + (db and db.Crit or 0)
	return {
		Power = db and db.Power or Balance.UnarmedGains,
		Gains = stats.Gains,
		Coins = stats.Coins * (1 + (db and db.Coins or 0)),
		Cooldown = math.max(Balance.LiftCooldownMin, stats.LiftCooldown * (1 - (db and db.Speed or 0))),
		CritChance = math.min(crit, 0.75),
		CritMult = stats.CritMult * (1 + (db and db.CritPower or 0)),
		SuperChance = stats.SuperChance + (db and db.Super or 0),
		SuperMult = stats.SuperMult,
		ComboWindow = stats.ComboWindow + (db and db.Combo or 0),
		ComboMastery = stats.ComboMastery + (db and db.ComboBonus or 0),
		Luck = stats.Luck * (1 + (db and db.Luck or 0)),
	}
end

return PlayerStats
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format - turns numbers into short, readable text.

	Format.Short(1234)        -> "1.23K"
	Format.Short(5.2e15)      -> "5.2Qa"
	Format.Commas(1234567)    -> "1,234,567"
	Format.Time(125)          -> "2m 05s"
	Format.Percent(0.125)     -> "12.5%"
	Format.Mult(2.5)          -> "x2.5"
]]

local Format = {}

local SUFFIXES = {
	"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc",
	"Ud", "Dd", "Td", "Qad", "Qid", "Sxd", "Spd", "Ocd", "Nod", "Vg",
	"Uvg", "Dvg", "Tvg", "Qavg", "Qivg", "Sxvg", "Spvg", "Ocvg", "Novg", "Tg",
}

local function trim(s: string): string
	-- "1.50" -> "1.5", "2.00" -> "2"
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

-- Short form with ~3 significant digits.
function Format.Short(n: number?): string
	n = n or 0
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "∞"
	end
	local negative = n < 0
	n = math.abs(n)
	local text: string
	if n < 1000 then
		if n < 10 and n ~= math.floor(n) then
			text = trim(string.format("%.1f", math.floor(n * 10) / 10))
		else
			text = tostring(math.floor(n))
		end
	else
		local tier = math.floor(math.log10(n) / 3)
		tier = math.min(tier, #SUFFIXES - 1)
		local scaled = n / 10 ^ (tier * 3)
		-- floor instead of round so 999.9K never shows as 1000K
		if scaled >= 100 then
			text = tostring(math.floor(scaled))
		elseif scaled >= 10 then
			text = trim(string.format("%.1f", math.floor(scaled * 10) / 10))
		else
			text = trim(string.format("%.2f", math.floor(scaled * 100) / 100))
		end
		text ..= SUFFIXES[tier + 1]
	end
	return (negative and "-" or "") .. text
end

function Format.Commas(n: number?): string
	n = math.floor(n or 0)
	if math.abs(n) >= 1e15 then
		return Format.Short(n)
	end
	local s = tostring(math.abs(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	out = string.gsub(out, "^,", "")
	return (n < 0 and "-" or "") .. out
end

function Format.Time(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

function Format.Clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function Format.Percent(fraction: number, decimals: number?): string
	local d = decimals or 1
	return trim(string.format("%." .. d .. "f", fraction * 100)) .. "%"
end

function Format.Mult(m: number): string
	if m >= 1000 then
		return "x" .. Format.Short(m)
	end
	return "x" .. trim(string.format("%.2f", m))
end

function Format.Chance(p: number): string
	-- 0.004 -> "1 in 250"
	if p <= 0 then
		return "—"
	end
	if p >= 0.1 then
		return Format.Percent(p)
	end
	return "1 in " .. Format.Short(math.floor(1 / p + 0.5))
end

function Format.Weight(kg: number): string
	return Format.Short(kg) .. " kg"
end

return Format
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Visuals</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DumbbellModel</string>
            <string name="Source"><![CDATA[--[[
	DumbbellModel - builds the 3D dumbbell for a dumbbell record, out of the exact
	materials the player chose (left plate, handle, right plate).

	local model = DumbbellModel.Build(record, {
		CFrame = CFrame.new(...),   -- handle center; the handle runs along the CFrame's X axis
		Scale = 1,                  -- overall size multiplier
		Anchored = true,            -- anchored (showcases) or welded to the Handle (held in hand)
		Detail = "High" | "Low",    -- Low skips small details (for trophy stands)
		Effects = true,             -- particles / lights / mutation looks
	})
	model.PrimaryPart is the Handle. Bigger plate sizes make the plates bigger on purpose.
]]

local Shared = script.Parent.Parent
local Materials = require(Shared.Config.Materials)
local Qualities = require(Shared.Config.Qualities)
local Rarities = require(Shared.Config.Rarities)
local DumbbellStats = require(Shared.DumbbellStats)
local Parts = require(script.Parent.Parts)
local MutationFx = require(script.Parent.MutationFx)

local DumbbellModel = {}

local rad = math.rad
local SQRT3_2 = 0.8660254

local function darker(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), t)
end

local function lighter(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), t)
end

type PlateCtx = {
	model: Model,
	cf: CFrame,
	D: number,
	T: number,
	mat: any,
	anchored: boolean,
	rng: (number?, number?) -> number,
	detail: string,
	outward: number,
}

local function styled(p: BasePart, mat: any)
	p.Material = Parts.material(mat.Material)
	if mat.Reflectance then
		p.Reflectance = mat.Reflectance
	end
	if mat.Transparency then
		p.Transparency = mat.Transparency
	end
	return p
end

local PLATE = {}

function PLATE.Disc(c: PlateCtx): { BasePart }
	local out = {}
	local col = c.mat.Color
	table.insert(out, styled(Parts.cyl(c.model, "Plate", c.cf, c.T, c.D, darker(col, 0.12), nil, c.anchored), c.mat))
	table.insert(out, styled(Parts.cyl(c.model, "PlateFace", c.cf, c.T * 1.12, c.D * 0.8, col, nil, c.anchored), c.mat))
	if c.detail == "High" then
		local hub = Parts.cyl(c.model, "Hub", c.cf, c.T * 1.24, c.D * 0.32, c.mat.Color2, Enum.Material.Metal, c.anchored)
		table.insert(out, hub)
	end
	return out
end

function PLATE.Tire(c: PlateCtx): { BasePart }
	local out = {}
	table.insert(out, styled(Parts.cyl(c.model, "Tire", c.cf, c.T * 1.1, c.D, c.mat.Color, nil, c.anchored), c.mat))
	table.insert(out, Parts.cyl(c.model, "Tread", c.cf, c.T * 0.7, c.D * 1.04, darker(c.mat.Color, 0.25), Enum.Material.Rubber, c.anchored))
	table.insert(out, Parts.cyl(c.model, "Rim", c.cf, c.T * 1.18, c.D * 0.5, c.mat.Color2, Enum.Material.Metal, c.anchored))
	return out
end

function PLATE.Hex(c: PlateCtx): { BasePart }
	local out = {}
	local col = c.mat.Color
	for i = 0, 2 do
		local cf = c.cf * CFrame.Angles(rad(60 * i), 0, 0)
		table.insert(out, styled(Parts.part(c.model, "Hex", cf, Vector3.new(c.T, c.D * SQRT3_2, c.D * 0.5), darker(col, 0.1), nil, c.anchored), c.mat))
	end
	if c.detail == "High" then
		for i = 0, 2 do
			local cf = c.cf * CFrame.Angles(rad(60 * i), 0, 0)
			table.insert(out, styled(Parts.part(c.model, "HexFace", cf, Vector3.new(c.T * 1.12, c.D * SQRT3_2 * 0.72, c.D * 0.5 * 0.72), lighter(col, 0.06), nil, c.anchored), c.mat))
		end
		table.insert(out, Parts.cyl(c.model, "Hub", c.cf, c.T * 1.24, c.D * 0.3, c.mat.Color2, Enum.Material.Metal, c.anchored))
	end
	return out
end

function PLATE.Rock(c: PlateCtx): { BasePart }
	local out = {}
	local col = c.mat.Color
	for i = 1, 3 do
		local size = Vector3.new(c.T * c.rng(1.4, 2.1), c.D * c.rng(0.55, 0.78), c.D * c.rng(0.55, 0.78))
		local rot = CFrame.Angles(rad(c.rng(0, 90)), rad(c.rng(-20, 20)), rad(c.rng(-20, 20)))
		local off = CFrame.new(0, c.D * c.rng(-0.08, 0.08), c.D * c.rng(-0.08, 0.08))
		table.insert(out, styled(Parts.part(c.model, "Rock", c.cf * off * rot, size, col:Lerp(c.mat.Color2, c.rng(0, 0.3)), nil, c.anchored), c.mat))
	end
	return out
end

function PLATE.Crystal(c: PlateCtx): { BasePart }
	local out = {}
	local col = c.mat.Color
	table.insert(out, styled(Parts.part(c.model, "Gem", c.cf * CFrame.Angles(rad(45), 0, 0), Vector3.new(c.T * 1.7, c.D * 0.66, c.D * 0.66), col, nil, c.anchored), c.mat))
	table.insert(out, styled(Parts.part(c.model, "Gem2", c.cf * CFrame.Angles(0, 0, 0), Vector3.new(c.T * 1.3, c.D * 0.62, c.D * 0.62), darker(col, 0.08), nil, c.anchored), c.mat))
	if c.mat.Glow then
		local core = Parts.part(c.model, "Core", c.cf * CFrame.Angles(rad(45), 0, 0), Vector3.new(c.T * 1.8, c.D * 0.28, c.D * 0.28), lighter(c.mat.Color2, 0.2), Enum.Material.Neon, c.anchored)
		table.insert(out, core)
	end
	return out
end

function PLATE.Orb(c: PlateCtx): { BasePart }
	local out = {}
	table.insert(out, styled(Parts.ball(c.model, "Orb", c.cf, c.D * 0.86, c.mat.Color, nil, c.anchored), c.mat))
	if c.detail == "High" then
		local ring = Parts.cyl(c.model, "Ring", c.cf * CFrame.Angles(0, 0, rad(90)) * CFrame.Angles(rad(20), 0, 0), 0.07, c.D * 1.12, c.mat.Color2, c.mat.Glow and Enum.Material.Neon or Enum.Material.Metal, c.anchored)
		table.insert(out, ring)
	end
	return out
end

function PLATE.Block(c: PlateCtx): { BasePart }
	local out = {}
	local col = c.mat.Color
	table.insert(out, styled(Parts.part(c.model, "Block", c.cf, Vector3.new(c.T * 1.7, c.D * 0.84, c.D * 0.84), col, nil, c.anchored), c.mat))
	if c.detail == "High" then
		table.insert(out, styled(Parts.part(c.model, "Edge", c.cf, Vector3.new(c.T * 1.5, c.D * 0.9, c.D * 0.72), darker(col, 0.12), nil, c.anchored), c.mat))
		table.insert(out, styled(Parts.part(c.model, "Edge", c.cf, Vector3.new(c.T * 1.5, c.D * 0.72, c.D * 0.9), darker(col, 0.12), nil, c.anchored), c.mat))
	end
	return out
end

function PLATE.Spiky(c: PlateCtx): { BasePart }
	local out = {}
	table.insert(out, styled(Parts.ball(c.model, "Core", c.cf, c.D * 0.78, c.mat.Color, nil, c.anchored), c.mat))
	local spikes = c.detail == "High" and 8 or 5
	for i = 1, spikes do
		local a = (i / spikes) * 360
		local cf = c.cf * CFrame.Angles(rad(a), 0, 0) * CFrame.new(0, c.D * 0.42, 0) * CFrame.Angles(0, rad(45), 0)
		table.insert(out, Parts.part(c.model, "Spike", cf, Vector3.new(c.D * 0.16, c.D * 0.34, c.D * 0.16), c.mat.Color2, Enum.Material.Neon, c.anchored))
	end
	return out
end

local function plateFor(style: string)
	return PLATE[style] or PLATE.Disc
end

-- Special looks for secret recipes
local function recipeLook(model: Model, look: string, handle: BasePart, plates: { { BasePart } }, anchored: boolean, s: number, platePos: { CFrame }, D: number)
	local gold = Color3.fromRGB(255, 206, 60)
	if look == "Meteor" or look == "Frostfire" or look == "Solar" then
		for i, list in plates do
			local f = Instance.new("Fire")
			f.Size = 1.6 * s * (D / 1.3)
			f.Heat = 3
			if look == "Frostfire" and i == 1 then
				f.Color = Color3.fromRGB(120, 200, 255)
				f.SecondaryColor = Color3.fromRGB(220, 250, 255)
			end
			f.Parent = list[1]
		end
	elseif look == "Royal" or look == "Divine" or look == "Chrome" then
		for _, cf in platePos do
			local ring = Parts.cyl(model, "Trim", cf, 0.08 * s, D * 1.08, gold, Enum.Material.Foil, anchored)
			ring.Reflectance = 0.3
		end
		if look ~= "Chrome" then
			local halo = Parts.cyl(model, "Halo", handle.CFrame * CFrame.new(0, 1.2 * s + D * 0.3, 0) * CFrame.Angles(0, 0, rad(90)), 0.06 * s, 1.2 * s, gold, Enum.Material.Neon, anchored)
			if look == "Divine" then
				halo.Color = Color3.fromRGB(255, 246, 214)
			end
		end
	elseif look == "Reactor" or look == "Nuclear" or look == "Toxic" then
		local col = look == "Reactor" and Color3.fromRGB(190, 80, 255) or Color3.fromRGB(110, 255, 70)
		local core = Parts.cyl(model, "ReactorCore", handle.CFrame, handle.Size.X * 0.5, handle.Size.Y * 1.25, col, Enum.Material.Neon, anchored)
		local l = Instance.new("PointLight")
		l.Color = col
		l.Range = 8 * s
		l.Brightness = 1.2
		l.Parent = core
	elseif look == "Rainbow" or look == "Galaxy" or look == "Glitch" then
		for _, list in plates do
			for _, p in list do
				pcall(function()
					p:AddTag(look == "Glitch" and "Glitch" or "Rainbow")
				end)
			end
		end
	else
		-- every other secret dumbbell gets golden trim so it stands out
		for _, cf in platePos do
			Parts.cyl(model, "Trim", cf, 0.07 * s, D * 1.06, gold, Enum.Material.Foil, anchored)
		end
	end
end

function DumbbellModel.Build(record: any, opts: { [string]: any }?): Model
	opts = opts or {}
	local anchored = opts.Anchored == true
	local detail = opts.Detail or "High"
	local effects = opts.Effects ~= false
	local s = opts.Scale or 1
	local root: CFrame = opts.CFrame or CFrame.new()

	local stats = DumbbellStats.Compute(record)
	local model = Instance.new("Model")
	model.Name = opts.Name or "Dumbbell"

	local parts = record.Parts
	local mats = {
		Materials.ById[parts[1].Material] or Materials.ById.Rubber,
		Materials.ById[parts[2].Material] or Materials.ById.Plastic,
		Materials.ById[parts[3].Material] or Materials.ById.Rubber,
	}
	local rng = Parts.rng(Parts.hash(tostring(record.Id or "preview")))

	local plateScale = DumbbellStats.PlateScale(stats.Size)
	local D = 1.3 * plateScale * s
	local T = 0.3 * (0.8 + 0.2 * plateScale) * s
	local stack = stats.Size >= 8 and 3 or (stats.Size >= 3 and 2 or 1)
	local handleD = 0.3 * s * (1 + 0.12 * (plateScale - 1))
	local grip = 1.5 * s * (1 + 0.1 * (plateScale - 1))
	local collarT = 0.16 * s
	local gap = T * 0.1

	-- how far the plate stack reaches from the collar
	local stackT = 0
	local thickness = {}
	for i = 1, stack do
		local t = T * (1 - (i - 1) * 0.12)
		thickness[i] = t
		stackT += t + gap
	end
	local halfLen = grip / 2 + collarT + stackT + 0.12 * s

	-- handle ---------------------------------------------------------------------------------
	local hm = mats[2]
	local handle = styled(Parts.cyl(model, "Handle", root, halfLen * 2, handleD, hm.Color, nil, anchored), hm)
	handle.Transparency = math.min(handle.Transparency, 0.1)
	model.PrimaryPart = handle
	local handleParts = { handle }
	if detail == "High" then
		for i = -1, 1 do
			local knurl = Parts.cyl(model, "Knurl", root * CFrame.new(i * grip * 0.28, 0, 0), 0.05 * s, handleD * 1.12, darker(hm.Color, 0.2), Parts.material(hm.Material), anchored)
			table.insert(handleParts, knurl)
		end
	end

	-- plates ----------------------------------------------------------------------------------
	local platesBySide = {}
	local platePos = {}
	for side = 1, 2 do
		local sign = side == 1 and -1 or 1
		local part = parts[side == 1 and 1 or 3]
		local mat = mats[side == 1 and 1 or 3]
		local collarCf = root * CFrame.new(sign * (grip / 2 + collarT / 2), 0, 0)
		Parts.cyl(model, "Collar", collarCf, collarT, handleD * 2, Color3.fromRGB(206, 212, 222), Enum.Material.Metal, anchored)
		local x = grip / 2 + collarT + gap
		local sideParts = {}
		for i = 1, stack do
			local t = thickness[i]
			local d = D * (1 - (i - 1) * 0.16)
			local cf = root * CFrame.new(sign * (x + t / 2), 0, 0)
			local list = plateFor(mat.Plate)({
				model = model, cf = cf, D = d, T = t, mat = mat, anchored = anchored,
				rng = rng, detail = detail, outward = sign,
			})
			for _, p in list do
				table.insert(sideParts, p)
			end
			if i == 1 then
				table.insert(platePos, cf)
			end
			x += t + gap
		end
		local cap = Parts.cyl(model, "Cap", root * CFrame.new(sign * (halfLen - 0.05 * s), 0, 0), 0.1 * s, handleD * 1.5, mat.Color2, Enum.Material.Metal, anchored)
		table.insert(sideParts, cap)
		platesBySide[side] = sideParts

		if effects then
			if mat.Glow and detail == "High" then
				local l = Instance.new("PointLight")
				l.Color = mat.Color
				l.Brightness = 0.7
				l.Range = 3 + D * 2
				l.Parent = sideParts[1]
			end
			if part.Mutation then
				MutationFx.Apply(sideParts, part.Mutation, sideParts[1], D / 1.3)
			end
		end
	end
	if effects and parts[2].Mutation then
		MutationFx.Apply(handleParts, parts[2].Mutation, handle, 0.6 * s)
	end

	-- quality, recipe, level --------------------------------------------------------------------
	if effects then
		local q = Qualities.Get(record.Quality)
		if q.Fx ~= "None" then
			local all = {}
			for _, list in platesBySide do
				for _, p in list do
					table.insert(all, p)
				end
			end
			MutationFx.ApplyQuality(all, q, handle, D / 1.3)
		end
		if stats.Recipe then
			recipeLook(model, stats.Recipe.Look, handle, platesBySide, anchored, s, platePos, D)
		end
		local level = record.Level or 1
		if level >= 25 then
			local rarity = Rarities.Get(stats.Rarity)
			MutationFx.Emitter(handle, {
				Color = ColorSequence.new(rarity.Color, Color3.new(1, 1, 1)),
				Rate = level >= 50 and 10 or 4,
				Size = NumberSequence.new(0.3 * s, 0),
			})
		end
		if level >= 100 then
			pcall(function()
				handle:AddTag("Evolved")
			end)
		end
	end

	if not anchored then
		Parts.weldAll(model, handle)
	end
	model:SetAttribute("DumbbellId", record.Id or "")
	model:SetAttribute("Length", halfLen * 2)
	model:SetAttribute("PlateDiameter", D)
	return model
end

return DumbbellModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MutationFx</string>
            <string name="Source"><![CDATA[--[[
	MutationFx - makes mutated materials look special, on world nodes and on dumbbells.

	MutationFx.Apply(parts, mutationId, emitterPart, scale)
		parts       : the parts to recolor (plates / node chunks)
		emitterPart : where particles, fire and lights attach
		scale       : size of the effect (1 = dumbbell-sized, 3-4 = world node)

	Some looks animate on the client (tags read by Controllers/FxController):
		"Rainbow" - hue cycling, "Glitch" - flickering colors, "Flicker" - lights flicker
]]

local Mutations = require(script.Parent.Parent.Config.Mutations)

local MutationFx = {}

local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function seq(a: number, b: number): NumberSequence
	return NumberSequence.new(a, b)
end

function MutationFx.Emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Rate = 6
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = seq(0.4, 0)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	for k, v in props do
		(e :: any)[k] = v
	end
	e.Parent = parent
	return e
end

local function light(parent: Instance, color: Color3, brightness: number, range: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

local function tint(parts: { BasePart }, color: Color3, amount: number, material: Enum.Material?)
	for _, p in parts do
		p.Color = p.Color:Lerp(color, amount)
		if material then
			p.Material = material
		end
	end
end

local function tag(inst: Instance, name: string)
	pcall(function()
		inst:AddTag(name)
	end)
end

function MutationFx.Apply(parts: { BasePart }, mutationId: string?, emitterPart: BasePart, scale: number?)
	local m = Mutations.Get(mutationId)
	if not m or #parts == 0 then
		return
	end
	local s = scale or 1
	local fx = m.Fx
	local c1, c2 = m.Color, m.Color2

	if fx == "Sparkle" then
		for _, p in parts do
			p.Reflectance = math.max(p.Reflectance, 0.25)
		end
		tint(parts, c1, 0.15)
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c1, c2), Rate = 5, Size = seq(0.35 * s, 0) })
	elseif fx == "Gold" then
		tint(parts, c1, 0.75, Enum.Material.Foil)
		for _, p in parts do
			p.Reflectance = 0.25
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c1, c2), Rate = 7, Size = seq(0.4 * s, 0) })
		light(emitterPart, c1, 0.8, 5 * s)
	elseif fx == "Frost" then
		tint(parts, c1, 0.6, Enum.Material.Ice)
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(Color3.new(1, 1, 1)), Rate = 8, Size = seq(0.25 * s, 0.1 * s),
			Speed = NumberRange.new(0.2, 0.6), Acceleration = Vector3.new(0, -1.5, 0), Lifetime = NumberRange.new(1, 2),
		})
	elseif fx == "Fire" then
		tint(parts, c1, 0.35)
		local f = Instance.new("Fire")
		f.Size = 2.5 * s
		f.Heat = 4 * s
		f.Color = c1
		f.SecondaryColor = c2
		f.Parent = emitterPart
		light(emitterPart, c1, 1.2, 7 * s)
	elseif fx == "Electric" then
		tint(parts, c1, 0.3)
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(c1, c2), Rate = 14, Lifetime = NumberRange.new(0.08, 0.2),
			Speed = NumberRange.new(4 * s, 8 * s), Size = seq(0.3 * s, 0.05 * s), LightEmission = 1,
		})
		local l = light(emitterPart, c1, 1.2, 6 * s)
		tag(l, "Flicker")
	elseif fx == "Toxic" then
		tint(parts, c1, 0.5)
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(c1, c2), Rate = 6, Size = seq(0.3 * s, 0.5 * s),
			Speed = NumberRange.new(0.5, 1.2), Acceleration = Vector3.new(0, 1.5, 0), Texture = SPARKLES,
		})
		light(emitterPart, c1, 0.6, 5 * s)
	elseif fx == "Magnetic" then
		for i, p in parts do
			p.Color = p.Color:Lerp(i % 2 == 0 and c2 or c1, 0.6)
			p.Material = Enum.Material.Metal
		end
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(c1, c2), Rate = 10, Size = seq(0.2 * s, 0.2 * s),
			Speed = NumberRange.new(0, 0), RotSpeed = NumberRange.new(200, 400), Lifetime = NumberRange.new(0.5, 1),
			Shape = Enum.ParticleEmitterShape.Sphere, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		})
	elseif fx == "Radioactive" then
		for i, p in parts do
			p.Color = p.Color:Lerp(c1, 0.7)
			if i % 2 == 1 then
				p.Material = Enum.Material.Neon
			end
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c1, c2), Rate = 9, Size = seq(0.45 * s, 0) })
		light(emitterPart, c1, 1.4, 8 * s)
	elseif fx == "Crystal" then
		tint(parts, c1, 0.55, Enum.Material.Glass)
		for _, p in parts do
			p.Transparency = math.max(p.Transparency, 0.2)
			p.Reflectance = 0.3
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c1, c2), Rate = 8, Size = seq(0.4 * s, 0) })
		light(emitterPart, c1, 0.8, 6 * s)
	elseif fx == "Shadow" then
		tint(parts, c1, 0.8)
		MutationFx.Emitter(emitterPart, {
			Texture = SMOKE, Color = ColorSequence.new(c1, c2), Rate = 8, LightEmission = 0,
			Size = seq(0.6 * s, 1.4 * s), Speed = NumberRange.new(0.3, 0.8), Lifetime = NumberRange.new(1, 1.8),
			Transparency = NumberSequence.new(0.4, 1),
		})
	elseif fx == "Corrupted" then
		tint(parts, c1, 0.7)
		for i, p in parts do
			if i % 2 == 0 then
				p.Material = Enum.Material.Neon
				p.Color = c2
			end
			tag(p, "Glitch")
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c2, c1), Rate = 10, Size = seq(0.3 * s, 0), Lifetime = NumberRange.new(0.2, 0.5) })
		light(emitterPart, c2, 1, 6 * s)
	elseif fx == "Void" then
		tint(parts, c2, 0.8)
		for i, p in parts do
			if i % 2 == 0 then
				p.Material = Enum.Material.Neon
				p.Color = c1
			end
		end
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(c1, c2), Rate = 12, Size = seq(0.5 * s, 0),
			Speed = NumberRange.new(-2 * s, -1 * s), Lifetime = NumberRange.new(0.8, 1.4),
			Shape = Enum.ParticleEmitterShape.Sphere, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		})
		light(emitterPart, c1, 1.6, 8 * s)
	elseif fx == "Rainbow" then
		for _, p in parts do
			tag(p, "Rainbow")
			p.Material = Enum.Material.SmoothPlastic
			p.Reflectance = 0.15
		end
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 80)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 220, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
			}),
			Rate = 10, Size = seq(0.45 * s, 0),
		})
		light(emitterPart, Color3.fromRGB(255, 200, 255), 1, 6 * s)
	elseif fx == "Glitched" then
		for i, p in parts do
			p.Material = Enum.Material.Neon
			p.Color = i % 2 == 0 and c1 or c2
			tag(p, "Glitch")
		end
		MutationFx.Emitter(emitterPart, {
			Color = ColorSequence.new(c1, c2), Rate = 16, Size = seq(0.35 * s, 0.35 * s),
			Lifetime = NumberRange.new(0.1, 0.3), Speed = NumberRange.new(2, 5), RotSpeed = NumberRange.new(0, 0),
		})
	elseif fx == "Cosmic" then
		tint(parts, c1, 0.75)
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c2, Color3.fromRGB(140, 180, 255)), Rate = 14, Size = seq(0.3 * s, 0), Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(0.2, 0.6) })
		light(emitterPart, Color3.fromRGB(120, 140, 255), 1.4, 8 * s)
	elseif fx == "Celestial" then
		for i, p in parts do
			p.Color = p.Color:Lerp(c1, 0.8)
			p.Material = i % 2 == 0 and Enum.Material.Neon or Enum.Material.Foil
			p.Reflectance = 0.2
			tag(p, "Celestial")
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(c1, c2), Rate = 16, Size = seq(0.55 * s, 0), Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(0.5, 2) })
		light(emitterPart, c2, 2, 10 * s)
	elseif fx == "Spooky" then
		tint(parts, c1, 0.6)
		MutationFx.Emitter(emitterPart, { Texture = SMOKE, Color = ColorSequence.new(c2, c1), Rate = 6, LightEmission = 0.3, Size = seq(0.5 * s, 1.2 * s), Transparency = NumberSequence.new(0.5, 1) })
		light(emitterPart, c1, 0.8, 6 * s)
	elseif fx == "Festive" then
		for i, p in parts do
			p.Color = p.Color:Lerp(i % 2 == 0 and c2 or c1, 0.6)
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(Color3.new(1, 1, 1)), Rate = 8, Size = seq(0.3 * s, 0.1 * s), Acceleration = Vector3.new(0, -2, 0) })
	end
end

-- Quality effects for dumbbells (Great and up).
function MutationFx.ApplyQuality(parts: { BasePart }, quality: any, emitterPart: BasePart, scale: number?)
	local s = scale or 1
	local fx = quality.Fx
	if fx == "Sparkle" then
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(quality.Color, Color3.new(1, 1, 1)), Rate = 3, Size = seq(0.25 * s, 0) })
	elseif fx == "Shiny" then
		for _, p in parts do
			p.Reflectance = math.max(p.Reflectance, 0.35)
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(Color3.new(1, 1, 1), quality.Color), Rate = 7, Size = seq(0.4 * s, 0) })
	elseif fx == "Gold" then
		tint(parts, quality.Color, 0.45)
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(quality.Color, quality.Color2), Rate = 9, Size = seq(0.45 * s, 0) })
		light(emitterPart, quality.Color, 1, 6 * s)
	elseif fx == "Rainbow" then
		for _, p in parts do
			tag(p, "Rainbow")
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(quality.Color, quality.Color2), Rate = 10, Size = seq(0.45 * s, 0) })
	elseif fx == "Glitched" then
		for _, p in parts do
			tag(p, "Glitch")
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(quality.Color, quality.Color2), Rate = 14, Size = seq(0.3 * s, 0.3 * s), Lifetime = NumberRange.new(0.1, 0.3) })
	elseif fx == "Celestial" then
		for _, p in parts do
			tag(p, "Celestial")
			p.Reflectance = math.max(p.Reflectance, 0.3)
		end
		MutationFx.Emitter(emitterPart, { Color = ColorSequence.new(quality.Color, quality.Color2), Rate = 18, Size = seq(0.6 * s, 0), Lifetime = NumberRange.new(1, 2) })
		light(emitterPart, quality.Color2, 2, 10 * s)
	end
end

return MutationFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">NodeModel</string>
            <string name="Source"><![CDATA[--[[
	NodeModel - builds the smashable material node you see in the world
	(a stack of tires, a plastic crate, an iron ore rock, a glowing crystal...).

	local model = NodeModel.Build(materialId, mutationId, cframe, seed)
	The model's PrimaryPart is "Hitbox" (invisible, used for clicks/taps and distance).
	Visible parts are anchored and collide, so players bump into nodes like real objects.
]]

local Shared = script.Parent.Parent
local Materials = require(Shared.Config.Materials)
local Rarities = require(Shared.Config.Rarities)
local Parts = require(script.Parent.Parts)
local MutationFx = require(script.Parent.MutationFx)

local NodeModel = {}

local rad = math.rad

local function darker(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), t)
end

local function lighter(c: Color3, t: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), t)
end

type Ctx = {
	model: Model,
	cf: CFrame,
	mat: any,
	rng: (number?, number?) -> number,
	s: number,
	main: { BasePart },
}

local function solid(p: BasePart): BasePart
	p.Anchored = true
	p.CanCollide = true
	p.Massless = false
	return p
end

local function add(ctx: Ctx, p: BasePart, isMain: boolean?): BasePart
	solid(p)
	if isMain ~= false then
		table.insert(ctx.main, p)
	end
	return p
end

local function styled(p: BasePart, mat: any): BasePart
	p.Material = Parts.material(mat.Material)
	if mat.Reflectance then
		p.Reflectance = mat.Reflectance
	end
	if mat.Transparency then
		p.Transparency = mat.Transparency
	end
	return p
end

local STYLE = {}

function STYLE.Tire(c: Ctx)
	local n = 2 + math.floor(c.rng() * 2)
	for i = 1, n do
		local off = CFrame.new(c.rng(-0.4, 0.4) * c.s, (0.65 + (i - 1) * 1.3) * c.s, c.rng(-0.4, 0.4) * c.s) * CFrame.Angles(0, rad(c.rng(0, 360)), 0)
		add(c, styled(Parts.disc(c.model, "Tire", c.cf * off, 4.2 * c.s, 1.3 * c.s, c.mat.Color, nil, true), c.mat))
		add(c, Parts.disc(c.model, "Hole", c.cf * off, 2.1 * c.s, 1.36 * c.s, Color3.fromRGB(18, 18, 22), Enum.Material.SmoothPlastic, true), false)
	end
end

local CRATE_COLORS = {
	Color3.fromRGB(255, 92, 76), Color3.fromRGB(70, 150, 255), Color3.fromRGB(255, 208, 60), Color3.fromRGB(90, 210, 110),
}

function STYLE.Crate(c: Ctx)
	local col = CRATE_COLORS[math.floor(c.rng() * #CRATE_COLORS) + 1]
	local stack = c.rng() < 0.4 and 2 or 1
	for i = 1, stack do
		local cf = c.cf * CFrame.new(0, (1.3 + (i - 1) * 2.6) * c.s, 0) * CFrame.Angles(0, rad(c.rng(-20, 20)), 0)
		add(c, Parts.part(c.model, "Crate", cf, Vector3.new(3.6, 2.6, 3.6) * c.s, col, Enum.Material.SmoothPlastic, true))
		local rim = darker(col, 0.25)
		for _, z in { -1.75, 1.75 } do
			add(c, Parts.part(c.model, "Rim", cf * CFrame.new(0, 1.2 * c.s, z * c.s), Vector3.new(3.7, 0.3, 0.25) * c.s, rim, Enum.Material.SmoothPlastic, true), false)
			add(c, Parts.part(c.model, "Rim", cf * CFrame.new(z * c.s, 1.2 * c.s, 0), Vector3.new(0.25, 0.3, 3.7) * c.s, rim, Enum.Material.SmoothPlastic, true), false)
		end
		add(c, Parts.part(c.model, "Slot", cf * CFrame.new(0, 0.5 * c.s, -1.81 * c.s), Vector3.new(1.4, 0.45, 0.05) * c.s, darker(col, 0.5), Enum.Material.SmoothPlastic, true), false)
	end
end

function STYLE.Logs(c: Ctx)
	local wood = c.mat.Color
	local ends = c.mat.Color2
	local positions = { { -0.8, 0.8 }, { 0.8, 0.8 }, { 0, 2.1 } }
	local yaw = CFrame.Angles(0, rad(c.rng(0, 180)), 0)
	for _, p in positions do
		local cf = c.cf * yaw * CFrame.new(0, p[2] * c.s, p[1] * c.s)
		add(c, styled(Parts.cyl(c.model, "Log", cf, 5 * c.s, 1.6 * c.s, wood, nil, true), c.mat))
		for _, x in { -2.52, 2.52 } do
			add(c, Parts.cyl(c.model, "End", cf * CFrame.new(x * c.s, 0, 0), 0.06 * c.s, 1.4 * c.s, ends, Enum.Material.Wood, true), false)
		end
	end
end

local function rockCluster(c: Ctx, color: Color3, material: Enum.Material, count: number, scale: number)
	local list = {}
	for i = 1, count do
		local size = Vector3.new(c.rng(2.2, 3.6), c.rng(1.8, 3), c.rng(2.2, 3.6)) * c.s * scale
		local off = CFrame.new(c.rng(-1, 1) * c.s, size.Y * 0.38, c.rng(-1, 1) * c.s)
		local rot = CFrame.Angles(rad(c.rng(-20, 20)), rad(c.rng(0, 360)), rad(c.rng(-20, 20)))
		local p = Parts.part(c.model, "Stone", c.cf * off * rot, size, color:Lerp(darker(color, 0.3), c.rng(0, 0.6)), material, true)
		table.insert(list, p)
	end
	return list
end

function STYLE.Rock(c: Ctx)
	for _, p in rockCluster(c, c.mat.Color, Parts.material(c.mat.Material), 4, 1.05) do
		add(c, p)
	end
end

function STYLE.Ore(c: Ctx)
	local stone = c.mat.Color2
	for _, p in rockCluster(c, stone, Enum.Material.Slate, 3, 1) do
		add(c, p, false)
	end
	local chunks = 5 + math.floor(c.rng() * 3)
	for i = 1, chunks do
		local a = (i / chunks) * 360 + c.rng(-20, 20)
		local r = c.rng(1, 1.9) * c.s
		local cf = c.cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(r, c.rng(1.4, 3) * c.s, 0) * CFrame.Angles(rad(c.rng(0, 90)), rad(c.rng(0, 90)), rad(c.rng(0, 90)))
		local size = Vector3.new(c.rng(0.9, 1.5), c.rng(0.9, 1.5), c.rng(0.9, 1.5)) * c.s
		add(c, styled(Parts.part(c.model, "Ore", cf, size, c.mat.Color, nil, true), c.mat))
	end
end

function STYLE.Scrap(c: Ctx)
	local rust = c.mat.Color
	local steel = c.mat.Color2
	for i = 1, 6 do
		local size = Vector3.new(c.rng(1.2, 3), c.rng(0.4, 1.4), c.rng(1.2, 3)) * c.s
		local cf = c.cf * CFrame.new(c.rng(-1.4, 1.4) * c.s, (0.4 + i * 0.35) * c.s, c.rng(-1.4, 1.4) * c.s) * CFrame.Angles(rad(c.rng(-35, 35)), rad(c.rng(0, 360)), rad(c.rng(-35, 35)))
		local p = Parts.part(c.model, "Scrap", cf, size, i % 2 == 0 and rust or steel, i % 2 == 0 and Enum.Material.CorrodedMetal or Enum.Material.Metal, true)
		add(c, p, i % 2 == 0)
	end
	add(c, Parts.cyl(c.model, "Pipe", c.cf * CFrame.new(0, 1.2 * c.s, 0) * CFrame.Angles(0, rad(c.rng(0, 180)), rad(25)), 4 * c.s, 0.6 * c.s, steel, Enum.Material.Metal, true), false)
end

function STYLE.Beam(c: Ctx)
	local col = c.mat.Color
	local yaw = CFrame.Angles(0, rad(c.rng(0, 180)), 0)
	for i = 0, 2 do
		local cf = c.cf * yaw * CFrame.new((i - 1) * 1.3 * c.s, (0.5 + (i % 2) * 1.05) * c.s, c.rng(-0.4, 0.4) * c.s)
		if i == 2 then
			cf = c.cf * yaw * CFrame.new(0, 1.6 * c.s, 0) * CFrame.Angles(0, rad(90), 0)
		end
		add(c, styled(Parts.part(c.model, "Web", cf, Vector3.new(0.3, 1, 5.2) * c.s, col, nil, true), c.mat))
		add(c, styled(Parts.part(c.model, "Flange", cf * CFrame.new(0, 0.5 * c.s, 0), Vector3.new(1.1, 0.22, 5.2) * c.s, darker(col, 0.08), nil, true), c.mat))
		add(c, styled(Parts.part(c.model, "Flange", cf * CFrame.new(0, -0.5 * c.s, 0), Vector3.new(1.1, 0.22, 5.2) * c.s, darker(col, 0.08), nil, true), c.mat))
	end
end

function STYLE.Spool(c: Ctx)
	local cf = c.cf * CFrame.new(0, 1.9 * c.s, 0) * CFrame.Angles(0, rad(c.rng(0, 180)), 0)
	add(c, styled(Parts.cyl(c.model, "Wrap", cf, 3 * c.s, 3 * c.s, c.mat.Color, nil, true), c.mat))
	for _, x in { -1.6, 1.6 } do
		add(c, Parts.cyl(c.model, "Flange", cf * CFrame.new(x * c.s, 0, 0), 0.3 * c.s, 3.8 * c.s, c.mat.Color2, Enum.Material.Metal, true), false)
	end
	add(c, Parts.cyl(c.model, "Axle", cf, 3.8 * c.s, 0.6 * c.s, Color3.fromRGB(200, 200, 210), Enum.Material.Metal, true), false)
end

function STYLE.Nugget(c: Ctx)
	for _, p in rockCluster(c, c.mat.Color2, Enum.Material.Slate, 3, 0.9) do
		add(c, p, false)
	end
	for i = 1, 7 do
		local a = (i / 7) * 360
		local cf = c.cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(c.rng(0.5, 1.8) * c.s, c.rng(1.6, 3) * c.s, 0)
		add(c, styled(Parts.ball(c.model, "Nugget", cf, c.rng(0.8, 1.5) * c.s, c.mat.Color, nil, true), c.mat))
	end
end

function STYLE.Shard(c: Ctx)
	add(c, Parts.part(c.model, "Base", c.cf * CFrame.new(0, 0.4 * c.s, 0) * CFrame.Angles(0, rad(c.rng(0, 90)), 0), Vector3.new(3.4, 0.8, 3.4) * c.s, darker(c.mat.Color, 0.4), Enum.Material.Slate, true), false)
	for i = 1, 3 do
		local a = i * 120 + c.rng(-20, 20)
		local h = c.rng(3.5, 5.5) * c.s
		local cf = c.cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(0.9 * c.s, 0.8 * c.s + h / 2, 0) * CFrame.Angles(rad(c.rng(-12, 12)), 0, rad(c.rng(-15, 5)))
		add(c, styled(Parts.part(c.model, "Shard", cf * CFrame.Angles(0, rad(45), 0), Vector3.new(1.2 * c.s, h, 1.2 * c.s), c.mat.Color, nil, true), c.mat))
		if c.mat.Glow then
			add(c, Parts.part(c.model, "Core", cf * CFrame.Angles(0, rad(45), 0), Vector3.new(0.45 * c.s, h * 0.8, 0.45 * c.s), c.mat.Color2, Enum.Material.Neon, true), false)
		end
	end
end

function STYLE.Crystal(c: Ctx)
	add(c, Parts.part(c.model, "Base", c.cf * CFrame.new(0, 0.5 * c.s, 0) * CFrame.Angles(0, rad(c.rng(0, 90)), 0), Vector3.new(3.6, 1, 3.6) * c.s, darker(c.mat.Color, 0.55), Enum.Material.Slate, true), false)
	local count = 4 + math.floor(c.rng() * 2)
	for i = 1, count do
		local h = c.rng(2.6, 5) * c.s
		local w = c.rng(0.9, 1.4) * c.s
		local lean = CFrame.Angles(rad(c.rng(-28, 28)), rad(c.rng(0, 360)), rad(c.rng(-28, 28)))
		local base = c.cf * CFrame.new(c.rng(-0.9, 0.9) * c.s, 0.8 * c.s, c.rng(-0.9, 0.9) * c.s) * lean
		add(c, styled(Parts.part(c.model, "Crystal", base * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, rad(45), 0), Vector3.new(w, h, w), c.mat.Color, nil, true), c.mat))
		add(c, styled(Parts.part(c.model, "Tip", base * CFrame.new(0, h + w * 0.25, 0) * CFrame.Angles(rad(45), rad(45), 0), Vector3.new(w * 0.7, w * 0.7, w * 0.7), lighter(c.mat.Color, 0.1), nil, true), c.mat))
		if c.mat.Glow then
			add(c, Parts.part(c.model, "Core", base * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, rad(45), 0), Vector3.new(w * 0.4, h * 0.85, w * 0.4), lighter(c.mat.Color2, 0.2), Enum.Material.Neon, true), false)
		end
	end
end

function STYLE.Ice(c: Ctx)
	for i = 1, 4 do
		local size = Vector3.new(c.rng(1.8, 3), c.rng(1.8, 3.4), c.rng(1.8, 3)) * c.s
		local cf = c.cf * CFrame.new(c.rng(-1, 1) * c.s, size.Y * 0.45 + (i > 2 and 1.2 * c.s or 0), c.rng(-1, 1) * c.s) * CFrame.Angles(rad(c.rng(-15, 15)), rad(c.rng(0, 360)), rad(c.rng(-15, 15)))
		add(c, styled(Parts.part(c.model, "Ice", cf, size, c.mat.Color:Lerp(c.mat.Color2, c.rng(0, 0.5)), nil, true), c.mat))
	end
end

function STYLE.Barrel(c: Ctx)
	local n = 2 + math.floor(c.rng() * 2)
	for i = 1, n do
		local a = (i / n) * 360
		local cf = c.cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(n > 1 and 1.2 * c.s or 0, 1.7 * c.s, 0)
		add(c, Parts.disc(c.model, "Barrel", cf, 2.4 * c.s, 3.4 * c.s, c.mat.Color2, Enum.Material.Metal, true), false)
		for _, y in { -1.1, 1.1 } do
			add(c, Parts.disc(c.model, "Band", cf * CFrame.new(0, y * c.s, 0), 2.5 * c.s, 0.25 * c.s, Color3.fromRGB(255, 208, 40), Enum.Material.SmoothPlastic, true), false)
		end
		add(c, styled(Parts.disc(c.model, "Goo", cf * CFrame.new(0, 1.72 * c.s, 0), 2 * c.s, 0.12 * c.s, c.mat.Color, nil, true), c.mat))
	end
end

function STYLE.Meteor(c: Ctx)
	local core = Parts.ball(c.model, "Meteor", c.cf * CFrame.new(0, 2 * c.s, 0), 4.2 * c.s, c.mat.Color, Parts.material(c.mat.Material), true)
	add(c, core)
	for i = 1, 5 do
		local cf = core.CFrame * CFrame.Angles(rad(c.rng(0, 360)), rad(c.rng(0, 360)), 0) * CFrame.new(0, 2.02 * c.s, 0)
		add(c, Parts.part(c.model, "Crack", cf, Vector3.new(0.25, 0.1, 2.2) * c.s, c.mat.Color2, Enum.Material.Neon, true), false)
	end
	for i = 1, 6 do
		local a = (i / 6) * 360
		add(c, Parts.part(c.model, "Debris", c.cf * CFrame.Angles(0, rad(a), 0) * CFrame.new(2.6 * c.s, 0.3 * c.s, 0) * CFrame.Angles(rad(c.rng(0, 60)), rad(c.rng(0, 90)), 0), Vector3.new(0.8, 0.6, 0.9) * c.s, darker(c.mat.Color, 0.3), Enum.Material.Basalt, true), false)
	end
	MutationFx.Emitter(core, {
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(90, 80, 80)), LightEmission = 0, Rate = 3,
		Size = NumberSequence.new(1.2 * c.s, 2.5 * c.s), Speed = NumberRange.new(1, 2),
		Transparency = NumberSequence.new(0.5, 1), Lifetime = NumberRange.new(1.5, 2.5),
	})
end

function STYLE.Orb(c: Ctx)
	add(c, Parts.part(c.model, "Pedestal", c.cf * CFrame.new(0, 0.5 * c.s, 0) * CFrame.Angles(0, rad(c.rng(0, 90)), 0), Vector3.new(2.6, 1, 2.6) * c.s, darker(c.mat.Color2, 0.5), Enum.Material.Slate, true), false)
	local orb = add(c, styled(Parts.ball(c.model, "Orb", c.cf * CFrame.new(0, 3 * c.s, 0), 3 * c.s, c.mat.Color, nil, true), c.mat))
	add(c, Parts.cyl(c.model, "Ring", orb.CFrame * CFrame.Angles(0, 0, rad(90)) * CFrame.Angles(rad(25), 0, 0), 0.12 * c.s, 4.4 * c.s, c.mat.Color2, Enum.Material.Neon, true), false)
end

function NodeModel.Build(materialId: string, mutationId: string?, cf: CFrame, seed: number?): Model
	local mat = Materials.ById[materialId] or Materials.ById.Rubber
	local rank = Rarities.Rank(mat.Rarity)
	local model = Instance.new("Model")
	model.Name = materialId
	local ctx: Ctx = {
		model = model,
		cf = cf,
		mat = mat,
		rng = Parts.rng(seed or 12345),
		s = 1 + (rank - 1) * 0.07,
		main = {},
	}
	local build = STYLE[mat.Node] or STYLE.Rock
	build(ctx)

	local hitbox = Parts.part(model, "Hitbox", cf * CFrame.new(0, 2.4 * ctx.s, 0), Vector3.new(5.5, 5, 5.5) * ctx.s, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, true)
	hitbox.Transparency = 1
	hitbox.CanQuery = true
	hitbox.CastShadow = false
	model.PrimaryPart = hitbox

	if mat.Glow then
		local l = Instance.new("PointLight")
		l.Color = mat.Color
		l.Brightness = 1
		l.Range = 12
		l.Parent = hitbox
	end
	if mutationId then
		MutationFx.Apply(ctx.main, mutationId, hitbox, 2.6)
	end
	return model
end

return NodeModel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Parts</string>
            <string name="Source"><![CDATA[--[[
	Parts - tiny helpers for building models out of parts at runtime.

	Works both in Roblox and in the offline place builder (it only uses Instance.new
	and CFrames; never Position/Orientation, PivotTo or other engine-only calls).
]]

local Parts = {}

local rad = math.rad

function Parts.new(className: string, parent: Instance?, props: { [string]: any }?): any
	local inst = Instance.new(className)
	if props then
		for k, v in props do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- A visual part: smooth, no collisions, ready to weld or anchor.
function Parts.part(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, anchored: boolean?): BasePart
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = anchored == true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

-- Cylinder along the CFrame's X axis
function Parts.cyl(parent: Instance, name: string, cf: CFrame, length: number, diameter: number, color: Color3, material: Enum.Material?, anchored: boolean?): BasePart
	local p = Parts.part(parent, name, cf, Vector3.new(length, diameter, diameter), color, material, anchored)
	p.Shape = Enum.PartType.Cylinder
	return p
end

-- Cylinder standing up (axis = the CFrame's Y axis)
function Parts.disc(parent: Instance, name: string, cf: CFrame, diameter: number, height: number, color: Color3, material: Enum.Material?, anchored: boolean?): BasePart
	return Parts.cyl(parent, name, cf * CFrame.Angles(0, 0, rad(90)), height, diameter, color, material, anchored)
end

function Parts.ball(parent: Instance, name: string, cf: CFrame, diameter: number, color: Color3, material: Enum.Material?, anchored: boolean?): BasePart
	local p = Parts.part(parent, name, cf, Vector3.new(diameter, diameter, diameter), color, material, anchored)
	p.Shape = Enum.PartType.Ball
	return p
end

function Parts.wedge(parent: Instance, name: string, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, anchored: boolean?): BasePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = anchored == true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function Parts.material(name: string?): Enum.Material
	local ok, result = pcall(function()
		return (Enum.Material :: any)[name or "SmoothPlastic"]
	end)
	return (ok and result) or Enum.Material.SmoothPlastic
end

-- Weld every BasePart in `model` to `root` (for models that get carried around).
function Parts.weldAll(model: Instance, root: BasePart)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = d
			w.Parent = d
		end
	end
end

-- Simple 32-bit string hash so visuals can be "random" but stable per item.
function Parts.hash(s: string): number
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + string.byte(s, i)) % 4294967296
	end
	return h
end

function Parts.rng(seed: number)
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	return function(a: number?, b: number?): number
		state = (state * 48271) % 2147483647
		local r = state / 2147483647
		if a and b then
			return a + (b - a) * r
		end
		return r
	end
end

return Parts
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
