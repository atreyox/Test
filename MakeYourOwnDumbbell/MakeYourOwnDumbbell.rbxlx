		Power = 1500, Weight = 900, Source = "Event", SourceId = "Summer", Spawn = 0,
		Color = rgb(255, 170, 60), Color2 = rgb(255, 240, 150), Material = "Glass", Glow = true,
		Node = "Crystal", Plate = "Crystal", Trait = { Kind = "Coins", Amount = 0.2 },
		Desc = "Summer exclusive. Warm to the touch.",
	},
	{
		Id = "PartyChrome", Name = "Party Chrome", Short = "Party", Adj = "Party", Rarity = "Epic",
		Power = 1500, Weight = 900, Source = "Event", SourceId = "Anniversary", Spawn = 0,
		Color = rgb(255, 90, 220), Color2 = rgb(90, 220, 255), Material = "Foil", Reflectance = 0.3,
		Node = "Orb", Plate = "Disc", Trait = { Kind = "Speed", Amount = 0.06 },
		Desc = "Anniversary exclusive. Comes with free confetti.",
	},
	{
		Id = "Heartstone", Name = "Heartstone", Short = "Heart", Adj = "Lovely", Rarity = "Epic",
		Power = 1500, Weight = 900, Source = "Event", SourceId = "Valentine", Spawn = 0,
		Color = rgb(255, 80, 130), Color2 = rgb(255, 200, 220), Material = "Glass", Glow = true,
		Node = "Crystal", Plate = "Crystal", Trait = { Kind = "Crit", Amount = 0.02 },
		Desc = "Valentine exclusive. Lift it with love.",
	},
}

local byId: { [string]: Material } = {}
local byZone: { [string]: { Material } } = {}
local Rarities = require(script.Parent.Rarities)

for i, m in list do
	m.Order = i
	assert(byId[m.Id] == nil, "duplicate material " .. m.Id)
	byId[m.Id] = m
	if m.Zone then
		byZone[m.Zone] = byZone[m.Zone] or {}
		table.insert(byZone[m.Zone], m)
	end
end

for _, mats in byZone do
	table.sort(mats, function(a, b)
		return Rarities.Rank(a.Rarity) < Rarities.Rank(b.Rarity)
	end)
end

local Materials = {
	List = list,
	ById = byId,
	ByZone = byZone,
}

function Materials.Get(id: string): Material?
	return byId[id]
end

return Materials
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Mutations</string>
            <string name="Source"><![CDATA[--[[
	Mutations - special versions of materials.

	A node can spawn mutated (you can see it from far away: it glows, burns, sparkles...).
	Every unit smashed from it carries the mutation, and a plate or handle made from a
	mutated material is multiplied by Mult.

	Weight : spawn weight when a node rolls a mutation (see Balance.NodeMutationChance).
	Event  : event-only mutations never roll naturally; the matching event adds them.
	Fx     : visual style used by Shared.Visuals.MutationFx.
]]

export type Mutation = {
	Id: string,
	Name: string,
	Mult: number,
	Weight: number,
	Rarity: string,
	Color: Color3,
	Color2: Color3,
	Fx: string,
	Event: string?,
	Desc: string,
	Order: number,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local list: { Mutation } = {
	{ Id = "Shiny", Name = "Shiny", Mult = 1.5, Weight = 400, Rarity = "Uncommon", Color = rgb(255, 255, 255), Color2 = rgb(200, 230, 255), Fx = "Sparkle", Desc = "Freshly polished. x1.5" },
	{ Id = "Golden", Name = "Golden", Mult = 2, Weight = 250, Rarity = "Uncommon", Color = rgb(255, 204, 48), Color2 = rgb(255, 240, 150), Fx = "Gold", Desc = "Dipped in pure gold. x2" },
	{ Id = "Frozen", Name = "Frozen", Mult = 2.5, Weight = 120, Rarity = "Rare", Color = rgb(150, 220, 255), Color2 = rgb(235, 250, 255), Fx = "Frost", Desc = "Frozen solid. x2.5" },
	{ Id = "Burning", Name = "Burning", Mult = 3, Weight = 100, Rarity = "Rare", Color = rgb(255, 110, 30), Color2 = rgb(255, 210, 60), Fx = "Fire", Desc = "It's on fire. Literally. x3" },
	{ Id = "Electric", Name = "Electric", Mult = 3.5, Weight = 80, Rarity = "Rare", Color = rgb(90, 200, 255), Color2 = rgb(255, 255, 140), Fx = "Electric", Desc = "Crackling with power. x3.5" },
	{ Id = "Toxic", Name = "Toxic", Mult = 4, Weight = 60, Rarity = "Epic", Color = rgb(150, 255, 40), Color2 = rgb(60, 140, 20), Fx = "Toxic", Desc = "Bubbling green goo. x4" },
	{ Id = "Magnetic", Name = "Magnetic", Mult = 5, Weight = 45, Rarity = "Epic", Color = rgb(255, 70, 70), Color2 = rgb(70, 110, 255), Fx = "Magnetic", Desc = "Pulls bolts from across the room. x5" },
	{ Id = "Radioactive", Name = "Radioactive", Mult = 6, Weight = 35, Rarity = "Epic", Color = rgb(90, 255, 70), Color2 = rgb(200, 255, 120), Fx = "Radioactive", Desc = "Glows in the dark. x6" },
	{ Id = "Crystal", Name = "Crystal", Mult = 7, Weight = 25, Rarity = "Legendary", Color = rgb(120, 240, 255), Color2 = rgb(255, 255, 255), Fx = "Crystal", Desc = "Turned to living crystal. x7" },
	{ Id = "Shadow", Name = "Shadow", Mult = 8.5, Weight = 15, Rarity = "Legendary", Color = rgb(40, 36, 52), Color2 = rgb(120, 100, 160), Fx = "Shadow", Desc = "Wrapped in living shadow. x8.5" },
	{ Id = "Corrupted", Name = "Corrupted", Mult = 10, Weight = 9, Rarity = "Legendary", Color = rgb(170, 20, 40), Color2 = rgb(255, 60, 60), Fx = "Corrupted", Desc = "Something went very wrong. x10" },
	{ Id = "Void", Name = "Void", Mult = 13, Weight = 5, Rarity = "Mythic", Color = rgb(120, 40, 220), Color2 = rgb(20, 6, 36), Fx = "Void", Desc = "Touched by the Void. x13" },
	{ Id = "Rainbow", Name = "Rainbow", Mult = 16, Weight = 2.5, Rarity = "Mythic", Color = rgb(255, 120, 200), Color2 = rgb(120, 220, 255), Fx = "Rainbow", Desc = "Every color, all the time. x16" },
	{ Id = "Glitched", Name = "Glitched", Mult = 22, Weight = 1.2, Rarity = "Mythic", Color = rgb(0, 255, 140), Color2 = rgb(255, 0, 200), Fx = "Glitched", Desc = "Th1s sh0uldn't ex1st. x22" },
	{ Id = "Cosmic", Name = "Cosmic", Mult = 30, Weight = 0.6, Rarity = "Secret", Color = rgb(60, 70, 200), Color2 = rgb(255, 255, 255), Fx = "Cosmic", Desc = "Full of tiny stars. x30" },
	{ Id = "Celestial", Name = "Celestial", Mult = 50, Weight = 0.15, Rarity = "Secret", Color = rgb(255, 246, 210), Color2 = rgb(255, 214, 110), Fx = "Celestial", Desc = "Blessed by the heavens. x50" },

	-- Event-only (only appear while their event is live)
	{ Id = "Spooky", Name = "Spooky", Mult = 6, Weight = 0, Rarity = "Epic", Event = "Halloween", Color = rgb(255, 130, 20), Color2 = rgb(130, 40, 200), Fx = "Spooky", Desc = "Halloween exclusive. Boo! x6" },
	{ Id = "Festive", Name = "Festive", Mult = 6, Weight = 0, Rarity = "Epic", Event = "Winter", Color = rgb(230, 40, 50), Color2 = rgb(40, 200, 90), Fx = "Festive", Desc = "Winter exclusive. Jingle gains. x6" },
	{ Id = "Sunkissed", Name = "Sunkissed", Mult = 6, Weight = 0, Rarity = "Epic", Event = "Summer", Color = rgb(255, 190, 70), Color2 = rgb(255, 120, 90), Fx = "Sparkle", Desc = "Summer exclusive. Warm glow. x6" },
	{ Id = "Confetti", Name = "Confetti", Mult = 6, Weight = 0, Rarity = "Epic", Event = "Anniversary", Color = rgb(255, 90, 220), Color2 = rgb(90, 220, 255), Fx = "Rainbow", Desc = "Anniversary exclusive. Party time! x6" },
	{ Id = "Lovestruck", Name = "Lovestruck", Mult = 6, Weight = 0, Rarity = "Epic", Event = "Valentine", Color = rgb(255, 80, 140), Color2 = rgb(255, 200, 220), Fx = "Sparkle", Desc = "Valentine exclusive. x6" },
}

local byId: { [string]: Mutation } = {}
for i, m in list do
	m.Order = i
	byId[m.Id] = m
end

local Mutations = {
	List = list,
	ById = byId,
}

function Mutations.Get(id: string?): Mutation?
	if id == nil or id == "" then
		return nil
	end
	return byId[id]
end

function Mutations.Mult(id: string?): number
	local m = Mutations.Get(id)
	return m and m.Mult or 1
end

return Mutations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Qualities</string>
            <string name="Source"><![CDATA[--[[
	Qualities - rolled every time you forge a dumbbell.

	Weight     : base roll weight (see Formulas.RollQuality: luck boosts the rarer rows).
	LuckPower  : how strongly luck boosts this row (0 = not at all, 1 = fully).
	RebirthReq : the row is locked until you have this many rebirths.
	Mult       : multiplies the dumbbell's gains.
]]

export type Quality = {
	Id: string,
	Name: string,
	Mult: number,
	Weight: number,
	LuckPower: number,
	RebirthReq: number,
	Color: Color3,
	Color2: Color3,
	Rank: number,
	Announce: boolean,
	Fx: string,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local list: { Quality } = {
	{ Id = "Normal", Name = "Normal", Mult = 1, Weight = 5200, LuckPower = 0, RebirthReq = 0, Color = rgb(200, 206, 214), Color2 = rgb(150, 156, 166), Rank = 1, Announce = false, Fx = "None" },
	{ Id = "Good", Name = "Good", Mult = 1.25, Weight = 2400, LuckPower = 0.3, RebirthReq = 0, Color = rgb(120, 230, 130), Color2 = rgb(60, 180, 90), Rank = 2, Announce = false, Fx = "None" },
	{ Id = "Great", Name = "Great", Mult = 1.6, Weight = 1400, LuckPower = 0.5, RebirthReq = 0, Color = rgb(90, 180, 255), Color2 = rgb(40, 120, 230), Rank = 3, Announce = false, Fx = "Sparkle" },
	{ Id = "Perfect", Name = "Perfect", Mult = 2.2, Weight = 650, LuckPower = 0.7, RebirthReq = 0, Color = rgb(200, 120, 255), Color2 = rgb(140, 60, 230), Rank = 4, Announce = false, Fx = "Sparkle" },
	{ Id = "Shiny", Name = "Shiny", Mult = 3.2, Weight = 230, LuckPower = 1, RebirthReq = 0, Color = rgb(170, 250, 255), Color2 = rgb(255, 255, 255), Rank = 5, Announce = false, Fx = "Shiny" },
	{ Id = "Golden", Name = "Golden", Mult = 4.5, Weight = 90, LuckPower = 1, RebirthReq = 0, Color = rgb(255, 204, 40), Color2 = rgb(255, 150, 20), Rank = 6, Announce = true, Fx = "Gold" },
	{ Id = "Rainbow", Name = "Rainbow", Mult = 7, Weight = 25, LuckPower = 1, RebirthReq = 0, Color = rgb(255, 120, 200), Color2 = rgb(120, 220, 255), Rank = 7, Announce = true, Fx = "Rainbow" },
	{ Id = "Glitched", Name = "Glitched", Mult = 12, Weight = 4, LuckPower = 1, RebirthReq = 1, Color = rgb(0, 255, 150), Color2 = rgb(255, 0, 200), Rank = 8, Announce = true, Fx = "Glitched" },
	{ Id = "Celestial", Name = "Celestial", Mult = 25, Weight = 0.8, LuckPower = 1, RebirthReq = 3, Color = rgb(255, 246, 210), Color2 = rgb(255, 210, 110), Rank = 9, Announce = true, Fx = "Celestial" },
}

local byId: { [string]: Quality } = {}
for _, q in list do
	byId[q.Id] = q
end

local Qualities = {
	List = list,
	ById = byId,
}

function Qualities.Get(id: string?): Quality
	return (id and byId[id]) or byId.Normal
end

return Qualities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--[[
	Rarities - the rarity ladder shared by materials, dumbbells, titles and shop items.

	Order matters: `Rank` is used everywhere to compare rarities (higher = rarer).
	Colors are used for item cards, name text, popups and node labels.
]]

export type Rarity = {
	Id: string,
	Rank: number,
	Color: Color3,
	Glow: Color3,
	Announce: boolean, -- announce to the whole server when found/forged
}

local list: { Rarity } = {
	{ Id = "Common", Rank = 1, Color = Color3.fromRGB(176, 186, 199), Glow = Color3.fromRGB(120, 130, 145), Announce = false },
	{ Id = "Uncommon", Rank = 2, Color = Color3.fromRGB(96, 222, 116), Glow = Color3.fromRGB(40, 170, 70), Announce = false },
	{ Id = "Rare", Rank = 3, Color = Color3.fromRGB(70, 162, 255), Glow = Color3.fromRGB(30, 110, 230), Announce = false },
	{ Id = "Epic", Rank = 4, Color = Color3.fromRGB(184, 96, 255), Glow = Color3.fromRGB(130, 50, 220), Announce = false },
	{ Id = "Legendary", Rank = 5, Color = Color3.fromRGB(255, 184, 40), Glow = Color3.fromRGB(240, 140, 0), Announce = true },
	{ Id = "Mythic", Rank = 6, Color = Color3.fromRGB(255, 70, 120), Glow = Color3.fromRGB(220, 20, 80), Announce = true },
	{ Id = "Secret", Rank = 7, Color = Color3.fromRGB(255, 255, 255), Glow = Color3.fromRGB(20, 20, 30), Announce = true },
}

local byId: { [string]: Rarity } = {}
for _, r in list do
	byId[r.Id] = r
end

local Rarities = {
	List = list,
	ById = byId,
}

function Rarities.Get(id: string): Rarity
	return byId[id] or byId.Common
end

function Rarities.Rank(id: string): number
	return Rarities.Get(id).Rank
end

function Rarities.FromRank(rank: number): Rarity
	rank = math.clamp(math.floor(rank), 1, #list)
	return list[rank]
end

return Rarities
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Rebirths</string>
            <string name="Source"><![CDATA[--[[
	Rebirths - the prestige system (the Rebirth Machine on your plot).

	Rebirthing RESETS: Strength, Coins, zone unlocks (except Starter Yard) and coin Upgrades.
	Rebirthing KEEPS : dumbbells, materials, gems, index, achievements, titles, security,
	                   Rebirth Shop perks and your plot's look.
	You get         : a new rank name, a permanent gains/coins/luck multiplier,
	                   Rebirth Tokens and the unlocks listed in Unlocks.

	Requirement for the next rebirth (Strength): RequirementList[rebirths + 1], and after
	the list runs out it keeps multiplying by RequirementGrowth.
]]

export type Perk = {
	Id: string,
	Name: string,
	Emoji: string,
	Desc: string,
	Max: number,
	CostBase: number,
	CostStep: number,
	Per: number,
	Format: string,
	Order: number,
}

local Rebirths = {}

Rebirths.RequirementList = {
	1.9e9, 4e10, 3.7e11, 3.6e12, 2e13, 1.5e14, 1.2e15, 1e16, 9e16, 8e17,
}
Rebirths.RequirementGrowth = 9
Rebirths.GainsPerRebirth = 1.0 -- +100% gains and coins per rebirth (additive)
Rebirths.LuckPerRebirth = 0.1 -- +10% luck per rebirth
Rebirths.TokensBase = 2
Rebirths.TokensPerRebirth = 1

Rebirths.Ranks = {
	[0] = { Name = "Rookie", Color = Color3.fromRGB(190, 196, 206) },
	[1] = { Name = "Gym Rat", Color = Color3.fromRGB(120, 220, 120) },
	[2] = { Name = "Iron Pumper", Color = Color3.fromRGB(150, 160, 175) },
	[3] = { Name = "Powerlifter", Color = Color3.fromRGB(80, 170, 255) },
	[4] = { Name = "Bodybuilder", Color = Color3.fromRGB(255, 150, 60) },
	[5] = { Name = "Champion", Color = Color3.fromRGB(255, 205, 50) },
	[6] = { Name = "Titan", Color = Color3.fromRGB(255, 90, 60) },
	[7] = { Name = "Colossus", Color = Color3.fromRGB(200, 90, 255) },
	[8] = { Name = "Superhuman", Color = Color3.fromRGB(60, 140, 255) },
	[9] = { Name = "Demigod", Color = Color3.fromRGB(255, 230, 150) },
	[10] = { Name = "Cosmic Lifter", Color = Color3.fromRGB(120, 120, 255) },
	[11] = { Name = "Star Crusher", Color = Color3.fromRGB(255, 180, 90) },
	[12] = { Name = "Galaxy Bender", Color = Color3.fromRGB(255, 110, 220) },
	[13] = { Name = "Void Titan", Color = Color3.fromRGB(170, 70, 255) },
	[14] = { Name = "Omnilifter", Color = Color3.fromRGB(90, 255, 220) },
	[15] = { Name = "Reality Bender", Color = Color3.fromRGB(255, 80, 120) },
	[16] = { Name = "Time Lifter", Color = Color3.fromRGB(120, 255, 150) },
	[17] = { Name = "Universe Hauler", Color = Color3.fromRGB(150, 200, 255) },
	[18] = { Name = "Infinity Pumper", Color = Color3.fromRGB(255, 140, 255) },
	[19] = { Name = "The Absolute", Color = Color3.fromRGB(255, 255, 255) },
	[20] = { Name = "Dumbbell Deity", Color = Color3.fromRGB(255, 220, 90) },
}

local ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" }

function Rebirths.RankName(rebirths: number): string
	if rebirths <= 20 then
		return Rebirths.Ranks[rebirths].Name
	end
	local extra = rebirths - 20
	local suffix = ROMAN[((extra - 1) % 10) + 1]
	if extra > 10 then
		suffix = tostring(extra + 1)
	end
	return "Dumbbell Deity " .. suffix
end

function Rebirths.RankColor(rebirths: number): Color3
	return Rebirths.Ranks[math.min(rebirths, 20)].Color
end

-- Plot looks: your workshop grows as you rebirth.
Rebirths.PlotTiers = {
	{ At = 0, Name = "Garage" },
	{ At = 1, Name = "Small Gym" },
	{ At = 3, Name = "Pro Gym" },
	{ At = 6, Name = "Future Lab" },
	{ At = 10, Name = "Titan Facility" },
}

function Rebirths.PlotTier(rebirths: number): number
	local tier = 1
	for i, t in Rebirths.PlotTiers do
		if rebirths >= t.At then
			tier = i
		end
	end
	return tier
end

-- Unlocks shown on the Rebirth screen (the systems themselves check the numbers).
Rebirths.Unlocks = {
	{ At = 1, Text = "Crystal Cavern zone" },
	{ At = 1, Text = "GLITCHED forge quality" },
	{ At = 1, Text = "Workshop becomes a Small Gym" },
	{ At = 2, Text = "Nuclear Facility zone" },
	{ At = 2, Text = "+1 trophy display stand" },
	{ At = 3, Text = "Meteor Crater zone" },
	{ At = 3, Text = "CELESTIAL forge quality" },
	{ At = 3, Text = "Workshop becomes a Pro Gym" },
	{ At = 4, Text = "Space Zone" },
	{ At = 5, Text = "Void Zone" },
	{ At = 5, Text = "Second dumbbell slot (dual wield!)" },
	{ At = 6, Text = "Workshop becomes a Future Lab" },
	{ At = 10, Text = "Workshop becomes a Titan Facility" },
	{ At = 10, Text = "Third dumbbell slot" },
}

function Rebirths.EquipSlots(rebirths: number, hasPass: boolean): number
	local slots = 1
	if rebirths >= 5 then
		slots += 1
	end
	if rebirths >= 10 then
		slots += 1
	end
	if hasPass then
		slots += 1
	end
	return math.min(slots, 3)
end

-- Rebirth Shop: permanent perks bought with Rebirth Tokens.
local perks: { Perk } = {
	{ Id = "MuscleMemory", Name = "Muscle Memory", Emoji = "💪", Desc = "+10% gains forever.", Max = 50, CostBase = 1, CostStep = 1, Per = 0.1, Format = "Percent" },
	{ Id = "LuckyGenes", Name = "Lucky Genes", Emoji = "🍀", Desc = "+5% luck forever.", Max = 30, CostBase = 2, CostStep = 1, Per = 0.05, Format = "Percent" },
	{ Id = "PocketSpace", Name = "Pocket Space", Emoji = "🎒", Desc = "+20% backpack capacity.", Max = 10, CostBase = 2, CostStep = 1, Per = 0.2, Format = "Percent" },
	{ Id = "BigForge", Name = "Big Forge", Emoji = "🔥", Desc = "+2 max plate size.", Max = 25, CostBase = 3, CostStep = 1, Per = 2, Format = "PlusInt" },
	{ Id = "HeadStart", Name = "Head Start", Emoji = "🚀", Desc = "Start every rebirth with the next zone already unlocked.", Max = 3, CostBase = 5, CostStep = 5, Per = 1, Format = "Zones" },
	{ Id = "PiggyBank", Name = "Piggy Bank", Emoji = "🐷", Desc = "Keep 5% of your coins when you rebirth.", Max = 10, CostBase = 3, CostStep = 1, Per = 0.05, Format = "Percent" },
	{ Id = "QuickHands", Name = "Quick Hands", Emoji = "✋", Desc = "-3% lift cooldown.", Max = 10, CostBase = 3, CostStep = 2, Per = 0.03, Format = "Percent" },
	{ Id = "CritInstinct", Name = "Crit Instinct", Emoji = "🎯", Desc = "+1% crit chance.", Max = 10, CostBase = 3, CostStep = 2, Per = 0.01, Format = "Percent" },
	{ Id = "StickyCombo", Name = "Sticky Combo", Emoji = "🔗", Desc = "+0.1s combo window.", Max = 10, CostBase = 2, CostStep = 1, Per = 0.1, Format = "Seconds" },
	{ Id = "ForeverTeleporter", Name = "Forever Teleporter", Emoji = "📦", Desc = "Keep Material Teleporter level 1 through rebirths.", Max = 1, CostBase = 8, CostStep = 0, Per = 1, Format = "Unlock" },
}

local perkById: { [string]: Perk } = {}
for i, p in perks do
	p.Order = i
	perkById[p.Id] = p
end

Rebirths.Perks = perks
Rebirths.PerkById = perkById

function Rebirths.PerkCost(perk: Perk, level: number): number
	return perk.CostBase + perk.CostStep * level
end

return Rebirths
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Recipes</string>
            <string name="Source"><![CDATA[--[[
	Recipes - SECRET dumbbells.

	The game never lists these for players. The Index only shows "???" and a vague
	hint until someone forges one; the first person on a server gets a big announcement.

	Plates   : the two plate materials (order does not matter)
	Handle   : the handle material ("*" = anything)
	Mutation : optional - every part must carry this mutation
	MinSize  : optional - minimum plate size
	Mult     : extra gains multiplier on top of the normal stats
	Rarity   : the dumbbell is at least this rarity
	Ability  : special ability (see Abilities below)
	Look     : special visual used by DumbbellModel
]]

export type Ability = {
	Id: string,
	Name: string,
	Desc: string,
	Stats: { [string]: number },
	Special: string?,
}

export type Recipe = {
	Id: string,
	Name: string,
	Plates: { string },
	Handle: string,
	Mutation: string?,
	MinSize: number?,
	Mult: number,
	Rarity: string,
	Ability: string,
	Look: string,
	Hint: string,
	Order: number,
}

local abilities: { [string]: Ability } = {
	Bouncy = { Id = "Bouncy", Name = "Bouncy", Desc = "Your combo only halves when it breaks.", Stats = { Combo = 0.3 }, Special = "ComboSaver" },
	Unga = { Id = "Unga", Name = "UNGA!", Desc = "+100% crit power.", Stats = { CritPower = 1 } },
	JunkPunk = { Id = "JunkPunk", Name = "Junk Punk", Desc = "+35% coins.", Stats = { Coins = 0.35 } },
	Plunder = { Id = "Plunder", Name = "Plunder", Desc = "+40% coins and +10% luck.", Stats = { Coins = 0.4, Luck = 0.1 } },
	Conductor = { Id = "Conductor", Name = "Conductor", Desc = "+4% crit chance.", Stats = { Crit = 0.04 } },
	Craftsman = { Id = "Craftsman", Name = "Craftsman", Desc = "+25% gains.", Stats = { Gains = 0.25 } },
	Balance = { Id = "Balance", Name = "Perfect Balance", Desc = "+25% luck and +2% crit.", Stats = { Luck = 0.25, Crit = 0.02 } },
	CarbonCopy = { Id = "CarbonCopy", Name = "Carbon Copy", Desc = "-12% lift cooldown.", Stats = { Speed = 0.12 } },
	ChromeDome = { Id = "ChromeDome", Name = "Chrome Dome", Desc = "+60% coins.", Stats = { Coins = 0.6 } },
	SteamBurst = { Id = "SteamBurst", Name = "Steam Burst", Desc = "+50% crit power and +0.4s combo.", Stats = { CritPower = 0.5, Combo = 0.4 } },
	MountainHeart = { Id = "MountainHeart", Name = "Mountain Heart", Desc = "+3% crit, +50% crit power.", Stats = { Crit = 0.03, CritPower = 0.5 } },
	RoyalTax = { Id = "RoyalTax", Name = "Royal Tax", Desc = "+75% coins and +15% luck.", Stats = { Coins = 0.75, Luck = 0.15 } },
	Chandelier = { Id = "Chandelier", Name = "Chandelier", Desc = "+1% super crit chance.", Stats = { Super = 0.01 } },
	Meltdown = { Id = "Meltdown", Name = "Meltdown", Desc = "+1.5% super crit chance.", Stats = { Super = 0.015 } },
	MeteorStrike = { Id = "MeteorStrike", Name = "Meteor Strike", Desc = "Every 25th rep is a guaranteed SUPER CRIT.", Stats = {}, Special = "MeteorStrike" },
	Stargazer = { Id = "Stargazer", Name = "Stargazer", Desc = "+40% luck.", Stats = { Luck = 0.4 } },
	Eclipse = { Id = "Eclipse", Name = "Eclipse", Desc = "+75% gains at night.", Stats = {}, Special = "Night" },
	SolarFlare = { Id = "SolarFlare", Name = "Solar Flare", Desc = "+75% gains during the day.", Stats = {}, Special = "Day" },
	GalaxyBrain = { Id = "GalaxyBrain", Name = "Galaxy Brain", Desc = "+50% gains and +2% super crit.", Stats = { Gains = 0.5, Super = 0.02 } },
	AbyssPulse = { Id = "AbyssPulse", Name = "Abyss Pulse", Desc = "1% chance per rep of a x50 VOID LIFT.", Stats = {}, Special = "AbyssPulse" },
	GravityWell = { Id = "GravityWell", Name = "Gravity Well", Desc = "Weighs nothing. Anyone strong enough to hold air can lift it.", Stats = { Gains = 0.25 }, Special = "Weightless" },
	Glitch = { Id = "Glitch", Name = "G̷l̷i̷t̷c̷h̷", Desc = "Every rep gets a random x0.5 to x5 multiplier.", Stats = {}, Special = "Glitch" },
	TitanGrip = { Id = "TitanGrip", Name = "Titan Grip", Desc = "+40% gains.", Stats = { Gains = 0.4 } },
	GolemFist = { Id = "GolemFist", Name = "Golem Fist", Desc = "+30% gains and +30% coins.", Stats = { Gains = 0.3, Coins = 0.3 } },
	ToxicAvenger = { Id = "ToxicAvenger", Name = "Toxic Avenger", Desc = "+60% gains.", Stats = { Gains = 0.6 } },
	DuckSqueak = { Id = "DuckSqueak", Name = "SQUEAK", Desc = "+50% combo bonus. Squeaks every rep.", Stats = { ComboBonus = 0.5 } },
	Spooky = { Id = "Spooky", Name = "Spooky", Desc = "+30% luck.", Stats = { Luck = 0.3 } },
	CandyRush = { Id = "CandyRush", Name = "Sugar Rush", Desc = "-15% lift cooldown.", Stats = { Speed = 0.15 } },
	RainbowRoad = { Id = "RainbowRoad", Name = "Rainbow Road", Desc = "+100% luck.", Stats = { Luck = 1 } },
	Divine = { Id = "Divine", Name = "DIVINE", Desc = "+100% gains, coins and luck. +3% super crit.", Stats = { Gains = 1, Coins = 1, Luck = 1, Super = 0.03 } },
}

local list: { Recipe } = {
	{ Id = "BouncyBoi", Name = "Bouncy Boi", Plates = { "Rubber", "Rubber" }, Handle = "Rubber", MinSize = 3, Mult = 1.5, Rarity = "Uncommon", Ability = "Bouncy", Look = "Bouncy", Hint = "Nothing but the bounciest stuff... and a big size." },
	{ Id = "CavemanClub", Name = "Caveman Club", Plates = { "Stone", "Stone" }, Handle = "Wood", Mult = 1.6, Rarity = "Rare", Ability = "Unga", Look = "Caveman", Hint = "Rocks on a stick. Unga bunga." },
	{ Id = "JunkPunk", Name = "Junk Punk", Plates = { "Scrap", "Scrap" }, Handle = "Rubber", Mult = 1.5, Rarity = "Rare", Ability = "JunkPunk", Look = "Junk", Hint = "Scrap on both sides, grip from a tire." },
	{ Id = "PiratesBooty", Name = "Pirate's Booty", Plates = { "Wood", "Wood" }, Handle = "Brass", Mult = 1.6, Rarity = "Rare", Ability = "Plunder", Look = "Pirate", Hint = "Wooden like a ship, with a handle that looks like gold." },
	{ Id = "PennyPress", Name = "Penny Press", Plates = { "Copper", "Copper" }, Handle = "Copper", Mult = 1.5, Rarity = "Rare", Ability = "Conductor", Look = "Penny", Hint = "Make it out of pennies. All of it." },
	{ Id = "BlacksmithPride", Name = "Blacksmith's Pride", Plates = { "Iron", "Iron" }, Handle = "Steel", Mult = 1.7, Rarity = "Epic", Ability = "Craftsman", Look = "Smith", Hint = "Iron weights on a steel bar. A classic." },
	{ Id = "YinYang", Name = "Yin & Yang", Plates = { "Coal", "Silver" }, Handle = "Titanium", Mult = 1.8, Rarity = "Epic", Ability = "Balance", Look = "YinYang", Hint = "Darkest black, brightest white, one strong bar between." },
	{ Id = "CarbonCopy", Name = "Carbon Copy", Plates = { "CarbonFiber", "CarbonFiber" }, Handle = "CarbonFiber", Mult = 1.8, Rarity = "Epic", Ability = "CarbonCopy", Look = "Carbon", Hint = "Copy, paste, paste." },
	{ Id = "ChromeDome", Name = "Chrome Dome", Plates = { "Chrome", "Chrome" }, Handle = "Chrome", Mult = 2, Rarity = "Legendary", Ability = "ChromeDome", Look = "Chrome", Hint = "So shiny you can see your future." },
	{ Id = "Frostfire", Name = "Frostfire", Plates = { "Ice", "MagmaRock" }, Handle = "Obsidian", Mult = 2.2, Rarity = "Legendary", Ability = "SteamBurst", Look = "Frostfire", Hint = "Fire on one side, ice on the other. Volcanic glass between." },
	{ Id = "HeartOfTheMountain", Name = "Heart of the Mountain", Plates = { "Obsidian", "Obsidian" }, Handle = "MagmaRock", Mult = 2, Rarity = "Legendary", Ability = "MountainHeart", Look = "Mountain", Hint = "The volcano's darkest glass, held by its hottest rock." },
	{ Id = "RoyalDumbbell", Name = "Royal Dumbbell", Plates = { "Gold", "Gold" }, Handle = "Diamond", Mult = 1.9, Rarity = "Legendary", Ability = "RoyalTax", Look = "Royal", Hint = "Fit for a king: gold, gold... and the rarest gem." },
	{ Id = "CrystalChandelier", Name = "Crystal Chandelier", Plates = { "Diamond", "Diamond" }, Handle = "Quartz", Mult = 2.2, Rarity = "Mythic", Ability = "Chandelier", Look = "Chandelier", Hint = "Two diamonds hanging from pink crystal." },
	{ Id = "NuclearOption", Name = "The Nuclear Option", Plates = { "Uranium", "Uranium" }, Handle = "Plutonium", Mult = 2.5, Rarity = "Mythic", Ability = "Meltdown", Look = "Nuclear", Hint = "Two glowing weights, an even more glowing bar." },
	{ Id = "MeteorCrusher", Name = "Meteor Crusher", Plates = { "Meteorite", "Meteorite" }, Handle = "Meteorite", Mult = 2.5, Rarity = "Mythic", Ability = "MeteorStrike", Look = "Meteor", Hint = "Three rocks that fell from the sky." },
	{ Id = "Starfall", Name = "Starfall", Plates = { "Stardust", "Stardust" }, Handle = "Meteorite", Mult = 2.5, Rarity = "Mythic", Ability = "Stargazer", Look = "Starfall", Hint = "Stars on the ends, a meteor to hold." },
	{ Id = "LunarEclipse", Name = "Lunar Eclipse", Plates = { "Moonstone", "DarkMatter" }, Handle = "Moonstone", Mult = 3, Rarity = "Mythic", Ability = "Eclipse", Look = "Eclipse", Hint = "When the moon meets the dark." },
	{ Id = "SolarFlare", Name = "Solar Flare", Plates = { "SolarCore", "SolarCore" }, Handle = "FireOpal", Mult = 2.8, Rarity = "Mythic", Ability = "SolarFlare", Look = "Solar", Hint = "Two suns and a gem of fire." },
	{ Id = "GalaxyBrain", Name = "Galaxy Brain", Plates = { "NebulaGlass", "NebulaGlass" }, Handle = "QuasarShard", Mult = 3.5, Rarity = "Secret", Ability = "GalaxyBrain", Look = "Galaxy", Hint = "Nebulas on the ends, the brightest thing in space in the middle." },
	{ Id = "ReactorOfTheAbyss", Name = "Reactor of the Abyss", Plates = { "VoidOre", "VoidOre" }, Handle = "Uranium", Mult = 3.5, Rarity = "Secret", Ability = "AbyssPulse", Look = "Reactor", Hint = "Void on both sides, powered by uranium." },
	{ Id = "EventHorizon", Name = "Event Horizon", Plates = { "Singularity", "Singularity" }, Handle = "DarkMatter", Mult = 5, Rarity = "Secret", Ability = "GravityWell", Look = "Horizon", Hint = "Two points of infinite gravity, held by the dark." },
	{ Id = "GlitchInTheMatrix", Name = "Glitch in the Matrix", Plates = { "GlitchOre", "GlitchOre" }, Handle = "GlitchOre", Mult = 7.77, Rarity = "Secret", Ability = "Glitch", Look = "Glitch", Hint = "E̷r̷r̷o̷r̷ ×3" },
	{ Id = "TitansGrip", Name = "Titan's Grip", Plates = { "TitanAlloy", "TitanAlloy" }, Handle = "Iron", Mult = 2.2, Rarity = "Legendary", Ability = "TitanGrip", Look = "Titan", Hint = "Armor of a fallen titan on a plain iron bar." },
	{ Id = "GolemFist", Name = "Golem Fist", Plates = { "GolemHeart", "GolemHeart" }, Handle = "Scrap", Mult = 2, Rarity = "Legendary", Ability = "GolemFist", Look = "Golem", Hint = "Two golem hearts, wired together with junk." },
	{ Id = "ToxicAvenger", Name = "Toxic Avenger", Plates = { "MutantGoo", "MutantGoo" }, Handle = "Lead", Mutation = "Toxic", Mult = 3, Rarity = "Secret", Ability = "ToxicAvenger", Look = "Toxic", Hint = "Goo on goo on lead. And everything has to be toxic." },
	{ Id = "DuckDynasty", Name = "Duck Dynasty", Plates = { "SqueakyCore", "SqueakyCore" }, Handle = "Rubber", Mult = 2, Rarity = "Legendary", Ability = "DuckSqueak", Look = "Duck", Hint = "Two squeaks and a rubber handle." },
	{ Id = "RainbowRoad", Name = "Rainbow Road", Plates = { "Prismite", "Prismite" }, Handle = "*", Mutation = "Rainbow", Mult = 4, Rarity = "Secret", Ability = "RainbowRoad", Look = "Rainbow", Hint = "Every color crystal, every part RAINBOW." },
	{ Id = "SpookyScary", Name = "Spooky Scary", Plates = { "PumpkinIron", "PumpkinIron" }, Handle = "Coal", Mult = 2, Rarity = "Epic", Ability = "Spooky", Look = "Spooky", Hint = "Halloween only: pumpkins and coal." },
	{ Id = "CandyCrusher", Name = "Candy Crusher", Plates = { "CandySteel", "CandySteel" }, Handle = "CandySteel", Mult = 2, Rarity = "Epic", Ability = "CandyRush", Look = "Candy", Hint = "Winter only: nothing but candy canes." },
	{ Id = "DivineDumbbell", Name = "The Divine Dumbbell", Plates = { "CelestialOre", "CelestialOre" }, Handle = "CelestialOre", Mult = 10, Rarity = "Secret", Ability = "Divine", Look = "Divine", Hint = "Only a god could drop what this needs." },
}

local byId: { [string]: Recipe } = {}
for i, r in list do
	r.Order = i
	byId[r.Id] = r
	assert(abilities[r.Ability], "missing ability " .. r.Ability)
end

local Recipes = {
	List = list,
	ById = byId,
	Abilities = abilities,
}

-- Returns the recipe matching these parts, or nil.
-- parts = { {Material=..., Mutation=...} x3 } in the order Left plate, Handle, Right plate.
function Recipes.Match(parts: { any }, plateSize: number): Recipe?
	local left, handle, right = parts[1], parts[2], parts[3]
	if not (left and handle and right) then
		return nil
	end
	for _, r in list do
		local a, b = r.Plates[1], r.Plates[2]
		local platesOk = (left.Material == a and right.Material == b) or (left.Material == b and right.Material == a)
		local handleOk = r.Handle == "*" or handle.Material == r.Handle
		if platesOk and handleOk then
			local ok = true
			if r.MinSize and plateSize < r.MinSize then
				ok = false
			end
			if ok and r.Mutation then
				local needAll = r.Handle ~= "*"
				if left.Mutation ~= r.Mutation or right.Mutation ~= r.Mutation then
					ok = false
				elseif needAll and handle.Mutation ~= r.Mutation then
					ok = false
				end
			end
			if ok then
				return r
			end
		end
	end
	return nil
end

return Recipes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Refine</string>
            <string name="Source"><![CDATA[--[[
	Refine - material processing levels (the Material Processor on your plot).

	Iron -> Iron Ingot -> Refined Iron -> Reinforced Iron -> Perfect Iron

	Input   : units of the previous level needed for one unit of this level
	Seconds : base processing time per output unit (upgrades make it faster)
	Mult    : power multiplier of a unit at this level
	Pattern : display name, %s is the (mutation +) material name
]]

export type RefineLevel = {
	Level: number,
	Name: string,
	Mult: number,
	Input: number,
	Seconds: number,
	FeePerPower: number,
	Pattern: string,
	Color: Color3,
}

local list: { RefineLevel } = {
	{ Level = 0, Name = "Raw", Mult = 1, Input = 0, Seconds = 0, FeePerPower = 0, Pattern = "%s", Color = Color3.fromRGB(200, 200, 200) },
	{ Level = 1, Name = "Ingot", Mult = 1.5, Input = 3, Seconds = 5, FeePerPower = 1, Pattern = "%s Ingot", Color = Color3.fromRGB(120, 220, 255) },
	{ Level = 2, Name = "Refined", Mult = 2.25, Input = 3, Seconds = 10, FeePerPower = 2, Pattern = "Refined %s", Color = Color3.fromRGB(120, 255, 160) },
	{ Level = 3, Name = "Reinforced", Mult = 3.4, Input = 3, Seconds = 18, FeePerPower = 4, Pattern = "Reinforced %s", Color = Color3.fromRGB(255, 200, 80) },
	{ Level = 4, Name = "Perfect", Mult = 5, Input = 3, Seconds = 30, FeePerPower = 8, Pattern = "Perfect %s", Color = Color3.fromRGB(255, 110, 220) },
}

local Refine = {
	List = list,
	Max = #list - 1,
}

function Refine.Get(level: number): RefineLevel
	return list[math.clamp(math.floor(level), 0, #list - 1) + 1]
end

return Refine
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--[[
	Upgrades - bought with Coins at the Upgrade Machine on your plot.
	They reset when you Rebirth (the Rebirth Shop perks do not).

	Values[level + 1] is the upgrade's value at that level (level 0 = not bought).
	Cost of the next level = Cost.Base * Cost.Growth ^ level (rounded to a nice number).
	Format tells the UI how to show a value: Int, Percent, Mult, Seconds, Speed, PlusInt.
]]

export type Upgrade = {
	Id: string,
	Name: string,
	Emoji: string,
	Group: string,
	Desc: string,
	Cost: { Base: number, Growth: number },
	Values: { number },
	Format: string,
	Order: number,
}

local function series(count: number, start: number, step: number): { number }
	local t = {}
	for i = 0, count do
		t[i + 1] = start + step * i
	end
	return t
end

local function geometric(count: number, start: number, ratio: number, digits: number?): { number }
	local t = {}
	local d = 10 ^ (digits or 2)
	for i = 0, count do
		t[i + 1] = math.floor(start * ratio ^ i * d + 0.5) / d
	end
	return t
end

local list: { Upgrade } = {
	-- GATHERING --------------------------------------------------------------------------
	{
		Id = "Backpack", Name = "Backpack", Emoji = "🎒", Group = "Gather",
		Desc = "Carry more materials before heading home.",
		Cost = { Base = 30, Growth = 2.45 },
		Values = { 20, 30, 45, 65, 90, 120, 160, 210, 275, 350, 450, 600, 800, 1000, 1300, 1700 },
		Format = "Int",
	},
	{
		Id = "Hammer", Name = "Smash Power", Emoji = "🔨", Group = "Gather",
		Desc = "Hit material nodes harder. Tough ores need more power.",
		Cost = { Base = 40, Growth = 2.9 },
		Values = geometric(18, 1, 1.18, 2),
		Format = "Mult",
	},
	{
		Id = "SmashSpeed", Name = "Smash Speed", Emoji = "⚡", Group = "Gather",
		Desc = "Swing faster at material nodes.",
		Cost = { Base = 75, Growth = 2.6 },
		Values = geometric(10, 1, 0.94, 3),
		Format = "Speed",
	},
	{
		Id = "Yield", Name = "Double Drops", Emoji = "✨", Group = "Gather",
		Desc = "Chance to get an extra unit from every node you break.",
		Cost = { Base = 150, Growth = 2.5 },
		Values = series(15, 0, 0.05),
		Format = "Percent",
	},
	{
		Id = "MaterialLuck", Name = "Material Luck", Emoji = "🍀", Group = "Gather",
		Desc = "Find rare materials and mutations more often.",
		Cost = { Base = 250, Growth = 2.4 },
		Values = series(20, 0, 0.1),
		Format = "Percent",
	},
	{
		Id = "WalkSpeed", Name = "Walk Speed", Emoji = "👟", Group = "Gather",
		Desc = "Run between zones and your workshop faster.",
		Cost = { Base = 60, Growth = 2.3 },
		Values = series(10, 20, 1.5),
		Format = "Int",
	},
	{
		Id = "AutoDeposit", Name = "Material Teleporter", Emoji = "📦", Group = "Gather",
		Desc = "Automatically beams your backpack home every few seconds.",
		Cost = { Base = 25000, Growth = 12 },
		Values = { 0, 60, 40, 25, 15, 8 },
		Format = "Seconds",
	},

	-- FORGING ----------------------------------------------------------------------------
	{
		Id = "ForgeLevel", Name = "Forge Level", Emoji = "🔥", Group = "Forge",
		Desc = "Bigger plates! Raises the max plate size you can forge.",
		Cost = { Base = 60, Growth = 3 },
		Values = { 1, 2, 3, 4, 5, 6, 7, 8, 10, 12, 14, 16, 18, 20, 23, 26, 30, 35, 40, 45, 50 },
		Format = "PlusInt",
	},
	{
		Id = "ForgeSpeed", Name = "Forge Speed", Emoji = "⏩", Group = "Forge",
		Desc = "Forge dumbbells faster.",
		Cost = { Base = 200, Growth = 2.4 },
		Values = geometric(8, 1, 0.88, 3),
		Format = "Speed",
	},
	{
		Id = "CraftLuck", Name = "Forge Luck", Emoji = "🎲", Group = "Forge",
		Desc = "Better odds of Perfect, Shiny, Golden and Rainbow quality.",
		Cost = { Base = 400, Growth = 2.45 },
		Values = series(20, 0, 0.1),
		Format = "Percent",
	},
	{
		Id = "ProcessSpeed", Name = "Processing Speed", Emoji = "⚙️", Group = "Forge",
		Desc = "Your Material Processor works faster.",
		Cost = { Base = 1500, Growth = 2.5 },
		Values = geometric(10, 1, 0.88, 3),
		Format = "Speed",
	},
	{
		Id = "ProcessSlots", Name = "Processor Slots", Emoji = "🏗️", Group = "Forge",
		Desc = "Process more materials at the same time.",
		Cost = { Base = 5000, Growth = 9 },
		Values = { 1, 2, 3, 4, 5 },
		Format = "Int",
	},
	{
		Id = "MutationLuck", Name = "Mutation Luck", Emoji = "🧪", Group = "Forge",
		Desc = "Your drops come out mutated more often.",
		Cost = { Base = 800, Growth = 2.5 },
		Values = series(20, 0, 0.1),
		Format = "Percent",
	},

	-- TRAINING ---------------------------------------------------------------------------
	{
		Id = "LiftSpeed", Name = "Lift Speed", Emoji = "💨", Group = "Train",
		Desc = "Do reps faster.",
		Cost = { Base = 50, Growth = 2.35 },
		Values = geometric(15, 1, 0.955, 3),
		Format = "Speed",
	},
	{
		Id = "CritChance", Name = "Crit Chance", Emoji = "🎯", Group = "Train",
		Desc = "More CRITICAL LIFTS.",
		Cost = { Base = 120, Growth = 2.3 },
		Values = series(20, 0, 0.005),
		Format = "Percent",
	},
	{
		Id = "CritPower", Name = "Crit Power", Emoji = "💥", Group = "Train",
		Desc = "Critical lifts give even more.",
		Cost = { Base = 180, Growth = 2.35 },
		Values = series(20, 0, 0.5),
		Format = "PlusMult",
	},
	{
		Id = "ComboMastery", Name = "Combo Mastery", Emoji = "🔗", Group = "Train",
		Desc = "Longer combo window and bigger combo bonuses.",
		Cost = { Base = 300, Growth = 2.6 },
		Values = series(10, 0, 0.1),
		Format = "Percent",
	},
	{
		Id = "CoinBoost", Name = "Coin Boost", Emoji = "🪙", Group = "Train",
		Desc = "Earn more coins from every rep.",
		Cost = { Base = 100, Growth = 2.4 },
		Values = series(25, 0, 0.1),
		Format = "Percent",
	},
	{
		Id = "BossDamage", Name = "Boss Damage", Emoji = "⚔️", Group = "Train",
		Desc = "Hit world bosses harder.",
		Cost = { Base = 2000, Growth = 2.3 },
		Values = series(20, 0, 0.1),
		Format = "Percent",
	},
	{
		Id = "JumpPower", Name = "Jump Power", Emoji = "🦘", Group = "Train",
		Desc = "Jump higher. Useful for dodging boss slams.",
		Cost = { Base = 90, Growth = 2.2 },
		Values = series(8, 7.5, 1),
		Format = "Int",
	},
}

local byId: { [string]: Upgrade } = {}
for i, u in list do
	u.Order = i
	byId[u.Id] = u
end

local Upgrades = {
	List = list,
	ById = byId,
	Groups = { "Gather", "Forge", "Train" },
	GroupNames = { Gather = "Gathering", Forge = "Forging", Train = "Training" },
}

function Upgrades.Get(id: string)
	return byId[id]
end

function Upgrades.MaxLevel(u: Upgrade): number
	return #u.Values - 1
end

return Upgrades
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Zones</string>
            <string name="Source"><![CDATA[--[[
	Zones - the gathering areas, in unlock order.

	Tier       : 1..11, used to scale materials, quests, bosses and event loot.
	Cost       : coins to unlock (paid once per rebirth cycle).
	RebirthReq : rebirths needed before the zone can be bought at all.
	Toughness  : how hard the zone's material nodes are to smash (see Formulas.SmashDamage).
	MaxNodes   : how many material nodes the server keeps alive in the zone.
	MutationBias : multipliers applied to the mutation table for nodes spawned here.

	The physical island for each zone lives in Workspace.Map.Zones.<Id> (built by the
	place builder) and contains Spawn, Bounds and NodeSpawns.
]]

export type Zone = {
	Id: string,
	Name: string,
	Tier: number,
	Cost: number,
	RebirthReq: number,
	Toughness: number,
	MaxNodes: number,
	Color: Color3,
	Accent: Color3,
	Emoji: string,
	Blurb: string,
	MutationBias: { [string]: number },
}

local list: { Zone } = {
	{
		Id = "StarterYard", Name = "Starter Yard", Tier = 1, Cost = 0, RebirthReq = 0,
		Toughness = 6, MaxNodes = 34,
		Color = Color3.fromRGB(98, 196, 92), Accent = Color3.fromRGB(255, 214, 64), Emoji = "🌳",
		Blurb = "Old tires, plastic crates and firewood. Everyone starts somewhere!",
		MutationBias = {},
	},
	{
		Id = "Scrapyard", Name = "Scrapyard", Tier = 2, Cost = 3500, RebirthReq = 0,
		Toughness = 10000, MaxNodes = 22,
		Color = Color3.fromRGB(196, 110, 58), Accent = Color3.fromRGB(255, 196, 80), Emoji = "🚗",
		Blurb = "Crushed cars and rusty treasure. Watch out for loose bolts.",
		MutationBias = { Magnetic = 3, Electric = 1.5 },
	},
	{
		Id = "Mine", Name = "The Mine", Tier = 3, Cost = 31000, RebirthReq = 0,
		Toughness = 70000, MaxNodes = 22,
		Color = Color3.fromRGB(124, 98, 78), Accent = Color3.fromRGB(255, 176, 72), Emoji = "⛏️",
		Blurb = "Deep tunnels full of iron, silver and glittering amethyst.",
		MutationBias = { Golden = 2, Crystal = 2 },
	},
	{
		Id = "Factory", Name = "Industrial Factory", Tier = 4, Cost = 1400000, RebirthReq = 0,
		Toughness = 9000000, MaxNodes = 22,
		Color = Color3.fromRGB(88, 120, 158), Accent = Color3.fromRGB(255, 204, 0), Emoji = "🏭",
		Blurb = "Steel beams, titanium sheets and humming machines.",
		MutationBias = { Electric = 4, Magnetic = 3 },
	},
	{
		Id = "Volcano", Name = "Volcano", Tier = 5, Cost = 29000000, RebirthReq = 0,
		Toughness = 150000000, MaxNodes = 22,
		Color = Color3.fromRGB(70, 56, 56), Accent = Color3.fromRGB(255, 104, 24), Emoji = "🌋",
		Blurb = "Molten gold and razor obsidian. Don't touch the orange stuff.",
		MutationBias = { Burning = 6, Golden = 1.5 },
	},
	{
		Id = "FrozenCave", Name = "Frozen Cave", Tier = 6, Cost = 250000000, RebirthReq = 0,
		Toughness = 1800000000, MaxNodes = 22,
		Color = Color3.fromRGB(150, 206, 240), Accent = Color3.fromRGB(230, 250, 255), Emoji = "❄️",
		Blurb = "Ancient ice that never melts, hiding sapphires in the dark.",
		MutationBias = { Frozen = 6, Crystal = 2 },
	},
	{
		Id = "CrystalCavern", Name = "Crystal Cavern", Tier = 7, Cost = 7600000000, RebirthReq = 1,
		Toughness = 40000000000, MaxNodes = 22,
		Color = Color3.fromRGB(150, 84, 214), Accent = Color3.fromRGB(255, 120, 230), Emoji = "💎",
		Blurb = "A glowing cave of gems. Diamonds are a lifter's best friend.",
		MutationBias = { Crystal = 6, Rainbow = 2 },
	},
	{
		Id = "Nuclear", Name = "Nuclear Facility", Tier = 8, Cost = 140000000000, RebirthReq = 2,
		Toughness = 600000000000, MaxNodes = 22,
		Color = Color3.fromRGB(96, 110, 96), Accent = Color3.fromRGB(120, 255, 60), Emoji = "☢️",
		Blurb = "Hazard pay not included. Uranium glows for a reason.",
		MutationBias = { Radioactive = 6, Toxic = 5 },
	},
	{
		Id = "MeteorCrater", Name = "Meteor Crater", Tier = 9, Cost = 1900000000000, RebirthReq = 3,
		Toughness = 5500000000000, MaxNodes = 22,
		Color = Color3.fromRGB(92, 64, 58), Accent = Color3.fromRGB(255, 120, 60), Emoji = "☄️",
		Blurb = "Rocks from outer space, still warm from the fall.",
		MutationBias = { Burning = 2, Cosmic = 4 },
	},
	{
		Id = "Space", Name = "Space Zone", Tier = 10, Cost = 23000000000000, RebirthReq = 4,
		Toughness = 55000000000000, MaxNodes = 22,
		Color = Color3.fromRGB(64, 72, 120), Accent = Color3.fromRGB(140, 200, 255), Emoji = "🪐",
		Blurb = "Low gravity, high gains. Moonstone and nebula glass drift here.",
		MutationBias = { Cosmic = 6, Celestial = 2 },
	},
	{
		Id = "Void", Name = "Void Zone", Tier = 11, Cost = 30000000000000, RebirthReq = 5,
		Toughness = 200000000000000, MaxNodes = 22,
		Color = Color3.fromRGB(40, 20, 64), Accent = Color3.fromRGB(190, 80, 255), Emoji = "🌀",
		Blurb = "The edge of reality. Nobody knows who left the dumbbells here.",
		MutationBias = { Void = 6, Shadow = 4, Corrupted = 3 },
	},
}

local byId: { [string]: Zone } = {}
local byTier: { [number]: Zone } = {}
for _, z in list do
	byId[z.Id] = z
	byTier[z.Tier] = z
end

local Zones = {
	List = list,
	ById = byId,
	ByTier = byTier,
	Count = #list,
}

function Zones.Get(id: string): Zone?
	return byId[id]
end

return Zones
]]></string>
