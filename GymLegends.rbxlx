return { W = 96, H = 96, Data = "" }</ProtectedString>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="LEADERBOARD1">
          <Properties>
            <string name="Name">Leaderboard</string>
            <ProtectedString name="Source">--[[
	Leaderboard - the custom player list (top right), in the game's chunky sim style:
	  * gold header with the trophy logo; click it (or press Tab) to collapse / expand
	  * column headers use the game's logos (Money, Strength, Rebirth star)
	  * every row: rank badge (gold / silver / bronze), avatar, name and stats
	  * sorted by Rebirths, then Strength; your own row is highlighted
	  * compact: the top rows + your own row (MAX_ROWS), so it never covers the menu buttons
	    below it - the Ranks panel lists everyone
	Numbers come from the Player attributes the server sets (display only).
]]
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Leaderboard = {}

local COLUMNS = {
	{ Attr = "Coins", Icon = "Money", Emoji = "💵", Color = Color3.fromRGB(110, 240, 90) },
	{ Attr = "Strength", Icon = "Strength", Emoji = "💪", Color = Color3.fromRGB(255, 118, 96) },
	{ Attr = "Rebirths", Icon = "RebirthStar", Emoji = "⭐", Color = Color3.fromRGB(255, 212, 70), Whole = true },
}
local MEDAL = {
	{ Top = Color3.fromRGB(255, 226, 90), Bottom = Color3.fromRGB(240, 160, 20) },
	{ Top = Color3.fromRGB(236, 242, 250), Bottom = Color3.fromRGB(160, 172, 190) },
	{ Top = Color3.fromRGB(240, 170, 110), Bottom = Color3.fromRGB(180, 96, 40) },
}

local WIDTH, HEADER_H, COLS_H, ROW_H, ROW_GAP = 318, 40, 28, 30, 4
local MAX_ROWS = 4 -- top 3 + you (or the top 4 when you are in it)
local NAME_W, COL_W = 150, 50
local C, UIKit, Format
local frame, body, list, chevron
local open = true
local rows = {}
local dirty = true

local function hideDefaultList()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
		end)
		if ok then
			return
		end
		task.wait(0.5)
	end
end

local function valueText(player, col)
	local v = player:GetAttribute(col.Attr)
	if type(v) ~= "number" then
		return "-"
	end
	return col.Whole and Format.Commas(v) or Format.Number(v)
end

local function resize()
	if not frame then
		return
	end
	local count = 0
	for _, r in pairs(rows) do
		if r.Frame.Visible then
			count = count + 1
		end
	end
	local h = HEADER_H
	if open then
		h = h + 6 + COLS_H + 6 + count * (ROW_H + ROW_GAP) + 4
	end
	frame.Size = UDim2.fromOffset(WIDTH, h)
	body.Visible = open
	UIKit.SetCaret(chevron, open)
end

local function styleRank(r, rank)
	r.RankLabel.Text = tostring(rank)
	local medal = MEDAL[rank]
	local grad = r.Badge:FindFirstChildOfClass("UIGradient")
	if medal then
		grad.Color = ColorSequence.new(medal.Top, medal.Bottom)
		r.RankLabel.TextColor3 = Color3.new(1, 1, 1)
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(70, 82, 120), Color3.fromRGB(40, 48, 78))
		r.RankLabel.TextColor3 = Color3.fromRGB(210, 222, 255)
	end
end

local function refreshAll()
	dirty = false
	local ordered = {}
	for player in pairs(rows) do
		ordered[#ordered + 1] = player
	end
	table.sort(ordered, function(a, b)
		local ra, rb = a:GetAttribute("Rebirths") or 0, b:GetAttribute("Rebirths") or 0
		if ra ~= rb then
			return ra &gt; rb
		end
		local sa, sb = a:GetAttribute("Strength") or 0, b:GetAttribute("Strength") or 0
		if sa ~= sb then
			return sa &gt; sb
		end
		return a.Name &lt; b.Name
	end)
	local myRank = table.find(ordered, Players.LocalPlayer)
	for rank, player in ipairs(ordered) do
		local r = rows[player]
		-- the top rows, plus your own row in the last slot when you rank lower
		if myRank and myRank &gt; MAX_ROWS then
			r.Frame.Visible = rank &lt; MAX_ROWS or player == Players.LocalPlayer
		else
			r.Frame.Visible = rank &lt;= MAX_ROWS
		end
		r.Frame.LayoutOrder = rank
		r.Name.Text = player.DisplayName
		for i, col in ipairs(COLUMNS) do
			r.Cells[i].Text = valueText(player, col)
		end
		styleRank(r, rank)
	end
	resize()
end

local function addRow(player)
	if rows[player] or not list then
		return
	end
	local mine = player == Players.LocalPlayer
	local row = UIKit.Card({
		Name = "Row", Top = mine and Color3.fromRGB(64, 140, 255) or Color3.fromRGB(34, 48, 92),
		Bottom = mine and Color3.fromRGB(34, 84, 210) or Color3.fromRGB(22, 30, 62),
		Size = UDim2.new(1, 0, 0, ROW_H), Radius = 10, OutlineThickness = 2,
		Outline = mine and Color3.fromRGB(230, 240, 255) or UIKit.C.Outline, ZIndex = 61, Parent = list,
	})
	local badge = UIKit.Card({ Name = "Rank", Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 5, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
		Radius = 26, OutlineThickness = 2, ZIndex = 62, Parent = row })
	badge:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	local rankLabel = UIKit.Text({ Text = "", TextSize = 15, Size = UDim2.fromScale(1, 1), StrokeThickness = 1.6, ZIndex = 63, Parent = badge })
	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.BackgroundColor3 = Color3.fromRGB(16, 22, 44)
	avatar.BorderSizePixel = 0
	avatar.Size = UDim2.fromOffset(24, 24)
	avatar.Position = UDim2.new(0, 34, 0.5, 0)
	avatar.AnchorPoint = Vector2.new(0, 0.5)
	avatar.Image = "rbxthumb://type=AvatarHeadShot&amp;id=" .. player.UserId .. "&amp;w=48&amp;h=48"
	avatar.ZIndex = 62
	UIKit.Corner(avatar, 12)
	UIKit.Stroke(avatar, UIKit.C.Outline, 1.5)
	avatar.Parent = row
	local name = UIKit.Text({ Name = "PlayerName", Text = player.DisplayName, TextSize = 15, Size = UDim2.new(0, NAME_W - 66, 1, 0), Position = UDim2.fromOffset(66, 0),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.6, ZIndex = 62, Parent = row })
	name.TextTruncate = Enum.TextTruncate.AtEnd
	local r = { Frame = row, Badge = badge, RankLabel = rankLabel, Name = name, Cells = {} }
	for i, col in ipairs(COLUMNS) do
		r.Cells[i] = UIKit.Text({ Text = "-", TextSize = 15, Color = col.Color, Size = UDim2.new(0, COL_W, 1, 0),
			Position = UDim2.fromOffset(NAME_W + (i - 1) * (COL_W + 4) + 4, 0), StrokeThickness = 1.6, ZIndex = 62, Parent = row })
	end
	rows[player] = r
	for _, col in ipairs(COLUMNS) do
		player:GetAttributeChangedSignal(col.Attr):Connect(function()
			dirty = true
		end)
	end
	dirty = true
	refreshAll()
end

local function removeRow(player)
	local r = rows[player]
	if r then
		r.Frame:Destroy()
		rows[player] = nil
		refreshAll()
	end
end

function Leaderboard.Init(client)
	C = client
	UIKit, Format = C.UIKit, C.Format
	task.spawn(hideDefaultList)

	frame = UIKit.Frame({ Name = "Leaderboard", Color = UIKit.C.Navy, Transparency = 0.12, Size = UDim2.fromOffset(WIDTH, HEADER_H),
		Position = UDim2.new(1, -12, 0, 8), AnchorPoint = Vector2.new(1, 0), Radius = 18, Stroke = UIKit.C.Outline, StrokeThickness = 3,
		ZIndex = 5, Parent = C.Root }) -- below pop-up panels (ZIndex 20), above the HUD
	frame.ClipsDescendants = true

	-- gold header (a button: collapses the list)
	local header = Instance.new("TextButton")
	header.Name = "Header"
	header.AutoButtonColor = false
	header.Text = ""
	header.BackgroundColor3 = Color3.new(1, 1, 1)
	header.BorderSizePixel = 0
	header.Size = UDim2.new(1, 0, 0, HEADER_H)
	header.ZIndex = 60
	UIKit.Corner(header, 18)
	UIKit.Gradient(header, UIKit.C.Gold, UIKit.C.GoldDark, 90)
	UIKit.Stroke(header, UIKit.C.Outline, 2)
	UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.78, Size = UDim2.new(1, -14, 0, 12), Position = UDim2.fromOffset(7, 4), Radius = 8, ZIndex = 60, Parent = header })
	header.Parent = frame
	UIKit.Icon({ Icon = "Ranks", Emoji = "🏆", Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 61, Parent = header })
	UIKit.Text({ Text = "LEADERBOARD", TextSize = 21, Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(48, 0), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.6, ZIndex = 61, Parent = header })
	chevron = UIKit.Caret({ Size = 16, Up = true, Position = UDim2.new(1, -20, 0.5, 0), ZIndex = 61, Parent = header })

	body = UIKit.Frame({ Name = "Body", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -12, 1, -(HEADER_H + 6)), Position = UDim2.fromOffset(6, HEADER_H + 6),
		ZIndex = 59, Parent = frame })
	-- column header: logos instead of words
	local cols = UIKit.Frame({ Name = "Columns", Color = Color3.fromRGB(8, 14, 34), Transparency = 0.2, Size = UDim2.new(1, 0, 0, COLS_H), Radius = 10, ZIndex = 60, Parent = body })
	UIKit.Text({ Text = "PLAYER", TextSize = 13, Color = UIKit.C.Muted, Size = UDim2.new(0, 110, 1, 0), Position = UDim2.fromOffset(10, 0), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 1.4, ZIndex = 61, Parent = cols })
	for i, col in ipairs(COLUMNS) do
		UIKit.Icon({ Icon = col.Icon, Emoji = col.Emoji, Size = UDim2.fromOffset(24, 24), Position = UDim2.new(0, NAME_W + (i - 1) * (COL_W + 4) + 4 + COL_W / 2, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 61, Parent = cols })
	end
	list = UIKit.Frame({ Name = "Rows", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, 0, 1, -(COLS_H + 6)), Position = UDim2.fromOffset(0, COLS_H + 6),
		ZIndex = 60, Parent = body })
	UIKit.List(list, ROW_GAP)

	local function toggle()
		open = not open
		resize()
	end
	header.Activated:Connect(toggle)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Tab then
			toggle()
		end
	end)

	for _, p in ipairs(Players:GetPlayers()) do
		addRow(p)
	end
	Players.PlayerAdded:Connect(addRow)
	Players.PlayerRemoving:Connect(removeRow)
	-- stats change often: re-sort at most twice a second
	task.spawn(function()
		while true do
			task.wait(0.5)
			if dirty then
				refreshAll()
			end
		end
	end)
	refreshAll()
end

return Leaderboard
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="ICONLOADER1">
          <Properties>
            <string name="Name">IconLoader</string>
            <ProtectedString name="Source">--[[
	IconLoader - draws the custom HUD pictures (money stack, flexing arm, dumbbell)
	without needing uploaded Roblox images. The pixels live in IconData and are
	painted into an EditableImage at runtime.

	If you ever upload the PNGs yourself, put the rbxassetid:// in Config.Icons and
	that uploaded image is used instead.
]]
local AssetService = game:GetService("AssetService")

local IconLoader = {}
local DataFolder = script.Parent:WaitForChild("IconData")
local cache = {}

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #B64 do
	lookup[string.byte(B64, i)] = i - 1
end

local function decode(str)
	local len = #str
	local pad = 0
	if string.sub(str, -2) == "==" then pad = 2 elseif string.sub(str, -1) == "=" then pad = 1 end
	local outLen = (len // 4) * 3 - pad
	local buf = buffer.create(outLen)
	local o = 0
	for i = 1, len, 4 do
		local a = lookup[string.byte(str, i)] or 0
		local b = lookup[string.byte(str, i + 1)] or 0
		local c = lookup[string.byte(str, i + 2)] or 0
		local d = lookup[string.byte(str, i + 3)] or 0
		local n = a * 262144 + b * 4096 + c * 64 + d
		if o &lt; outLen then buffer.writeu8(buf, o, n // 65536) end
		if o + 1 &lt; outLen then buffer.writeu8(buf, o + 1, (n // 256) % 256) end
		if o + 2 &lt; outLen then buffer.writeu8(buf, o + 2, n % 256) end
		o = o + 3
	end
	return buf
end

local function editableFor(name)
	if cache[name] ~= nil then
		return cache[name] or nil
	end
	local module = DataFolder:FindFirstChild(name)
	if not module then
		cache[name] = false
		return nil
	end
	local ok, img = pcall(function()
		local data = require(module)
		local size = Vector2.new(data.W, data.H)
		local e = AssetService:CreateEditableImage({ Size = size })
		e:WritePixelsBuffer(Vector2.zero, size, decode(data.Data))
		return e
	end)
	cache[name] = ok and img or false
	if not ok then
		warn("[IconLoader] Could not draw icon '" .. name .. "': " .. tostring(img))
	end
	return ok and img or nil
end

-- Returns an ImageLabel showing the icon, or nil if it can't be drawn (caller falls back to emoji).
function IconLoader.Make(name, uploadedId)
	local label = Instance.new("ImageLabel")
	label.Name = name .. "Icon"
	label.BackgroundTransparency = 1
	label.ScaleType = Enum.ScaleType.Fit
	if uploadedId and uploadedId ~= "" then
		label.Image = uploadedId
		return label
	end
	local img = editableFor(name)
	if not img then
		label:Destroy()
		return nil
	end
	local ok = pcall(function()
		label.ImageContent = Content.fromObject(img)
	end)
	if not ok then
		label:Destroy()
		return nil
	end
	return label
end

-- Paints an icon into an existing ImageLabel (used for the server-built "GymIcon" slots).
function IconLoader.Apply(label, name)
	local img = editableFor(name)
	if not img then
		return false
	end
	return (pcall(function()
		label.ImageContent = Content.fromObject(img)
	end))
end

-- Turns an existing UIKit button into a picture button (same click/hover behaviour).
-- opts.Text = true keeps the button's (changing) text, drawn on top of the picture.
-- opts.KeepRim = true keeps the coloured inner rim (used for rarity on pet slots).
function IconLoader.Skin(button, name, opts)
	opts = opts or {}
	local img = IconLoader.Make(name)
	if not img then
		return nil -- keep the old look if the picture can't be drawn
	end
	img.Name = "Skin"
	img.Size = UDim2.fromScale(1, 1)
	img.ZIndex = button.ZIndex
	img.Active = false
	img.Parent = button
	button.BackgroundTransparency = 1
	local outline = button:FindFirstChild("Outline")
	if outline then outline.Visible = false end
	local rim = button:FindFirstChild("Rim")
	if rim then
		if opts.KeepRim then
			rim.ZIndex = button.ZIndex + 1
		else
			rim.Visible = false
		end
	end
	local textStroke = button:FindFirstChild("TextOutline")
	if opts.Text then
		-- the button's own text would be hidden under the picture, so mirror it on a label
		local label = Instance.new("TextLabel")
		label.Name = "SkinText"
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 1, -4)
		label.Font = button.Font
		label.TextSize = opts.TextSize or button.TextSize
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Text = button.Text
		label.ZIndex = button.ZIndex + 2
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(0, 0, 0)
		st.Thickness = 3
		st.Parent = label
		label.Parent = button
		button:GetPropertyChangedSignal("Text"):Connect(function()
			label.Text = button.Text
		end)
	end
	button.TextTransparency = 1
	if textStroke then textStroke.Enabled = false end
	return img
end

return IconLoader
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX31">
          <Properties>
            <string name="Name">HUD</string>
            <ProtectedString name="Source">--[[
	HUD - everything that is always on screen:
	  * stat pills (Strength / Coins / Rebirths / Boost) with rolling numbers
	  * "next gate" progress bar (becomes a rebirth bar once every gym is open)
	  * menu bar with notification badges
	  * quest tracker, equipped-pet strip
	  * training buttons (Train / Stop / Auto) - shown only while at a machine
	  * toast messages
]]
local RunService = game:GetService("RunService")

local HUD = {}

local C, UIKit, Store, Format, Formulas, Config
local IconLoader = require(script.Parent:WaitForChild("IconLoader"))
local counters = {}   -- rolling number labels
local badges = {}     -- [menuName] = Frame
local toastList
local toasts = {}
local pillFrames = {}

----------------------------------------------------------------------
-- Rolling counters
----------------------------------------------------------------------
local function addCounter(label, getter, formatter, pill)
	local counter = { Label = label, Get = getter, Format = formatter, Display = getter(), LastText = "", Pill = pill, LastTarget = getter(), LastBump = 0 }
	label.Text = formatter(counter.Display)
	counter.LastText = label.Text
	counters[#counters + 1] = counter
end

local function updateCounters(dt)
	local now = os.clock()
	for _, c in ipairs(counters) do
		local target = c.Get()
		if c.Display ~= target then
			c.Display = c.Display + (target - c.Display) * math.min(1, dt * 12)
			if math.abs(target - c.Display) &lt;= math.max(1e-6, math.abs(target) * 2e-4) then
				c.Display = target
			end
			local text = c.Format(c.Display)
			if text ~= c.LastText then
				c.Label.Text = text
				c.LastText = text
			end
		end
		if target &gt; c.LastTarget and c.Pill and now - c.LastBump &gt; 0.09 then
			c.LastBump = now
			UIKit.Bump(c.Pill, 1.07)
		end
		c.LastTarget = target
	end
end

----------------------------------------------------------------------
-- Big outlined stat readouts (bottom-left, like the reference UI)
----------------------------------------------------------------------
local infoLabel

function HUD.RefreshInfo()
	if infoLabel then
		infoLabel.Text = "⭐ " .. math.floor(Store.Attr("Rebirths")) .. "     🚀 " .. Format.Mult(Store.Attr("StrengthMult")) .. " boost"
	end
end

local function buildPills(parent)
	local function row(bottom, icon, color, getter, formatter, iconName)
		local f = UIKit.Frame({
			Name = "StatRow", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(380, 56),
			Position = UDim2.new(0, 14, 1, -bottom), AnchorPoint = Vector2.new(0, 1), Parent = parent,
		})
		local uploaded = C.Config.Icons and C.Config.Icons[iconName]
		local img = iconName and IconLoader.Make(iconName, uploaded)
		if img then
			img.Size = UDim2.fromOffset(58, 58)
			img.Position = UDim2.fromOffset(-2, -1)
			img.Parent = f
		else
			UIKit.Text({ Text = icon, TextSize = 44, Size = UDim2.fromOffset(56, 56), Stroke = false, Parent = f })
		end
		local value = UIKit.Text({
			Name = "Value", Text = "0", TextSize = 46, Color = color, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(60, 0),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 4, Parent = f,
		})
		addCounter(value, getter, formatter, f)
		return f, value
	end
	row(70, "💪", Color3.fromRGB(255, 70, 214), function() return Store.Attr("Strength") end, Format.Number, "Strength")
	local _, coinValue = row(12, "💵", Color3.fromRGB(64, 236, 56), function() return Store.Attr("Coins") end, Format.Number, "Money")
	C.CoinTarget = coinValue
	infoLabel = UIKit.Text({
		Name = "Info", Text = "", TextSize = 20, Size = UDim2.fromOffset(380, 26), Position = UDim2.new(0, 22, 1, -132), AnchorPoint = Vector2.new(0, 1),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.5, Parent = parent,
	})
end

----------------------------------------------------------------------
-- Gym progression: [current gym] ==== progress to the next gym ==== [next gym]
-- (turns into a rebirth tracker once every gym is open)
----------------------------------------------------------------------
local gate = {}

local function nextLockedArea()
	for _, area in ipairs(Config.Areas) do
		if not Store.AreaUnlocked(area.Id) then
			return area
		end
	end
	return nil
end

local function highestUnlockedArea()
	local best = Config.Areas[1]
	for _, area in ipairs(Config.Areas) do
		if Store.AreaUnlocked(area.Id) then
			best = area
		end
	end
	return best
end

local function setBadge(badge, top, bottom, emoji, icon)
	badge.Frame:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(top, bottom)
	badge.Emoji.Text = emoji or ""
	badge.Emoji.Visible = icon == nil
	badge.Icon.Visible = icon ~= nil
end

function HUD.RefreshGateBar()
	if not gate.Frame then
		return
	end
	local strength = Store.Attr("Strength")
	local area = nextLockedArea()
	local current = highestUnlockedArea()
	local fraction, target, ready
	if area then
		target = area.Required
		ready = strength &gt;= target
		fraction = target &gt; 0 and strength / target or 1
		gate.Title.Text = ready and ("PUSH THE GATE: " .. string.upper(area.Name) .. "!") or ("NEXT GYM:  " .. string.upper(area.Name))
		local accent = area.Theme.Accent
		gate.Fill:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(UIKit.Shade(accent, 1.25), UIKit.Shade(accent, 0.8))
		setBadge(gate.Left, UIKit.Shade(current.Theme.Accent, 1.15), UIKit.Shade(current.Theme.Accent, 0.65), current.Icon)
		setBadge(gate.Right, ready and Color3.fromRGB(110, 230, 90) or Color3.fromRGB(90, 98, 124), ready and Color3.fromRGB(40, 160, 50) or Color3.fromRGB(46, 52, 74), area.Icon)
		gate.Lock.Visible = not ready
		gate.Go.Visible = ready
	else
		target = Formulas.RebirthRequirement(Store.Attr("Rebirths"))
		ready = strength &gt;= target
		fraction = strength / target
		gate.Title.Text = ready and "READY TO REBIRTH!" or "NEXT REBIRTH"
		gate.Fill:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(Color3.fromRGB(200, 140, 255), Color3.fromRGB(130, 70, 230))
		setBadge(gate.Left, UIKit.Shade(current.Theme.Accent, 1.15), UIKit.Shade(current.Theme.Accent, 0.65), current.Icon)
		setBadge(gate.Right, Color3.fromRGB(190, 130, 255), Color3.fromRGB(110, 50, 210), nil, "RebirthStar")
		gate.Lock.Visible = false
		gate.Go.Visible = ready
	end
	fraction = math.clamp(fraction, 0, 1)
	gate.Fill.Size = UDim2.new(fraction, 0, 1, 0)
	gate.Fill.Visible = fraction &gt; 0.01
	gate.Value.Text = Format.Number(strength) .. " / " .. Format.Number(target)
	gate.Title.TextColor3 = ready and Color3.fromRGB(140, 255, 120) or Color3.new(1, 1, 1)
	HUD.SetBadge("Rebirth", strength &gt;= Formulas.RebirthRequirement(Store.Attr("Rebirths")))
end

local function makeBadge(parent, xScale, anchorX)
	local frame = UIKit.Card({ Name = "Badge", Size = UDim2.fromOffset(60, 60), Position = UDim2.new(xScale, 0, 0, 10), AnchorPoint = Vector2.new(anchorX, 0),
		Radius = 60, OutlineThickness = 3, Rim = Color3.fromRGB(255, 255, 255), ZIndex = 4, Parent = parent })
	frame:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	local rim = frame:FindFirstChild("Rim")
	if rim then
		rim:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
		rim:FindFirstChildOfClass("UIStroke").Transparency = 0.45
	end
	local emoji = UIKit.Text({ Name = "Emoji", Text = "", TextSize = 30, Size = UDim2.fromScale(1, 1), Stroke = false, ZIndex = 5, Parent = frame })
	local icon = UIKit.Icon({ Icon = "RebirthStar", Emoji = "⭐", Size = UDim2.new(1, -10, 1, -10), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 5, Parent = frame })
	icon.Visible = false
	return { Frame = frame, Emoji = emoji, Icon = icon }
end

local function buildGateBar(parent)
	local holder = UIKit.Frame({ Name = "GymProgress", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(520, 78),
		Position = UDim2.new(0.5, -44, 0, -2), AnchorPoint = Vector2.new(0.5, 0), Parent = parent })
	gate.Frame = holder
	gate.Title = UIKit.Text({ Name = "Title", Text = "", TextSize = 18, Size = UDim2.new(1, -150, 0, 24), Position = UDim2.new(0.5, 0, 0, 6), AnchorPoint = Vector2.new(0.5, 0),
		StrokeThickness = 2.5, ZIndex = 4, Parent = holder })
	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(22, 30, 60), Bottom = Color3.fromRGB(10, 14, 32), Size = UDim2.new(1, -118, 0, 32),
		Position = UDim2.new(0.5, 0, 0, 34), AnchorPoint = Vector2.new(0.5, 0), Radius = 20, OutlineThickness = 3, Clip = true, ZIndex = 3, Parent = holder })
	gate.Fill = UIKit.Card({ Name = "Fill", Top = Color3.fromRGB(255, 150, 120), Bottom = Color3.fromRGB(220, 70, 60), Size = UDim2.new(0, 0, 1, 0), Radius = 20,
		OutlineThickness = 0, ZIndex = 3, Parent = track })
	gate.Fill:FindFirstChildOfClass("UIStroke").Enabled = false
	UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.82, Size = UDim2.new(1, -16, 0, 9), Position = UDim2.fromOffset(8, 4), Radius = 10, ZIndex = 4, Parent = track })
	local _, value = UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "", TextSize = 18, IconSize = 24, Align = "Center", StrokeThickness = 2.5,
		Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = track })
	gate.Value = value
	gate.Left = makeBadge(holder, 0, 0)
	gate.Right = makeBadge(holder, 1, 1)
	gate.Lock = UIKit.Text({ Name = "Lock", Text = "🔒", TextSize = 20, Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, 4, 1, 4), AnchorPoint = Vector2.new(1, 1),
		Stroke = false, ZIndex = 6, Parent = gate.Right.Frame })
	gate.Go = UIKit.Chip({ Name = "Go", Text = "GO!", Color = Color3.fromRGB(64, 200, 80), Size = UDim2.fromOffset(46, 22), TextSize = 15,
		Position = UDim2.new(0.5, 0, 1, 6), AnchorPoint = Vector2.new(0.5, 1), ZIndex = 6, Parent = gate.Right.Frame })
	gate.Go.Visible = false
end

----------------------------------------------------------------------
-- Menu bar
----------------------------------------------------------------------
-- Shop = the Robux donation shop (PanelDonate), Upgrades = the coin upgrade shop (PanelShop)
local LEFT_MENU = {
	{ Name = "Donate", Text = "🛒 Shop", Color = Color3.fromRGB(72, 214, 40), Skin = "Shop", Size = UDim2.fromOffset(112, 92), Row = true },
	{ Name = "Shop", Text = "", Color = Color3.fromRGB(255, 210, 40), Skin = "UpgradeBtn", Size = UDim2.fromOffset(142, 90), Row = true },
	{ Name = "Areas", Text = "🗺️ Gyms", Color = Color3.fromRGB(24, 196, 240), Skin = "Gyms", Size = UDim2.fromOffset(186, 60) },
	{ Name = "Rebirth", Text = "⭐ Rebirth", Color = Color3.fromRGB(170, 84, 255), Skin = "Rebirth", Size = UDim2.fromOffset(186, 60) },
}
local RIGHT_MENU = {
	{ Name = "Pets", Icon = "🐾", Color = Color3.fromRGB(255, 150, 30), Skin = "Pets" },
	{ Name = "Quests", Icon = "📋", Color = Color3.fromRGB(52, 140, 255), Skin = "Quests" },
	{ Name = "Ranks", Icon = "🏆", Color = Color3.fromRGB(240, 60, 64), Skin = "Ranks" },
}

function HUD.SetBadge(name, visible)
	local b = badges[name]
	if b then
		b.Visible = visible
	end
end

local function addBadge(button, name)
	local badge = UIKit.Frame({
		Name = "Badge", Color = UIKit.C.Bad, Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, 8, 0, -8),
		AnchorPoint = Vector2.new(1, 0), Radius = 14, Stroke = Color3.new(1, 1, 1), StrokeThickness = 2, Visible = false,
		ZIndex = 8, Parent = button,
	})
	UIKit.Text({ Text = "!", TextSize = 20, ZIndex = 9, Parent = badge })
	badges[name] = badge
end

local function buildMenu(parent)
	local left = UIKit.Frame({
		Name = "LeftMenu", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(190, 330),
		Position = UDim2.new(0, 14, 0.36, 0), Parent = parent,
	})
	UIKit.List(left, 10, Enum.FillDirection.Vertical)
	left.Size = UDim2.fromOffset(270, 330)
	-- the Shop + Upgrade buttons share the first row
	local topRow = UIKit.Frame({ Name = "ShopRow", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(266, 92), LayoutOrder = 0, Parent = left })
	UIKit.List(topRow, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	for i, item in ipairs(LEFT_MENU) do
		local button = UIKit.Button({
			Name = item.Name, Text = item.Text, Color = item.Color, TextSize = 30, Size = item.Size or UDim2.fromOffset(180, 62), LayoutOrder = i,
			Radius = 10, Parent = item.Row and topRow or left, OnClick = function() C.TogglePanel(item.Name) end,
		})
		IconLoader.Skin(button, item.Skin)
		addBadge(button, item.Name)
	end


	local right = UIKit.Frame({
		Name = "RightMenu", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(84, 270),
		Position = UDim2.new(1, -14, 0.36, 0), AnchorPoint = Vector2.new(1, 0), Parent = parent,
	})
	UIKit.List(right, 10, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Right)
	for i, item in ipairs(RIGHT_MENU) do
		local button = UIKit.Button({
			Name = item.Name, Text = item.Icon, Color = item.Color, TextSize = 44, Size = UDim2.fromOffset(78, 78), LayoutOrder = i,
			Radius = 8, Parent = right, OnClick = function() C.TogglePanel(item.Name) end,
		})
		IconLoader.Skin(button, item.Skin)
		addBadge(button, item.Name)
	end
end

----------------------------------------------------------------------
-- Quest tracker card (top left)
----------------------------------------------------------------------
local quest = {}

local function buildQuestCard(parent)
	local card = UIKit.Card({ Name = "QuestCard", Top = Color3.fromRGB(78, 172, 255), Bottom = Color3.fromRGB(30, 104, 228), Size = UDim2.fromOffset(292, 124),
		Position = UDim2.new(0, 22, 0, 82), Radius = 18, OutlineThickness = 3, Rim = Color3.fromRGB(160, 214, 255), Shine = true, Parent = parent })
	quest.Card = card
	card.Position = UDim2.new(0, 22, 0, 102)
	card.ZIndex = 3
	-- the clipboard is a button: tap it to fold the card away (e.g. to use the chat) and back
	-- it sits in Roblox's top bar, right next to the chat button (unscaled, like the top bar)
	local toggle = UIKit.Button({ Name = "QuestToggle", Text = "📋", Color = Color3.fromRGB(52, 140, 255), TextSize = 26, Size = UDim2.fromOffset(44, 44),
		Position = UDim2.fromOffset(172, 12), Radius = 8, ZIndex = 8, Parent = C.Gui or parent,
		OnClick = function()
			quest.Hidden = not quest.Hidden
			card.Visible = not quest.Hidden
		end })
	IconLoader.Skin(toggle, "Quests")
	quest.Number = select(2, UIKit.Chip({ Name = "Number", Text = "QUEST #1", Color = Color3.fromRGB(16, 44, 110), Size = UDim2.fromOffset(98, 22), TextSize = 14,
		Position = UDim2.fromOffset(42, 7), ZIndex = 3, Parent = card }))
	quest.Text = UIKit.Text({ Name = "QuestText", Text = "", TextSize = 20, Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 32),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.4, ZIndex = 3, Parent = card })
	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(12, 30, 80), Bottom = Color3.fromRGB(8, 20, 56), Size = UDim2.new(1, -24, 0, 24),
		Position = UDim2.fromOffset(12, 62), Radius = 16, OutlineThickness = 2, Clip = true, ZIndex = 3, Parent = card })
	quest.Fill = UIKit.Card({ Name = "Fill", Top = Color3.fromRGB(150, 245, 100), Bottom = Color3.fromRGB(40, 176, 60), Size = UDim2.new(0, 0, 1, 0), Radius = 16,
		OutlineThickness = 0, ZIndex = 3, Parent = track })
	quest.Fill:FindFirstChildOfClass("UIStroke").Enabled = false
	UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.84, Size = UDim2.new(1, -10, 0, 7), Position = UDim2.fromOffset(5, 3), Radius = 8, ZIndex = 4, Parent = track })
	quest.Progress = UIKit.Text({ Name = "Progress", Text = "", TextSize = 15, Size = UDim2.fromScale(1, 1), StrokeThickness = 2, ZIndex = 5, Parent = track })
	local reward
	reward, quest.Reward = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "", TextSize = 17, IconSize = 26, Color = UIKit.C.Coins, StrokeThickness = 2.2,
		Size = UDim2.new(1, -120, 0, 28), Position = UDim2.fromOffset(12, 90), ZIndex = 3, Parent = card })
	quest.RewardRow = reward
	quest.Claim = UIKit.Button({ Name = "Claim", Text = "CLAIM!", Color = UIKit.C.Good, TextSize = 19, Size = UDim2.fromOffset(104, 32), Gloss = true,
		Position = UDim2.new(1, -10, 1, -8), AnchorPoint = Vector2.new(1, 1), Visible = false, ZIndex = 6, Parent = card,
		OnClick = function()
			HUD.ClaimQuest()
		end })
	-- the claim button gently pulses so a finished quest is impossible to miss
	task.spawn(function()
		local scale = UIKit.Scale(quest.Claim, 1)
		scale.Name = "Pulse"
		while quest.Card.Parent do
			if quest.Claim.Visible then
				UIKit.Tween(scale, 0.35, { Scale = 1.08 }, Enum.EasingStyle.Sine)
				task.wait(0.35)
				UIKit.Tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Sine)
				task.wait(0.35)
			else
				task.wait(0.4)
			end
		end
	end)
end

function HUD.ClaimQuest()
	local result = C.Remotes.Get("ClaimQuest"):InvokeServer()
	if result and result.Ok then
		C.Sfx.Play("Buy")
		C.Fx.Confetti(40)
		HUD.Toast("Quest reward: +" .. Format.Number(result.Reward) .. " 💵", "Success")
	elseif result then
		HUD.Toast(result.Msg or "Can't claim yet.", "Error")
	end
end

function HUD.RefreshQuest()
	local q = Store.State.Quest
	if not q or not quest.Card then
		return
	end
	quest.Number.Text = "QUEST #" .. tostring(q.Index or 1)
	quest.Text.Text = q.Text
	local fraction = q.Goal &gt; 0 and math.clamp(q.Progress / q.Goal, 0, 1) or 1
	UIKit.Tween(quest.Fill, 0.25, { Size = UDim2.new(fraction, 0, 1, 0) })
	quest.Fill.Visible = fraction &gt; 0.01
	quest.Progress.Text = q.Done and "COMPLETE!" or (Format.Number(q.Progress) .. " / " .. Format.Number(q.Goal))
	quest.Reward.Text = "+" .. Format.Number(q.Reward)
	quest.Claim.Visible = q.Done
	HUD.SetBadge("Quests", q.Done)
end

----------------------------------------------------------------------
-- Equipped pets strip
----------------------------------------------------------------------
local petStrip

function HUD.RefreshPets()
	if not petStrip then
		return
	end
	for _, child in ipairs(petStrip:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local inv = Store.Inventory
	for i = 1, inv.Slots do
		local uid = inv.Equipped[i]
		local pet = uid and Store.GetPet(uid)
		local def = pet and Config.PetsById[pet.id]
		local color = def and Config.Rarities[def.Rarity].Color or Color3.fromRGB(96, 100, 108)
		local chip = UIKit.Button({
			Name = "Slot" .. i, Text = "", Color = Color3.fromRGB(70, 74, 82), Size = UDim2.fromOffset(60, 60), LayoutOrder = i, Radius = 6,
			Silent = true, StrokeThickness = 3, Parent = petStrip,
			OnClick = function()
				C.TogglePanel("Pets")
			end,
		})
		IconLoader.Skin(chip, "Slot", { KeepRim = def ~= nil })
		local rim = chip:FindFirstChild("Rim")
		local rs = rim and rim:FindFirstChildOfClass("UIStroke")
		if rs then
			rs.Color = color
		end
		UIKit.Text({ Text = tostring(i), TextSize = 13, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(6, 3), Stroke = false, Color = Color3.fromRGB(230, 230, 230), ZIndex = 4, Parent = chip })
		if def then
			UIKit.Text({ Text = def.Emoji, TextSize = 28, Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 4), ZIndex = 3, Stroke = false, Parent = chip })
			UIKit.Text({ Text = Format.Mult(def.Mult), TextSize = 13, Color = color, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 40), ZIndex = 3, Parent = chip })
		end
	end
end

local function buildPetStrip(parent)
	petStrip = UIKit.Frame({
		Name = "PetStrip",
		Color = Color3.new(0, 0, 0),
		Transparency = 1,
		Size = UDim2.fromOffset(8 * 66, 64),
		Position = UDim2.new(0.5, 0, 1, -10),
		AnchorPoint = Vector2.new(0.5, 1),
		Parent = parent,
	})
	UIKit.List(petStrip, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
end

----------------------------------------------------------------------
-- Training controls
----------------------------------------------------------------------
local trainGroup
local workout = {}

-- called by TrainingController when a session starts / stops
function HUD.SetWorkout(station)
	if not workout.Card then
		return
	end
	if not station then
		workout.Reps.Text = "0"
		return
	end
	local name = (Config.ExerciseNames and Config.ExerciseNames[station.Kind]) or station.Name
	workout.Name.Text = string.upper(name)
	workout.Gain.Text = "+" .. Format.Number(station.Strength) .. " Strength per rep"
	workout.Reps.Text = "0"
end

function HUD.SetReps(count)
	if workout.Reps then
		workout.Reps.Text = Format.Commas(count)
		UIKit.Bump(workout.Reps.Parent, 1.12)
	end
end

function HUD.SetIntensity(level)
	if workout.Heat then
		workout.Heat.Size = UDim2.fromScale(math.clamp(level, 0, 1), 1)
		workout.Heat.BackgroundColor3 = Color3.fromRGB(120, 220, 255):Lerp(Color3.fromRGB(255, 90, 60), math.clamp(level, 0, 1))
	end
end

local function buildTrainControls(parent)
	trainGroup = UIKit.Frame({
		Name = "TrainControls",
		Color = Color3.new(0, 0, 0),
		Transparency = 1,
		Size = UDim2.fromOffset(420, 100),
		Position = UDim2.new(0.5, 0, 1, -62),
		AnchorPoint = Vector2.new(0.5, 1),
		Visible = false,
		Parent = parent,
	})
	HUD.TrainButton = UIKit.Button({
		Name = "Train", Text = "💪 TRAIN!", Color = UIKit.C.Strength, TextSize = 30, Size = UDim2.fromOffset(222, 70),
		Position = UDim2.fromScale(0.5, 0), AnchorPoint = Vector2.new(0.5, 0), Radius = 12, Silent = true, Parent = trainGroup,
	})
	IconLoader.Skin(HUD.TrainButton, "Train", { Text = true, TextSize = 32 })
	HUD.StopButton = UIKit.Button({
		Name = "Stop", Text = "✋ Stop", Color = UIKit.C.Bad, TextSize = 20, Size = UDim2.fromOffset(120, 50),
		Position = UDim2.new(0.5, -124, 0, 10), AnchorPoint = Vector2.new(1, 0), Parent = trainGroup,
	})
	IconLoader.Skin(HUD.StopButton, "Stop")
	-- Auto Clicker (donation-shop perk): right of the TRAIN button
	HUD.AutoClickButton = UIKit.Button({
		Name = "AutoClick", Text = "AUTO\nCLICK", Color = Color3.fromRGB(150, 92, 255), TextSize = 16, Size = UDim2.fromOffset(120, 50), Wrap = true, Gloss = true,
		Position = UDim2.new(0.5, 124, 0, 10), AnchorPoint = Vector2.new(0, 0), Radius = 10, Tooltip = "Auto Clicker (Shop)", Parent = trainGroup,
	})
	HUD.AutoClickLock = UIKit.Text({ Name = "Lock", Text = "🔒", TextSize = 18, Stroke = false, Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, 4, 0, -8),
		AnchorPoint = Vector2.new(1, 0), ZIndex = 4, Parent = HUD.AutoClickButton })

	-- workout card: which exercise you're doing, your reps this set and how hard you're going
	local card = UIKit.Card({ Name = "Workout", Top = Color3.fromRGB(255, 176, 52), Bottom = Color3.fromRGB(236, 112, 24), Size = UDim2.fromOffset(330, 50),
		Position = UDim2.new(0.5, 0, 0, -12), AnchorPoint = Vector2.new(0.5, 1), Radius = 16, OutlineThickness = 3, Rim = Color3.fromRGB(255, 226, 130),
		Shine = true, Parent = trainGroup })
	workout.Card = card
	UIKit.Icon({ Icon = "Strength", Emoji = "💪", Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 2, Parent = card })
	workout.Name = UIKit.Text({ Name = "Exercise", Text = "", TextSize = 19, Size = UDim2.new(1, -150, 0, 26), Position = UDim2.fromOffset(50, 3),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.4, ZIndex = 2, Parent = card })
	workout.Gain = UIKit.Text({ Name = "Gain", Text = "", TextSize = 14, Color = Color3.fromRGB(255, 244, 214), Size = UDim2.new(1, -150, 0, 18), Position = UDim2.fromOffset(50, 27),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.6, ZIndex = 2, Parent = card })
	workout.Gain.TextTruncate = Enum.TextTruncate.AtEnd
	local reps = UIKit.Card({ Name = "Reps", Top = Color3.fromRGB(40, 30, 70), Bottom = Color3.fromRGB(20, 14, 40), Size = UDim2.fromOffset(88, 40),
		Position = UDim2.new(1, -6, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Radius = 12, OutlineThickness = 2, ZIndex = 2, Parent = card })
	UIKit.Text({ Text = "REPS", TextSize = 11, Color = Color3.fromRGB(255, 206, 120), Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 3), StrokeThickness = 1.2, ZIndex = 3, Parent = reps })
	workout.Reps = UIKit.Text({ Text = "0", TextSize = 20, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 15), StrokeThickness = 2, ZIndex = 3, Parent = reps })
	-- intensity: fills up while you keep repping (same "heat" that drives the sweaty aura)
	local heat = UIKit.Frame({ Name = "Intensity", Color = Color3.fromRGB(60, 24, 10), Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0.5, 0, 1, 4),
		AnchorPoint = Vector2.new(0.5, 0), Radius = 6, Stroke = UIKit.C.Outline, StrokeThickness = 2, ZIndex = 2, Parent = card })
	workout.Heat = UIKit.Frame({ Name = "Fill", Color = Color3.fromRGB(120, 220, 255), Size = UDim2.fromScale(0, 1), Radius = 6, ZIndex = 3, Parent = heat })
	UIKit.Text({
		Name = "Hint", Text = "Click or tap to train — one rep per click", TextSize = 16, Color = UIKit.C.Muted,
		Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 72), Parent = trainGroup,
	})
end

function HUD.SetTrainingVisible(visible)
	if trainGroup then
		trainGroup.Visible = visible
		if visible then
			HUD.RefreshAuto()
		end
	end
end

-- on = auto clicker running, owned = has the perk
function HUD.SetAutoClick(on, owned)
	local b = HUD.AutoClickButton
	if not b then
		return
	end
	b.Text = owned and (on and "AUTO: ON" or "AUTO: OFF") or "AUTO\nCLICK"
	UIKit.SetButtonColor(b, on and Color3.fromRGB(56, 190, 88) or Color3.fromRGB(150, 92, 255))
	HUD.AutoClickLock.Visible = not owned
end

function HUD.RefreshAuto()
	-- (the old Auto Trainer upgrade was removed - the Auto Clicker replaces it)
end

----------------------------------------------------------------------
-- Side buttons (sound)
----------------------------------------------------------------------
local function buildSideButtons(parent)
	local mute
	mute = UIKit.Button({
		Name = "Mute", Text = "🔊", Color = Color3.fromRGB(90, 96, 112), TextSize = 28, Size = UDim2.fromOffset(56, 52), Radius = 8,
		Position = UDim2.new(1, -12, 1, -12), AnchorPoint = Vector2.new(1, 1), Parent = parent,
		OnClick = function()
			C.Sfx.Muted = not C.Sfx.Muted
			mute.Text = C.Sfx.Muted and "🔇" or "🔊"
			local skin = mute:FindFirstChild("Skin")
			if skin then
				skin.ImageColor3 = C.Sfx.Muted and Color3.fromRGB(110, 110, 110) or Color3.new(1, 1, 1)
				skin.ImageTransparency = C.Sfx.Muted and 0.25 or 0
			end
		end,
	})
	mute.Size = UDim2.fromOffset(60, 58)
	IconLoader.Skin(mute, "Sound")
end

----------------------------------------------------------------------
-- Toasts
----------------------------------------------------------------------
local TOAST_COLORS = {
	Info = Color3.fromRGB(64, 148, 255),
	Success = Color3.fromRGB(64, 200, 104),
	Error = Color3.fromRGB(240, 82, 92),
}

function HUD.Toast(text, kind, color, duration)
	if not toastList then
		return
	end
	local accent = color or TOAST_COLORS[kind or "Info"] or TOAST_COLORS.Info
	while #toasts &gt;= 4 do
		local old = table.remove(toasts, 1)
		old:Destroy()
	end
	local toast = UIKit.Frame({
		Name = "Toast", Color = UIKit.Shade(accent, 0.4), Size = UDim2.fromOffset(460, 42), Radius = 14,
		Stroke = accent, StrokeThickness = 3, Parent = toastList,
	})
	UIKit.Text({ Text = text, TextSize = 18, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Wrap = true, Parent = toast })
	local scale = UIKit.Scale(toast, 0.6)
	UIKit.Tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	toasts[#toasts + 1] = toast
	task.delay(duration or 3.2, function()
		if toast.Parent then
			UIKit.Tween(scale, 0.2, { Scale = 0 })
			task.delay(0.22, function()
				local i = table.find(toasts, toast)
				if i then
					table.remove(toasts, i)
				end
				toast:Destroy()
			end)
		end
	end)
end

local function buildToastList(parent)
	toastList = UIKit.Frame({
		Name = "Toasts", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(470, 200),
		Position = UDim2.new(0.5, 0, 0, 92), AnchorPoint = Vector2.new(0.5, 0), Parent = parent,
	})
	UIKit.List(toastList, 6, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function HUD.Init(client)
	C = client
	UIKit, Store, Format, Formulas, Config = C.UIKit, C.Store, C.Format, C.Formulas, C.Config
	local hudRoot = UIKit.Frame({ Name = "HUD", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = C.Root })
	buildPills(hudRoot)
	buildGateBar(hudRoot)
	buildToastList(hudRoot)
	buildQuestCard(hudRoot)
	-- (no equipped-pet strip at the bottom: pets are equipped in the Pets menu itself)
	buildTrainControls(hudRoot)
	buildMenu(hudRoot)
	buildSideButtons(hudRoot)

	-- warning when the game cannot save (Studio without API access / unpublished place)
	local warn = UIKit.Frame({
		Name = "NoSaveWarning", Color = Color3.fromRGB(200, 40, 40), Size = UDim2.fromOffset(640, 34), Position = UDim2.new(0.5, 0, 0, 84),
		AnchorPoint = Vector2.new(0.5, 0), Radius = 8, Stroke = Color3.new(0, 0, 0), StrokeThickness = 3, Visible = false, ZIndex = 30, Parent = hudRoot,
	})
	UIKit.Text({ Text = "⚠️ Progress is NOT being saved - publish the place &amp; enable Studio API Access", TextSize = 17, ZIndex = 31, Parent = warn })
	Store.Watch("NoSave", function(value)
		warn.Visible = value == true or value == 1
	end)

	RunService.RenderStepped:Connect(function(dt)
		updateCounters(dt)
		if trainGroup and trainGroup.Visible and C.SweatAura and C.SweatAura.GetHeat then
			HUD.SetIntensity(C.SweatAura.GetHeat())
		end
	end)
	Store.Watch("Strength", function()
		HUD.RefreshGateBar()
	end)
	Store.Watch("Rebirths", function()
		HUD.RefreshGateBar()
		HUD.RefreshInfo()
	end)
	Store.Watch("StrengthMult", HUD.RefreshInfo)
	Store.StateChanged:Connect(function()
		HUD.RefreshGateBar()
		HUD.RefreshQuest()
		HUD.RefreshAuto()
	end)
	Store.InventoryChanged:Connect(function()
		HUD.RefreshPets()
	end)
	Store.TrainingChanged:Connect(function(stationId)
		HUD.SetTrainingVisible(stationId ~= nil)
	end)
	HUD.RefreshGateBar()
	HUD.RefreshPets()
	HUD.RefreshQuest()
end

return HUD
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX32">
          <Properties>
            <string name="Name">LightingController</string>
            <ProtectedString name="Source">--[[
	LightingController - each gym has its own mood (sky time, ambient colour, fog).
	Checks which gym you are standing in and blends the lighting to match.
]]
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LightingController = {}

local C
local currentArea = nil

local function apply(area, instant)
	local theme = area.Theme
	local goal = {
		Ambient = theme.Ambient,
		OutdoorAmbient = theme.Ambient,
		ClockTime = theme.Clock,
		Brightness = theme.Brightness,
		FogColor = theme.Fog,
		FogEnd = theme.FogEnd,
		FogStart = 0,
	}
	if instant then
		for k, v in pairs(goal) do
			Lighting[k] = v
		end
	else
		TweenService:Create(Lighting, TweenInfo.new(2, Enum.EasingStyle.Sine), goal):Play()
	end
end

function LightingController.Init(client)
	C = client
	Lighting.GlobalShadows = true

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 28
	bloom.Threshold = 1.1
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.12
	color.Contrast = 0.06
	color.Parent = Lighting

	apply(C.Config.Areas[1], true)
	currentArea = 1
	task.spawn(function()
		while true do
			task.wait(0.4)
			local pos = C.Fx.CharacterPosition()
			if pos then
				local index = C.Config.AreaAt(pos)
				if index and index ~= currentArea then
					currentArea = index
					local area = C.Config.Areas[index]
					apply(area, false)
					C.Fx.Banner(area.Icon .. " " .. area.Name, nil, area.Theme.Accent, 1.8)
				end
			end
		end
	end)
end

return LightingController
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX33">
          <Properties>
            <string name="Name">PanelAreas</string>
            <ProtectedString name="Source">--[[
	PanelAreas - gym progression: every gym on one path, top to bottom.
	  * a node + line connects the gyms (lit up once unlocked)
	  * each card uses its gym's colours and shows the best machine's gains
	  * open gyms: TELEPORT (your current gym says YOU ARE HERE)
	  * the next gym: a live progress bar towards its Strength requirement
	  * later gyms: locked and dimmed
	Teleporting is validated by the server (TeleportArea -&gt; AreaService.Teleport).
]]
local Players = game:GetService("Players")

local PanelAreas = {}

local C, UIKit, Store, Config, Format, Remotes
local panel
local rows = {}

local CYAN_TOP, CYAN_BOTTOM = Color3.fromRGB(70, 220, 252), Color3.fromRGB(22, 150, 226)
local LOCKED_TOP, LOCKED_BOTTOM = Color3.fromRGB(58, 64, 88), Color3.fromRGB(36, 40, 60)

local function bestStation(area)
	local best
	for _, id in ipairs(area.StationIds) do
		local s = Config.StationsById[id]
		if not best or s.Strength &gt; best.Strength then
			best = s
		end
	end
	return best
end

local function teleport(area)
	local result = Remotes.Get("TeleportArea"):InvokeServer(area.Id)
	if result and result.Ok then
		C.Sfx.Play("Gate", 1.4, 0.6)
		C.Fx.Flash(Color3.new(1, 1, 1), 0.3, 0.6)
		panel.Close()
	else
		C.Sfx.Play("Error")
		C.HUD.Toast(result and result.Msg or "Can't teleport.", "Error")
	end
end

local function refresh()
	local strength = Store.Attr("Strength")
	local here = Players.LocalPlayer:GetAttribute("CurrentGym")
	local nextShown = false
	for i, area in ipairs(Config.Areas) do
		local row = rows[area.Id]
		local open = Store.AreaUnlocked(area.Id)
		local isNext = not open and not nextShown
		if isNext then
			nextShown = true
		end
		local accent = area.Theme.Accent
		local grad = row.Card:FindFirstChildOfClass("UIGradient")
		grad.Color = open and ColorSequence.new(UIKit.Shade(accent, 1.1), UIKit.Shade(accent, 0.62))
			or ColorSequence.new(LOCKED_TOP, LOCKED_BOTTOM)
		row.NodeGrad.Color = open and ColorSequence.new(UIKit.Shade(accent, 1.2), UIKit.Shade(accent, 0.7)) or ColorSequence.new(LOCKED_TOP, LOCKED_BOTTOM)
		row.Emoji.TextTransparency = open and 0 or 0.45
		row.Line.BackgroundColor3 = open and UIKit.Shade(accent, 0.95) or Color3.fromRGB(46, 52, 74)
		row.Teleport.Visible = open and area.Name ~= here
		row.Here.Visible = open and area.Name == here
		row.BarHolder.Visible = isNext
		row.Locked.Visible = not open and not isNext
		row.Name.TextTransparency = open and 0 or 0.25
		if isNext then
			local fraction = area.Required &gt; 0 and math.clamp(strength / area.Required, 0, 1) or 1
			row.Fill.Size = UDim2.new(fraction, 0, 1, 0)
			row.Fill.Visible = fraction &gt; 0.01
			row.BarText.Text = Format.Number(strength) .. " / " .. Format.Number(area.Required)
			row.Status.Text = strength &gt;= area.Required and "READY! Push the gate" or "NEXT GYM"
			row.Status.TextColor3 = strength &gt;= area.Required and Color3.fromRGB(150, 255, 130) or UIKit.C.Gold
		elseif open then
			row.Status.Text = "UNLOCKED"
			row.Status.TextColor3 = Color3.fromRGB(190, 255, 190)
		else
			row.Status.Text = "LOCKED"
			row.Status.TextColor3 = UIKit.C.Muted
		end
	end
end

local function buildRow(list, i, area)
	local accent = area.Theme.Accent
	local rowFrame = UIKit.Frame({ Name = area.Id, Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -8, 0, 92), LayoutOrder = i, ZIndex = 23, Parent = list })
	-- path: a vertical line through the node
	local line = UIKit.Frame({ Name = "Line", Color = accent, Size = UDim2.new(0, 8, 1, 10), Position = UDim2.new(0, 38, 0, i == 1 and 46 or -5),
		ZIndex = 23, Parent = rowFrame })
	if i == 1 then
		line.Size = UDim2.new(0, 8, 0.5, 10)
	elseif i == #Config.Areas then
		line.Size = UDim2.new(0, 8, 0.5, 5)
	end
	local node = UIKit.Card({ Name = "Node", Size = UDim2.fromOffset(62, 62), Position = UDim2.new(0, 42, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), Radius = 70,
		Rim = Color3.new(1, 1, 1), ZIndex = 24, Parent = rowFrame })
	node:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	node:FindFirstChild("Rim"):FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	node:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.5
	local emoji = UIKit.Text({ Text = area.Icon, TextSize = 30, Size = UDim2.fromScale(1, 1), Stroke = false, ZIndex = 25, Parent = node })
	local number = UIKit.Chip({ Name = "Index", Text = tostring(i), Color = UIKit.C.Outline, Size = UDim2.fromOffset(24, 20), TextSize = 13, Position = UDim2.new(1, 4, 1, 2),
		AnchorPoint = Vector2.new(1, 1), ZIndex = 26, Parent = node })
	number.Name = "Index"

	local card = UIKit.Card({ Name = "Card", Size = UDim2.new(1, -86, 1, -8), Position = UDim2.fromOffset(84, 4), Radius = 16, Rim = Color3.fromRGB(255, 255, 255),
		ZIndex = 24, Parent = rowFrame })
	card:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.6
	local name = UIKit.Text({ Name = "GymName", Text = area.Name, TextSize = 24, Size = UDim2.new(1, -170, 0, 30), Position = UDim2.fromOffset(14, 8),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.8, ZIndex = 25, Parent = card })
	local status = UIKit.Text({ Name = "Status", Text = "", TextSize = 14, Size = UDim2.new(0, 180, 0, 18), Position = UDim2.fromOffset(14, 36),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.8, ZIndex = 25, Parent = card })
	local best = bestStation(area)
	UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "up to +" .. Format.Number(best.Strength) .. " per rep", TextSize = 15, IconSize = 22,
		StrokeThickness = 1.8, Size = UDim2.new(0, 250, 0, 24), Position = UDim2.fromOffset(12, 56), ZIndex = 25, Parent = card })

	local teleportButton = UIKit.Button({ Name = "Teleport", Text = "TELEPORT", Color = UIKit.C.Good, TextSize = 19, Size = UDim2.fromOffset(136, 44), Gloss = true,
		Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 26, Parent = card, OnClick = function() teleport(area) end })
	local here = UIKit.Chip({ Name = "Here", Text = "YOU ARE HERE", Color = Color3.fromRGB(255, 196, 40), TextColor = Color3.new(1, 1, 1), TextSize = 14,
		Size = UDim2.fromOffset(136, 30), Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 26, Parent = card })

	-- progress towards the next gym
	local barHolder = UIKit.Frame({ Name = "Progress", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(0, 230, 0, 52),
		Position = UDim2.new(1, -12, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 25, Parent = card })
	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(14, 18, 40), Bottom = Color3.fromRGB(8, 10, 26), Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 22),
		Radius = 18, OutlineThickness = 2, Clip = true, ZIndex = 26, Parent = barHolder })
	local fill = UIKit.Card({ Name = "Fill", Top = UIKit.Shade(accent, 1.3), Bottom = UIKit.Shade(accent, 0.85), Size = UDim2.new(0, 0, 1, 0), Radius = 18,
		OutlineThickness = 0, ZIndex = 26, Parent = track })
	fill:FindFirstChildOfClass("UIStroke").Enabled = false
	local _, barText = UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "", TextSize = 15, IconSize = 20, Align = "Center", StrokeThickness = 2,
		Size = UDim2.fromScale(1, 1), ZIndex = 27, Parent = track })
	UIKit.Text({ Text = "Strength needed", TextSize = 13, Color = UIKit.C.Muted, Size = UDim2.new(1, 0, 0, 18), StrokeThickness = 1.4, ZIndex = 26, Parent = barHolder })

	local locked = UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "🔒 " .. Format.Number(area.Required), TextSize = 18, IconSize = 24, Align = "Right",
		StrokeThickness = 2.2, Size = UDim2.new(0, 200, 0, 30), Position = UDim2.new(1, -14, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 26, Parent = card })

	rows[area.Id] = {
		Card = card, NodeGrad = node:FindFirstChildOfClass("UIGradient"), Emoji = emoji, Line = line, Name = name, Status = status,
		Teleport = teleportButton, Here = here, BarHolder = barHolder, Fill = fill, BarText = barText, Locked = locked,
	}
end

function PanelAreas.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes = C.UIKit, C.Store, C.Config, C.Format, C.Remotes
	panel = UIKit.GoldPanel(C.Root, "Areas", "GYMS", Vector2.new(680, 560), { Icon = "GymMap", Emoji = "🗺️", NoScroll = true })
	local list = UIKit.Scroll(panel.Body, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -12, 1, -16), Name = "List" })
	UIKit.List(list, 0)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.Parent = list
	for i, area in ipairs(Config.Areas) do
		buildRow(list, i, area)
	end
	Store.StateChanged:Connect(refresh)
	Store.Watch("Strength", function()
		if panel.IsOpen then
			refresh()
		end
	end)
	Players.LocalPlayer:GetAttributeChangedSignal("CurrentGym"):Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	panel.OnOpen = refresh
	refresh()
end

return PanelAreas
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX34">
          <Properties>
            <string name="Name">PanelEgg</string>
            <ProtectedString name="Source">--[[
	PanelEgg - opens when you press E at a Lucky Block (eggs are shown as Lucky Blocks).
	Shows the exact drop odds (with your Luck), the price, and the Open x1 / x3 buttons.
	The opening animation always plays the pets the SERVER rolled - the client never
	decides what you get.
]]
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local PanelEgg = {}

local C, UIKit, Store, Config, Format, Remotes, Formulas

local panel
local currentEgg = nil
local busy = false
local titleLabel, subtitleLabel, oddsHolder, hatch1, hatch3, eggIcon
local overlay

----------------------------------------------------------------------
-- Odds list
----------------------------------------------------------------------
local function renderOdds()
	for _, child in ipairs(oddsHolder:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	if not currentEgg then
		return
	end
	local chances = Formulas.PetChances(currentEgg, Store.Luck())
	for i = #chances, 1, -1 do -- rarest first
		local entry = chances[i]
		local pet = entry.Pet
		local rarity = Config.Rarities[pet.Rarity]
		local row = UIKit.Frame({
			Color = UIKit.Shade(rarity.Color, 0.32), Size = UDim2.new(1, -6, 0, 40), LayoutOrder = #chances - i, Radius = 10,
			Stroke = rarity.Color, StrokeThickness = 2, ZIndex = 23, Parent = oddsHolder,
		})
		UIKit.Text({ Text = pet.Emoji, TextSize = 26, Size = UDim2.fromOffset(40, 40), ZIndex = 24, Parent = row })
		UIKit.Text({ Text = pet.Name, TextSize = 17, Size = UDim2.new(0, 150, 1, 0), Position = UDim2.fromOffset(42, 0), XAlign = Enum.TextXAlignment.Left, ZIndex = 24, Parent = row })
		UIKit.Text({ Text = rarity.Label, TextSize = 11, Font = Enum.Font.GothamBold, Color = rarity.Color, Size = UDim2.new(0, 80, 1, 0), Position = UDim2.fromOffset(190, 0), ZIndex = 24, Parent = row })
		UIKit.Text({ Text = Format.Mult(pet.Mult), TextSize = 16, Color = UIKit.C.Mult, Size = UDim2.new(0, 70, 1, 0), Position = UDim2.fromOffset(272, 0), ZIndex = 24, Parent = row })
		local pct = entry.Chance
		local text = pct &gt;= 1 and string.format("%.1f%%", pct) or string.format("%.2f%%", pct)
		UIKit.Text({ Text = text, TextSize = 17, Size = UDim2.new(0, 80, 1, 0), Position = UDim2.new(1, -86, 0, 0), XAlign = Enum.TextXAlignment.Right, ZIndex = 24, Parent = row })
	end
end

local function refreshButtons()
	if not currentEgg then
		return
	end
	local coins = Store.Attr("Coins")
	local tripleOwned = Store.UpgradeLevel("MultiHatch") &gt;= 1
	hatch1.Text = "Open x1\n💵 " .. Format.Number(currentEgg.Price)
	UIKit.SetDisabled(hatch1, busy or coins &lt; currentEgg.Price, Color3.fromRGB(110, 96, 100))
	if tripleOwned then
		hatch3.Text = "Open x3\n💵 " .. Format.Number(currentEgg.Price * 3)
		UIKit.SetDisabled(hatch3, busy or coins &lt; currentEgg.Price * 3, Color3.fromRGB(110, 96, 100))
	else
		hatch3.Text = "🔒 Open x3\nBuy in Shop"
		UIKit.SetDisabled(hatch3, true, Color3.fromRGB(96, 100, 128))
	end
end

----------------------------------------------------------------------
-- Hatch animation
----------------------------------------------------------------------
local function closeOverlay()
	if overlay then
		overlay:Destroy()
		overlay = nil
	end
	busy = false
	refreshButtons()
end

local function revealCard(holder, result, isNew, index, count)
	local def = Config.PetsById[result.PetId]
	local rarity = Config.Rarities[def.Rarity]
	local order = rarity.Order
	local card = UIKit.Frame({
		Color = UIKit.Shade(rarity.Color, 0.3), Size = UDim2.fromOffset(200, 250), Radius = 20, Stroke = rarity.Color, StrokeThickness = 5,
		ZIndex = 55, LayoutOrder = index, Parent = holder,
	})
	UIKit.Gradient(card, Color3.new(1, 1, 1), UIKit.Shade(Color3.new(1, 1, 1), 0.6), 90)
	local icon = UIKit.Frame({ Color = UIKit.Shade(rarity.Color, 0.55), Size = UDim2.new(1, -20, 0, 130), Position = UDim2.fromOffset(10, 10), Radius = 14, ZIndex = 56, Parent = card })
	C.PetVisuals.Icon(icon, def, UDim2.fromScale(1, 1), 57)
	UIKit.Text({ Text = def.Name, TextSize = 22, Size = UDim2.new(1, -10, 0, 28), Position = UDim2.fromOffset(5, 146), ZIndex = 56, Parent = card })
	UIKit.Text({ Text = rarity.Label, TextSize = 18, Color = rarity.Color, Size = UDim2.new(1, -10, 0, 22), Position = UDim2.fromOffset(5, 174), ZIndex = 56, Parent = card })
	UIKit.Text({ Text = Format.Mult(def.Mult) .. " Strength", TextSize = 20, Color = UIKit.C.Mult, Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 198), ZIndex = 56, Parent = card })
	if isNew then
		local tag = UIKit.Frame({ Color = UIKit.C.Bad, Size = UDim2.fromOffset(58, 26), Position = UDim2.new(1, 6, 0, -8), AnchorPoint = Vector2.new(1, 0), Radius = 8, Stroke = Color3.new(1, 1, 1), StrokeThickness = 2, ZIndex = 60, Parent = card })
		tag.Rotation = 10
		UIKit.Text({ Text = "NEW!", TextSize = 16, ZIndex = 61, Parent = tag })
	end
	local scale = UIKit.Scale(card, 0.1)
	UIKit.Tween(scale, 0.42, { Scale = 1 }, Enum.EasingStyle.Back)

	-- escalating effects
	C.Sfx.Play(order &gt;= 4 and "RareReveal" or "Reveal", 0.9 + order * 0.06)
	local pos = C.Fx.CharacterPosition()
	if order &gt;= 3 then
		C.Fx.Flash(rarity.Color, 0.8 - order * 0.05, 0.4)
	end
	if order &gt;= 4 then
		C.Fx.Confetti(20 + order * 10)
	end
	if order &gt;= 5 then
		C.Fx.Shake(0.4 + order * 0.08, 0.5)
		C.Fx.FovPunch(8, 0.4)
		if pos then
			C.Fx.Ring(pos - Vector3.new(0, 2.8, 0), rarity.Color, 50, 0.9)
		end
	end
	if order &gt;= 6 then
		C.Fx.Banner(rarity.Label .. "!! " .. def.Emoji, def.Name .. "  " .. Format.Mult(def.Mult), rarity.Color, 3.2)
	end
	if rarity.Rainbow then
		task.spawn(function()
			local h = 0
			local stroke = card:FindFirstChildOfClass("UIStroke")
			while card.Parent and stroke do
				h = (h + 0.02) % 1
				stroke.Color = Color3.fromHSV(h, 0.8, 1)
				task.wait(0.03)
			end
		end)
	end
end

-- a 2D Lucky Block: golden cube with a big "?"
local function luckyBlockIcon(parent)
	local block = UIKit.Frame({
		Name = "LuckyBlock", Color = Color3.fromRGB(255, 196, 28), Size = UDim2.fromOffset(150, 150), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), Radius = 16, Stroke = Color3.fromRGB(150, 84, 6), StrokeThickness = 6, ZIndex = 55, Parent = parent,
	})
	UIKit.Gradient(block, Color3.fromRGB(255, 230, 120), Color3.fromRGB(240, 160, 20), 90)
	local inner = UIKit.Frame({
		Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -30, 1, -30), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), Radius = 10, Stroke = Color3.fromRGB(200, 120, 12), StrokeThickness = 4, ZIndex = 56, Parent = block,
	})
	UIKit.Text({ Text = "?", TextSize = 110, Font = Enum.Font.GothamBlack, StrokeColor = Color3.fromRGB(120, 64, 0), StrokeThickness = 5, ZIndex = 57, Parent = inner })
	return block
end

local function playHatch(results, owned)
	overlay = UIKit.Frame({ Name = "HatchOverlay", Color = Color3.fromRGB(8, 10, 24), Transparency = 0.25, Size = UDim2.fromScale(1, 1), ZIndex = 50, Parent = C.Root })
	local blocker = Instance.new("TextButton")
	blocker.Size = UDim2.fromScale(1, 1)
	blocker.BackgroundTransparency = 1
	blocker.Text = ""
	blocker.ZIndex = 51
	blocker.Parent = overlay

	local count = #results
	local holder = UIKit.Frame({ Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(count * 220, 260), Position = UDim2.fromScale(0.5, 0.48), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 54, Parent = overlay })
	UIKit.List(holder, 16, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local eggs = {}
	for i = 1, count do
		local slot = UIKit.Frame({ Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(200, 250), LayoutOrder = i, ZIndex = 54, Parent = holder })
		eggs[i] = { Slot = slot, Egg = luckyBlockIcon(slot) }
	end

	local finished = false
	local skipped = false
	blocker.Activated:Connect(function()
		if finished then
			closeOverlay()
		else
			skipped = true
		end
	end)

	-- shake phase
	local shakes = 9
	for k = 1, shakes do
		if skipped then
			break
		end
		local strength = 6 + k * 3
		for _, e in ipairs(eggs) do
			e.Egg.Rotation = (k % 2 == 0 and 1 or -1) * strength
			UIKit.Tween(e.Egg, 0.08, { Rotation = (k % 2 == 0 and -1 or 1) * strength }, Enum.EasingStyle.Sine)
		end
		C.Sfx.Play("Shake", 0.8 + k * 0.08)
		task.wait(0.14)
	end
	-- the blocks swell up and burst open
	if not skipped then
		for _, e in ipairs(eggs) do
			UIKit.Tween(e.Egg, 0.12, { Size = UDim2.fromOffset(190, 190), Rotation = 0 }, Enum.EasingStyle.Back)
		end
		task.wait(0.12)
	end
	C.Fx.Flash(Color3.new(1, 1, 1), 0.2, 0.5)
	C.Fx.Shake(0.5, 0.25)

	for i, e in ipairs(eggs) do
		e.Egg:Destroy()
		local isNew = not owned[results[i].PetId]
		revealCard(e.Slot, results[i], isNew, i, count)
		owned[results[i].PetId] = true
		if not skipped then
			task.wait(count &gt; 1 and 0.35 or 0.1)
		end
	end
	finished = true
	UIKit.Text({ Text = "Tap anywhere to continue", TextSize = 22, Color = UIKit.C.Muted, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.5, 170), ZIndex = 55, Parent = overlay })
end

local function doHatch(count)
	if busy or not currentEgg then
		return
	end
	busy = true
	refreshButtons()
	local owned = {}
	for _, p in ipairs(Store.Inventory.Pets) do
		owned[p.id] = true
	end
	local result = Remotes.Get("HatchEgg"):InvokeServer(currentEgg.Id, count)
	if not result or not result.Ok then
		busy = false
		refreshButtons()
		C.Sfx.Play("Error")
		C.HUD.Toast(result and result.Msg or "Couldn't open the Lucky Block.", "Error")
		return
	end
	task.spawn(playHatch, result.Results, owned)
end

----------------------------------------------------------------------
-- Opening
----------------------------------------------------------------------
local function findEggModel(eggId)
	for _, model in ipairs(CollectionService:GetTagged("GymEgg")) do
		if model:GetAttribute("EggId") == eggId then
			return model
		end
	end
end

function PanelEgg.Open(eggId)
	local egg = Config.EggsById[eggId]
	if not egg then
		return
	end
	currentEgg = egg
	local area = Config.AreasById[egg.Area]
	titleLabel.Text = egg.Name
	subtitleLabel.Text = area.Icon .. " " .. area.Name .. "  •  Luck x" .. string.format("%.2f", Store.Luck())
	renderOdds()
	refreshButtons()
	panel.Open()
end

function PanelEgg.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes, Formulas = C.UIKit, C.Store, C.Config, C.Format, C.Remotes, C.Formulas
	panel = UIKit.Panel(C.Root, "Egg", "❓ Lucky Block", Vector2.new(560, 560), Color3.fromRGB(255, 176, 46))
	local body = panel.Body

	titleLabel = UIKit.Text({ Text = "", TextSize = 28, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 6), ZIndex = 22, Parent = body })
	subtitleLabel = UIKit.Text({ Text = "", TextSize = 16, Color = UIKit.C.Muted, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 40), ZIndex = 22, Parent = body })
	oddsHolder = UIKit.Scroll(body, { Position = UDim2.fromOffset(8, 70), Size = UDim2.new(1, -16, 1, -150), Name = "Odds" })
	UIKit.List(oddsHolder, 5)
	hatch1 = UIKit.Button({
		Text = "Open x1", Color = UIKit.C.Good, TextSize = 22, Size = UDim2.new(0.5, -14, 0, 66), Position = UDim2.new(0, 8, 1, -8), AnchorPoint = Vector2.new(0, 1),
		ZIndex = 23, Parent = body, OnClick = function() doHatch(1) end,
	})
	hatch3 = UIKit.Button({
		Text = "Open x3", Color = UIKit.C.Orange, TextSize = 22, Size = UDim2.new(0.5, -14, 0, 66), Position = UDim2.new(1, -8, 1, -8), AnchorPoint = Vector2.new(1, 1),
		ZIndex = 23, Parent = body, OnClick = function() doHatch(3) end,
	})

	Remotes.Get("OpenEgg").OnClientEvent:Connect(function(eggId)
		PanelEgg.Open(eggId)
	end)
	Store.StateChanged:Connect(function()
		if panel.IsOpen then
			renderOdds()
			refreshButtons()
		end
	end)
	Store.Watch("Coins", function()
		if panel.IsOpen then
			refreshButtons()
		end
	end)
	-- close automatically when you walk away from the Lucky Block
	task.spawn(function()
		while true do
			task.wait(0.5)
			if panel.IsOpen and currentEgg and not busy then
				local model = findEggModel(currentEgg.Id)
				local prompt = model and model:FindFirstChild("Prompt")
				local pos = C.Fx.CharacterPosition()
				if prompt and pos and (prompt.Position - pos).Magnitude &gt; Config.Egg.Range - 2 then
					panel.Close()
				end
			end
		end
	end)
end

return PanelEgg
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX35">
          <Properties>
            <string name="Name">PanelEquip</string>
            <ProtectedString name="Source">--[[
	PanelEquip - the "new equipment" card. Opens when you press E at a machine you don't own:
	exercise type, tier, gains per rep, how it compares with your best machine, and BUY.
	The purchase itself is validated by the server (BuyEquipment remote).
]]
local PanelEquip = {}

local C, UIKit, Store, Config, Format, Remotes
local panel
local ui = {}
local currentId = nil

local ORANGE_TOP, ORANGE_BOTTOM = Color3.fromRGB(255, 184, 60), Color3.fromRGB(240, 116, 22)

local function bestOwned()
	local best
	for _, s in ipairs(Config.Stations) do
		if Store.OwnsStation(s.Id) and (not best or s.Strength &gt; best.Strength) then
			best = s
		end
	end
	return best
end

local function refresh()
	local station = currentId and Config.StationsById[currentId]
	if not station then
		return
	end
	local area = Config.AreasById[station.Area]
	ui.Name.Text = station.Name
	ui.Area.Text = area.Icon .. " " .. string.upper(area.Name)
	ui.Exercise.Text = string.upper((Config.ExerciseNames and Config.ExerciseNames[station.Kind]) or station.Kind)
	ui.Tier.Text = "TIER " .. station.Tier .. "  " .. string.rep("★", station.Tier) .. string.rep("☆", 3 - station.Tier)
	ui.Strength.Text = "+" .. Format.Number(station.Strength)
	ui.Coins.Text = "+" .. Format.Number(station.Coins)
	ui.Header:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(UIKit.Shade(area.Theme.Accent, 1.15), UIKit.Shade(area.Theme.Accent, 0.7))

	-- compare with the best machine you already own
	local best = bestOwned()
	if best then
		local ratio = station.Strength / math.max(best.Strength, 1e-9)
		local fraction = math.clamp(best.Strength / math.max(station.Strength, best.Strength), 0, 1)
		ui.BestFill.Size = UDim2.new(fraction, 0, 1, 0)
		ui.NewFill.Size = UDim2.new(math.clamp(station.Strength / math.max(station.Strength, best.Strength), 0, 1), 0, 1, 0)
		ui.BestLabel.Text = "Your best: " .. best.Name .. "  (+" .. Format.Number(best.Strength) .. ")"
		if ratio &gt; 1.001 then
			ui.Verdict.Text = Format.Mult(ratio) .. " STRONGER!"
			ui.Verdict.TextColor3 = Color3.fromRGB(140, 255, 120)
		else
			ui.Verdict.Text = "not an upgrade"
			ui.Verdict.TextColor3 = UIKit.C.Muted
		end
		ui.Compare.Visible = true
	else
		ui.Compare.Visible = false
	end

	local coins = Store.Attr("Coins")
	if coins &gt;= station.Price then
		ui.Buy.Text = "BUY " .. Format.Number(station.Price)
		UIKit.SetDisabled(ui.Buy, false)
	else
		ui.Buy.Text = "NEED " .. Format.Number(station.Price - coins) .. " MORE"
		UIKit.SetDisabled(ui.Buy, true, Color3.fromRGB(110, 96, 100))
	end
end

local function gainTile(parent, x, icon, emoji, label, color)
	local tile = UIKit.Card({ Name = label, Top = Color3.fromRGB(38, 54, 104), Bottom = Color3.fromRGB(22, 30, 64), Size = UDim2.new(0.5, -18, 0, 72),
		Position = UDim2.new(x, x == 0 and 12 or 6, 0, 108), Radius = 16, OutlineThickness = 2, ZIndex = 23, Parent = parent })
	UIKit.Icon({ Icon = icon, Emoji = emoji, Size = UDim2.fromOffset(50, 50), Position = UDim2.new(0, 10, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 24, Parent = tile })
	local value = UIKit.Text({ Text = "", TextSize = 28, Color = color, Size = UDim2.new(1, -74, 0, 34), Position = UDim2.fromOffset(66, 8), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 3, ZIndex = 24, Parent = tile })
	UIKit.Text({ Text = label, TextSize = 14, Color = UIKit.C.Muted, Size = UDim2.new(1, -74, 0, 18), Position = UDim2.fromOffset(66, 44), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 1.6, ZIndex = 24, Parent = tile })
	return value
end

function PanelEquip.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes = C.UIKit, C.Store, C.Config, C.Format, C.Remotes
	panel = UIKit.Panel(C.Root, "Equip", "NEW EQUIPMENT", Vector2.new(580, 440), Color3.fromRGB(255, 154, 40),
		{ Icon = "UPG_Power", Emoji = "🏋️", Top = ORANGE_TOP, Bottom = ORANGE_BOTTOM, Accent = Color3.fromRGB(210, 120, 40) })
	local body = panel.Body

	-- name card tinted with the gym's colour
	ui.Header = UIKit.Card({ Name = "Machine", Top = ORANGE_TOP, Bottom = ORANGE_BOTTOM, Size = UDim2.new(1, -24, 0, 88), Position = UDim2.fromOffset(12, 10),
		Radius = 18, Rim = Color3.fromRGB(255, 255, 255), Shine = true, ZIndex = 22, Parent = body })
	ui.Header:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.55
	ui.Area = UIKit.Text({ Text = "", TextSize = 14, Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(14, 8), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 1.8, ZIndex = 23, Parent = ui.Header })
	ui.Name = UIKit.Text({ Text = "", TextSize = 30, Scaled = true, Size = UDim2.new(1, -28, 0, 34), Position = UDim2.fromOffset(14, 24), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 3, ZIndex = 23, Parent = ui.Header })
	local cap = Instance.new("UITextSizeConstraint")
	cap.MaxTextSize = 30
	cap.Parent = ui.Name
	local chips = UIKit.Frame({ Name = "Chips", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -28, 0, 24), Position = UDim2.fromOffset(14, 60), ZIndex = 23, Parent = ui.Header })
	UIKit.List(chips, 6, Enum.FillDirection.Horizontal)
	ui.Exercise = select(2, UIKit.Chip({ Name = "Exercise", Text = "", Color = Color3.fromRGB(30, 30, 44), TextSize = 13, Size = UDim2.fromOffset(10, 22), AutoWidth = true,
		LayoutOrder = 1, ZIndex = 24, Parent = chips }))
	ui.Tier = select(2, UIKit.Chip({ Name = "Tier", Text = "", Color = Color3.fromRGB(30, 30, 44), TextColor = UIKit.C.Gold, TextSize = 13, Size = UDim2.fromOffset(10, 22),
		AutoWidth = true, LayoutOrder = 2, ZIndex = 24, Parent = chips }))

	ui.Strength = gainTile(body, 0, "Strength", "💪", "STRENGTH PER REP", Color3.fromRGB(255, 120, 96))
	ui.Coins = gainTile(body, 0.5, "Money", "💵", "COINS PER REP", UIKit.C.Coins)

	-- comparison with your best machine
	ui.Compare = UIKit.Frame({ Name = "Compare", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -24, 0, 64), Position = UDim2.fromOffset(12, 190), ZIndex = 22, Parent = body })
	ui.BestLabel = UIKit.Text({ Text = "", TextSize = 14, Color = UIKit.C.Muted, Size = UDim2.new(0.62, 0, 0, 18), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, ZIndex = 23, Parent = ui.Compare })
	ui.Verdict = UIKit.Text({ Text = "", TextSize = 16, Size = UDim2.new(0.38, 0, 0, 18), Position = UDim2.fromScale(0.62, 0), XAlign = Enum.TextXAlignment.Right, StrokeThickness = 2, ZIndex = 23, Parent = ui.Compare })
	local function bar(y, color, label)
		local track = UIKit.Card({ Top = Color3.fromRGB(14, 18, 40), Bottom = Color3.fromRGB(8, 10, 26), Size = UDim2.new(1, -60, 0, 16), Position = UDim2.fromOffset(60, y),
			Radius = 12, OutlineThickness = 2, Clip = true, ZIndex = 23, Parent = ui.Compare })
		local fill = UIKit.Card({ Top = UIKit.Shade(color, 1.2), Bottom = UIKit.Shade(color, 0.8), Size = UDim2.new(0, 0, 1, 0), Radius = 12, OutlineThickness = 0, ZIndex = 23, Parent = track })
		fill:FindFirstChildOfClass("UIStroke").Enabled = false
		UIKit.Text({ Text = label, TextSize = 13, Color = UIKit.C.Muted, Size = UDim2.fromOffset(54, 16), Position = UDim2.fromOffset(0, y), XAlign = Enum.TextXAlignment.Left,
			StrokeThickness = 1.4, ZIndex = 23, Parent = ui.Compare })
		return fill
	end
	ui.BestFill = bar(24, Color3.fromRGB(140, 150, 180), "BEST")
	ui.NewFill = bar(44, Color3.fromRGB(255, 150, 60), "THIS")

	ui.Buy = UIKit.Button({ Name = "Buy", Text = "", Icon = "Money", Emoji = "💵", IconSize = 40, Color = UIKit.C.Good, TextSize = 28, Gloss = true,
		Size = UDim2.new(1, -60, 0, 66), Position = UDim2.new(0.5, 0, 1, -14), AnchorPoint = Vector2.new(0.5, 1), Radius = 18, ZIndex = 23, Parent = body,
		OnClick = function()
			local result = Remotes.Get("BuyEquipment"):InvokeServer(currentId)
			if result and result.Ok then
				C.Sfx.Play("Buy")
				C.Fx.Confetti(30)
				panel.Close()
				if result.Msg then
					C.HUD.Toast(result.Msg, "Success")
				end
			else
				C.Sfx.Play("Error")
				C.HUD.Toast(result and result.Msg or "Can't buy that.", "Error")
			end
		end })
	Remotes.Get("PromptEquipment").OnClientEvent:Connect(function(stationId)
		currentId = stationId
		refresh()
		panel.Open()
	end)
	Store.Watch("Coins", function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return PanelEquip
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX36">
          <Properties>
            <string name="Name">PanelPets</string>
            <ProtectedString name="Source">--[[
	PanelPets - inventory grid, pet details and the equip / lock / delete tools.
	Every button only *asks* the server (PetAction); the panel redraws when the server syncs.
]]
local PanelPets = {}

local C, UIKit, Store, Config, Format, Remotes

local panel, grid, countLabel, slotsLabel, detail
local selectedUid = nil
local dirty = true
local detailIcon
local deleteArmedUntil = 0

local function act(action, arg)
	local result = Remotes.Get("PetAction"):InvokeServer(action, arg)
	if result and not result.Ok then
		C.HUD.Toast(result.Msg or "Something went wrong.", "Error")
		C.Sfx.Play("Error")
	end
	return result
end

local function sortedPets()
	local list = {}
	for _, p in ipairs(Store.Inventory.Pets) do
		list[#list + 1] = p
	end
	table.sort(list, function(a, b)
		local da, db = Config.PetsById[a.id], Config.PetsById[b.id]
		if da.Mult ~= db.Mult then
			return da.Mult &gt; db.Mult
		end
		return tonumber(a.u) &lt; tonumber(b.u)
	end)
	return list
end

local function renderDetail()
	for _, child in ipairs(detail:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local pet = selectedUid and Store.GetPet(selectedUid)
	if not pet then
		UIKit.Text({ Text = "Select a pet", TextSize = 20, Color = UIKit.C.Muted, Parent = detail })
		return
	end
	local def = Config.PetsById[pet.id]
	local rarity = Config.Rarities[def.Rarity]
	local iconHolder = UIKit.Frame({
		Color = UIKit.Shade(rarity.Color, 0.35), Size = UDim2.new(1, -12, 0, 150), Position = UDim2.fromOffset(6, 6),
		Radius = 16, Stroke = rarity.Color, StrokeThickness = 3, ZIndex = 23, Parent = detail,
	})
	C.PetVisuals.Icon(iconHolder, def, UDim2.fromScale(1, 1), 24)
	UIKit.Text({ Text = def.Name, TextSize = 22, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 160), ZIndex = 23, Parent = detail })
	UIKit.Text({ Text = rarity.Label, TextSize = 16, Color = rarity.Color, Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 186), ZIndex = 23, Parent = detail })
	UIKit.Text({ Text = Format.Mult(def.Mult) .. " Strength", TextSize = 20, Color = UIKit.C.Mult, Size = UDim2.new(1, -8, 0, 24), Position = UDim2.fromOffset(4, 206), ZIndex = 23, Parent = detail })

	local equipped = Store.IsEquipped(pet.u)
	UIKit.Button({
		Text = equipped and "Unequip" or "Equip", Color = equipped and UIKit.C.Orange or UIKit.C.Good, TextSize = 20,
		Size = UDim2.new(1, -16, 0, 40), Position = UDim2.fromOffset(8, 238), ZIndex = 23, Parent = detail,
		OnClick = function()
			local r = act(equipped and "Unequip" or "Equip", pet.u)
			if r and r.Ok then
				C.Sfx.Play("Equip")
			end
		end,
	})
	UIKit.Button({
		Text = pet.l and "🔒 Locked" or "🔓 Lock", Color = pet.l and UIKit.C.Blue or Color3.fromRGB(96, 100, 128), TextSize = 18,
		Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 284), ZIndex = 23, Parent = detail,
		OnClick = function()
			act("Lock", pet.u)
		end,
	})
	local deleteButton
	deleteButton = UIKit.Button({
		Text = "🗑️ Delete", Color = UIKit.C.Bad, TextSize = 18, Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 324),
		ZIndex = 23, Parent = detail,
		OnClick = function()
			if os.clock() &lt; deleteArmedUntil then
				deleteArmedUntil = 0
				local r = act("Delete", pet.u)
				if r and r.Ok then
					selectedUid = nil
				end
			else
				deleteArmedUntil = os.clock() + 2.5
				deleteButton.Text = "Sure? Tap again"
				task.delay(2.5, function()
					if deleteButton.Parent then
						deleteButton.Text = "🗑️ Delete"
					end
				end)
			end
		end,
	})
end

local function render()
	dirty = false
	for _, child in ipairs(grid:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local inv = Store.Inventory
	countLabel.Text = "🐾 " .. #inv.Pets .. " / " .. inv.Max
	slotsLabel.Text = "Equipped " .. #inv.Equipped .. " / " .. inv.Slots
	local list = sortedPets()
	if selectedUid and not Store.GetPet(selectedUid) then
		selectedUid = nil
	end
	if not selectedUid and list[1] then
		selectedUid = list[1].u
	end
	for i, pet in ipairs(list) do
		local def = Config.PetsById[pet.id]
		local rarity = Config.Rarities[def.Rarity]
		local card = UIKit.Button({
			Name = "Pet" .. pet.u, Text = "", Color = UIKit.Shade(rarity.Color, 0.4), Size = UDim2.fromOffset(84, 96), LayoutOrder = i,
			Radius = 12, Silent = true, ZIndex = 23, Parent = grid,
			OnClick = function()
				selectedUid = pet.u
				C.Sfx.Play("Click", 1.2)
				renderDetail()
			end,
		})
		local stroke = UIKit.OutlineOf(card)
		if stroke then
			stroke.Color = (pet.u == selectedUid) and Color3.new(1, 1, 1) or rarity.Color
			stroke.Thickness = (pet.u == selectedUid) and 4 or 2
		end
		UIKit.Text({ Text = def.Emoji, TextSize = 40, Size = UDim2.new(1, 0, 0, 52), Position = UDim2.fromOffset(0, 4), ZIndex = 24, Parent = card })
		UIKit.Text({ Text = Format.Mult(def.Mult), TextSize = 16, Color = rarity.Color, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 58), ZIndex = 24, Parent = card })
		UIKit.Text({ Text = rarity.Label, TextSize = 9, Color = UIKit.C.Muted, Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 78), ZIndex = 24, Parent = card })
		if Store.IsEquipped(pet.u) then
			local tag = UIKit.Frame({ Color = UIKit.C.Good, Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -2, 0, 2), AnchorPoint = Vector2.new(1, 0), Radius = 11, ZIndex = 25, Parent = card })
			UIKit.Text({ Text = "E", TextSize = 14, ZIndex = 26, Parent = tag })
		end
		if pet.l then
			UIKit.Text({ Text = "🔒", TextSize = 16, Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(2, 2), ZIndex = 25, Parent = card })
		end
	end
	if #list == 0 then
		UIKit.Text({ Text = "No pets yet! Open a Lucky Block ❓", TextSize = 22, Color = UIKit.C.Muted, ZIndex = 24, Parent = grid })
	end
	renderDetail()
end

local function bulkDeleteCommons()
	local uids = {}
	for _, pet in ipairs(Store.Inventory.Pets) do
		local def = Config.PetsById[pet.id]
		if def.Rarity == "Common" and not pet.l and not Store.IsEquipped(pet.u) then
			uids[#uids + 1] = pet.u
			if #uids &gt;= 60 then
				break
			end
		end
	end
	if #uids == 0 then
		C.HUD.Toast("No unlocked, unequipped Commons to delete.", "Info")
		return
	end
	local r = act("Delete", uids)
	if r and r.Ok then
		C.HUD.Toast("Deleted " .. r.Deleted .. " Common pets.", "Success")
	end
end

function PanelPets.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes = C.UIKit, C.Store, C.Config, C.Format, C.Remotes
	panel = UIKit.Panel(C.Root, "Pets", "🐾 My Pets", Vector2.new(740, 500), Color3.fromRGB(255, 130, 200))
	local body = panel.Body

	countLabel = UIKit.Text({ Text = "", TextSize = 20, Size = UDim2.fromOffset(120, 36), Position = UDim2.fromOffset(10, 8), XAlign = Enum.TextXAlignment.Left, ZIndex = 22, Parent = body })
	slotsLabel = UIKit.Text({ Text = "", TextSize = 20, Color = UIKit.C.Mult, Size = UDim2.fromOffset(150, 36), Position = UDim2.fromOffset(134, 8), XAlign = Enum.TextXAlignment.Left, ZIndex = 22, Parent = body })
	UIKit.Button({ Text = "⚡ Equip Best", Color = UIKit.C.Good, TextSize = 16, Size = UDim2.fromOffset(120, 34), Position = UDim2.new(1, -8, 0, 9), AnchorPoint = Vector2.new(1, 0), ZIndex = 23, Parent = body,
		OnClick = function() act("EquipBest") end })
	UIKit.Button({ Text = "Unequip All", Color = UIKit.C.Orange, TextSize = 16, Size = UDim2.fromOffset(116, 34), Position = UDim2.new(1, -134, 0, 9), AnchorPoint = Vector2.new(1, 0), ZIndex = 23, Parent = body,
		OnClick = function() act("UnequipAll") end })
	UIKit.Button({ Text = "🗑️ Clear Commons", Color = UIKit.C.Bad, TextSize = 16, Size = UDim2.fromOffset(148, 34), Position = UDim2.new(1, -256, 0, 9), AnchorPoint = Vector2.new(1, 0), ZIndex = 23, Parent = body,
		OnClick = bulkDeleteCommons })

	grid = UIKit.Scroll(body, { Position = UDim2.fromOffset(8, 52), Size = UDim2.new(1, -228, 1, -60), Name = "Grid" })
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(84, 96)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	UIKit.Padding(grid, 4)

	detail = UIKit.Frame({ Name = "Detail", Color = UIKit.C.Panel, Size = UDim2.new(0, 200, 1, -60), Position = UDim2.new(1, -208, 0, 52), Radius = 14, ZIndex = 22, Parent = body })

	Store.InventoryChanged:Connect(function()
		dirty = true
		if panel.IsOpen then
			render()
		end
	end)
	panel.OnOpen = function()
		if dirty then
			render()
		end
	end
	render()
end

return PanelPets
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX37">
          <Properties>
            <string name="Name">PanelQuests</string>
            <ProtectedString name="Source">--[[
	PanelQuests - the quest book:
	  * the current quest: number medallion, what it tracks, a big progress bar, the reward and CLAIM
	  * "Up next": the next quests in the chain (worked out with the same shared Formulas the server uses)
	  * "Your stats": lifetime counters with the game's logos
	Claiming is server-side (HUD.ClaimQuest -&gt; ClaimQuest remote).
]]
local PanelQuests = {}

local C, UIKit, Store, Config, Format, Formulas
local panel
local hero = {}
local upNext = {}
local statTiles = {}

-- how each tracked stat is shown (logo + label). Stat keys come from Config.Quests / the profile.
local STAT_INFO = {
	Reps = { Icon = "Strength", Emoji = "💪", Label = "Reps trained" },
	Hatches = { Icon = "LuckyBlock", Emoji = "❓", Label = "Lucky Blocks opened" },
	Orbs = { Icon = "Money", Emoji = "💵", Label = "Dumbbells collected" },
	Sells = { Emoji = "🥤", Label = "Shakes sold" },
	Upgrades = { Icon = "Shop", Emoji = "🛒", Label = "Upgrades bought" },
	Rebirths = { Icon = "RebirthStar", Emoji = "⭐", Label = "Rebirths" },
	Areas = { Icon = "GymMap", Emoji = "🗺️", Label = "Gyms unlocked" },
}
local STAT_ORDER = { "Reps", "Hatches", "Orbs", "Sells", "Upgrades", "Rebirths", "Areas" }

local BLUE_TOP, BLUE_BOTTOM = Color3.fromRGB(78, 172, 255), Color3.fromRGB(30, 104, 228)

local function refresh()
	local q = Store.State.Quest
	if not q then
		return
	end
	local info = STAT_INFO[q.Stat] or STAT_INFO.Reps
	hero.Number.Text = "#" .. tostring(q.Index or 1)
	hero.Title.Text = q.Text
	hero.StatLabel.Text = string.upper(info.Label)
	local fraction = q.Goal &gt; 0 and math.clamp(q.Progress / q.Goal, 0, 1) or 1
	UIKit.Tween(hero.Fill, 0.3, { Size = UDim2.new(fraction, 0, 1, 0) })
	hero.Fill.Visible = fraction &gt; 0.01
	hero.Progress.Text = Format.Number(q.Progress) .. " / " .. Format.Number(q.Goal) .. "   (" .. math.floor(fraction * 100) .. "%)"
	hero.Reward.Text = "+" .. Format.Number(q.Reward)
	hero.Claim.Visible = q.Done
	hero.Status.Visible = not q.Done

	-- the next quests in the chain
	for k, row in ipairs(upNext) do
		local ok, nextInfo = pcall(Formulas.QuestInfo, (q.Index or 1) + k, Store.State.Stations, Store.State.Upgrades)
		if ok and nextInfo then
			row.Number.Text = "#" .. tostring((q.Index or 1) + k)
			row.Text.Text = nextInfo.Text
			row.Reward.Text = "+" .. Format.Number(nextInfo.Reward)
			row.Frame.Visible = true
		else
			row.Frame.Visible = false
		end
	end
	for key, tile in pairs(statTiles) do
		tile.Text = Format.Number((Store.State.Stats or {})[key] or 0)
	end
end

local function buildHero(parent)
	local card = UIKit.Card({ Name = "Current", Top = BLUE_TOP, Bottom = BLUE_BOTTOM, Size = UDim2.new(1, -8, 0, 176), LayoutOrder = 1, Radius = 18,
		Rim = Color3.fromRGB(160, 214, 255), Shine = true, ZIndex = 23, Parent = parent })
	-- quest number medallion
	local medal = UIKit.Card({ Name = "Medal", Top = UIKit.C.Gold, Bottom = UIKit.C.GoldDark, Size = UDim2.fromOffset(82, 82), Position = UDim2.fromOffset(14, 16),
		Radius = 90, Rim = Color3.fromRGB(255, 236, 150), ZIndex = 24, Parent = card })
	medal:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	medal:FindFirstChild("Rim"):FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	UIKit.Text({ Text = "QUEST", TextSize = 13, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14), StrokeThickness = 1.8, ZIndex = 25, Parent = medal })
	hero.Number = UIKit.Text({ Text = "#1", TextSize = 30, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 30), StrokeThickness = 3, ZIndex = 25, Parent = medal })

	hero.Title = UIKit.Text({ Name = "Title", Text = "", TextSize = 27, Scaled = true, Size = UDim2.new(1, -290, 0, 34), Position = UDim2.fromOffset(112, 14),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 3, ZIndex = 24, Parent = card })
	local cap = Instance.new("UITextSizeConstraint")
	cap.MaxTextSize = 27
	cap.Parent = hero.Title
	local chip
	chip, hero.StatLabel = UIKit.Chip({ Name = "Tracks", Text = "", Color = Color3.fromRGB(16, 44, 110), TextSize = 14, Size = UDim2.fromOffset(10, 26),
		AutoWidth = true, Position = UDim2.fromOffset(112, 54), ZIndex = 24, Parent = card })
	hero.StatChip = chip

	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(12, 30, 80), Bottom = Color3.fromRGB(8, 20, 56), Size = UDim2.new(1, -28, 0, 34),
		Position = UDim2.fromOffset(14, 108), Radius = 20, OutlineThickness = 3, Clip = true, ZIndex = 24, Parent = card })
	hero.Fill = UIKit.Card({ Name = "Fill", Top = Color3.fromRGB(150, 245, 100), Bottom = Color3.fromRGB(40, 176, 60), Size = UDim2.new(0, 0, 1, 0), Radius = 20,
		OutlineThickness = 0, ZIndex = 24, Parent = track })
	hero.Fill:FindFirstChildOfClass("UIStroke").Enabled = false
	UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.84, Size = UDim2.new(1, -14, 0, 10), Position = UDim2.fromOffset(7, 4), Radius = 10, ZIndex = 25, Parent = track })
	hero.Progress = UIKit.Text({ Text = "", TextSize = 18, Size = UDim2.fromScale(1, 1), StrokeThickness = 2.4, ZIndex = 26, Parent = track })

	local rewardRow
	rewardRow, hero.Reward = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "", TextSize = 24, IconSize = 36, Color = UIKit.C.Coins, StrokeThickness = 2.8,
		Size = UDim2.new(0, 220, 0, 36), Position = UDim2.new(1, -14, 0, 56), AnchorPoint = Vector2.new(1, 0), Align = "Right", ZIndex = 24, Parent = card })
	hero.RewardRow = rewardRow
	hero.Status = select(1, UIKit.Chip({ Name = "Status", Text = "IN PROGRESS", Color = Color3.fromRGB(16, 44, 110), TextSize = 13, Size = UDim2.fromOffset(112, 24),
		Position = UDim2.new(1, -14, 0, 150), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 24, Parent = card }))
	hero.Status.Position = UDim2.new(1, -14, 0, 16)
	hero.Claim = UIKit.Button({ Name = "Claim", Text = "🎁 CLAIM!", Color = UIKit.C.Good, TextSize = 22, Size = UDim2.fromOffset(150, 44), Gloss = true,
		Position = UDim2.new(1, -14, 0, 12), AnchorPoint = Vector2.new(1, 0), Visible = false, ZIndex = 26, Parent = card,
		OnClick = function()
			C.HUD.ClaimQuest()
		end })
end

local function sectionTitle(parent, text, order)
	local t = UIKit.Text({ Name = "Section", Text = text, TextSize = 19, Color = UIKit.C.Gold, Size = UDim2.new(1, -8, 0, 26), LayoutOrder = order,
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.4, ZIndex = 23, Parent = parent })
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 6)
	p.Parent = t
	return t
end

local function buildUpNext(parent)
	sectionTitle(parent, "UP NEXT", 2)
	for k = 1, 3 do
		local row = UIKit.Card({ Name = "Next" .. k, Top = Color3.fromRGB(38, 56, 108), Bottom = Color3.fromRGB(24, 34, 70), Size = UDim2.new(1, -8, 0, 46),
			LayoutOrder = 2 + k, Radius = 14, OutlineThickness = 2, ZIndex = 23, Parent = parent })
		local bubble = UIKit.Card({ Name = "Number", Top = Color3.fromRGB(90, 110, 170), Bottom = Color3.fromRGB(56, 70, 120), Size = UDim2.fromOffset(52, 30),
			Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Radius = 14, OutlineThickness = 2, ZIndex = 24, Parent = row })
		local number = UIKit.Text({ Text = "", TextSize = 16, Size = UDim2.fromScale(1, 1), StrokeThickness = 1.8, ZIndex = 25, Parent = bubble })
		local text = UIKit.Text({ Text = "", TextSize = 18, Color = Color3.fromRGB(214, 226, 255), Size = UDim2.new(1, -210, 1, 0), Position = UDim2.fromOffset(70, 0),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2, ZIndex = 24, Parent = row })
		local _, reward = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "", TextSize = 17, IconSize = 26, Color = UIKit.C.Coins, StrokeThickness = 2,
			Size = UDim2.new(0, 130, 1, 0), Position = UDim2.new(1, -12, 0, 0), AnchorPoint = Vector2.new(1, 0), Align = "Right", ZIndex = 24, Parent = row })
		upNext[k] = { Frame = row, Number = number, Text = text, Reward = reward }
	end
end

local function buildStats(parent)
	sectionTitle(parent, "YOUR STATS", 10)
	local grid = UIKit.Frame({ Name = "Stats", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -8, 0, 150), LayoutOrder = 11, ZIndex = 23, Parent = parent })
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.25, -6, 0, 70)
	layout.CellPadding = UDim2.fromOffset(8, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = grid
	for i, key in ipairs(STAT_ORDER) do
		local info = STAT_INFO[key]
		local tile = UIKit.Card({ Name = key, Top = Color3.fromRGB(34, 50, 98), Bottom = Color3.fromRGB(22, 30, 64), LayoutOrder = i, Radius = 14,
			OutlineThickness = 2, ZIndex = 24, Parent = grid })
		UIKit.Icon({ Icon = info.Icon, Emoji = info.Emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 25, Parent = tile })
		statTiles[key] = UIKit.Text({ Name = "Value", Text = "0", TextSize = 22, Size = UDim2.new(1, -50, 0, 28), Position = UDim2.fromOffset(46, 8),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.4, ZIndex = 25, Parent = tile })
		local label = UIKit.Text({ Name = "Label", Text = info.Label, TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.new(1, -50, 0, 28), Position = UDim2.fromOffset(46, 36),
			XAlign = Enum.TextXAlignment.Left, YAlign = Enum.TextYAlignment.Top, Wrap = true, StrokeThickness = 1.4, ZIndex = 25, Parent = tile })
		label.LineHeight = 0.9
	end
end

function PanelQuests.Init(client)
	C = client
	UIKit, Store, Config, Format, Formulas = C.UIKit, C.Store, C.Config, C.Format, C.Formulas
	panel = UIKit.Panel(C.Root, "Quests", "QUESTS", Vector2.new(640, 560), Color3.fromRGB(64, 148, 255),
		{ Icon = "Quests", Emoji = "📋", Top = BLUE_TOP, Bottom = BLUE_BOTTOM, Accent = Color3.fromRGB(60, 120, 220) })
	local scroll = UIKit.Scroll(panel.Body, { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -12, 1, -16), Name = "Content" })
	UIKit.List(scroll, 8)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = scroll
	buildHero(scroll)
	buildUpNext(scroll)
	buildStats(scroll)
	Store.StateChanged:Connect(refresh)
	panel.OnOpen = refresh
	refresh()
end

return PanelQuests
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX38">
          <Properties>
            <string name="Name">PanelRanks</string>
            <ProtectedString name="Source">--[[
	PanelRanks - the server leaderboard: a podium for the top 3 and a ranked list below.
	Tabs: Rebirths / Strength / All-time Strength. Values come from the Player attributes
	the server sets (display only).
]]
local Players = game:GetService("Players")

local PanelRanks = {}

local C, UIKit, Store, Config, Format
local panel, podium, list
local tab = "Rebirths"
local tabButtons = {}

local TABS = {
	{ Key = "Rebirths", Label = "REBIRTHS", Icon = "RebirthStar", Emoji = "⭐", Color = Color3.fromRGB(160, 96, 255), Whole = true },
	{ Key = "Strength", Label = "STRENGTH", Icon = "Strength", Emoji = "💪", Color = Color3.fromRGB(240, 84, 70) },
	{ Key = "TotalStrength", Label = "ALL-TIME", Icon = "Strength", Emoji = "📈", Color = Color3.fromRGB(56, 186, 96) },
}
local PODIUM = {
	[1] = { Top = Color3.fromRGB(255, 226, 90), Bottom = Color3.fromRGB(236, 150, 20), Height = 84, X = 0.5 },
	[2] = { Top = Color3.fromRGB(236, 242, 250), Bottom = Color3.fromRGB(150, 162, 184), Height = 64, X = 0.19 },
	[3] = { Top = Color3.fromRGB(240, 170, 110), Bottom = Color3.fromRGB(176, 92, 40), Height = 50, X = 0.81 },
}
local PODIUM_H = 196
local RED_TOP, RED_BOTTOM = Color3.fromRGB(255, 96, 96), Color3.fromRGB(208, 36, 48)

local function tabDef(key)
	for _, t in ipairs(TABS) do
		if t.Key == key then
			return t
		end
	end
	return TABS[1]
end

local function valueText(value)
	local t = tabDef(tab)
	return t.Whole and Format.Commas(value) or Format.Number(value)
end

local function avatar(parent, userId, size, zIndex)
	local img = Instance.new("ImageLabel")
	img.Name = "Avatar"
	img.BackgroundColor3 = Color3.fromRGB(16, 22, 44)
	img.BorderSizePixel = 0
	img.Size = UDim2.fromOffset(size, size)
	img.Image = "rbxthumb://type=AvatarHeadShot&amp;id=" .. tostring(userId) .. "&amp;w=150&amp;h=150"
	img.ZIndex = zIndex
	UIKit.Corner(img, size)
	img:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	UIKit.Stroke(img, UIKit.C.Outline, 3)
	img.Parent = parent
	return img
end

local function clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function refresh()
	for key, b in pairs(tabButtons) do
		local active = key == tab
		UIKit.SetButtonColor(b, active and tabDef(key).Color or UIKit.C.NavyLight)
		local outline = UIKit.OutlineOf(b)
		if outline then
			outline.Color = active and Color3.new(1, 1, 1) or UIKit.C.Outline
		end
	end
	local entries = {}
	for _, player in ipairs(Players:GetPlayers()) do
		entries[#entries + 1] = {
			Player = player,
			Value = player:GetAttribute(tab) or 0,
			Rebirths = player:GetAttribute("Rebirths") or 0,
			Strength = player:GetAttribute("Strength") or 0,
		}
	end
	table.sort(entries, function(a, b)
		if a.Value ~= b.Value then return a.Value &gt; b.Value end
		if a.Rebirths ~= b.Rebirths then return a.Rebirths &gt; b.Rebirths end
		return a.Strength &gt; b.Strength
	end)

	-- podium (2nd, 1st, 3rd)
	clear(podium)
	local t = tabDef(tab)
	for rank = 1, 3 do
		local e = entries[rank]
		local spec = PODIUM[rank]
		local column = UIKit.Frame({ Name = "Place" .. rank, Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(0.3, 0, 1, 0),
			Position = UDim2.fromScale(spec.X, 0), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 23, Parent = podium })
		local block = UIKit.Card({ Name = "Block", Top = spec.Top, Bottom = spec.Bottom, Size = UDim2.new(1, -10, 0, spec.Height), Position = UDim2.new(0.5, 0, 1, 0),
			AnchorPoint = Vector2.new(0.5, 1), Radius = 16, Rim = Color3.new(1, 1, 1), Shine = true, ZIndex = 24, Parent = column })
		block:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.45
		UIKit.Text({ Text = tostring(rank), TextSize = rank == 1 and 44 or 36, Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), StrokeThickness = 3.5, ZIndex = 25, Parent = block })
		if e then
			-- stacked above the block: avatar, name, value
			local blockTop = PODIUM_H - spec.Height
			local valueY = blockTop - 24
			local nameY = valueY - 20
			local avSize = rank == 1 and 60 or 50
			local av = avatar(column, e.Player.UserId, avSize, 25)
			av.Position = UDim2.new(0.5, 0, 0, nameY - avSize - 2)
			av.AnchorPoint = Vector2.new(0.5, 0)
			if rank == 1 then
				UIKit.Text({ Text = "👑", TextSize = 24, Size = UDim2.fromOffset(30, 26), Position = UDim2.new(0.5, 22, 0, nameY - avSize - 12), AnchorPoint = Vector2.new(0.5, 0),
					Rotation = 18, Stroke = false, ZIndex = 26, Parent = column })
			end
			local name = UIKit.Text({ Text = e.Player.DisplayName, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, nameY),
				Color = e.Player == Players.LocalPlayer and Color3.fromRGB(140, 220, 255) or Color3.new(1, 1, 1), StrokeThickness = 2, ZIndex = 25, Parent = column })
			name.TextTruncate = Enum.TextTruncate.AtEnd
			UIKit.IconLabel({ Icon = t.Icon, Emoji = t.Emoji, Text = valueText(e.Value), TextSize = 16, IconSize = 20, Align = "Center", Color = UIKit.C.Coins,
				StrokeThickness = 2, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, valueY), ZIndex = 25, Parent = column })
		end
	end

	-- everyone else
	clear(list)
	if #entries &lt;= 3 then
		UIKit.Empty(list, #entries == 0 and "No players yet." or "Only the podium so far - invite your friends!", 23)
	end
	for rank = 4, #entries do
		local e = entries[rank]
		local mine = e.Player == Players.LocalPlayer
		local row = UIKit.Card({ Name = "Row", Top = mine and Color3.fromRGB(64, 140, 255) or Color3.fromRGB(38, 54, 104),
			Bottom = mine and Color3.fromRGB(34, 84, 210) or Color3.fromRGB(24, 32, 68), Size = UDim2.new(1, -8, 0, 48), LayoutOrder = rank, Radius = 14,
			Outline = mine and Color3.fromRGB(230, 240, 255) or UIKit.C.Outline, OutlineThickness = 2, ZIndex = 23, Parent = list })
		local badge = UIKit.Card({ Name = "Rank", Top = Color3.fromRGB(80, 94, 140), Bottom = Color3.fromRGB(48, 58, 96), Size = UDim2.fromOffset(40, 32),
			Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Radius = 14, OutlineThickness = 2, ZIndex = 24, Parent = row })
		UIKit.Text({ Text = "#" .. rank, TextSize = 16, Size = UDim2.fromScale(1, 1), StrokeThickness = 2, ZIndex = 25, Parent = badge })
		local av = avatar(row, e.Player.UserId, 36, 24)
		av.Position = UDim2.new(0, 56, 0.5, 0)
		av.AnchorPoint = Vector2.new(0, 0.5)
		UIKit.Text({ Text = e.Player.DisplayName, TextSize = 19, Size = UDim2.new(1, -280, 1, 0), Position = UDim2.fromOffset(102, 0), XAlign = Enum.TextXAlignment.Left,
			StrokeThickness = 2.2, ZIndex = 24, Parent = row })
		UIKit.IconLabel({ Icon = t.Icon, Emoji = t.Emoji, Text = valueText(e.Value), TextSize = 19, IconSize = 26, Align = "Right", Color = UIKit.C.Coins,
			StrokeThickness = 2.2, Size = UDim2.new(0, 170, 1, 0), Position = UDim2.new(1, -12, 0, 0), AnchorPoint = Vector2.new(1, 0), ZIndex = 24, Parent = row })
	end
end

function PanelRanks.Init(client)
	C = client
	UIKit, Store, Config, Format = C.UIKit, C.Store, C.Config, C.Format
	panel = UIKit.Panel(C.Root, "Ranks", "TOP PLAYERS", Vector2.new(620, 560), Color3.fromRGB(255, 96, 96),
		{ Icon = "Ranks", Emoji = "🏆", Top = RED_TOP, Bottom = RED_BOTTOM, Accent = Color3.fromRGB(200, 60, 70) })
	local body = panel.Body
	local tabs = UIKit.Frame({ Name = "Tabs", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -16, 0, 42), Position = UDim2.fromOffset(8, 8), ZIndex = 22, Parent = body })
	UIKit.List(tabs, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
	for i, t in ipairs(TABS) do
		tabButtons[t.Key] = UIKit.Button({ Name = t.Key, Text = t.Label, Icon = t.Icon, Emoji = t.Emoji, IconSize = 24, Color = t.Color, TextSize = 17,
			Size = UDim2.new(1 / 3, -6, 1, 0), LayoutOrder = i, Gloss = true, ZIndex = 23, Parent = tabs,
			OnClick = function()
				tab = t.Key
				refresh()
			end })
	end
	podium = UIKit.Frame({ Name = "Podium", Color = Color3.fromRGB(8, 14, 34), Transparency = 0.2, Size = UDim2.new(1, -16, 0, PODIUM_H), Position = UDim2.fromOffset(8, 58),
		Radius = 16, ZIndex = 22, Parent = body })
	podium.ClipsDescendants = false
	list = UIKit.Scroll(body, { Position = UDim2.fromOffset(8, PODIUM_H + 66), Size = UDim2.new(1, -12, 1, -(PODIUM_H + 74)), Name = "List" })
	UIKit.List(list, 6)
	panel.OnOpen = refresh
	task.spawn(function()
		while true do
			task.wait(1.5)
			if panel.IsOpen then
				refresh()
			end
		end
	end)
end

return PanelRanks
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX39">
          <Properties>
            <string name="Name">PanelRebirth</string>
            <ProtectedString name="Source">--[[
	PanelRebirth - requirement, the boost you gain and what you keep, in the admin-panel style.
	Needs a second tap to confirm so nobody rebirths by accident. The server decides (Rebirth remote).
]]
local PanelRebirth = {}

local C, UIKit, Store, Config, Format, Remotes, Formulas
local panel, button
local ui = {}
local armedUntil = 0
local PURPLE_TOP, PURPLE_BOTTOM = Color3.fromRGB(190, 130, 255), Color3.fromRGB(120, 60, 220)

local function refresh()
	local rebirths = Store.Attr("Rebirths")
	local strength = Store.Attr("Strength")
	local maxed = rebirths &gt;= Config.Game.MaxRebirths
	local req = Formulas.RebirthRequirement(rebirths)
	local ready = strength &gt;= req and not maxed
	ui.Count.Text = rebirths .. " / " .. Config.Game.MaxRebirths
	ui.Now.Text = Format.Mult(Formulas.RebirthMultiplier(rebirths))
	ui.Next.Text = maxed and "MAX" or Format.Mult(Formulas.RebirthMultiplier(rebirths + 1))
	local fraction = maxed and 1 or math.clamp(strength / req, 0, 1)
	ui.Fill.Size = UDim2.fromScale(fraction, 1)
	ui.Fill.Visible = fraction &gt; 0.01
	ui.BarText.Text = maxed and "MAX REBIRTHS REACHED" or (Format.Number(strength) .. " / " .. Format.Number(req))
	if ready then
		local armed = os.clock() &lt; armedUntil
		UIKit.SetDisabled(button, false)
		button.Text = armed and "TAP AGAIN TO CONFIRM!" or "REBIRTH"
		UIKit.SetButtonColor(button, armed and UIKit.C.Bad or UIKit.C.Purple)
	else
		button.Text = maxed and "MAXED" or "NEED MORE STRENGTH"
		UIKit.SetDisabled(button, true, Color3.fromRGB(96, 100, 128))
	end
end

local function onClick()
	local rebirths = Store.Attr("Rebirths")
	if Store.Attr("Strength") &lt; Formulas.RebirthRequirement(rebirths) then
		return
	end
	if os.clock() &gt; armedUntil then
		armedUntil = os.clock() + 3
		refresh()
		task.delay(3.05, refresh)
		return
	end
	armedUntil = 0
	local result = Remotes.Get("Rebirth"):InvokeServer()
	if result and result.Ok then
		panel.Close()
	else
		C.Sfx.Play("Error")
		C.HUD.Toast(result and result.Msg or "Can't rebirth yet.", "Error")
	end
	refresh()
end

function PanelRebirth.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes, Formulas = C.UIKit, C.Store, C.Config, C.Format, C.Remotes, C.Formulas
	panel = UIKit.GoldPanel(C.Root, "Rebirth", "REBIRTH", Vector2.new(600, 610), { Icon = "RebirthStar", Emoji = "⭐" })

	local s = UIKit.Section(panel.Content, "YOUR REBIRTHS", { Icon = "RebirthStar", Emoji = "⭐", LayoutOrder = 1, Top = PURPLE_TOP, Bottom = PURPLE_BOTTOM })
	local r1 = s.Row(70)
	local _
	_, ui.Count = UIKit.Tile(r1, 170, { Label = "REBIRTHS", Icon = "RebirthStar", Emoji = "⭐", Color = Color3.fromRGB(215, 170, 255), LayoutOrder = 1 })
	_, ui.Now = UIKit.Tile(r1, 170, { Label = "BOOST NOW", Icon = "Strength", Emoji = "💪", Color = UIKit.C.Mult, LayoutOrder = 2 })
	_, ui.Next = UIKit.Tile(r1, 170, { Label = "AFTER REBIRTH", Icon = "Strength", Emoji = "💪", Color = UIKit.C.Gold, LayoutOrder = 3,
		Top = Color3.fromRGB(120, 70, 200), Bottom = Color3.fromRGB(70, 34, 140) })

	local s2 = UIKit.Section(panel.Content, "STRENGTH NEEDED", { Icon = "Strength", Emoji = "💪", LayoutOrder = 2 })
	local r2 = s2.Row(34, true)
	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(12, 18, 44), Bottom = Color3.fromRGB(8, 12, 30), Size = UDim2.fromScale(1, 1), Radius = 14,
		OutlineThickness = 2, Clip = true, ZIndex = 24, Parent = r2 })
	ui.Fill = UIKit.Card({ Name = "Fill", Top = PURPLE_TOP, Bottom = PURPLE_BOTTOM, Size = UDim2.fromScale(0, 1), Radius = 14, OutlineThickness = 0, ZIndex = 24, Parent = track })
	ui.Fill:FindFirstChildOfClass("UIStroke").Enabled = false
	ui.BarText = UIKit.Text({ Text = "", TextSize = 17, StrokeThickness = 2.2, ZIndex = 25, Parent = track })

	local s3 = UIKit.Section(panel.Content, "WHAT HAPPENS", { Icon = "AdmLogs", Emoji = "📜", LayoutOrder = 3 })
	local r3 = s3.Row(62, true)
	UIKit.Text({ Text = "Your Strength goes back to 0 and you get a permanent Strength boost.\nYour UPGRADES are reset too. You KEEP your coins, pets, equipment and unlocked gyms!",
		TextSize = 15, Color = UIKit.C.Muted, Wrap = true, Size = UDim2.fromScale(1, 1), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, ZIndex = 24, Parent = r3 })

	local s4 = UIKit.Section(panel.Content, "READY?", { Icon = "RebirthStar", Emoji = "⭐", LayoutOrder = 4, Top = PURPLE_TOP, Bottom = PURPLE_BOTTOM })
	local r4 = s4.Row(60, true)
	button = UIKit.Button({ Name = "Rebirth", Text = "", Color = UIKit.C.Purple, TextSize = 26, Gloss = true, Size = UDim2.fromScale(1, 1), Radius = 16, ZIndex = 24,
		Parent = r4, OnClick = onClick })

	Store.Watch("Strength", function()
		if panel.IsOpen then refresh() end
	end)
	Store.Watch("Rebirths", refresh)
	panel.OnOpen = function()
		armedUntil = 0
		refresh()
	end
	refresh()
end

return PanelRebirth
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX40">
          <Properties>
            <string name="Name">PanelSell</string>
            <ProtectedString name="Source">--[[
	PanelSell - the Protein Bar supplement menu, in the admin-panel style. Order a supplement
	to trade some of your Strength for coins (Config.Sell: Options + Menu). The server decides
	the payout (SellStrength remote); the numbers shown here are an estimate.
]]
local PanelSell = {}

local C, UIKit, Store, Config, Format, Remotes
local panel
local cards = {}
local ui = {}
-- one colour theme per menu item (same order as Config.Sell.Menu)
local THEMES = {
	{ Top = Color3.fromRGB(120, 210, 255), Bottom = Color3.fromRGB(40, 130, 230) },
	{ Top = Color3.fromRGB(255, 226, 90), Bottom = Color3.fromRGB(236, 150, 20) },
	{ Top = Color3.fromRGB(255, 120, 96), Bottom = Color3.fromRGB(214, 40, 56) },
}

local function estimate(fraction)
	local sold = Store.Attr("Strength") * fraction
	if sold &lt; 1 then
		return 0
	end
	local mult = math.max(1, Store.Attr("StrengthMult"))
	local coinMult = math.max(1, Store.Attr("CoinMult"))
	return math.max(1, math.floor((sold / mult) * Config.Training.CoinRatio * coinMult * Config.Sell.Efficiency))
end

local function menuItem(i)
	local menu = Config.Sell.Menu
	return (menu and menu[i]) or { Name = "Sell", Emoji = "🥤", Desc = "" }
end

local function refresh()
	ui.Strength.Text = Format.Number(Store.Attr("Strength"))
	for i, fraction in ipairs(Config.Sell.Options) do
		local c = cards[i]
		local coins = estimate(fraction)
		c.Cost.Text = "-" .. Format.Number(Store.Attr("Strength") * fraction)
		c.Gain.Text = "+" .. Format.Number(coins)
		UIKit.SetDisabled(c.Button, coins &lt;= 0, Color3.fromRGB(96, 100, 128))
	end
end

local function order(i, fraction)
	local result = Remotes.Get("SellStrength"):InvokeServer(fraction)
	if result and result.Ok then
		C.Sfx.Play("Buy")
		C.Fx.CoinFly(C.Fx.CharacterPosition() or Vector3.new(), result.Coins)
		local item = menuItem(i)
		C.HUD.Toast(item.Name .. " served! +" .. Format.Number(result.Coins) .. " 💵", "Success")
	else
		C.Sfx.Play("Error")
		C.HUD.Toast(result and result.Msg or "Can't sell.", "Error")
	end
	refresh()
end

function PanelSell.Open()
	panel.Open()
end

function PanelSell.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes = C.UIKit, C.Store, C.Config, C.Format, C.Remotes
	panel = UIKit.GoldPanel(C.Root, "Sell", "PROTEIN BAR", Vector2.new(700, 490), { Icon = "Money", Emoji = "🥤" })

	local s = UIKit.Section(panel.Content, "YOUR STRENGTH", { Icon = "Strength", Emoji = "💪", LayoutOrder = 1 })
	local r = s.Row(40)
	UIKit.Icon({ Icon = "Strength", Emoji = "💪", Size = UDim2.fromOffset(38, 38), LayoutOrder = 1, ZIndex = 24, Parent = r })
	ui.Strength = UIKit.Text({ Text = "", TextSize = 28, Color = UIKit.C.Strength, Size = UDim2.fromOffset(160, 40), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.6, LayoutOrder = 2, ZIndex = 24, Parent = r })
	UIKit.Text({ Text = "Trade Strength for coins - it lowers your Strength!", TextSize = 14, Color = UIKit.C.Muted, Size = UDim2.fromOffset(360, 40),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, LayoutOrder = 3, ZIndex = 24, Parent = r })

	local s2 = UIKit.Section(panel.Content, "SUPPLEMENT MENU", { Icon = "Money", Emoji = "🥤", LayoutOrder = 2 })
	local row = s2.Row(230)
	local n = #Config.Sell.Options
	local width = math.floor((630 - 8 * (n - 1)) / n)
	for i, fraction in ipairs(Config.Sell.Options) do
		local item = menuItem(i)
		local theme = THEMES[(i - 1) % #THEMES + 1]
		local card = UIKit.Card({ Name = item.Name, Top = Color3.fromRGB(44, 64, 124), Bottom = Color3.fromRGB(26, 36, 78), Size = UDim2.fromOffset(width, 230), Radius = 16,
			OutlineThickness = 3, Rim = theme.Top, LayoutOrder = i, ZIndex = 24, Parent = row })
		-- tub-style label on top: the supplement's colour, big emoji, name and size
		local label = UIKit.Card({ Name = "Label", Top = theme.Top, Bottom = theme.Bottom, Size = UDim2.new(1, -16, 0, 96), Position = UDim2.fromOffset(8, 8), Radius = 14,
			OutlineThickness = 2, Rim = Color3.new(1, 1, 1), Shine = true, ZIndex = 25, Parent = card })
		label:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.5
		UIKit.Text({ Text = item.Emoji, TextSize = 44, Stroke = false, Size = UDim2.fromOffset(56, 56), Position = UDim2.new(0.5, 0, 0, 2), AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 26, Parent = label })
		UIKit.Text({ Text = string.upper(item.Name), TextSize = 19, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.new(0.5, 0, 0, 56), AnchorPoint = Vector2.new(0.5, 0),
			StrokeThickness = 2.4, ZIndex = 26, Parent = label })
		UIKit.Chip({ Text = math.floor(fraction * 100) .. "% OF YOUR STRENGTH", Color = UIKit.C.Outline, TextSize = 11, Size = UDim2.fromOffset(10, 18), AutoWidth = true,
			Position = UDim2.new(0.5, 0, 1, 8), AnchorPoint = Vector2.new(0.5, 1), ZIndex = 27, Parent = label })
		UIKit.Text({ Text = item.Desc or "", TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.new(1, -16, 0, 16), Position = UDim2.fromOffset(8, 110), StrokeThickness = 1.2,
			ZIndex = 25, Parent = card })
		local _, cost = UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "", TextSize = 16, IconSize = 22, Align = "Center", Color = UIKit.C.Strength, StrokeThickness = 2,
			Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 128), ZIndex = 25, Parent = card })
		local _, gain = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "", TextSize = 18, IconSize = 24, Align = "Center", Color = UIKit.C.Coins, StrokeThickness = 2,
			Size = UDim2.new(1, -16, 0, 26), Position = UDim2.fromOffset(8, 152), ZIndex = 25, Parent = card })
		local button = UIKit.Button({ Name = "Order", Text = "ORDER", Color = UIKit.C.Good, TextSize = 20, Gloss = true, Size = UDim2.new(1, -16, 0, 40),
			Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), Radius = 12, ZIndex = 25, Parent = card,
			OnClick = function() order(i, fraction) end })
		cards[i] = { Cost = cost, Gain = gain, Button = button }
	end
	Remotes.Get("OpenSell").OnClientEvent:Connect(function()
		panel.Open()
	end)
	Store.Watch("Strength", function()
		if panel.IsOpen then refresh() end
	end)
	panel.OnOpen = refresh
	refresh()
end

return PanelSell
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX41">
          <Properties>
            <string name="Name">PanelShop</string>
            <ProtectedString name="Source">--[[
	PanelShop - the coin UPGRADE shop (the "Upgrade" button), in the admin-panel style.
	One row per upgrade in Config.Upgrades: logo, name, description, level bar, price, BUY.
	Buying is validated by the server (BuyUpgrade remote).
	(The Robux donation shop is PanelDonate, opened by the "Shop" button.)
]]
local PanelShop = {}

local C, UIKit, Store, Config, Format, Remotes, Formulas
local panel
local rows = {}
local HIDDEN = {} -- upgrade ids not sold here

function PanelShop.Refresh()
	local coins = Store.Attr("Coins")
	for id, r in pairs(rows) do
		local def = r.Def
		local level = Store.UpgradeLevel(id)
		local maxed = level &gt;= def.Max
		r.Level.Text = "LEVEL " .. level .. " / " .. def.Max
		r.Level.TextColor3 = maxed and UIKit.C.Gold or UIKit.C.Muted
		r.Fill.Size = UDim2.fromScale(math.clamp(level / math.max(def.Max, 1), 0, 1), 1)
		r.Fill.Visible = level &gt; 0
		if maxed then
			r.Price.Text = "MAXED"
			r.Buy.Text = "MAX"
			UIKit.SetDisabled(r.Buy, true, Color3.fromRGB(58, 120, 72))
		else
			local cost = Formulas.UpgradeCost(def, level)
			r.Price.Text = Format.Number(cost)
			r.Buy.Text = "BUY"
			UIKit.SetDisabled(r.Buy, coins &lt; cost, Color3.fromRGB(80, 86, 112))
		end
	end
end

function PanelShop.Init(client)
	C = client
	UIKit, Store, Config, Format, Remotes, Formulas = C.UIKit, C.Store, C.Config, C.Format, C.Remotes, C.Formulas
	panel = UIKit.GoldPanel(C.Root, "Shop", "UPGRADES", Vector2.new(720, 560), { Icon = "UPG_Power", Emoji = "⬆️" })

	local s = UIKit.Section(panel.Content, "SPEND COINS ON PERMANENT BOOSTS", { Icon = "Money", Emoji = "💵", LayoutOrder = 1 })
	for _, def in ipairs(Config.Upgrades) do
		if not HIDDEN[def.Id] then
			local row = s.Row(64, true)
			local card = UIKit.Card({ Name = def.Id, Top = Color3.fromRGB(44, 64, 124), Bottom = Color3.fromRGB(26, 36, 78), Size = UDim2.fromScale(1, 1), Radius = 12,
				OutlineThickness = 2, ZIndex = 24, Parent = row })
			UIKit.Icon({ Icon = "UPG_" .. def.Id, Emoji = def.Icon, Size = UDim2.fromOffset(52, 52), Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
				ZIndex = 25, Parent = card })
			UIKit.Text({ Text = def.Name, TextSize = 19, Size = UDim2.new(0, 260, 0, 22), Position = UDim2.fromOffset(66, 4), XAlign = Enum.TextXAlignment.Left,
				StrokeThickness = 2.2, ZIndex = 25, Parent = card })
			UIKit.Text({ Text = def.Desc, TextSize = 13, Color = UIKit.C.Muted, Size = UDim2.new(0, 260, 0, 16), Position = UDim2.fromOffset(66, 25), XAlign = Enum.TextXAlignment.Left,
				StrokeThickness = 1.2, ZIndex = 25, Parent = card })
			local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(12, 18, 44), Bottom = Color3.fromRGB(8, 12, 30), Size = UDim2.fromOffset(150, 12),
				Position = UDim2.fromOffset(66, 45), Radius = 8, OutlineThickness = 2, Clip = true, ZIndex = 25, Parent = card })
			local fill = UIKit.Card({ Name = "Fill", Top = Color3.fromRGB(255, 226, 90), Bottom = Color3.fromRGB(240, 150, 20), Size = UDim2.fromScale(0, 1), Radius = 8,
				OutlineThickness = 0, ZIndex = 25, Parent = track })
			fill:FindFirstChildOfClass("UIStroke").Enabled = false
			local level = UIKit.Text({ Text = "", TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.fromOffset(120, 14), Position = UDim2.fromOffset(224, 44),
				XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.2, ZIndex = 25, Parent = card })
			local _, price = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "", TextSize = 18, IconSize = 26, Align = "Right", Color = UIKit.C.Coins, StrokeThickness = 2,
				Size = UDim2.fromOffset(130, 30), Position = UDim2.new(1, -124, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 25, Parent = card })
			local buy = UIKit.Button({ Name = "Buy", Text = "BUY", Color = UIKit.C.Good, TextSize = 20, Gloss = true, Size = UDim2.fromOffset(104, 46),
				Position = UDim2.new(1, -8, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Radius = 12, ZIndex = 25, Parent = card,
				OnClick = function()
					local result = Remotes.Get("BuyUpgrade"):InvokeServer(def.Id)
					if result and result.Ok then
						C.Sfx.Play("Buy")
						C.Fx.Flash(UIKit.C.Gold, 0.88, 0.22)
					else
						C.Sfx.Play("Error")
						C.HUD.Toast(result and result.Msg or "Can't buy that.", "Error")
					end
				end })
			rows[def.Id] = { Def = def, Level = level, Fill = fill, Price = price, Buy = buy }
		end
	end
	panel.OnOpen = PanelShop.Refresh
	Store.StateChanged:Connect(function()
		if panel.IsOpen then PanelShop.Refresh() end
	end)
	Store.Watch("Coins", function()
		if panel.IsOpen then PanelShop.Refresh() end
	end)
	PanelShop.Refresh()
end

return PanelShop
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX42">
          <Properties>
            <string name="Name">PetVisuals</string>
            <ProtectedString name="Source">--[[
	PetVisuals - draws every player's equipped pets following them around.

	Pets are built locally from simple Parts (a body, eyes and a themed extra) so no models are
	needed. Rarity changes size, glow and sparkles; Secret pets cycle through rainbow colours.
	The same builder is used for the little viewport icons in the Pets / Egg panels.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PetTemplates = ReplicatedStorage:WaitForChild("GymShared"):WaitForChild("PetTemplates")
local DoggyTemplate = PetTemplates:WaitForChild("Doggy")

local PetVisuals = {}

local Config
local followers = {} -- [player] = { Ids = {petId...}, Models = {Model...}, Frames = {CFrame...}, Signature = "" }
local rainbowParts = {}
local petFolder

local function hashString(s)
	local h = 0
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 100003
	end
	return h
end

local function part(parent, shape, size, color, material, offset)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Shape = shape or Enum.PartType.Block
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CFrame = CFrame.new(offset or Vector3.new())
	p.Parent = parent
	return p
end

-- Builds the uploaded Pet_Index "Doggy" model at the origin.
-- The supplied RBXM contains one actual pet mesh set, so every hatch now uses that
-- mesh as the visual base. Area/rarity changes the colour, size and effects.
local function shade(color, amount)
	return color:Lerp(Color3.new(0, 0, 0), math.clamp(amount, 0, 1))
end

local function tint(color, amount)
	return color:Lerp(Color3.new(1, 1, 1), math.clamp(amount, 0, 1))
end

function PetVisuals.Build(def)
	local rarity = Config.Rarities[def.Rarity]
	local order = rarity.Order

	local model = DoggyTemplate:Clone()
	model.Name = def.Name

	local primary = model:FindFirstChild("Primary")
	if not primary then
		model:Destroy()
		return Instance.new("Model")
	end
	model.PrimaryPart = primary

	-- The Doggy template is ~4 studs tall (feet to ear tips). Scale it to a normal
	-- simulator pet size: ~1.8 studs for Common up to ~2.6 studs for the top rarity.
	local petScale = 0.45 + (order - 1) * 0.028
	model:ScaleTo(petScale)
	model:PivotTo(CFrame.new())
	-- Remember how far the feet are below the pivot so the follower can put them on the floor.
	local boxCF, boxSize = model:GetBoundingBox()
	model:SetAttribute("FootOffset", -(boxCF.Position.Y - boxSize.Y * 0.5))

	local body = model:FindFirstChild("Body")
	local legs = model:FindFirstChild("Legs")
	local ears = model:FindFirstChild("DogEars")
	local tail = model:FindFirstChild("Tail1")

	local bodyColor = def.Color
	local darkColor = shade(def.Color, 0.28)
	local accentColor = tint(def.Color, 0.18)

	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.CanTouch = false
			obj.CanQuery = false
			obj.CastShadow = false
			obj.Massless = true
		end
	end

	-- Solid body colour; only the small accent pieces glow on high rarities so the pet
	-- keeps its shape instead of turning into a flat neon blob.
	local accentMaterial = order &gt;= 6 and Enum.Material.Neon or Enum.Material.SmoothPlastic
	if body then
		body.Color = bodyColor
		body.Material = Enum.Material.SmoothPlastic
	end
	if legs then
		legs.Color = darkColor
		legs.Material = Enum.Material.SmoothPlastic
	end
	if ears then
		ears.Color = order &gt;= 6 and rarity.Color or darkColor
		ears.Material = accentMaterial
	end
	if tail then
		tail.Color = order &gt;= 6 and rarity.Color or accentColor
		tail.Material = accentMaterial
	end

	-- Keep rarity readable without replacing the supplied pet geometry.
	if body and order &gt;= 3 then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "RaritySparkles"
		emitter.Color = ColorSequence.new(rarity.Color)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.18 + order * 0.035),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.30),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.55, 0.95)
		emitter.Speed = NumberRange.new(0.5, 1.8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.LightEmission = 0.8
		emitter.Rate = (order - 2) * 3
		emitter.Parent = body
	end

	if body and order &gt;= 5 then
		local light = Instance.new("PointLight")
		light.Name = "RarityGlow"
		light.Color = rarity.Color
		light.Range = 6 + order
		light.Brightness = 0.45 + order * 0.08
		light.Parent = body
	end

	if rarity.Rainbow then
		for _, obj in ipairs({body, legs, ears, tail}) do
			if obj then
				rainbowParts[#rainbowParts + 1] = obj
			end
		end
	end

	return model
end

-- Puts a rotating-free 3D icon into `parent` (a GuiObject). Returns the ViewportFrame.
function PetVisuals.Icon(parent, def, size, zIndex)
	local vp = Instance.new("ViewportFrame")
	vp.BackgroundTransparency = 1
	vp.Size = size or UDim2.fromScale(1, 1)
	vp.ZIndex = zIndex or 3
	vp.Ambient = Color3.fromRGB(190, 190, 200)
	vp.LightColor = Color3.new(1, 1, 1)
	local model = PetVisuals.Build(def)
	model.Parent = vp
	local cam = Instance.new("Camera")
	local extents = model:GetExtentsSize()
	local d = math.max(extents.X, extents.Y, extents.Z)
	cam.CFrame = CFrame.lookAt(Vector3.new(d * 0.42, d * 0.28, -d * 1.75), Vector3.new(0, 0, 0))
	cam.FieldOfView = 38
	cam.Parent = vp
	vp.CurrentCamera = cam
	vp.Parent = parent
	return vp
end

----------------------------------------------------------------------
-- Following
----------------------------------------------------------------------
local function clearFollower(player)
	local f = followers[player]
	if not f then
		return
	end
	for _, m in ipairs(f.Models) do
		m:Destroy()
	end
	followers[player] = nil
end

local function refresh(player)
	local value = player:GetAttribute("EquippedPets") or ""
	local f = followers[player]
	if f and f.Signature == value then
		return
	end
	clearFollower(player)
	local f2 = { Signature = value, Models = {}, Frames = {} }
	for id in string.gmatch(value, "[^,]+") do
		local def = Config.PetsById[id]
		if def then
			local model = PetVisuals.Build(def)
			model.Parent = petFolder
			f2.Models[#f2.Models + 1] = model
		end
	end
	followers[player] = f2
end

local function slotOffset(i, n)
	-- up to 8 pets in two staggered rows behind the player
	local row = math.floor((i - 1) / 4)
	local inRow = math.min(4, n - row * 4)
	local col = (i - 1) % 4
	local x = (col - (inRow - 1) / 2) * 2.6
	local z = 3.6 + row * 3.0
	return x, z
end

function PetVisuals.Init(client)
	Config = client.Config
	petFolder = Instance.new("Folder")
	petFolder.Name = "GymPets"
	petFolder.Parent = Workspace

	local function watch(player)
		player:GetAttributeChangedSignal("EquippedPets"):Connect(function()
			refresh(player)
		end)
		refresh(player)
	end
	for _, p in ipairs(Players:GetPlayers()) do
		watch(p)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(clearFollower)

	local hueClock = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()
		hueClock = (hueClock + dt * 0.4) % 1
		for player, f in pairs(followers) do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root then
				local n = #f.Models
				local heightScale = 1
				local humanoid = character:FindFirstChildOfClass("Humanoid")
				local hs = humanoid and humanoid:FindFirstChild("BodyHeightScale")
				if hs then
					heightScale = hs.Value
				end
				-- Distance from the root part's centre down to the floor.
				local groundDrop = root.Size.Y * 0.5 + (humanoid and humanoid.HipHeight or 2)
				if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
					groundDrop = root.Size.Y * 0.5 + 2
				end
				local look = root.CFrame.LookVector
				local yaw = math.atan2(-look.X, -look.Z)
				local rootCF = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
				for i, model in ipairs(f.Models) do
					local x, z = slotOffset(i, n)
					local bob = math.sin(t * 3 + i * 1.7) * 0.18
					local foot = model:GetAttribute("FootOffset") or 0.8
					local y = -groundDrop + foot + 0.35 + bob
					local target = rootCF * CFrame.new(x * heightScale, y, z * heightScale)
					local current = f.Frames[i]
					if not current or (current.Position - target.Position).Magnitude &gt; 60 then
						current = target
					else
						current = current:Lerp(target, math.min(1, dt * 7))
					end
					f.Frames[i] = current
					if model.PrimaryPart then
						model:PivotTo(current)
					end
				end
			end
		end
		for i = #rainbowParts, 1, -1 do
			local p = rainbowParts[i]
			if p.Parent then
				p.Color = Color3.fromHSV(hueClock, 0.7, 1)
			else
				table.remove(rainbowParts, i)
			end
		end
	end)
end

return PetVisuals
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX43">
          <Properties>
            <string name="Name">Sfx</string>
            <ProtectedString name="Source">--[[
	Sfx - plays short UI / gameplay sounds defined in Config.Sounds.
	Missing / unloadable sound ids fail silently, so the game never breaks because of audio.
]]
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("GymShared").Config)

local Sfx = {}
Sfx.Muted = false

function Sfx.Play(name, pitchScale, volumeScale)
	if Sfx.Muted then
		return
	end
	local def = Config.Sounds[name]
	if not def then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = def.Id
	sound.Volume = (def.Volume or 0.5) * (volumeScale or 1)
	sound.PlaybackSpeed = (def.Pitch or 1) * (pitchScale or 1) * (0.94 + math.random() * 0.12)
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 4)
end

return Sfx
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX44">
          <Properties>
            <string name="Name">Store</string>
            <ProtectedString name="Source">--[[
	Store - the client's mirror of the server's data (read-only for the UI).
	Fast numbers (Strength, Coins...) come from Player attributes; everything else from
	the SyncState / SyncInventory remotes. Panels listen to the Changed signals.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Signal = require(Shared.Signal)
local Config = require(Shared.Config)
local Formulas = require(Shared.Formulas)

local Store = {}

local player = Players.LocalPlayer

Store.State = {
	Areas = { Beginner = true },
	Stations = { Beginner_1 = true },
	Upgrades = {},
	Quest = nil,
	AutoTrain = false,
	Stats = {},
}
Store.Inventory = { Pets = {}, Equipped = {}, Slots = Config.Game.BasePetSlots, Max = Config.Game.MaxPetsOwned }
Store.TrainingStation = nil -- station id while training

Store.StateChanged = Signal.new()
Store.InventoryChanged = Signal.new()
Store.TrainingChanged = Signal.new()

function Store.Attr(name)
	local v = player:GetAttribute(name)
	if v == nil then
		return 0
	end
	return v
end

-- calls fn(value) now and every time the attribute changes; returns the connection
function Store.Watch(name, fn)
	local connection = player:GetAttributeChangedSignal(name):Connect(function()
		fn(Store.Attr(name))
	end)
	fn(Store.Attr(name))
	return connection
end

function Store.AreaUnlocked(areaId)
	return Store.State.Areas[areaId] == true
end

function Store.OwnsStation(stationId)
	return Store.State.Stations[stationId] == true
end

function Store.UpgradeLevel(id)
	return Formulas.Level(Store.State.Upgrades, id)
end

function Store.Luck()
	return Formulas.Luck(Store.State.Upgrades)
end

function Store.IsEquipped(uid)
	return table.find(Store.Inventory.Equipped, uid) ~= nil
end

function Store.PetCount()
	return #Store.Inventory.Pets
end

function Store.GetPet(uid)
	for _, p in ipairs(Store.Inventory.Pets) do
		if p.u == uid then
			return p
		end
	end
	return nil
end

function Store.Init(Remotes)
	Remotes.Get("SyncState").OnClientEvent:Connect(function(state)
		Store.State = state
		Store.StateChanged:Fire(state)
	end)
	Remotes.Get("SyncInventory").OnClientEvent:Connect(function(inv)
		Store.Inventory = inv
		Store.InventoryChanged:Fire(inv)
	end)
	Remotes.Get("TrainingState").OnClientEvent:Connect(function(active, stationId)
		Store.TrainingStation = active and stationId or nil
		Store.TrainingChanged:Fire(Store.TrainingStation)
	end)
end

return Store
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX45">
          <Properties>
            <string name="Name">TrainingController</string>
            <ProtectedString name="Source">--[[
	TrainingController - client input, poses and feedback for every station.

	Free weights (Dumbbell / Squat / Deadlift) are different from fixed machines:
	  * pressing E at their rack starts a carry session
	  * the player stays mobile
	  * no Tool/Backpack is used
	  * DumbbellAnim creates the held visual and animation locally
	Fixed machines keep the original stand/freeze/mover behaviour from the server.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")

local TrainingController = {}
local FreeweightAnim = require(script.Parent.DumbbellAnim)
local PoseDriver = require(script.Parent.PoseDriver)

local C, Store, Fx, Sfx, Format, Config, Remotes, UIKit

local SEND_INTERVAL = 1 / 7
local active = false
local stationDef = nil
local freeWeight = false
local lastSend = 0
local repCount = 0

local mover = nil
local hiddenStockMover = nil
local joints = nil -- Motor6D joints of the local character while on a fixed machine
local driver = nil -- PoseDriver playing the machine pose (see PoseDriver for why)
local treadmillPhase = 0
local treadmillRunning = false
local jogBoost = 0 -- each treadmill rep speeds the jog up for a moment

----------------------------------------------------------------------
-- Fixed-machine poses (free-weight poses live in DumbbellAnim)
----------------------------------------------------------------------
local A = math.rad
local function ang(x, y, z)
	return CFrame.Angles(A(x or 0), A(y or 0), A(z or 0))
end

local POSES = {
	Press = {
		Rest = { RS = ang(80), LS = ang(80) },
		Rep = { RS = ang(172), LS = ang(172), Waist = ang(-4) },
	},
	Curl = {
		Rest = { RS = ang(8), LS = ang(8) },
		Rep = { RS = ang(96), LS = ang(96), Waist = ang(-6) },
	},
	Run = {
		Rest = { RS = ang(-10), LS = ang(-10) },
		Rep = { RS = ang(55), LS = ang(-55), RH = ang(-45), LH = ang(40), RK = ang(-10), LK = ang(-70), Waist = ang(-8) },
		Rep2 = { RS = ang(-55), LS = ang(55), RH = ang(40), LH = ang(-45), RK = ang(-70), LK = ang(-10), Waist = ang(-8) },
		Alt = true,
	},
	Squat = {
		Rest = { RS = ang(82), LS = ang(82) },
		Rep = { RS = ang(82), LS = ang(82), RH = ang(68), LH = ang(68), RK = ang(-88), LK = ang(-88), Waist = ang(-14), Root = CFrame.new(0, -1.25, 0.2) },
	},
	-- Boxing: guard up (fists by the chin, knees soft), then alternate jab / cross with a
	-- hip + shoulder turn; a critical rep throws an uppercut.
	Punch = {
		Rest = { RS = ang(72), LS = ang(72), RE = ang(118), LE = ang(118), RH = ang(10), LH = ang(10), RK = ang(-20), LK = ang(-20),
			Waist = ang(-5, 12, 0), Root = CFrame.new(0, -0.22, 0) },
		Rep = { RS = ang(94), RE = ang(4), LS = ang(66), LE = ang(122), RH = ang(16), LH = ang(6), RK = ang(-22), LK = ang(-16),
			Waist = ang(-7, -30, 0), Root = CFrame.new(0, -0.26, -0.12) },
		Rep2 = { LS = ang(94), LE = ang(4), RS = ang(66), RE = ang(122), RH = ang(6), LH = ang(16), RK = ang(-16), LK = ang(-22),
			Waist = ang(-7, 28, 0), Root = CFrame.new(0, -0.26, -0.12) },
		Crit = { RS = ang(150), RE = ang(70), LS = ang(70), LE = ang(118), RH = ang(4), LH = ang(4), RK = ang(-8), LK = ang(-8),
			Waist = ang(8, -18, 0), Root = CFrame.new(0, 0.12, 0) },
		Alt = true,
		Out = 0.07,
		Back = 0.17,
	},
	Deadlift = {
		Rest = { RS = ang(14), LS = ang(14), RH = ang(48), LH = ang(48), RK = ang(-58), LK = ang(-58), Waist = ang(-46), Root = CFrame.new(0, -0.9, 0.3) },
		Rep = { RS = ang(6), LS = ang(6), Waist = ang(-6) },
	},
	-- Giant weights (boulder / anvil / Olympus weight): squat down, then heave overhead.
	Lift = {
		Rest = { RS = ang(40, 0, 20), LS = ang(40, 0, -20), RH = ang(55), LH = ang(55), RK = ang(-70), LK = ang(-70), Waist = ang(-20), Root = CFrame.new(0, -0.9, 0.2) },
		Rep = { RS = ang(170, 0, 14), LS = ang(170, 0, -14), Waist = ang(4), Root = CFrame.new(0, 0.15, 0) },
	},
	-- Machines (gravity trainer / plasma press / ascension engine): seated-style row pull.
	Pull = {
		Rest = { RS = ang(85, 0, 10), LS = ang(85, 0, -10), Waist = ang(-10) },
		Rep = { RS = ang(20, 0, 25), LS = ang(20, 0, -25), Waist = ang(8) },
	},
}

local isR6 = false

local function findJoints(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end
	local function motor(partName, motorName)
		local part = character:FindFirstChild(partName)
		return part and part:FindFirstChild(motorName)
	end
	local j
	isR6 = humanoid.RigType ~= Enum.HumanoidRigType.R15
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		j = {
			RS = motor("RightUpperArm", "RightShoulder"), LS = motor("LeftUpperArm", "LeftShoulder"),
			RH = motor("RightUpperLeg", "RightHip"), LH = motor("LeftUpperLeg", "LeftHip"),
			RK = motor("RightLowerLeg", "RightKnee"), LK = motor("LeftLowerLeg", "LeftKnee"),
			Waist = motor("UpperTorso", "Waist"), Root = motor("LowerTorso", "Root"),
			RE = motor("RightLowerArm", "RightElbow"), LE = motor("LeftLowerArm", "LeftElbow"),
		}
	else
		j = {
			RS = motor("Torso", "Right Shoulder"), LS = motor("Torso", "Left Shoulder"),
			RH = motor("Torso", "Right Hip"), LH = motor("Torso", "Left Hip"),
			Root = motor("HumanoidRootPart", "RootJoint"),
		}
	end
	local out = {}
	for name, m in pairs(j) do
		if m then
			out[name] = m
		end
	end
	return next(out) and out or nil
end

-- R6 shoulder/hip motors are yawed 90 degrees, so the X-axis pitch used by the R15
-- poses would swing R6 limbs sideways. Convert it to the R6 forward axis instead.
local R6_SIGN = { RS = 1, RH = 1, LS = -1, LH = -1 }
local function convertForRig(name, offset)
	if not isR6 or not offset then return offset end
	local sign = R6_SIGN[name]
	if not sign then return nil end -- R6 has no waist/knees; skip root shifts too
	local x = offset:ToEulerAnglesXYZ()
	return CFrame.Angles(0, 0, x * sign)
end

-- pose table converted for the character's rig (R6 drops waist / knees / elbows)
local function rigPose(pose)
	local out = {}
	for name, offset in pairs(pose) do
		out[name] = convertForRig(name, offset)
	end
	return out
end

local function applyPose(pose, duration)
	if driver then
		driver:To(rigPose(pose), duration)
	end
end

local function resetPose()
	if driver then
		driver:Destroy()
		driver = nil
	end
	joints = nil
end

-- Treadmill: the REAL Roblox run animation - the one in the character's Animate script
-- (so it matches the player's avatar animation pack), with Roblox's default run as a
-- fallback. Played at Action priority so it wins over idle; reps speed it up briefly.
local DEFAULT_RUN = { R15 = "rbxassetid://913376220", R6 = "rbxassetid://180426354" }
local runTrack = nil

local function stopRun()
	if runTrack then
		runTrack:Stop(0.2)
		runTrack = nil
	end
end

local function startRun(character)
	stopRun()
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	local id
	local animate = character:FindFirstChild("Animate")
	local runFolder = animate and animate:FindFirstChild("run")
	local anim = runFolder and runFolder:FindFirstChildOfClass("Animation")
	if anim and anim.AnimationId ~= "" then
		id = anim.AnimationId
	else
		id = humanoid.RigType == Enum.HumanoidRigType.R15 and DEFAULT_RUN.R15 or DEFAULT_RUN.R6
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		track:Play(0.25, 1, 1.15)
		runTrack = track
	end
end

----------------------------------------------------------------------
-- Finding the world station (fixed machines animate their Mover model)
----------------------------------------------------------------------
local function findStationModel(stationId)
	for _, model in ipairs(CollectionService:GetTagged("GymStation")) do
		if model:GetAttribute("StationId") == stationId then return model end
	end
	return nil
end

local function setStockVisible(moverModel, visible)
	if not moverModel then return end
	for _, obj in ipairs(moverModel:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.LocalTransparencyModifier = visible and 0 or 1
		elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
			obj.Enabled = visible
		end
	end
end

local function clearLocalState()
	treadmillRunning = false
	treadmillPhase = 0
	jogBoost = 0
	stopRun()
	if mover and mover.Model and mover.Model.Parent then
		mover.Model:PivotTo(mover.Base)
	end
	mover = nil
	if hiddenStockMover then
		setStockVisible(hiddenStockMover, true)
		hiddenStockMover = nil
	end
	resetPose()
	FreeweightAnim.Detach()
end

local function setTrainButtonText()
	local hud = C and C.HUD
	if not hud or not hud.TrainButton or not stationDef then return end
	if stationDef.Kind == "Dumbbell" then
		hud.TrainButton.Text = "💪 CURL!"
	elseif stationDef.Kind == "Deadlift" then
		hud.TrainButton.Text = "🏋️ DEADLIFT!"
	elseif stationDef.Kind == "Squat" then
		hud.TrainButton.Text = "🏋️ PRESS!"
	else
		hud.TrainButton.Text = "💪 TRAIN!"
	end
end

----------------------------------------------------------------------
-- Start / stop
----------------------------------------------------------------------
local function start(stationId)
	clearLocalState()
	stationDef = Config.StationsById[stationId]
	if not stationDef then
		active = false
		return
	end
	active = true
	freeWeight = FreeweightAnim.IsFreeWeight(stationDef.Kind)
	repCount = 0
	lastSend = 0
	setTrainButtonText()
	if C.HUD.SetWorkout then
		C.HUD.SetWorkout(stationDef)
	end

	local character = Players.LocalPlayer.Character
	if freeWeight then
		if character then
			FreeweightAnim.Attach(character, stationDef)
		end
		-- A grabbed bar should no longer remain visibly floating on the rack/platform
		-- for this player. Other players still see their own local copy of the stock.
		if stationDef.Kind == "Squat" or stationDef.Kind == "Deadlift" then
			local stockModel = findStationModel(stationId)
			hiddenStockMover = stockModel and stockModel:FindFirstChild("Mover") or nil
			setStockVisible(hiddenStockMover, false)
		end
		mover = nil
	else
		local model = findStationModel(stationId)
		local m = model and model:FindFirstChild("Mover")
		if m then
			mover = {
				Model = m,
				Base = m:GetPivot(),
				Kind = m:GetAttribute("MoverKind"),
				Amp = m:GetAttribute("Amp") or 1,
				Spin = m:GetAttribute("SpinSpeed"),
				Kick = 0, Flow = 0, SpinAngle = 0,
				Dir = stationDef.Kind == "Squat" and -1 or 1,
			}
		end
		if character then
			joints = findJoints(character)
			driver = joints and PoseDriver.new(joints) or nil
		end
		local pose = POSES[stationDef.Pose] or POSES.Press
		if stationDef.Kind == "Treadmill" then
			treadmillPhase = 0
			treadmillRunning = true
			if driver then
				driver:Destroy() -- the real run animation drives the body
				driver = nil
			end
			startRun(character)
		else
			applyPose(pose.Rest, 0.25)
			if stationDef.Pose == "Punch" and driver then
				-- a light boxer's bounce on top of whatever punch is playing
				driver.Extra = function(name)
					if name == "Root" and not isR6 then
						return CFrame.new(0, 0.06 * math.abs(math.sin(os.clock() * 7)), 0)
					end
				end
			end
		end
	end

	Sfx.Play("Equip")
	local pos = Fx.CharacterPosition()
	if pos then
		Fx.Ring(pos - Vector3.new(0, 2.8, 0), Config.AreasById[stationDef.Area].Theme.Accent, 16, 0.5)
	end
end

local function stop()
	active = false
	clearLocalState()
	stationDef = nil
	freeWeight = false
	if C and C.HUD and C.HUD.TrainButton then
		C.HUD.TrainButton.Text = "💪 TRAIN!"
	end
end

----------------------------------------------------------------------
-- Reps
----------------------------------------------------------------------
local function playRep()
	if not stationDef then return end
	repCount = repCount + 1
	if freeWeight then
		FreeweightAnim.Rep(false)
	else
		if stationDef.Kind == "Treadmill" then
			jogBoost = 1
			if runTrack then
				runTrack:AdjustSpeed(1.6) -- sprint for a moment on every rep
				task.delay(0.6, function()
					if runTrack then runTrack:AdjustSpeed(1.15) end
				end)
			end
		else
			local pose = POSES[stationDef.Pose] or POSES.Press
			local repPose = pose.Rep
			if pose.Alt and repCount % 2 == 0 then repPose = pose.Rep2 end
			if pose.Crit and repCount % 5 == 0 then repPose = pose.Crit end
			local out, back = pose.Out or 0.12, pose.Back or 0.18
			applyPose(repPose, out)
			local myStation = stationDef
			task.delay(out + 0.03, function()
				if active and stationDef == myStation then applyPose(pose.Rest, back) end
			end)
		end
		if mover then mover.Kick = 1 end
	end
	Sfx.Play("Rep", 1 + math.min(repCount % 8, 6) * 0.03)
	if C and C.SweatAura then
		C.SweatAura.Pulse()
	end
	if C and C.HUD.SetReps then
		C.HUD.SetReps(repCount)
	end
end

local function sendRep()
	if not active then return end
	local now = os.clock()
	if now - lastSend &lt; SEND_INTERVAL then return end
	lastSend = now
	Remotes.Get("Train"):FireServer()
	playRep()
end

local function updateMover(dt)
	if not mover then return end
	if not mover.Model.Parent then mover = nil; return end
	mover.Kick = math.max(0, mover.Kick - dt * 5.5)
	local cf = mover.Base
	local kick = mover.Kick
	if mover.Kind == "Lift" then
		cf = cf * CFrame.new(0, mover.Amp * kick * mover.Dir, 0)
	elseif mover.Kind == "Swing" then
		cf = cf * CFrame.Angles(mover.Amp * kick, 0, 0)
	elseif mover.Kind == "Flow" then
		mover.Flow = (mover.Flow + dt * ((stationDef and stationDef.Kind == "Treadmill") and (5.5 + 5.0 * kick) or (2.5 + 9 * kick))) % 2
		cf = cf * CFrame.new(0, 0, mover.Flow)
	end
	if mover.Spin then
		mover.SpinAngle = mover.SpinAngle + dt * mover.Spin * (1 + kick * 2)
		cf = cf * CFrame.Angles(0, mover.SpinAngle, 0)
	end
	mover.Model:PivotTo(cf)
end

----------------------------------------------------------------------
-- Server result (all payout remains server-authoritative)
----------------------------------------------------------------------
local coinTick = 0
local function onTrainResult(gain, coins, crit)
	local pos = Fx.CharacterPosition()
	if not pos then return end
	local jitter = Vector3.new((math.random() - 0.5) * 4, 3.6 + math.random() * 0.8, (math.random() - 0.5) * 2)
	if crit then
		Fx.FloatText(pos + jitter + Vector3.new(0, 1.5, 0), "CRIT! +" .. Format.Number(gain), Color3.fromRGB(255, 220, 60), 46, 1.1, 6)
		Fx.Burst(pos + Vector3.new(0, 1, 0), Color3.fromRGB(255, 220, 60), 26, 30, 0.9)
		Fx.Shake(0.5, 0.3)
		Fx.FovPunch(7, 0.3)
		Fx.Flash(Color3.fromRGB(255, 230, 140), 0.85, 0.25)
		Sfx.Play("Crit")
	else
		Fx.FloatText(pos + jitter, "+" .. Format.Number(gain), Color3.fromRGB(255, 130, 96), 30, 0.85, 5)
		if repCount % 2 == 0 then
			Fx.Burst(pos + Vector3.new(0, 0.5, 0), Color3.fromRGB(255, 170, 90), 5, 16, 0.5)
		end
	end
	coinTick = coinTick + 1
	if coinTick % 3 == 0 or crit then
		Fx.FloatText(pos + Vector3.new((math.random() - 0.5) * 3, 1.6, 0), "+" .. Format.Number(coins) .. " 💵", Color3.fromRGB(255, 214, 70), 20, 0.8, 3.5)
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function TrainingController.Init(client)
	C = client
	Store, Fx, Sfx, Format, Config, Remotes, UIKit = C.Store, C.Fx, C.Sfx, C.Format, C.Config, C.Remotes, C.UIKit

	Remotes.Get("TrainResult").OnClientEvent:Connect(onTrainResult)

	Store.TrainingChanged:Connect(function(stationId)
		if stationId then start(stationId) else stop() end
	end)

	-- Click / tap / Space = one rep per press. Free weights remain mobile.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then return end
		local k = input.KeyCode
		local t = input.UserInputType
		if k == Enum.KeyCode.Space then sendRep(); return end
		if processed then return end
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then sendRep() end
	end)

	local hud = C.HUD
	hud.TrainButton.Activated:Connect(sendRep)
	hud.StopButton.Activated:Connect(function()
		Remotes.Get("StopTraining"):FireServer()
	end)
	-- Auto Clicker (donation perk): sends reps for you at the normal click pace. The server
	-- still decides every rep (same Train remote, same rate cap) - this only saves clicking.
	local autoClick = false
	local function ownsAutoClicker()
		return Store.State.Perks ~= nil and Store.State.Perks.AutoClicker == true
	end
	hud.SetAutoClick(false, ownsAutoClicker())
	hud.AutoClickButton.Activated:Connect(function()
		if not ownsAutoClicker() then
			C.OpenPanel("Donate")
			return
		end
		autoClick = not autoClick
		hud.SetAutoClick(autoClick, true)
	end)
	Store.StateChanged:Connect(function()
		if autoClick and not ownsAutoClicker() then
			autoClick = false
		end
		hud.SetAutoClick(autoClick, ownsAutoClicker())
	end)
	RunService.Heartbeat:Connect(function()
		if autoClick and active then
			sendRep()
		end
	end)

	-- The belt is visual-only and can update on RenderStepped.
	RunService.RenderStepped:Connect(function(dt)
		if active and not freeWeight then
			updateMover(dt)
		end
	end)


	Players.LocalPlayer.CharacterAdded:Connect(function()
		-- The server will resend/clear state as appropriate. This guarantees no old local
		-- attachment survives a respawn frame.
		stop()
	end)
end

return TrainingController
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX46">
          <Properties>
            <string name="Name">UIKit</string>
            <ProtectedString name="Source">--[[
	UIKit - tiny helpers to build the same chunky, colourful "simulator" look everywhere:
	rounded frames, outlined labels, springy buttons and pop-up panels.
]]
local TweenService = game:GetService("TweenService")

local UIKit = {}

UIKit.C = {
	Bg = Color3.fromRGB(10, 18, 38),
	Panel = Color3.fromRGB(18, 32, 68),
	PanelLight = Color3.fromRGB(48, 88, 174),
	PanelDark = Color3.fromRGB(9, 18, 44),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(196, 214, 255),
	Strength = Color3.fromRGB(255, 112, 84),
	Coins = Color3.fromRGB(255, 208, 56),
	Rebirth = Color3.fromRGB(190, 112, 255),
	Mult = Color3.fromRGB(80, 232, 140),
	Good = Color3.fromRGB(64, 200, 104),
	Bad = Color3.fromRGB(240, 82, 92),
	Blue = Color3.fromRGB(44, 156, 255),
	Orange = Color3.fromRGB(255, 154, 48),
	-- chunky "sim" card palette (thick outlines, gold/orange accents, deep navy)
	Outline = Color3.fromRGB(12, 12, 18),
	Gold = Color3.fromRGB(255, 200, 52),
	GoldDark = Color3.fromRGB(240, 132, 22),
	Navy = Color3.fromRGB(14, 22, 48),
	NavyLight = Color3.fromRGB(30, 46, 94),
	NavyEdge = Color3.fromRGB(44, 76, 150),
	Purple = Color3.fromRGB(150, 92, 255),
	Gray = Color3.fromRGB(96, 104, 128),
}

UIKit.Root = nil -- the scaled canvas (set by GymClient); tooltips / dropdowns / modals live here

-- IconLoader is required lazily: UIKit is loaded before the HUD and must not depend on load order.
local iconLoaderModule = nil
local function iconLoader()
	if iconLoaderModule == nil then
		local ok, mod = pcall(function()
			return require(script.Parent:WaitForChild("IconLoader"))
		end)
		iconLoaderModule = ok and mod or false
	end
	return iconLoaderModule or nil
end

UIKit.Sfx = nil -- set by init
UIKit.Panels = {} -- [name] = panel object

local function shade(c, f)
	return Color3.new(math.clamp(c.R * f, 0, 1), math.clamp(c.G * f, 0, 1), math.clamp(c.B * f, 0, 1))
end
UIKit.Shade = shade

function UIKit.Tween(instance, time, goal, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

----------------------------------------------------------------------
-- Decorators
----------------------------------------------------------------------
function UIKit.Corner(parent, radius)
	local c = Instance.new("UICorner")
	-- chunky "simulator" look: only slightly rounded corners
	c.CornerRadius = UDim.new(0, math.max(3, math.ceil((radius or 12) * 0.45)))
	c.Parent = parent
	return c
end

function UIKit.Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

function UIKit.Gradient(parent, top, bottom, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

function UIKit.Padding(parent, all)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, all)
	p.PaddingBottom = UDim.new(0, all)
	p.PaddingLeft = UDim.new(0, all)
	p.PaddingRight = UDim.new(0, all)
	p.Parent = parent
	return p
end

function UIKit.List(parent, padding, direction, hAlign, vAlign)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, padding or 6)
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if hAlign then
		l.HorizontalAlignment = hAlign
	end
	if vAlign then
		l.VerticalAlignment = vAlign
	end
	l.Parent = parent
	return l
end

function UIKit.Scale(parent, value)
	local s = Instance.new("UIScale")
	s.Scale = value or 1
	s.Parent = parent
	return s
end

----------------------------------------------------------------------
-- Building blocks
----------------------------------------------------------------------
-- props: any Frame property + Parent, Radius, Stroke (color), StrokeThickness
function UIKit.Frame(props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.Color or UIKit.C.Panel
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.fromScale(1, 1)
	f.Position = props.Position or UDim2.new()
	f.AnchorPoint = props.AnchorPoint or Vector2.new()
	f.BackgroundTransparency = props.Transparency or 0
	f.ClipsDescendants = props.Clip or false
	f.Name = props.Name or "Frame"
	f.LayoutOrder = props.LayoutOrder or 0
	f.ZIndex = props.ZIndex or 1
	f.Visible = props.Visible ~= false
	if props.Radius then
		UIKit.Corner(f, props.Radius)
	end
	if props.Stroke then
		UIKit.Stroke(f, props.Stroke, props.StrokeThickness or 3)
	end
	f.Parent = props.Parent
	return f
end

function UIKit.Text(props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Name = props.Name or "Text"
	l.Text = props.Text or ""
	l.Font = props.Font or Enum.Font.FredokaOne
	l.TextSize = props.TextSize or 20
	l.TextColor3 = props.Color or UIKit.C.Text
	l.TextXAlignment = props.XAlign or Enum.TextXAlignment.Center
	l.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	l.TextWrapped = props.Wrap or false
	l.TextScaled = props.Scaled or false
	l.RichText = props.Rich or false
	l.Size = props.Size or UDim2.fromScale(1, 1)
	l.Position = props.Position or UDim2.new()
	l.AnchorPoint = props.AnchorPoint or Vector2.new()
	l.LayoutOrder = props.LayoutOrder or 0
	l.ZIndex = props.ZIndex or 1
	l.Visible = props.Visible ~= false
	if props.Stroke ~= false then
		local st = Instance.new("UIStroke")
		st.Name = "TextOutline"
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		st.Color = props.StrokeColor or Color3.new(0, 0, 0)
		st.Thickness = props.StrokeThickness or math.max(1.5, (props.TextSize or 20) / 11)
		st.Parent = l
	end
	l.Parent = props.Parent
	return l
end

-- Chunky flat button: coloured body, dark outline, light inner rim, thick outlined text.
-- props: Text, Color, Size, Position, TextSize, OnClick, Parent
function UIKit.Button(props)
	local color = props.Color or UIKit.C.Blue
	local radius = props.Radius or 12
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.Name = props.Name or "Button"
	b.Text = props.Text or ""
	b.Font = props.Font or Enum.Font.FredokaOne
	b.TextSize = props.TextSize or 22
	b.TextColor3 = props.TextColor or Color3.new(1, 1, 1)
	b.TextWrapped = props.Wrap or false
	b.RichText = props.Rich or false
	b.BackgroundColor3 = color
	b.BorderSizePixel = 0
	b.Size = props.Size or UDim2.fromOffset(140, 46)
	b.Position = props.Position or UDim2.new()
	b.AnchorPoint = props.AnchorPoint or Vector2.new()
	b.LayoutOrder = props.LayoutOrder or 0
	b.ZIndex = props.ZIndex or 1
	b.Visible = props.Visible ~= false
	UIKit.Corner(b, radius)
	-- thick text outline
	local textStroke = Instance.new("UIStroke")
	textStroke.Name = "TextOutline"
	textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	textStroke.Color = Color3.new(0, 0, 0)
	textStroke.Thickness = math.max(1.5, (props.TextSize or 22) / 10)
	textStroke.Parent = b
	-- dark outline around the whole button
	local outline = Instance.new("Frame")
	outline.Name = "Outline"
	outline.BackgroundTransparency = 1
	outline.Size = UDim2.fromScale(1, 1)
	outline.ZIndex = b.ZIndex
	outline.Active = false
	UIKit.Corner(outline, radius)
	UIKit.Stroke(outline, Color3.fromRGB(12, 12, 16), props.StrokeThickness or 3)
	outline.Parent = b
	-- light inner rim (the "bevel" in the reference UI)
	local rim = Instance.new("Frame")
	rim.Name = "Rim"
	rim.BackgroundTransparency = 1
	rim.Size = UDim2.new(1, -6, 1, -6)
	rim.Position = UDim2.fromOffset(3, 3)
	rim.ZIndex = b.ZIndex
	rim.Active = false
	UIKit.Corner(rim, math.max(radius - 4, 4))
	local rs = Instance.new("UIStroke")
	rs.Color = shade(color, 1.45)
	rs.Thickness = 2
	rs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	rs.Parent = rim
	rim.Parent = b
	local scale = UIKit.Scale(b, 1)
	b:SetAttribute("BaseColor", color)
	if props.Gloss then
		-- subtle top highlight (the "shine" on the chunky sim buttons)
		local shine = Instance.new("Frame")
		shine.Name = "Gloss"
		shine.BackgroundColor3 = Color3.new(1, 1, 1)
		shine.BackgroundTransparency = 0.78
		shine.BorderSizePixel = 0
		shine.Size = UDim2.new(1, -10, 0.42, 0)
		shine.Position = UDim2.fromOffset(5, 4)
		shine.ZIndex = b.ZIndex
		shine.Active = false
		UIKit.Corner(shine, math.max(radius - 5, 4))
		shine.Parent = b
	end
	if props.Icon then
		-- logo picture inside the button: centred on its own, or a centred [logo][text] group
		local iconOnly = props.IconOnly == true or props.Text == nil
		local pad = props.IconPadding or 8
		if iconOnly then
			local icon = UIKit.Icon({ Icon = props.Icon, Emoji = props.Emoji, ZIndex = b.ZIndex + 1, Parent = b,
				Size = UDim2.new(1, -pad * 2, 1, -pad * 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5) })
			icon.Name = "ButtonIcon"
		else
			local content = Instance.new("Frame")
			content.Name = "Content"
			content.BackgroundTransparency = 1
			content.Size = UDim2.new(0, 0, 1, 0)
			content.AutomaticSize = Enum.AutomaticSize.X
			content.Position = UDim2.fromScale(0.5, 0)
			content.AnchorPoint = Vector2.new(0.5, 0)
			content.ZIndex = b.ZIndex + 1
			content.Active = false
			content.Parent = b
			UIKit.List(content, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
			local s2 = props.IconSize or 26
			local icon = UIKit.Icon({ Icon = props.Icon, Emoji = props.Emoji, ZIndex = b.ZIndex + 1, LayoutOrder = 1, Parent = content, Size = UDim2.fromOffset(s2, s2) })
			icon.Name = "ButtonIcon"
			local label = Instance.new("TextLabel")
			label.Name = "ButtonText"
			label.BackgroundTransparency = 1
			label.Text = b.Text
			label.Font = b.Font
			label.TextSize = b.TextSize
			label.TextColor3 = b.TextColor3
			label.Size = UDim2.new(0, 0, 1, 0)
			label.AutomaticSize = Enum.AutomaticSize.X
			label.LayoutOrder = 2
			label.ZIndex = b.ZIndex + 1
			local ls = Instance.new("UIStroke")
			ls.Color = Color3.new(0, 0, 0)
			ls.Thickness = textStroke.Thickness
			ls.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
			ls.Parent = label
			label.Parent = content
			-- the button keeps its Text (code sets it as usual); the label mirrors it
			b.TextTransparency = 1
			textStroke.Enabled = false
			b:GetPropertyChangedSignal("Text"):Connect(function()
				label.Text = b.Text
			end)
		end
	end
	if props.Tooltip then
		UIKit.Tooltip(b, props.Tooltip)
	end

	b.MouseEnter:Connect(function()
		if b:GetAttribute("Disabled") then
			return
		end
		UIKit.Tween(scale, 0.12, { Scale = 1.05 })
	end)
	b.MouseLeave:Connect(function()
		UIKit.Tween(scale, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		UIKit.Tween(scale, 0.06, { Scale = 0.94 })
	end)
	b.MouseButton1Up:Connect(function()
		UIKit.Tween(scale, 0.1, { Scale = 1.04 }, Enum.EasingStyle.Back)
	end)
	b.Activated:Connect(function()
		if b:GetAttribute("Disabled") then
			if UIKit.Sfx then
				UIKit.Sfx.Play("Error", 1.3, 0.5)
			end
			return
		end
		if UIKit.Sfx and not props.Silent then
			UIKit.Sfx.Play("Click")
		end
		if props.OnClick then
			props.OnClick(b)
		end
	end)
	b.Parent = props.Parent
	return b
end

-- the dark outline stroke of a button (for highlighting a selected card)
function UIKit.OutlineOf(button)
	local o = button:FindFirstChild("Outline")
	return o and o:FindFirstChildOfClass("UIStroke")
end

function UIKit.SetButtonColor(button, color)
	button.BackgroundColor3 = color
	local rim = button:FindFirstChild("Rim")
	local rs = rim and rim:FindFirstChildOfClass("UIStroke")
	if rs then
		rs.Color = shade(color, 1.45)
	end
end

function UIKit.SetDisabled(button, disabled, disabledColor)
	button:SetAttribute("Disabled", disabled or nil)
	if disabled then
		UIKit.SetButtonColor(button, disabledColor or Color3.fromRGB(96, 100, 128))
	else
		UIKit.SetButtonColor(button, button:GetAttribute("BaseColor") or UIKit.C.Blue)
	end
end

-- Progress bar. Returns { Frame, Set = function(fraction) }
function UIKit.Bar(props)
	local root = UIKit.Frame({
		Name = props.Name or "Bar",
		Color = Color3.fromRGB(18, 20, 38),
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		Radius = props.Radius or 10,
		Stroke = props.StrokeColor or Color3.fromRGB(8, 10, 24),
		StrokeThickness = 2,
		Parent = props.Parent,
		Clip = true,
		ZIndex = props.ZIndex,
	})
	local fill = UIKit.Frame({
		Name = "Fill",
		Color = props.Color or UIKit.C.Good,
		Size = UDim2.fromScale(0, 1),
		Radius = props.Radius or 10,
		Parent = root,
		ZIndex = (props.ZIndex or 1) + 1,
	})
	UIKit.Gradient(fill, Color3.new(1, 1, 1), shade(Color3.new(1, 1, 1), 0.7), 90)
	local bar = { Frame = root, Fill = fill }
	function bar.Set(fraction, instant)
		fraction = math.clamp(fraction, 0, 1)
		if instant then
			fill.Size = UDim2.fromScale(fraction, 1)
		else
			UIKit.Tween(fill, 0.25, { Size = UDim2.fromScale(fraction, 1) })
		end
	end
	return bar
end

-- little "bump" animation on any GuiObject that has (or gets) a UIScale
function UIKit.Bump(guiObject, amount)
	local scale = guiObject:FindFirstChild("BumpScale")
	if not scale then
		scale = UIKit.Scale(guiObject, 1)
		scale.Name = "BumpScale"
	end
	scale.Scale = amount or 1.18
	UIKit.Tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
end

----------------------------------------------------------------------
-- Panels (pop-up windows)
----------------------------------------------------------------------
-- returns panel = { Frame, Body, Open(), Close(), Toggle(), IsOpen }
function UIKit.Panel(root, name, title, size, accent, opts)
	accent = accent or UIKit.C.Blue
	opts = opts or {}
	local frame = UIKit.Frame({
		Name = name,
		Color = UIKit.C.Panel,
		Size = UDim2.fromOffset(size.X, size.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = 22,
		Stroke = Color3.fromRGB(7, 10, 20),
		StrokeThickness = 4,
		Visible = false,
		ZIndex = 20,
		Parent = root,
	})
	local rim = UIKit.Frame({
		Name = "Rim", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4),
		Radius = 20, Stroke = accent, StrokeThickness = 2, ZIndex = 20, Parent = frame,
	})
	local scale = UIKit.Scale(frame, 1)

	local header = UIKit.Frame({
		Name = "Header",
		Color = accent,
		Size = UDim2.new(1, -16, 0, 54),
		Position = UDim2.fromOffset(8, 8),
		Radius = 15,
		Stroke = Color3.new(0, 0, 0),
		StrokeThickness = 3,
		ZIndex = 21,
		Parent = frame,
	})
	if opts.Top then
		-- chunky style: gradient header, inner bevel rim, top shine and a navy accent ring
		UIKit.Gradient(header, Color3.new(1, 1, 1), Color3.new(1, 1, 1), 90)
		header.BackgroundColor3 = Color3.new(1, 1, 1)
		header:FindFirstChildOfClass("UIGradient").Color = ColorSequence.new(opts.Top, opts.Bottom or shade(opts.Top, 0.75))
		UIKit.Frame({ Name = "Rim", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3),
			Radius = 13, Stroke = opts.Rim or shade(opts.Top, 1.25), StrokeThickness = 2, ZIndex = 21, Parent = header })
		UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.8, Size = UDim2.new(1, -16, 0.4, 0), Position = UDim2.fromOffset(8, 5),
			Radius = 10, ZIndex = 21, Parent = header })
		frame.BackgroundColor3 = opts.Body or UIKit.C.Navy
		local ring = frame:FindFirstChild("Rim")
		if ring then
			local st = ring:FindFirstChildOfClass("UIStroke")
			if st then st.Color = opts.Accent or UIKit.C.NavyEdge end
		end
	end
	local titleOffset = 16
	if opts.Icon then
		UIKit.Icon({ Icon = opts.Icon, Emoji = opts.Emoji, Size = UDim2.fromOffset(62, 62), Position = UDim2.fromOffset(4, -6), ZIndex = 23, Parent = header })
		titleOffset = 72
	end
	UIKit.Text({
		Name = "Title",
		Text = title,
		TextSize = opts.TitleSize or 30,
		Size = UDim2.new(1, -(titleOffset + 60), 1, 0),
		Position = UDim2.fromOffset(titleOffset, 0),
		XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = opts.Top and 3 or nil,
		ZIndex = 22,
		Parent = header,
	})
	local body = UIKit.Frame({
		Name = "Body",
		Color = Color3.fromRGB(10, 21, 50),
		Size = UDim2.new(1, -20, 1, -80),
		Position = UDim2.fromOffset(10, 70),
		Radius = 16,
		ZIndex = 21,
		Parent = frame,
	})

	local panel = { Frame = frame, Body = body, Header = header, IsOpen = false, Name = name }

	local closeButton = UIKit.Button({
		Name = "Close",
		Text = "✕",
		Color = UIKit.C.Bad,
		TextSize = 26,
		Size = UDim2.fromOffset(44, 40),
		Position = UDim2.new(1, -8, 0, 7),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 23,
		Parent = header,
		OnClick = function()
			panel.Close()
		end,
	})

	function panel.Open()
		if panel.IsOpen then
			return
		end
		for otherName, other in pairs(UIKit.Panels) do
			if otherName ~= name and other.IsOpen and not other.Modal then
				other.Close(true)
			end
		end
		panel.IsOpen = true
		frame.Visible = true
		scale.Scale = 0.82
		UIKit.Tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
		if panel.OnOpen then
			panel.OnOpen()
		end
	end

	function panel.Close(silent)
		if not panel.IsOpen then
			return
		end
		panel.IsOpen = false
		UIKit.Tween(scale, 0.12, { Scale = 0.88 })
		task.delay(0.12, function()
			if not panel.IsOpen then
				frame.Visible = false
			end
		end)
		if panel.OnClose then
			panel.OnClose()
		end
	end

	function panel.Toggle()
		if panel.IsOpen then
			panel.Close()
		else
			panel.Open()
		end
	end

	UIKit.Panels[name] = panel
	return panel
end

-- scrolling frame with list or grid layout
function UIKit.Scroll(parent, props)
	props = props or {}
	local s = Instance.new("ScrollingFrame")
	s.Name = props.Name or "Scroll"
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	s.Size = props.Size or UDim2.fromScale(1, 1)
	s.Position = props.Position or UDim2.new()
	s.ScrollBarThickness = 8
	s.ScrollBarImageColor3 = Color3.fromRGB(150, 160, 220)
	s.CanvasSize = UDim2.new()
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.ZIndex = props.ZIndex or 22
	s.Parent = parent
	return s
end


----------------------------------------------------------------------
-- Chunky "sim" building blocks (logos, cards, chips, inputs, dropdowns, modals, tooltips)
----------------------------------------------------------------------
-- The game's logo pictures (IconData: Strength, Money, RebirthStar, LuckyBlock, GymMap ...).
-- Falls back to the emoji when a logo can't be drawn. props: Icon, Emoji, Size, Position, AnchorPoint, ZIndex, LayoutOrder, Parent
function UIKit.Icon(props)
	local il = iconLoader()
	local img = il and props.Icon and il.Make(props.Icon, props.Uploaded)
	if img then
		img.Size = props.Size or UDim2.fromOffset(32, 32)
		img.Position = props.Position or UDim2.new()
		img.AnchorPoint = props.AnchorPoint or Vector2.new()
		img.ZIndex = props.ZIndex or 1
		img.LayoutOrder = props.LayoutOrder or 0
		if props.Name then img.Name = props.Name end
		img.Parent = props.Parent
		return img
	end
	return UIKit.Text({
		Name = props.Name or "IconEmoji", Text = props.Emoji or "", Scaled = true, Stroke = false,
		Size = props.Size or UDim2.fromOffset(32, 32), Position = props.Position, AnchorPoint = props.AnchorPoint,
		ZIndex = props.ZIndex, LayoutOrder = props.LayoutOrder, Parent = props.Parent,
	})
end

-- Card: gradient body, thick dark outline, optional inner bevel rim and top shine.
-- props: Top, Bottom, Radius, Outline, OutlineThickness, Rim (color), Shine (bool) + Frame props
function UIKit.Card(props)
	local radius = props.Radius or 14
	local f = UIKit.Frame({
		Name = props.Name or "Card", Color = Color3.new(1, 1, 1), Size = props.Size, Position = props.Position, AnchorPoint = props.AnchorPoint,
		Radius = radius, Stroke = props.Outline or UIKit.C.Outline, StrokeThickness = props.OutlineThickness or 3,
		ZIndex = props.ZIndex, LayoutOrder = props.LayoutOrder, Visible = props.Visible, Clip = props.Clip,
		Transparency = props.Transparency, Parent = props.Parent,
	})
	UIKit.Gradient(f, props.Top or UIKit.C.NavyLight, props.Bottom or shade(props.Top or UIKit.C.NavyLight, 0.7), 90)
	if props.Rim then
		UIKit.Frame({ Name = "Rim", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -6, 1, -6), Position = UDim2.fromOffset(3, 3),
			Radius = math.max(radius - 3, 3), Stroke = props.Rim, StrokeThickness = 2, ZIndex = props.ZIndex, Parent = f })
	end
	if props.Shine then
		UIKit.Frame({ Name = "Shine", Color = Color3.new(1, 1, 1), Transparency = 0.84, Size = UDim2.new(1, -12, 0, math.min(18, 999)), Position = UDim2.fromOffset(6, 4),
			Radius = math.max(radius - 5, 3), ZIndex = props.ZIndex, Parent = f })
	end
	return f
end

-- Horizontal "[logo] text" row. Returns row, label. props: Icon, Emoji, Text, TextSize, Color, IconSize,
-- Align ("Left"/"Center"/"Right"), Font, StrokeThickness + Frame props
function UIKit.IconLabel(props)
	local row = UIKit.Frame({ Name = props.Name or "IconLabel", Color = Color3.new(0, 0, 0), Transparency = 1, Size = props.Size,
		Position = props.Position, AnchorPoint = props.AnchorPoint, ZIndex = props.ZIndex, LayoutOrder = props.LayoutOrder, Parent = props.Parent })
	local align = props.Align or "Left"
	UIKit.List(row, props.Gap or 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment[align], Enum.VerticalAlignment.Center)
	local iconSize = props.IconSize or (props.TextSize or 18) + 6
	UIKit.Icon({ Icon = props.Icon, Emoji = props.Emoji, Size = UDim2.fromOffset(iconSize, iconSize), LayoutOrder = 1, ZIndex = props.ZIndex, Parent = row })
	local label = UIKit.Text({ Name = "Label", Text = props.Text or "", TextSize = props.TextSize or 18, Color = props.Color, Font = props.Font,
		StrokeThickness = props.StrokeThickness, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 2, ZIndex = props.ZIndex, Parent = row })
	label.AutomaticSize = Enum.AutomaticSize.X
	return row, label
end

-- Small rounded pill: optional logo + text. Returns chip, label.
function UIKit.Chip(props)
	local chip = UIKit.Frame({ Name = props.Name or "Chip", Color = props.Color or UIKit.C.NavyLight, Size = props.Size or UDim2.fromOffset(100, 26),
		Position = props.Position, AnchorPoint = props.AnchorPoint, Radius = props.Radius or 12, Stroke = props.Outline or UIKit.C.Outline,
		StrokeThickness = props.OutlineThickness or 2, ZIndex = props.ZIndex, LayoutOrder = props.LayoutOrder, Parent = props.Parent })
	if props.AutoWidth then
		chip.AutomaticSize = Enum.AutomaticSize.X
	end
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, props.Icon and 4 or 8)
	p.PaddingRight = UDim.new(0, 8)
	p.Parent = chip
	UIKit.List(chip, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	if props.Icon or props.Emoji then
		local s = props.IconSize or 20
		UIKit.Icon({ Icon = props.Icon, Emoji = props.Emoji, Size = UDim2.fromOffset(s, s), LayoutOrder = 1, ZIndex = props.ZIndex, Parent = chip })
	end
	local label = UIKit.Text({ Name = "Label", Text = props.Text or "", TextSize = props.TextSize or 15, Color = props.TextColor, Font = props.Font,
		Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 2, ZIndex = props.ZIndex, Parent = chip })
	label.AutomaticSize = Enum.AutomaticSize.X
	return chip, label
end

-- "1.5k", "20M", "3e6", "1,000,000" -&gt; number (nil if it isn't a finite number)
local NUMBER_SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
function UIKit.ParseNumber(text)
	if type(text) ~= "string" then
		return nil
	end
	local s = string.lower((text:gsub("[,%s_]", "")))
	local num, suffix = string.match(s, "^(-?[%d%.]+e?[%-+]?%d*)(%a*)$")
	local n = num and tonumber(num)
	if not n then
		return nil
	end
	if suffix ~= "" then
		local mult = NUMBER_SUFFIX[suffix]
		if not mult then
			return nil
		end
		n = n * mult
	end
	if n ~= n or n == math.huge or n == -math.huge then
		return nil
	end
	return n
end

-- Styled text box. props: Placeholder, Text, Size, Position, TextSize, OnEnter(text), Parent, ZIndex, LayoutOrder, Numeric
function UIKit.Input(props)
	local box = Instance.new("TextBox")
	box.Name = props.Name or "Input"
	box.ClearTextOnFocus = false
	box.Text = props.Text or ""
	box.PlaceholderText = props.Placeholder or ""
	box.PlaceholderColor3 = Color3.fromRGB(130, 146, 190)
	box.Font = Enum.Font.FredokaOne
	box.TextSize = props.TextSize or 18
	box.TextColor3 = Color3.new(1, 1, 1)
	box.TextXAlignment = props.XAlign or Enum.TextXAlignment.Left
	box.BackgroundColor3 = Color3.fromRGB(8, 14, 34)
	box.BorderSizePixel = 0
	box.Size = props.Size or UDim2.fromOffset(160, 38)
	box.Position = props.Position or UDim2.new()
	box.AnchorPoint = props.AnchorPoint or Vector2.new()
	box.ZIndex = props.ZIndex or 1
	box.LayoutOrder = props.LayoutOrder or 0
	box.TextTruncate = Enum.TextTruncate.AtEnd
	UIKit.Corner(box, 12)
	local st = UIKit.Stroke(box, UIKit.C.NavyEdge, 2)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = box
	box.Focused:Connect(function()
		st.Color = UIKit.C.Gold
	end)
	box.FocusLost:Connect(function(enter)
		st.Color = UIKit.C.NavyEdge
		if enter and props.OnEnter then
			props.OnEnter(box.Text)
		end
	end)
	box.Parent = props.Parent
	return box
end

-- Hover tooltip on any GuiObject (shown on the canvas so it is never clipped).
local tooltipFrame, tooltipLabel
function UIKit.Tooltip(guiObject, text)
	guiObject:SetAttribute("Tooltip", text)
	guiObject.MouseEnter:Connect(function()
		if not UIKit.Root then
			return
		end
		if not tooltipFrame then
			tooltipFrame = UIKit.Frame({ Name = "Tooltip", Color = UIKit.C.Outline, Transparency = 0.08, Size = UDim2.fromOffset(10, 28), Radius = 10,
				Stroke = UIKit.C.Gold, StrokeThickness = 2, ZIndex = 400, Visible = false, Parent = UIKit.Root })
			tooltipFrame.AutomaticSize = Enum.AutomaticSize.X
			local p = Instance.new("UIPadding")
			p.PaddingLeft = UDim.new(0, 10)
			p.PaddingRight = UDim.new(0, 10)
			p.Parent = tooltipFrame
			tooltipLabel = UIKit.Text({ Text = "", TextSize = 15, Size = UDim2.new(0, 0, 1, 0), ZIndex = 401, Parent = tooltipFrame })
			tooltipLabel.AutomaticSize = Enum.AutomaticSize.X
		end
		tooltipLabel.Text = guiObject:GetAttribute("Tooltip") or text
		local rootPos = UIKit.Root.AbsolutePosition
		local scale = (UIKit.Root.AbsoluteSize.X &gt; 0 and UIKit.Root.Size.X.Offset &gt; 0) and (UIKit.Root.AbsoluteSize.X / UIKit.Root.Size.X.Offset) or 1
		local p = guiObject.AbsolutePosition - rootPos
		local s = guiObject.AbsoluteSize
		tooltipFrame.Position = UDim2.fromOffset((p.X + s.X / 2) / scale, (p.Y - 6) / scale)
		tooltipFrame.AnchorPoint = Vector2.new(0.5, 1)
		tooltipFrame.Visible = true
	end)
	guiObject.MouseLeave:Connect(function()
		if tooltipFrame then
			tooltipFrame.Visible = false
		end
	end)
end

-- Spinning loading indicator + text. Returns frame (call :Destroy() to stop).
function UIKit.Spinner(parent, text, zIndex)
	local holder = UIKit.Frame({ Name = "Loading", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, 0, 0, 60), ZIndex = zIndex, Parent = parent })
	local ring = UIKit.Frame({ Name = "Ring", Color = UIKit.C.Gold, Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0.5, 0, 0, 4),
		AnchorPoint = Vector2.new(0.5, 0), Radius = 30, ZIndex = zIndex, Parent = holder })
	ring:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	local gap = UIKit.Frame({ Name = "Gap", Color = UIKit.C.Navy, Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(6, 6), Radius = 30, ZIndex = zIndex, Parent = ring })
	gap:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	UIKit.Frame({ Name = "Notch", Color = UIKit.C.Navy, Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 0), ZIndex = zIndex, Parent = ring })
	UIKit.Text({ Text = text or "Loading...", TextSize = 16, Color = UIKit.C.Muted, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 34), ZIndex = zIndex, Parent = holder })
	task.spawn(function()
		while holder.Parent do
			ring.Rotation = (ring.Rotation + 12) % 360
			task.wait(0.03)
		end
	end)
	return holder
end

-- A small "V" caret made of two bars (no font glyph needed). UIKit.SetCaret(c, true) points it up.
function UIKit.Caret(props)
	local size = props.Size or 12
	local holder = Instance.new("Frame")
	holder.Name = props.Name or "Caret"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size, size)
	holder.Position = props.Position or UDim2.new()
	holder.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	holder.ZIndex = props.ZIndex or 1
	holder.LayoutOrder = props.LayoutOrder or 0
	local thick = props.Thickness or math.max(3, math.floor(size * 0.3))
	for i, side in ipairs({ -1, 1 }) do
		local bar = Instance.new("Frame")
		bar.Name = "Bar" .. i
		bar.BackgroundColor3 = props.Color or Color3.new(1, 1, 1)
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0.5, 0.5)
		bar.Size = UDim2.fromOffset(math.floor(size * 0.72), thick)
		bar.Position = UDim2.new(0.5, side * size * 0.2, 0.5, 0)
		bar.ZIndex = holder.ZIndex
		UIKit.Corner(bar, thick * 2)
		UIKit.Stroke(bar, props.StrokeColor or UIKit.C.Outline, props.StrokeThickness or 1.5)
		bar:SetAttribute("Side", side)
		bar.Parent = holder
	end
	UIKit.SetCaret(holder, props.Up == true)
	holder.Parent = props.Parent
	return holder
end

function UIKit.SetCaret(holder, up)
	for _, bar in ipairs(holder:GetChildren()) do
		local side = bar:GetAttribute("Side")
		if side then
			bar.Rotation = (up and -40 or 40) * -side
		end
	end
end

----------------------------------------------------------------------
-- Admin-panel look for any panel: gold chunky header + navy body with a scrolling
-- list of section cards (gold title strips). Used by the Shop / Upgrades / Gyms /
-- Rebirth / Admin panels so they all match.
----------------------------------------------------------------------
UIKit.GOLD_TOP, UIKit.GOLD_BOTTOM = Color3.fromRGB(255, 212, 72), Color3.fromRGB(242, 128, 20)

-- returns panel (with panel.Content = scrolling list) - opts: Icon, Emoji, Top, Bottom
function UIKit.GoldPanel(root, name, title, size, opts)
	opts = opts or {}
	local panel = UIKit.Panel(root, name, title, size, UIKit.C.Gold, { Icon = opts.Icon, Emoji = opts.Emoji, Top = opts.Top or UIKit.GOLD_TOP,
		Bottom = opts.Bottom or UIKit.GOLD_BOTTOM, Rim = Color3.fromRGB(255, 240, 150), Accent = Color3.fromRGB(56, 96, 196), Body = UIKit.C.Navy })
	panel.Body.BackgroundColor3 = Color3.fromRGB(10, 18, 44)
	if opts.NoScroll then
		return panel
	end
	local content = UIKit.Scroll(panel.Body, { Name = "Content", Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -12, 1, -16), ZIndex = 22 })
	UIKit.List(content, 10)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 2)
	pad.Parent = content
	panel.Content = content
	return panel
end

-- Section card with a gold title strip; s.Row(height) adds a row (horizontal list).
function UIKit.Section(parent, title, opts)
	opts = opts or {}
	local card = UIKit.Card({ Name = "Section", Top = Color3.fromRGB(32, 48, 98), Bottom = Color3.fromRGB(18, 27, 60), Size = UDim2.new(1, -14, 0, 50), Radius = 16,
		OutlineThickness = 3, Rim = UIKit.C.NavyEdge, LayoutOrder = opts.LayoutOrder or 0, ZIndex = 22, Parent = parent })
	local strip = UIKit.Card({ Name = "Title", Top = opts.Top or UIKit.GOLD_TOP, Bottom = opts.Bottom or UIKit.GOLD_BOTTOM, Size = UDim2.new(1, -12, 0, 30),
		Position = UDim2.fromOffset(6, 6), Radius = 12, OutlineThickness = 2, Rim = Color3.fromRGB(255, 236, 150), Shine = true, ZIndex = 23, Parent = card })
	strip:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.35
	local x = 10
	if opts.Icon or opts.Emoji then
		UIKit.Icon({ Icon = opts.Icon, Emoji = opts.Emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 24, Parent = strip })
		x = 42
	end
	local titleLabel = UIKit.Text({ Text = title, TextSize = 18, Size = UDim2.new(1, -x - 10, 1, 0), Position = UDim2.fromOffset(x, 0), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.4, ZIndex = 24, Parent = strip })
	local s = { Card = card, Strip = strip, Title = titleLabel, Y = 44, Order = 0 }
	function s.Row(height, noList)
		local row = UIKit.Frame({ Name = "Row", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -24, 0, height), Position = UDim2.fromOffset(12, s.Y),
			ZIndex = 23, Parent = card })
		if not noList then
			UIKit.List(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		end
		s.Y = s.Y + height + 8
		card.Size = UDim2.new(1, -14, 0, s.Y + 4)
		return row
	end
	return s
end

-- Stat tile: logo + small label + big value (+ sub line). Returns tile, valueLabel, subLabel.
function UIKit.Tile(parent, width, opts)
	local t = UIKit.Card({ Name = "Tile", Top = opts.Top or Color3.fromRGB(44, 64, 124), Bottom = opts.Bottom or Color3.fromRGB(26, 36, 78),
		Size = UDim2.fromOffset(width, opts.Height or 70), Radius = 12, OutlineThickness = 2, LayoutOrder = opts.LayoutOrder or 0, ZIndex = 24, Parent = parent })
	local x = 8
	if opts.Icon or opts.Emoji then
		UIKit.Icon({ Icon = opts.Icon, Emoji = opts.Emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 25, Parent = t })
		x = 44
	end
	UIKit.Text({ Text = opts.Label or "", TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.new(1, -x - 6, 0, 16), Position = UDim2.fromOffset(x, 5),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.2, ZIndex = 25, Parent = t })
	local v = UIKit.Text({ Text = opts.Value or "", TextSize = opts.ValueSize or 20, Color = opts.Color or UIKit.C.Text, Size = UDim2.new(1, -x - 6, 0, 24),
		Position = UDim2.fromOffset(x, 21), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.2, ZIndex = 25, Parent = t })
	v.TextTruncate = Enum.TextTruncate.AtEnd
	local sub = UIKit.Text({ Text = opts.Sub or "", TextSize = 11, Color = UIKit.C.Muted, Size = UDim2.new(1, -x - 6, 0, 14), Position = UDim2.fromOffset(x, 47),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 25, Parent = t })
	sub.TextTruncate = Enum.TextTruncate.AtEnd
	return t, v, sub
end

-- Friendly "nothing here" message.
function UIKit.Empty(parent, text, zIndex, layoutOrder)
	return UIKit.Text({ Name = "Empty", Text = text, TextSize = 18, Color = UIKit.C.Muted, Wrap = true, Size = UDim2.new(1, -20, 0, 60),
		ZIndex = zIndex, LayoutOrder = layoutOrder or 999, Parent = parent })
end

-- Dropdown selector. props: Options = { {Value=, Text=, Icon=?, Emoji=?}, ... }, Value, OnChange(value), Size, Position, ZIndex, Parent, LayoutOrder
function UIKit.Select(props)
	local select = { Value = props.Value, Options = props.Options or {} }
	local button = UIKit.Button({ Name = props.Name or "Select", Text = "", Color = props.Color or UIKit.C.NavyLight, TextSize = props.TextSize or 17,
		Size = props.Size or UDim2.fromOffset(170, 38), Position = props.Position, AnchorPoint = props.AnchorPoint, ZIndex = props.ZIndex,
		LayoutOrder = props.LayoutOrder, Radius = 12, Silent = false, Parent = props.Parent })
	local valueLabel = UIKit.Text({ Name = "Value", Text = "", TextSize = props.TextSize or 17, Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(12, 0),
		XAlign = Enum.TextXAlignment.Left, ZIndex = (props.ZIndex or 1) + 1, Parent = button })
	valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
	UIKit.Caret({ Name = "Arrow", Size = 12, Color = UIKit.C.Gold, Position = UDim2.new(1, -16, 0.5, 0), ZIndex = (props.ZIndex or 1) + 1, Parent = button })
	local list
	local function textFor(value)
		for _, o in ipairs(select.Options) do
			if o.Value == value then
				return o.Text
			end
		end
		return props.Placeholder or "Select..."
	end
	function select.Set(value, silent)
		select.Value = value
		valueLabel.Text = textFor(value)
		if not silent and props.OnChange then
			props.OnChange(value)
		end
	end
	function select.SetOptions(options, value)
		select.Options = options
		select.Set(value ~= nil and value or (options[1] and options[1].Value), true)
	end
	local function close()
		if list then
			list:Destroy()
			list = nil
		end
	end
	button.Activated:Connect(function()
		if list then
			close()
			return
		end
		if not UIKit.Root then
			return
		end
		local rootPos = UIKit.Root.AbsolutePosition
		local scale = (UIKit.Root.AbsoluteSize.X &gt; 0 and UIKit.Root.Size.X.Offset &gt; 0) and (UIKit.Root.AbsoluteSize.X / UIKit.Root.Size.X.Offset) or 1
		local p = (button.AbsolutePosition - rootPos) / scale
		local s = button.AbsoluteSize / scale
		local rows = math.min(#select.Options, 8)
		list = UIKit.Frame({ Name = "SelectList", Color = UIKit.C.Navy, Size = UDim2.fromOffset(math.max(s.X, 160), rows * 34 + 10), Position = UDim2.fromOffset(p.X, p.Y + s.Y + 4),
			Radius = 12, Stroke = UIKit.C.Gold, StrokeThickness = 2, ZIndex = 450, Parent = UIKit.Root })
		local scroll = UIKit.Scroll(list, { Position = UDim2.fromOffset(5, 5), Size = UDim2.new(1, -10, 1, -10), ZIndex = 451 })
		UIKit.List(scroll, 2)
		for i, o in ipairs(select.Options) do
			local item = Instance.new("TextButton")
			item.AutoButtonColor = false
			item.Name = "Option"
			item.Text = o.Text
			item.Font = Enum.Font.FredokaOne
			item.TextSize = 16
			item.TextColor3 = Color3.new(1, 1, 1)
			item.TextXAlignment = Enum.TextXAlignment.Left
			item.BackgroundColor3 = o.Value == select.Value and UIKit.C.NavyEdge or UIKit.C.NavyLight
			item.BorderSizePixel = 0
			item.Size = UDim2.new(1, -6, 0, 32)
			item.LayoutOrder = i
			item.ZIndex = 452
			UIKit.Corner(item, 8)
			local ip = Instance.new("UIPadding")
			ip.PaddingLeft = UDim.new(0, 10)
			ip.Parent = item
			item.MouseEnter:Connect(function() item.BackgroundColor3 = UIKit.C.NavyEdge end)
			item.MouseLeave:Connect(function() item.BackgroundColor3 = o.Value == select.Value and UIKit.C.NavyEdge or UIKit.C.NavyLight end)
			item.Activated:Connect(function()
				close()
				select.Set(o.Value)
			end)
			item.Parent = scroll
		end
	end)
	select.Button = button
	select.Close = close
	select.Set(props.Value, true)
	return select
end

-- Confirmation modal. opts: Title, Message, ConfirmText, ConfirmColor, TypeToConfirm (word), OnConfirm(), OnCancel()
function UIKit.Confirm(opts)
	local root = opts.Root or UIKit.Root
	if not root then
		return nil
	end
	local modal = {}
	local shade = UIKit.Frame({ Name = "ConfirmModal", Color = Color3.new(0, 0, 0), Transparency = 0.45, Size = UDim2.fromScale(1, 1), ZIndex = 500, Parent = root })
	local blocker = Instance.new("TextButton")
	blocker.Text = ""
	blocker.BackgroundTransparency = 1
	blocker.Size = UDim2.fromScale(1, 1)
	blocker.ZIndex = 500
	blocker.AutoButtonColor = false
	blocker.Parent = shade
	local typed = opts.TypeToConfirm
	local height = typed and 290 or 240
	local card = UIKit.Card({ Name = "Dialog", Top = UIKit.C.NavyLight, Bottom = UIKit.C.Navy, Size = UDim2.fromOffset(470, height), Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5), Radius = 22, OutlineThickness = 4, Rim = UIKit.C.NavyEdge, ZIndex = 501, Parent = shade })
	local header = UIKit.Card({ Name = "Header", Top = opts.HeaderTop or UIKit.C.Gold, Bottom = opts.HeaderBottom or UIKit.C.GoldDark, Size = UDim2.new(1, -16, 0, 48),
		Position = UDim2.fromOffset(8, 8), Radius = 16, Rim = Color3.fromRGB(255, 236, 140), Shine = true, ZIndex = 502, Parent = card })
	UIKit.Text({ Text = opts.Title or "Are you sure?", TextSize = 24, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), StrokeThickness = 3, ZIndex = 503, Parent = header })
	UIKit.Text({ Text = opts.Message or "", TextSize = 18, Color = UIKit.C.Muted, Wrap = true, Size = UDim2.new(1, -40, 0, 84), Position = UDim2.fromOffset(20, 64), ZIndex = 502, Parent = card })
	local input
	if typed then
		input = UIKit.Input({ Placeholder = "Type " .. typed .. " to confirm", Size = UDim2.new(1, -60, 0, 40), Position = UDim2.fromOffset(30, 152), ZIndex = 503, Parent = card })
	end
	local confirmButton
	local function close()
		if shade.Parent then
			shade:Destroy()
		end
	end
	modal.Close = close
	UIKit.Button({ Name = "Cancel", Text = "CANCEL", Color = UIKit.C.Gray, TextSize = 22, Size = UDim2.new(0.5, -30, 0, 54), Position = UDim2.new(0, 20, 1, -16),
		AnchorPoint = Vector2.new(0, 1), ZIndex = 503, Gloss = true, Parent = card,
		OnClick = function()
			close()
			if opts.OnCancel then opts.OnCancel() end
		end })
	confirmButton = UIKit.Button({ Name = "Confirm", Text = opts.ConfirmText or "CONFIRM", Color = opts.ConfirmColor or UIKit.C.Bad, TextSize = 22,
		Size = UDim2.new(0.5, -30, 0, 54), Position = UDim2.new(1, -20, 1, -16), AnchorPoint = Vector2.new(1, 1), ZIndex = 503, Gloss = true, Parent = card,
		OnClick = function()
			if typed and string.upper(input.Text) ~= string.upper(typed) then
				if UIKit.Sfx then UIKit.Sfx.Play("Error") end
				return
			end
			close()
			if opts.OnConfirm then opts.OnConfirm(input and input.Text) end
		end })
	if typed then
		UIKit.SetDisabled(confirmButton, true)
		input:GetPropertyChangedSignal("Text"):Connect(function()
			UIKit.SetDisabled(confirmButton, string.upper(input.Text) ~= string.upper(typed))
		end)
	end
	local scale = UIKit.Scale(card, 0.85)
	UIKit.Tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	modal.Frame = shade
	return modal
end

return UIKit
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX47">
          <Properties>
            <string name="Name">World</string>
            <ProtectedString name="Source">--[[
	World - client-side dressing of the map the server built:
	  * info labels over machines, Lucky Blocks, gates and the Protein Bar
	  * gates slide open (only on YOUR screen) once you unlock the gym
	  * Lucky Blocks spin/bob, coin orbs float
	The server stays in charge: even if a client opens a gate locally, the server pushes
	a player out of a gym they haven't unlocked.
]]
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local World = {}
local IconLoader = require(script.Parent.IconLoader)

local C, UIKit, Store, Config, Format, Sfx, Fx

local stationLabels = {} -- [stationId] = { Status, Model }
local gates = {}         -- [areaId] = { Slab, Prompt, Label, Bar, Status, Open, Base }
local eggBodies = {}     -- { Body, Base, Phase }
local orbs = {}          -- [part] = { Base, Phase }
local initialSync = false
local FREE_WEIGHT = { Dumbbell = true, Squat = true, Deadlift = true }

----------------------------------------------------------------------
-- Label helper
----------------------------------------------------------------------
local function makeBillboard(adornee, width, height, offset, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(width, height)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 90
	gui.Adornee = adornee
	gui.Parent = adornee
	local card = UIKit.Frame({ Color = UIKit.C.Bg, Transparency = 0.15, Size = UDim2.fromScale(1, 1), Radius = 14, Stroke = Color3.new(1, 1, 1), StrokeThickness = 2, Parent = gui })
	return gui, card
end

-- A centred row "[logo] text" using the game's logo pictures (emoji if a logo can't be drawn).
-- Returns a setter so the text can change later.
local function iconRow(parent, iconName, emoji, text, textSize, color, y, height)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, -8, 0, height)
	row.Position = UDim2.fromOffset(4, y)
	row.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 4)
	layout.Parent = row
	local icon = IconLoader.Make(iconName)
	if icon then
		icon.Size = UDim2.fromOffset(height + 2, height + 2)
		icon.LayoutOrder = 1
		icon.Parent = row
	end
	local label = UIKit.Text({ Text = "", TextSize = textSize, Color = color, Size = UDim2.fromOffset(0, height), Parent = row })
	label.AutomaticSize = Enum.AutomaticSize.X
	label.LayoutOrder = 2
	local function set(t)
		label.Text = icon and t or (emoji .. " " .. t)
	end
	set(text)
	return set, label
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function setupStation(model)
	local stationId = model:GetAttribute("StationId")
	local station = stationId and Config.StationsById[stationId]
	if not station or stationLabels[stationId] then
		return
	end
	local prompt = model:WaitForChild("Prompt", 10)
	if not prompt then
		return
	end
	local area = Config.AreasById[station.Area]
	local accent = area.Theme.Accent
	-- exercise card: [tier + exercise] header in the gym's colour, the machine, gains, status
	local gui = Instance.new("BillboardGui")
	gui.Name = "StationCard"
	gui.Size = UDim2.fromOffset(250, 124)
	gui.StudsOffset = Vector3.new(0, 7.5, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 70
	gui.Adornee = prompt
	gui.Parent = prompt
	local card = UIKit.Card({ Name = "Card", Top = Color3.fromRGB(30, 42, 84), Bottom = Color3.fromRGB(14, 20, 44), Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.fromOffset(4, 4), Radius = 16, Parent = gui })
	card.BackgroundTransparency = 0.05
	local header = UIKit.Card({ Name = "Header", Top = UIKit.Shade(accent, 1.15), Bottom = UIKit.Shade(accent, 0.72), Size = UDim2.new(1, -8, 0, 30),
		Position = UDim2.fromOffset(4, 4), Radius = 12, OutlineThickness = 2, Shine = true, Parent = card })
	UIKit.Text({ Text = string.upper((Config.ExerciseNames and Config.ExerciseNames[station.Kind]) or station.Kind), TextSize = 16, Size = UDim2.new(1, -86, 1, 0),
		Position = UDim2.fromOffset(8, 0), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.2, Parent = header })
	UIKit.Chip({ Name = "Tier", Text = string.rep("★", station.Tier) .. string.rep("☆", 3 - station.Tier), Color = Color3.fromRGB(24, 24, 36), TextColor = UIKit.C.Gold,
		TextSize = 13, Size = UDim2.fromOffset(66, 22), Position = UDim2.new(1, -5, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Parent = header })
	UIKit.Text({ Text = station.Name, TextSize = 18, Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 36), StrokeThickness = 2.2, Parent = card })
	local gains = UIKit.Frame({ Name = "Gains", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -12, 0, 24), Position = UDim2.fromOffset(6, 60), Parent = card })
	UIKit.List(gains, 12, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local s1 = UIKit.IconLabel({ Icon = "Strength", Emoji = "💪", Text = "+" .. Format.Number(station.Strength), TextSize = 16, IconSize = 22, Color = UIKit.C.Strength,
		StrokeThickness = 2, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 1, Parent = gains })
	s1.AutomaticSize = Enum.AutomaticSize.X
	local s2 = UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "+" .. Format.Number(station.Coins), TextSize = 16, IconSize = 22, Color = UIKit.C.Coins,
		StrokeThickness = 2, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 2, Parent = gains })
	s2.AutomaticSize = Enum.AutomaticSize.X
	UIKit.Text({ Text = "per rep", TextSize = 13, Color = UIKit.C.Muted, Size = UDim2.new(0, 0, 1, 0), LayoutOrder = 3, StrokeThickness = 1.4, Parent = gains }).AutomaticSize = Enum.AutomaticSize.X
	local pill, status = UIKit.Chip({ Name = "Status", Text = "", Color = Color3.fromRGB(40, 150, 70), TextSize = 14, Size = UDim2.new(1, -24, 0, 26),
		Position = UDim2.new(0.5, 0, 1, -6), AnchorPoint = Vector2.new(0.5, 1), Parent = card })
	stationLabels[stationId] = { Status = status, Pill = pill, Station = station }
end

local function refreshStations()
	local coins = Store.Attr("Coins")
	for stationId, label in pairs(stationLabels) do
		local station = label.Station
		if Store.TrainingStation == stationId then
			label.Status.Text = FREE_WEIGHT[station.Kind] and "EQUIPPED - CLICK / SPACE" or "TRAINING HERE"
			label.Pill.BackgroundColor3 = Color3.fromRGB(230, 150, 30)
		elseif Store.OwnsStation(stationId) then
			label.Status.Text = FREE_WEIGHT[station.Kind] and "OWNED - PRESS E TO GRAB" or "OWNED - PRESS E"
			label.Pill.BackgroundColor3 = Color3.fromRGB(40, 150, 70)
		else
			label.Status.Text = "🔒 BUY FOR " .. Format.Number(station.Price)
			label.Pill.BackgroundColor3 = coins &gt;= station.Price and Color3.fromRGB(60, 110, 220) or Color3.fromRGB(170, 50, 60)
		end
	end
end

----------------------------------------------------------------------
-- Eggs / Sell stand
----------------------------------------------------------------------
local function setupEgg(model)
	local egg = Config.EggsById[model:GetAttribute("EggId")]
	if not egg then
		return
	end
	local prompt = model:WaitForChild("Prompt", 10)
	local body = model:WaitForChild("EggBody", 10)
	if not prompt or not body then
		return
	end
	local area = Config.AreasById[egg.Area]
	local _, card = makeBillboard(prompt, 230, 84, Vector3.new(0, 12, 0), 110)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = area.Theme.Accent
	end
	iconRow(card, "LuckyBlock", "❓", egg.Name, 20, UIKit.C.Text, 4, 26)
	iconRow(card, "Money", "💵", Format.Number(egg.Price), 22, UIKit.C.Coins, 32, 26)
	UIKit.Text({ Text = "Press E to open", TextSize = 14, Color = UIKit.C.Muted, Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 58), Parent = card })
	eggBodies[#eggBodies + 1] = { Body = body, Base = body:GetPivot(), Phase = math.random() * 6 }
end

local function setupSell(model)
	local prompt = model:WaitForChild("Prompt", 10)
	if not prompt then
		return
	end
	local _, card = makeBillboard(prompt, 220, 56, Vector3.new(0, 7.5, 0), 70)
	UIKit.Text({ Text = "🥤 Protein Bar", TextSize = 20, Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, 4), Parent = card })
	iconRow(card, "Money", "💵", "Sell Strength for coins", 14, UIKit.C.Coins, 30, 18)
end

----------------------------------------------------------------------
-- Gates
----------------------------------------------------------------------
local function setupGate(slab)
	local areaId = slab:GetAttribute("AreaId")
	local area = areaId and Config.AreasById[areaId]
	if not area or gates[areaId] then
		return
	end
	local folder = slab.Parent
	local promptPart = folder and folder:WaitForChild("GatePrompt", 10)
	if not promptPart then
		return
	end
	local _, card = makeBillboard(promptPart, 300, 118, Vector3.new(0, 14, 0), 130)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = area.Theme.Accent
	end
	UIKit.Text({ Text = area.Icon .. " " .. area.Name, TextSize = 26, Size = UDim2.new(1, -8, 0, 32), Position = UDim2.fromOffset(4, 4), Parent = card })
	local setStatus, status = iconRow(card, "Strength", "💪", "", 18, UIKit.C.Text, 38, 24)
	local bar = UIKit.Bar({ Size = UDim2.new(1, -30, 0, 18), Position = UDim2.fromOffset(15, 68), Color = area.Theme.Accent, Parent = card })
	local hint = UIKit.Text({ Text = "", TextSize = 14, Color = UIKit.C.Muted, Size = UDim2.new(1, -8, 0, 20), Position = UDim2.fromOffset(4, 92), Parent = card })
	gates[areaId] = { Slab = slab, PromptPart = promptPart, Status = status, SetStatus = setStatus, Bar = bar, Hint = hint, Area = area, Open = false, Base = slab.CFrame, BaseTransparency = slab.Transparency }
end

local function refreshGates()
	local strength = Store.Attr("Strength")
	for areaId, g in pairs(gates) do
		if g.Open then
			g.SetStatus("OPEN")
			g.Status.TextColor3 = UIKit.C.Good
			g.Bar.Frame.Visible = false
			g.Hint.Text = ""
		else
			local ready = strength &gt;= g.Area.Required
			g.SetStatus("Needs " .. Format.Number(g.Area.Required))
			g.Status.TextColor3 = ready and UIKit.C.Good or UIKit.C.Coins
			g.Bar.Set(strength / g.Area.Required, true)
			g.Hint.Text = ready and "Hold E to push the gate!" or ("You have " .. Format.Number(strength))
		end
	end
end

local function openGate(areaId, animate)
	local g = gates[areaId]
	if not g or g.Open then
		return
	end
	g.Open = true
	local slab = g.Slab
	local prompt = g.PromptPart:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Enabled = false
	end
	slab.CanCollide = false
	g.OpenedAt = os.clock()
	if animate then
		Sfx.Play("Gate")
		Fx.Shake(0.6, 0.8)
		Fx.Burst(slab.Position - Vector3.new(0, 14, 0), g.Area.Theme.Accent, 40, 40, 1.2)
		g.Tween = TweenService:Create(slab, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = g.Base.Position + Vector3.new(0, Config.World.GateHeight + 2, 0),
			Transparency = 1,
		})
		g.Tween:Play()
	else
		slab.Position = g.Base.Position + Vector3.new(0, Config.World.GateHeight + 2, 0)
		slab.Transparency = 1
	end
	refreshGates()
end

-- an admin locked this gym again: put the gate back
local function closeGate(areaId)
	local g = gates[areaId]
	if not g or not g.Open then
		return
	end
	g.Open = false
	if g.Tween then
		g.Tween:Cancel()
		g.Tween = nil
	end
	g.Slab.CFrame = g.Base
	g.Slab.Transparency = g.BaseTransparency
	g.Slab.CanCollide = true
	local prompt = g.PromptPart:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Enabled = true
	end
	refreshGates()
end

local function shakeGate(areaId)
	local g = gates[areaId]
	if not g or g.Open then
		return
	end
	local slab = g.Slab
	task.spawn(function()
		for i = 1, 6 do
			slab.Position = g.Base.Position + Vector3.new((i % 2 == 0 and 1 or -1) * (1.4 - i * 0.18), 0, 0)
			task.wait(0.04)
		end
		slab.Position = g.Base.Position
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function bindTag(tag, fn)
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		task.spawn(fn, inst)
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
		task.spawn(fn, inst)
	end)
end

function World.Init(client)
	C = client
	UIKit, Store, Config, Format, Sfx, Fx = C.UIKit, C.Store, C.Config, C.Format, C.Sfx, C.Fx

	bindTag("GymStation", setupStation)
	bindTag("GymEgg", setupEgg)
	bindTag("GymSell", setupSell)
	bindTag("GymGate", setupGate)
	-- logo slots in server-built UI (name tags, signs): paint the picture, hide the emoji
	-- The emoji fallback can replicate a moment AFTER its slot (server-built name tags), so it
	-- is hidden now, whenever it arrives, and once more on the next frame.
	local function hideFallbacks(img)
		for _, child in ipairs(img:GetChildren()) do
			if child:IsA("TextLabel") then
				child.Visible = false
			end
		end
	end
	bindTag("GymIcon", function(img)
		if img:IsA("ImageLabel") and IconLoader.Apply(img, img:GetAttribute("Icon")) then
			hideFallbacks(img)
			img.ChildAdded:Connect(function(child)
				if child:IsA("TextLabel") then
					child.Visible = false
				end
			end)
			task.defer(hideFallbacks, img)
		end
	end)
	bindTag("GymOrb", function(part)
		orbs[part] = { Base = part.Position, Phase = math.random() * 6 }
	end)
	CollectionService:GetInstanceRemovedSignal("GymOrb"):Connect(function(part)
		orbs[part] = nil
	end)

	-- gates follow the synced state: unlocked = open (instantly; unlock events animate),
	-- locked again by an admin = closed. A gate opened by an unlock event a moment ago is
	-- left alone until the matching state update arrives.
	local function syncGates()
		local areas = Store.State.Areas or {}
		for areaId, g in pairs(gates) do
			if areas[areaId] then
				if not g.Open then
					openGate(areaId, false)
				end
			elseif g.Open and os.clock() - (g.OpenedAt or 0) &gt; 3 then
				closeGate(areaId)
			end
		end
	end
	Store.StateChanged:Connect(function()
		refreshStations()
		if not initialSync then
			initialSync = true
			task.delay(1.5, syncGates) -- give the map time to stream in
		else
			task.delay(0.8, syncGates)
		end
		refreshGates()
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			refreshStations()
			refreshGates()
			if initialSync then
				syncGates()
			end
		end
	end)

	C.Remotes.Get("AreaUnlocked").OnClientEvent:Connect(function(areaId)
		local area = Config.AreasById[areaId]
		if not area then
			return
		end
		Sfx.Play("Unlock")
		Fx.Flash(area.Theme.Accent, 0.6, 0.7)
		Fx.Confetti(80)
		Fx.Banner(area.Icon .. " " .. string.upper(area.Name) .. " UNLOCKED!", "The gate is open - walk in!", area.Theme.Accent, 3.2)
		local pos = Fx.CharacterPosition()
		if pos then
			Fx.Ring(pos - Vector3.new(0, 2.8, 0), area.Theme.Accent, 60, 1)
		end
		openGate(areaId, true)
	end)

	C.Remotes.Get("GateDenied").OnClientEvent:Connect(function(areaId, required, have)
		Sfx.Play("Error")
		Fx.Shake(0.5, 0.35)
		shakeGate(areaId)
		C.HUD.Toast("🔒 Need " .. Format.Number(required - have) .. " more Strength (" .. Format.Number(have) .. " / " .. Format.Number(required) .. ")", "Error")
	end)

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		for _, e in ipairs(eggBodies) do
			if e.Body.Parent then
				e.Body:PivotTo(e.Base * CFrame.new(0, math.sin(t * 2 + e.Phase) * 0.6, 0) * CFrame.Angles(0, t * 0.7 + e.Phase, 0))
			end
		end
		for part, o in pairs(orbs) do
			if part.Parent then
				-- bob + slow spin (CFrame moves the welded dumbbell pieces too)
				part.CFrame = CFrame.new(o.Base + Vector3.new(0, math.sin(t * 2.2 + o.Phase) * 0.6, 0))
					* CFrame.Angles(0, t * 1.6 + o.Phase, 0) * CFrame.Angles(0, 0, math.rad(20))
			end
		end
	end)
end

return World
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>