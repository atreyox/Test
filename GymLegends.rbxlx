<Item class="ModuleScript" referent="NEWMOD2"><Properties><string name="Name">BarbellDesign</string><ProtectedString name="Source">--[[
	BarbellDesign (shared) - one description of the shoulder-press barbell, used by BOTH
	the bar resting on the squat rack (server, EquipmentModels) and the bar in your hands
	(client, DumbbellAnim), so they always look identical.

	The bar lies along X, centred on 0. Every piece is round - no flat panels on the plates:
	  * solid chrome sleeves that end in a rounded cap (no open tube end)
	  * blue competition bumper plates: rubber body, printed face band, white ring,
	    raised centre, steel hub insert with six bolts
	  * red lock-jaw collars with a small round lever
	Pieces: { Shape = "Cyl"|"Ball", Axis = "X"|"Y", Name, Pos = Vector3, Len, D, Size?, Color, Material }
	Labels: { Piece = &lt;PlateFace piece&gt;, Side = -1|1 } -&gt; print "+1 GYM GAME" / "20 KG" on that face.
]]
local BarbellDesign = {}

local CHROME = Color3.fromRGB(206, 211, 220)
local STEEL = Color3.fromRGB(176, 182, 192)
local SHAFT = Color3.fromRGB(190, 196, 206)
local KNURL = Color3.fromRGB(128, 133, 143)
local BLUE = Color3.fromRGB(22, 104, 222)
local BLUE_FACE = Color3.fromRGB(30, 116, 232)
local BLUE_RING = Color3.fromRGB(14, 74, 170)
local WHITE = Color3.fromRGB(245, 247, 250)
local RED = Color3.fromRGB(226, 46, 52)
local RED_DARK = Color3.fromRGB(168, 24, 32)

BarbellDesign.PlateBlue = BLUE

function BarbellDesign.PressBar(s)
	local pieces, labels = {}, {}
	local function cyl(name, pos, len, d, color, material, axis)
		local p = { Shape = "Cyl", Axis = axis or "X", Name = name, Pos = pos, Len = len, D = d, Color = color, Material = material }
		pieces[#pieces + 1] = p
		return p
	end
	local function ball(name, pos, size, color, material)
		local p = { Shape = "Ball", Name = name, Pos = pos, Size = size, Color = color, Material = material }
		pieces[#pieces + 1] = p
		return p
	end
	local V = Vector3.new

	-- centre shaft with two knurled grip bands
	cyl("Bar", V(0, 0, 0), 6.4 * s, 0.13 * s, SHAFT, "Metal")
	for _, x in ipairs({ -1.34, 1.34 }) do
		cyl("Knurl", V(x * s, 0, 0), 0.62 * s, 0.155 * s, KNURL, "DiamondPlate")
	end

	for _, side in ipairs({ -1, 1 }) do
		-- sleeve: a solid chrome tube from the inner collar to a rounded end cap
		cyl("InnerCollar", V(side * 3.18 * s, 0, 0), 0.2 * s, 0.52 * s, CHROME, "Metal")
		cyl("Sleeve", V(side * 4.24 * s, 0, 0), 1.92 * s, 0.36 * s, CHROME, "Metal")
		ball("EndCap", V(side * 5.2 * s, 0, 0), V(0.36 * s, 0.36 * s, 0.36 * s), CHROME, "Metal") -- rounded solid end

		-- competition bumper plate (each ring sits a little prouder than the one outside it)
		local px, t, d = side * 3.68 * s, 0.5 * s, 2.76 * s
		cyl("Plate", V(px, 0, 0), t, d, BLUE, "Rubber")
		local face = cyl("PlateFace", V(px, 0, 0), t + 0.04 * s, d * 0.93, BLUE_FACE, "Rubber")
		cyl("PlateStripe", V(px, 0, 0), t + 0.05 * s, d * 0.56, WHITE, "SmoothPlastic")
		cyl("PlateRing", V(px, 0, 0), t + 0.06 * s, d * 0.51, BLUE_RING, "Rubber")
		cyl("PlateField", V(px, 0, 0), t + 0.07 * s, d * 0.46, BLUE, "Rubber")
		cyl("PlateHub", V(px, 0, 0), t + 0.12 * s, d * 0.3, STEEL, "Metal")
		local boltX = px + side * (t / 2 + 0.06 * s)
		for k = 0, 5 do
			local a = k * math.pi / 3
			local r = d * 0.118
			ball("HubBolt", V(boltX, math.cos(a) * r, math.sin(a) * r), V(0.1 * s, 0.1 * s, 0.1 * s), CHROME, "Metal")
		end
		labels[#labels + 1] = { Piece = face, Side = side }

		-- lock-jaw collar with a round lever
		local cx = side * 4.1 * s
		cyl("Collar", V(cx, 0, 0), 0.22 * s, 0.66 * s, RED, "SmoothPlastic")
		cyl("CollarRing", V(cx, 0, 0), 0.24 * s, 0.5 * s, RED_DARK, "SmoothPlastic")
		cyl("CollarLever", V(cx, 0.4 * s, 0), 0.26 * s, 0.1 * s, RED_DARK, "SmoothPlastic", "Y")
		ball("CollarKnob", V(cx, 0.55 * s, 0), V(0.17 * s, 0.17 * s, 0.17 * s), RED, "SmoothPlastic")
	end
	return pieces, labels
end

-- Prints the plate lettering on the outer face of a PlateFace part (a cylinder along X).
function BarbellDesign.Label(part, side)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PlateLettering"
	gui.Face = side &gt; 0 and Enum.NormalId.Right or Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 110
	gui.LightInfluence = 0.2
	gui.MaxDistance = 140
	gui.Parent = part
	local function text(t, y, w, h)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Position = UDim2.fromScale((1 - w) / 2, y)
		l.Size = UDim2.fromScale(w, h)
		l.Text = t
		l.TextScaled = true
		l.Font = Enum.Font.GothamBlack
		l.TextColor3 = WHITE
		l.Parent = gui
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(8, 34, 90)
		st.Thickness = 2
		st.Parent = l
		return l
	end
	text("+1 GYM GAME", 0.05, 0.56, 0.13)
	text("20 KG", 0.81, 0.4, 0.13)
	return gui
end

return BarbellDesign
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="NEWMOD1"><Properties><string name="Name">IconSlot</string><ProtectedString name="Source">--[[
	IconSlot (shared) - lets server-built UI (the name tag over your head, the signs in the
	gyms) show the game's logo pictures (IconData: Strength arm, Money stack, Rebirth star,
	Lucky Block, Gyms map ...).

	The logos are painted on the CLIENT (IconLoader + EditableImage), so the server only
	creates an empty ImageLabel tagged "GymIcon" with the logo's name in its "Icon"
	attribute. Each client paints it; until then (or in Studio edit mode) the emoji
	fallback inside it is shown.
]]
local IconSlot = {}

function IconSlot.Make(parent, iconName, emoji, size, layoutOrder)
	local img = Instance.new("ImageLabel")
	img.Name = iconName .. "Icon"
	img.BackgroundTransparency = 1
	img.ScaleType = Enum.ScaleType.Fit
	img.Size = size or UDim2.fromScale(1, 1)
	img.LayoutOrder = layoutOrder or 0
	img:SetAttribute("Icon", iconName)
	img:AddTag("GymIcon")
	local fallback = Instance.new("TextLabel")
	fallback.Name = "Fallback"
	fallback.BackgroundTransparency = 1
	fallback.Size = UDim2.fromScale(1, 1)
	fallback.Text = emoji or ""
	fallback.TextScaled = true
	fallback.ZIndex = img.ZIndex
	fallback.Font = Enum.Font.GothamBold
	fallback.TextColor3 = Color3.new(1, 1, 1)
	fallback.Parent = img
	img.Parent = parent
	return img
end

return IconSlot
</ProtectedString></Properties></Item>
      <Item class="ModuleScript" referent="RBX5">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source">--[[
	Config  (shared: server + client)
	=================================
	EVERYTHING you might want to tune or extend lives in this file.

	  * Add a gym     -&gt; add an entry to AREAS (stations + egg + pets are generated from it)
	  * Add a quest   -&gt; add an entry to Config.Quests
	  * Add an upgrade-&gt; add an entry to Config.Upgrades (then handle its effect in Formulas if needed)
	  * Change balance-&gt; edit the numbers in Training / Rebirth / AREAS

	The world layout, stations, eggs and pets are all GENERATED from AREAS below,
	so the server (MapBuilder) and client (UI) always agree with each other.
]]

local Config = {}

----------------------------------------------------------------------
-- GENERAL
----------------------------------------------------------------------
Config.Game = {
	Title = "+1 Gym Game",
	DataStoreName = "GymLegends_v1", -- keep this key: changing it would wipe everyone's saves
	AutosaveSeconds = 30,
	MaxPetsOwned = 150,
	BasePetSlots = 3,
	BaseWalkSpeed = 16,
	MaxRebirths = 100,
	StartCoins = 150,
	MaxValue = 1e300, -- hard cap so numbers can never become inf / NaN
}

----------------------------------------------------------------------
-- ADMIN  (who may use the admin panel). The SERVER checks this on EVERY admin request;
-- hiding the button on the client is only cosmetic.
----------------------------------------------------------------------
Config.Admin = {
	-- PUT YOUR ROBLOX USER ID HERE (and your co-owners'). Explicit ids always work.
	UserIds = {
		-- 123456789,
	},
	-- Super admins can't be kicked / banned / edited by normal admins. The game owner is always protected.
	SuperAdminUserIds = {},
	AllowGameCreator = true,    -- the place owner (user-owned game) or the owner of the owning group
	GroupId = 0,                -- optional: members of this group with MinimumGroupRank+ are admins (0 = off)
	MinimumGroupRank = 255,
	AllowStudioTesting = true,  -- in a Studio test session every player is an admin
	BanDataStoreName = "GymLegends_AdminBans_v1", -- separate from the progression DataStore
	LogSize = 300,              -- audit entries kept in memory (the Logs tab shows the latest 100)
	ActionCooldown = 0.1,       -- seconds between admin actions, per admin
	StateCooldown = 0.15,       -- seconds between admin data requests, per admin
	MaxBanMinutes = 5 * 365 * 24 * 60,
	MaxGivePets = 25,           -- pets per "Give Pet" request
	MaxQuestIndex = 10000,
	BanPresets = {
		{ Label = "10 MIN", Minutes = 10 },
		{ Label = "1 HOUR", Minutes = 60 },
		{ Label = "1 DAY", Minutes = 24 * 60 },
		{ Label = "7 DAYS", Minutes = 7 * 24 * 60 },
		{ Label = "30 DAYS", Minutes = 30 * 24 * 60 },
	},
}

----------------------------------------------------------------------
-- DONATION SHOP  (the "Shop" button). Create the Developer Products on the Creator
-- Dashboard (Monetization &gt; Developer Products) and paste their ids into ProductId.
-- Items with ProductId = 0 show "coming soon" instead of a Robux prompt.
--   Kind = "Perk" : a permanent perk saved on the profile (Perk = its key)
--   Kind = "Tip"  : a thank-you donation (adds to the player's donated total)
-- Admins can hand out any item from the admin panel (Player tab).
----------------------------------------------------------------------
Config.Donations = {
	AutoClickRate = 7, -- reps per second while the Auto Clicker is on (server still caps reps)
	Items = {
		{ Id = "AutoClicker", Kind = "Perk", Perk = "AutoClicker", Name = "Auto Clicker", Robux = 149, ProductId = 0,
			Icon = "UPG_AutoTrain", Emoji = "🖱️", Desc = "Trains for you while you hold a weight or use a machine. Toggle it next to the TRAIN button." },
		{ Id = "Tip10", Kind = "Tip", Name = "Protein Shake", Robux = 10, ProductId = 0, Icon = "Money", Emoji = "🥤", Desc = "A small thank-you!" },
		{ Id = "Tip50", Kind = "Tip", Name = "Pre-Workout", Robux = 50, ProductId = 0, Icon = "Money", Emoji = "⚡", Desc = "Keeps the gym lights on." },
		{ Id = "Tip100", Kind = "Tip", Name = "Gym Membership", Robux = 100, ProductId = 0, Icon = "Money", Emoji = "🎫", Desc = "You're a legend!" },
		{ Id = "Tip500", Kind = "Tip", Name = "Personal Trainer", Robux = 500, ProductId = 0, Icon = "Money", Emoji = "🏋️", Desc = "Huge support - thank you!" },
		{ Id = "Tip1000", Kind = "Tip", Name = "Golden Dumbbell", Robux = 1000, ProductId = 0, Icon = "Money", Emoji = "🏆", Desc = "The ultimate supporter." },
	},
}
Config.DonationsById = {}
Config.DonationPerks = {}
for _, item in ipairs(Config.Donations.Items) do
	Config.DonationsById[item.Id] = item
	if item.Perk then
		Config.DonationPerks[item.Perk] = item
	end
end

----------------------------------------------------------------------
-- RARITIES  (Weight = hatch chance in %, BaseMult = pet strength multiplier in the FIRST egg)
----------------------------------------------------------------------
Config.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }
Config.Rarities = {
	Common = { Order = 1, Label = "COMMON", Color = Color3.fromRGB(205, 210, 222), Weight = 50, BaseMult = 1.2 },
	Uncommon = { Order = 2, Label = "UNCOMMON", Color = Color3.fromRGB(96, 224, 112), Weight = 25, BaseMult = 2 },
	Rare = { Order = 3, Label = "RARE", Color = Color3.fromRGB(72, 156, 255), Weight = 15, BaseMult = 5 },
	Epic = { Order = 4, Label = "EPIC", Color = Color3.fromRGB(190, 96, 255), Weight = 7, BaseMult = 10 },
	Legendary = { Order = 5, Label = "LEGENDARY", Color = Color3.fromRGB(255, 196, 40), Weight = 2.5, BaseMult = 25 },
	Mythic = { Order = 6, Label = "MYTHIC", Color = Color3.fromRGB(255, 64, 96), Weight = 0.45, BaseMult = 75 },
	Secret = { Order = 7, Label = "SECRET", Color = Color3.fromRGB(255, 92, 224), Weight = 0.05, BaseMult = 250, Rainbow = true },
}

----------------------------------------------------------------------
-- TRAINING / ECONOMY
----------------------------------------------------------------------
Config.Training = {
	TierMultipliers = { 1, 2.5, 6 }, -- strength per rep of station tier 1/2/3 relative to the area's StationBase
	PriceInReps = { 20, 60, 200 },   -- station price (coins) = its strength-per-rep * this
	CoinRatio = 0.5,                  -- coins per rep = strength-per-rep * this
	MaxRepsPerSecond = 9,             -- server-side cap for manual clicking
	AutoInterval = 0.5,               -- seconds between automatic reps (Auto Trainer upgrade)
	CritChance = 0.06,
	CritMultiplier = 3,
	StandRange = 14,                  -- how far from the station a player can be and keep training
	PromptRange = 11,
}

Config.Sell = {
	Options = { 0.1, 0.5, 1 }, -- fractions of current Strength the player may sell
	Efficiency = 0.75,         -- 1 = same coins you'd get from training that much strength
	Range = 30,
	-- what the Protein Bar menu calls each option (same order as Options)
	Menu = {
		{ Name = "Whey Shake", Emoji = "🥤", Desc = "A quick post-workout shake" },
		{ Name = "Mass Gainer", Emoji = "🍌", Desc = "Big shake, big payout" },
		{ Name = "Full Stack", Emoji = "🔥", Desc = "Cash in ALL your Strength" },
	},
}

Config.Egg = {
	Range = 40,
	Cooldown = 1.0,
	PriceInTopReps = { 50, 500, 900, 1500, 2500, 4000, 6000, 9000, 13000 }, -- egg price = (coins per rep of the area's best station) * this (per area)
}

Config.Orbs = {
	PerArea = 10,             -- floating dumbbells per gym; each spawns at a random open spot
	RespawnSeconds = 18,
	ValueInTopReps = 30, -- orb value = (coins per rep of the area's best station) * this
	PickupRange = 6,
}

Config.Rebirth = {
	MultiplierBase = 0.25,    -- additive per rebirth: total = 1 + rebirths * 0.25  (x1, x1.25, x1.50 ...)
	BaseRequirement = 1500, -- strength needed for the first rebirth
	Growth = 2.2,               -- requirement = BaseRequirement * Growth ^ rebirths
}

Config.PetRules = {
	AreaGrowth = 2, -- each new egg's pets are this many times stronger than the previous egg's
	Stacking = "additive", -- total = 1 + sum(mult - 1)   (documented in Formulas.PetMultiplier)
}

----------------------------------------------------------------------
-- WORLD LAYOUT  (areas are lined up along -Z, joined by corridors)
----------------------------------------------------------------------
-- HUD icon images. Upload the PNGs in Studio (Asset Manager / Toolbox &gt; My Images),
-- copy each "rbxassetid://..." and paste it here. Empty = the emoji is used instead.
Config.Icons = {
	Money = "",     -- money stack picture
	Strength = "",  -- red flexing arm picture
}

Config.World = {
	RoomSize = 240,
	Stride = 420,
	WallHeight = 44,
	GateWidth = 30,
	GateHeight = 34,
	CorridorWidth = 30,
	SpawnHeightOffset = 4,
}

function Config.AreaCenter(index)
	return Vector3.new(0, 0, -(index - 1) * Config.World.Stride)
end

-- Where a player is placed when they teleport into an area (near its entrance).
function Config.AreaSpawn(index)
	local c = Config.AreaCenter(index)
	return c + Vector3.new(0, Config.World.SpawnHeightOffset, Config.World.RoomSize / 2 - 30)
end

-- Where a locked player is pushed back to (just outside the gate).
function Config.GateFront(index)
	local c = Config.AreaCenter(index)
	return c + Vector3.new(0, Config.World.SpawnHeightOffset, Config.World.RoomSize / 2 + 16)
end

-- Which area (index) is this X/Z position inside? nil when in a corridor / outside.
function Config.AreaAt(position)
	local half = Config.World.RoomSize / 2 - 2
	if math.abs(position.X) &gt; half then
		return nil
	end
	local n = #Config.Areas
	for i = 1, n do
		local c = Config.AreaCenter(i)
		if math.abs(position.Z - c.Z) &lt; half then
			return i
		end
	end
	return nil
end

----------------------------------------------------------------------
-- AREAS  (the heart of the game: add a gym by adding an entry)
--   Stations = { {Kind, Name}, ... }  tier 1/2/3 = weaker -&gt; stronger
--   Pets     = { {Name, Emoji}, ... } one per rarity in RarityOrder
----------------------------------------------------------------------
local AREAS = {
	{
		Id = "Beginner", Name = "Beginner Gym", Icon = "🏋️", Required = 0, StationBase = 1, Hue = 0.07,
		Egg = "Beginner Lucky Block",
		Theme = {
			Floor = Color3.fromRGB(190, 150, 108), FloorMat = "WoodPlanks",
			Wall = Color3.fromRGB(214, 218, 224), WallMat = "Brick",
			Accent = Color3.fromRGB(255, 150, 40), Locker = Color3.fromRGB(70, 96, 140),
			Ambient = Color3.fromRGB(200, 200, 210), Clock = 13, Brightness = 3,
			Fog = Color3.fromRGB(200, 230, 255), FogEnd = 3000, Decor = "Mats",
		},
		Stations = { { "Dumbbell", "Basic Dumbbells" }, { "Squat", "Starter Squat Rack" }, { "Treadmill", "Old Treadmill" } },
		Pets = { { "Rookie Pup", "🐶" }, { "Chalk Hound", "🐕" }, { "Spotter Scout", "🐶" }, { "Pump Pooch", "🐕" },
			{ "Iron Retriever", "🐶" }, { "Golden Mastiff", "🐕" }, { "Apex Alpha", "🐺" } },
	},
	{
		Id = "City", Name = "City Gym", Icon = "🌆", Required = 5000, StationBase = 8, Hue = 0.93,
		Egg = "City Lucky Block",
		Theme = {
			Floor = Color3.fromRGB(150, 152, 158), FloorMat = "Concrete",
			Wall = Color3.fromRGB(150, 80, 64), WallMat = "Brick",
			Accent = Color3.fromRGB(235, 64, 80), Locker = Color3.fromRGB(64, 66, 72),
			Ambient = Color3.fromRGB(200, 185, 200), Clock = 15.5, Brightness = 2.8,
			Fog = Color3.fromRGB(255, 215, 225), FogEnd = 2600, Decor = "Skyline",
		},
		Stations = { { "Squat", "City Squat Rack" }, { "Bag", "Street Punching Bag" }, { "Deadlift", "Concrete Deadlift" } },
		Pets = { { "Metro Mutt", "🐶" }, { "Alley Bolt", "🐕" }, { "Neon Hound", "🐶" }, { "Rooftop Runner", "🐕" },
			{ "Chrome Canine", "🐶" }, { "Skyline Shepherd", "🐕" }, { "Graffiti Alpha", "🐺" } },
	},
	{
		Id = "Pro", Name = "Pro Gym", Icon = "🏆", Required = 200000, StationBase = 64, Hue = 0.0,
		Egg = "Pro Lucky Block",
		Theme = {
			Floor = Color3.fromRGB(176, 124, 80), FloorMat = "WoodPlanks",
			Wall = Color3.fromRGB(58, 62, 72), WallMat = "SmoothPlastic",
			Accent = Color3.fromRGB(230, 50, 60), Locker = Color3.fromRGB(150, 30, 40),
			Ambient = Color3.fromRGB(200, 200, 215), Clock = 14, Brightness = 3,
			Fog = Color3.fromRGB(210, 230, 255), FogEnd = 3000, Decor = "Trophies",
		},
		Stations = { { "Dumbbell", "Pro Hex Dumbbells" }, { "Squat", "Competition Squat Rack" }, { "Squat", "Power Rack" } },
		Pets = { { "Training Pup", "🐶" }, { "Plate Hound", "🐕" }, { "Rep Runner", "🐶" }, { "Champion K9", "🐕" },
			{ "Iron Bulldog", "🐶" }, { "Olympia Hound", "🐕" }, { "Trophy Alpha", "🐺" } },
	},
	{
		Id = "Luxury", Name = "Luxury Gym", Icon = "💎", Required = 8000000, StationBase = 512, Hue = 0.13,
		Egg = "Luxury Lucky Block",
		Theme = {
			Floor = Color3.fromRGB(238, 234, 228), FloorMat = "Marble",
			Wall = Color3.fromRGB(226, 216, 202), WallMat = "Marble",
			Accent = Color3.fromRGB(212, 175, 60), Locker = Color3.fromRGB(96, 70, 52),
			Beam = Color3.fromRGB(236, 230, 218), NoPanels = true,
			Ambient = Color3.fromRGB(215, 195, 200), Clock = 15, Brightness = 3,
			Fog = Color3.fromRGB(255, 225, 235), FogEnd = 2800, Decor = "Chandeliers",
		},
		Stations = { { "Treadmill", "Golden Treadmill" }, { "Bag", "Diamond Punching Bag" }, { "Deadlift", "Marble Deadlift" } },
