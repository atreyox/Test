local BRANDS = {
	{ Name = "IRON WHEY", Line = "100% WHEY • 5 LB", Color = Color3.fromRGB(24, 24, 28), Accent = Color3.fromRGB(230, 50, 50) },
	{ Name = "MASS MAX", Line = "GAINER • 6 LB", Color = Color3.fromRGB(236, 236, 240), Accent = Color3.fromRGB(40, 90, 200) },
	{ Name = "PRE-RAGE", Line = "PRE-WORKOUT", Color = Color3.fromRGB(196, 40, 44), Accent = Color3.fromRGB(255, 210, 40) },
	{ Name = "CREATINE", Line = "MONOHYDRATE", Color = Color3.fromRGB(36, 88, 196), Accent = WHITE },
	{ Name = "BCAA", Line = "ICY BLUE RAZZ", Color = Color3.fromRGB(40, 150, 90), Accent = Color3.fromRGB(255, 255, 255) },
	{ Name = "GOLD WHEY", Line = "DOUBLE CHOC", Color = Color3.fromRGB(246, 176, 24), Accent = Color3.fromRGB(40, 24, 10) },
}

-- Protein tub: body, lid, and a printed front label.
local function proteinTub(parent, cf, offset, brand, labelled)
	cyl(parent, cf, offset, "Y", 1.6, 1.2, brand.Color, "SmoothPlastic", { CanCollide = false, Name = "ProteinTub" })
	cyl(parent, cf, offset + V(0, 0.9, 0), "Y", 0.25, 1.14, brand.Accent, "SmoothPlastic", { CanCollide = false, Name = "TubLid" })
	cyl(parent, cf, offset + V(0, 0.79, 0), "Y", 0.04, 1.22, Color3.fromRGB(20, 20, 24), "SmoothPlastic", { CanCollide = false, Name = "TubSeal" })
	if labelled then
		local label = add(parent, cf, offset + V(0, -0.05, 0.61), V(0.86, 1.1, 0.02), WHITE, "SmoothPlastic", { CanCollide = false, Name = "TubLabel" })
		label.CFrame = label.CFrame * CFrame.Angles(0, math.pi, 0)
		local g = surface(label, Enum.NormalId.Front, 60)
		local bg = ui("Frame", g, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = brand.Color })
		ui("Frame", bg, { Size = UDim2.fromScale(1, 0.12), Position = UDim2.fromScale(0, 0.06), BackgroundColor3 = brand.Accent })
		ui("TextLabel", bg, { Size = UDim2.fromScale(0.92, 0.36), Position = UDim2.fromScale(0.04, 0.22), Text = brand.Name, TextColor3 = brand.Accent == WHITE and WHITE or brand.Accent })
		ui("TextLabel", bg, { Size = UDim2.fromScale(0.9, 0.14), Position = UDim2.fromScale(0.05, 0.6), Text = brand.Line, TextColor3 = WHITE, Font = Enum.Font.GothamBold,
			Stroke = { Color3.new(0, 0, 0), 1 } })
		ui("TextLabel", bg, { Size = UDim2.fromScale(0.6, 0.12), Position = UDim2.fromScale(0.2, 0.8), Text = "25g PROTEIN", TextColor3 = WHITE, Font = Enum.Font.GothamBold,
			BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3 })
	end
end

-- A wrapped protein bar: foil wrapper with crimped seals on both ends and a printed top.
local function proteinBar(parent, cf, brand, labelled)
	add(parent, cf, V(0, 0, 0), V(1.3, 0.22, 0.44), brand.Color, "SmoothPlastic", { CanCollide = false, Name = "BarWrapper" })
	for _, s in ipairs({ -1, 1 }) do
		add(parent, cf, V(s * 0.72, 0, 0), V(0.14, 0.05, 0.46), brand.Color:Lerp(WHITE, 0.25), "Foil", { CanCollide = false, Name = "BarCrimp" })
	end
	add(parent, cf, V(0, 0.112, 0), V(1.26, 0.01, 0.12), brand.Accent, "SmoothPlastic", { CanCollide = false, Name = "BarStripe" })
	if labelled then
		local top = add(parent, cf, V(0, 0.118, 0), V(1.2, 0.01, 0.4), brand.Color, "SmoothPlastic", { CanCollide = false, Name = "BarPrint" })
		local g = surface(top, Enum.NormalId.Top, 90)
		ui("TextLabel", g, { Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.08), Text = "PROTEIN BAR", TextColor3 = brand.Accent == WHITE and WHITE or brand.Accent })
		ui("TextLabel", g, { Size = UDim2.fromScale(0.9, 0.34), Position = UDim2.fromScale(0.05, 0.6), Text = "20g PROTEIN", TextColor3 = WHITE, Font = Enum.Font.GothamBold })
	end
end

-- Counter display box of protein bars (open cardboard tray, printed header card)
local function barDisplay(parent, cf, brand)
	local card = Color3.fromRGB(236, 230, 214)
	add(parent, cf, V(0, 0.05, 0), V(2.86, 0.1, 1.46), card, "Cardboard", { CanCollide = false, Name = "DisplayTray" })
	for _, s in ipairs({ -1, 1 }) do
		add(parent, cf, V(s * 1.43, 0.25, 0), V(0.04, 0.4, 1.5), card, "Cardboard", { CanCollide = false, Name = "DisplaySide" })
	end
	add(parent, cf, V(0, 0.2, 0.73), V(2.82, 0.3, 0.04), brand.Color, "Cardboard", { CanCollide = false, Name = "DisplayFront" })
	local header = add(parent, cf, V(0, 0.75, -0.73), V(2.8, 1.5, 0.04), brand.Color, "Cardboard", { CanCollide = false, Name = "DisplayHeader" })
	header.CFrame = header.CFrame * CFrame.Angles(0, math.pi, 0)
	local g = surface(header, Enum.NormalId.Front, 60)
	local bg = ui("Frame", g, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Gradient = { brand.Color, brand.Color:Lerp(Color3.new(0, 0, 0), 0.4), 90 } })
	ui("TextLabel", bg, { Size = UDim2.fromScale(0.9, 0.42), Position = UDim2.fromScale(0.05, 0.08), Text = "PROTEIN BARS", TextColor3 = brand.Accent == WHITE and WHITE or brand.Accent, Stroke = { Color3.new(0, 0, 0), 1 } })
	ui("TextLabel", bg, { Size = UDim2.fromScale(0.9, 0.26), Position = UDim2.fromScale(0.05, 0.55), Text = "20g PROTEIN • LOW SUGAR", Font = Enum.Font.GothamBold })
	-- bars standing in two tilted rows
	for row = 0, 1 do
		for i = 0, 5 do
			-- length points up (leaning back 20°), printed side faces the customer
			local c, sn = math.cos(math.rad(20)), math.sin(math.rad(20))
			local bcf = cf * CFrame.new(-1.15 + i * 0.46, 0.72 + row * 0.12, 0.3 - row * 0.55, 0, 0, 1, c, sn, 0, -sn, c, 0)
			proteinBar(parent, bcf, brand, row == 0)
		end
	end
end

-- Shaker bottle: translucent cup, screw ring, lid with flip spout and a carry loop.
local function shaker(parent, cf, color)
	cyl(parent, cf, V(0, 0.8, 0), "Y", 1.6, 0.72, color, "Glass", { CanCollide = false, Transparency = 0.25, Name = "ShakerCup" })
	cyl(parent, cf, V(0, 0.48, 0), "Y", 0.9, 0.66, Color3.fromRGB(150, 110, 80), "SmoothPlastic", { CanCollide = false, Name = "ShakeInside" })
	cyl(parent, cf, V(0, 1.66, 0), "Y", 0.14, 0.76, Color3.fromRGB(26, 26, 30), "SmoothPlastic", { CanCollide = false, Name = "ShakerRing" })
	cyl(parent, cf, V(0, 1.82, 0), "Y", 0.18, 0.66, Color3.fromRGB(26, 26, 30), "SmoothPlastic", { CanCollide = false, Name = "ShakerLid" })
	cyl(parent, cf, V(0.18, 1.98, 0), "Y", 0.16, 0.16, Color3.fromRGB(26, 26, 30), "SmoothPlastic", { CanCollide = false, Name = "ShakerSpout" })
	add(parent, cf, V(-0.42, 1.8, 0), V(0.1, 0.34, 0.2), Color3.fromRGB(26, 26, 30), "SmoothPlastic", { CanCollide = false, Name = "ShakerLoop" })
end

----------------------------------------------------------------------
-- Room shell: floor, walls with doorways, pillars, trim
----------------------------------------------------------------------
local function buildShell(ctx)
	local area, theme, folder = ctx.area, ctx.theme, ctx.folder
	local W = Config.World
	local half = W.RoomSize / 2
	local wallH = W.WallHeight
	local at = ctx.at
	local floorMat, wallMat = theme.FloorMat, theme.WallMat

	add(folder, at(0, -1, 0), V(0, 0, 0), V(W.RoomSize, 2, W.RoomSize), theme.Floor, floorMat, { Name = "Floor" })
	-- painted safety lines marking the walkway
	add(folder, at(0, 0.06, 0), V(-16, 0, 0), V(0.6, 0.12, W.RoomSize - 4), SAFETY_YELLOW, "SmoothPlastic", { CanCollide = false, Name = "LaneLeft" })
	add(folder, at(0, 0.06, 0), V(16, 0, 0), V(0.6, 0.12, W.RoomSize - 4), SAFETY_YELLOW, "SmoothPlastic", { CanCollide = false, Name = "LaneRight" })

	local gapWidth = W.GateWidth
	local function horizontalWall(z, hasGap, name)
		local total = W.RoomSize + 3.96
		if not hasGap then
			add(folder, at(0, wallH / 2, z), V(0, 0, 0), V(total, wallH, 4), theme.Wall, wallMat, { Name = name })
			return
		end
		local segLen = (total - gapWidth) / 2
		local segCenter = gapWidth / 2 + segLen / 2
		add(folder, at(-segCenter, wallH / 2, z), V(0, 0, 0), V(segLen, wallH, 4), theme.Wall, wallMat, { Name = name .. "L" })
		add(folder, at(segCenter, wallH / 2, z), V(0, 0, 0), V(segLen, wallH, 4), theme.Wall, wallMat, { Name = name .. "R" })
		local lintelH = wallH - W.GateHeight
		add(folder, at(0, W.GateHeight + lintelH / 2, z), V(0, 0, 0), V(gapWidth, lintelH, 4), theme.Wall, wallMat, { Name = name .. "Lintel" })
	end
	horizontalWall(half, area.Index &gt; 1, "WallEntrance")
	horizontalWall(-half, area.Index &lt; #Config.Areas, "WallExit")
	-- side walls are a hair taller/shorter than the end walls so the corners never share a face
	add(folder, at(-half, wallH / 2 + 0.01, 0), V(0, 0, 0), V(4, wallH + 0.02, W.RoomSize + 3.96), theme.Wall, wallMat, { Name = "WallWest" })
	add(folder, at(half, wallH / 2 + 0.01, 0), V(0, 0, 0), V(4, wallH + 0.02, W.RoomSize + 3.96), theme.Wall, wallMat, { Name = "WallEast" })

	-- dark kick band + painted accent stripe low on the side walls, LED strip up high
	for _, side in ipairs({ -1, 1 }) do
		add(folder, at(side * (half - 2.15), 2, 0), V(0, 0, 0), V(0.3, 4, W.RoomSize - 6), darker(theme.Wall, 0.45), "SmoothPlastic", { CanCollide = false, Name = "KickBand" })
		add(folder, at(side * (half - 2.3), 5, 0), V(0, 0, 0), V(0.4, 1.2, W.RoomSize - 6), theme.Accent, "SmoothPlastic", { CanCollide = false, Name = "Trim" })
		add(folder, at(side * (half - 2.3), wallH - 4, 0), V(0, 0, 0), V(0.4, 0.5, W.RoomSize - 6), theme.Accent, "Neon", { CanCollide = false, Name = "Trim" })
	end

	-- corner pillars (concrete columns with steel bands)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, at(sx * (half - 1), (wallH + 6) / 2, sz * (half - 1)), V(0, 0, 0), "Y", wallH + 6, 8, darker(theme.Wall, 0.8), wallMat, { Name = "Pillar" })
			cyl(folder, at(sx * (half - 1), 0.6, sz * (half - 1)), V(0, 0, 0), "Y", 1.2, 8.8, STEEL_DARK, "Metal", { CanCollide = false, Name = "PillarBand" })
			cyl(folder, at(sx * (half - 1), wallH - 4, sz * (half - 1)), V(0, 0, 0), "Y", 0.6, 8.8, theme.Accent, "Metal", { CanCollide = false, Name = "PillarBand" })
		end
	end

	-- area title sign above the exit / far wall
	local signPos = ctx.origin + V(0, wallH - 6, -half + 2.6)
	sign(folder, CFrame.lookAt(signPos, signPos + V(0, 0, 1)), V(70, 8, 0.6), area.Icon .. "  " .. string.upper(area.Name) .. "  " .. area.Icon,
		WHITE, darker(theme.Wall, 0.3), 0)
	add(folder, CFrame.lookAt(signPos, signPos + V(0, 0, 1)), V(0, 0, 0.4), V(71, 9, 0.3), theme.Accent, "Metal", { CanCollide = false, Name = "SignFrame" })

	if theme.Ceiling then
		add(folder, at(0, wallH + 3, 0), V(0, 0, 0), V(W.RoomSize + 8, 2, W.RoomSize + 8), darker(theme.Wall, 0.55), theme.WallMat, { Name = "Ceiling" })
	end
end

----------------------------------------------------------------------
-- Real gym interior shared by every room
----------------------------------------------------------------------

local function buildGymInterior(ctx)
	local folder, theme, area = ctx.folder, ctx.theme, ctx.area
	local W = Config.World
	local half = W.RoomSize / 2
	local wallH = W.WallHeight
	local at = ctx.at
	local accent = theme.Accent

	-- FREE-WEIGHT ZONE (west): rubber tiles, mirror wall, racks
	add(folder, at(-79, 0.05, 0), V(0, 0, 0), V(74, 0.1, W.RoomSize - 8), RUBBER_C, "Rubber", { CanCollide = false, Name = "RubberFloor" })
	for x = -114, -44, 8 do
		add(folder, at(x, 0.11, 0), V(0, 0, 0), V(0.12, 0.02, W.RoomSize - 8), SEAM_C, "SmoothPlastic", { CanCollide = false, Name = "TileSeam" })
	end
	for z = -112, 112, 8 do
		add(folder, at(-79, 0.115, z), V(0, 0, 0), V(74, 0.03, 0.12), SEAM_C, "SmoothPlastic", { CanCollide = false, Name = "TileSeam" })
	end

	for z = -100, 100, 20 do
		local m = add(folder, at(-half + 2.1, 12.8, z), V(0, 0, 0), V(0.2, 12, 19.4), MIRROR_C, "Glass", { CanCollide = false, Name = "Mirror" })
		m.Reflectance = 0.55
	end
	for z = -110, 110, 20 do
		add(folder, at(-half + 2.3, 12.8, z), V(0, 0, 0), V(0.3, 12.4, 0.6), STEEL_DARK, "Metal", { CanCollide = false, Name = "MirrorFrame" })
	end
	for _, y in ipairs({ 6.7, 18.9 }) do
		add(folder, at(-half + 2.3, y, 0), V(0, 0, 0), V(0.34, 0.4, 220.5), STEEL_DARK, "Metal", { CanCollide = false, Name = "MirrorFrame" })
	end

	dumbbellRack(folder, face(ctx, -110, 100, "+X"), 18)
	dumbbellRack(folder, face(ctx, -110, -92, "+X"), 18)
	flatBench(folder, face(ctx, -96, 100, "+X"))
	flatBench(folder, face(ctx, -96, -92, "+X"))
	plateTree(folder, face(ctx, -104, 35, "+X"))
	plateTree(folder, face(ctx, -104, -18, "+X"))
	kettlebellShelf(folder, face(ctx, -112, 10, "+X"), 12)
	plyoBoxes(folder, face(ctx, -96, -112, "+Z"))

	-- TURF SPRINT LANE down the middle
	add(folder, at(0, 0.06, 0), V(0, 0, 0), V(14, 0.12, W.RoomSize - 30), TURF, "Grass", { CanCollide = false, Name = "Turf" })
	for _, x in ipairs({ -6.6, 6.6 }) do
		add(folder, at(x, 0.13, 0), V(0, 0, 0), V(0.4, 0.02, W.RoomSize - 30), WHITE, "SmoothPlastic", { CanCollide = false, Name = "TurfLine" })
	end
	for z = -100, 100, 20 do
		add(folder, at(0, 0.135, z), V(0, 0, 0), V(13.2, 0.03, 0.4), WHITE, "SmoothPlastic", { CanCollide = false, Name = "TurfLine" })
	end

	-- EAST SIDE: windows + posters, cardio row, lockers, water fountain
	if not theme.Ceiling then
		for _, z in ipairs({ -75, 0, 75 }) do
			local x = half - 2.1
			add(folder, at(x, 21, z), V(0, 0, 0), V(0.3, 14, 22), Color3.fromRGB(205, 228, 245), "Neon", { CanCollide = false, Name = "Window", Transparency = 0.35 })
			for _, dz in ipairs({ -11, -3.7, 3.7, 11 }) do
				add(folder, at(x - 0.1, 21, z + dz), V(0, 0, 0), V(0.4, 14.5, 0.6), STEEL_DARK, "Metal", { CanCollide = false, Name = "WindowFrame" })
			end
			for _, dy in ipairs({ -7, 7 }) do
				add(folder, at(x - 0.1, 21 + dy, z), V(0, 0, 0), V(0.44, 0.6, 22.5), STEEL_DARK, "Metal", { CanCollide = false, Name = "WindowFrame" })
			end
		end
	end
	for i, z in ipairs({ -37.5, 37.5, 100 }) do
		local pos = ctx.origin + V(half - 2.15, 13, z)
		poster(folder, pos, V(-1, 0, 0), POSTER_DESIGNS[(i + area.Index * 2) % #POSTER_DESIGNS + 1])
	end
	-- two more on the entrance wall, either side of the doorway
	for i, x in ipairs({ -36, 36 }) do
		local pos = ctx.origin + V(x, 13, half - 2.15)
		poster(folder, pos, V(0, 0, -1), POSTER_DESIGNS[(i + area.Index * 2 + 3) % #POSTER_DESIGNS + 1])
	end
	do
		local pos = ctx.origin + V(84, 20, half - 2.25)
		sign(folder, CFrame.lookAt(pos, pos + V(0, 0, -1)), V(30, 5, 0.2), "LOCKER ROOM", WHITE, Color3.fromRGB(20, 20, 24), 0)
	end

	lockerRow(folder, face(ctx, 84, 114, "-Z"), 14, theme.Locker or Color3.fromRGB(70, 90, 120))
	for _, x in ipairs({ 54, 62, 70 }) do
		spinBike(folder, face(ctx, x, -100, "+Z"), accent)
	end
	for _, x in ipairs({ 86, 100 }) do
		rower(folder, face(ctx, x, -96, "+Z"))
	end
	wallTV(folder, ctx.origin + V(60, 17, -half + 2.4), V(0, 0, 1), area.Icon .. " " .. string.upper(area.Name) .. "\nCARDIO ZONE", darker(accent, 0.35))
	wallTV(folder, ctx.origin + V(96, 17, -half + 2.4), V(0, 0, 1), "🔥 KEEP GOING!\n❤ 142 BPM", Color3.fromRGB(16, 24, 40))
	waterFountain(folder, face(ctx, 116.5, 12, "-X"))
	pottedPlant(folder, ctx.at(112, 0, -8), 1.1)
	pottedPlant(folder, ctx.at(112, 0, 92), 1.2)
	pottedPlant(folder, ctx.at(52, 0, 112), 1.1)
	pottedPlant(folder, ctx.at(-44, 0, 112), 1.1)

	-- CEILING: steel I-beams with hanging LED panels
	local beamColor = theme.Beam or STEEL_BEAM
	local beamY = wallH - 2
	for _, z in ipairs({ -90, -45, 0, 45, 90 }) do
		iBeam(folder, at(0, beamY, z), W.RoomSize, beamColor)
	end
	if not theme.NoPanels then
		for _, z in ipairs({ -90, -45, 0, 45, 90 }) do
			for _, x in ipairs({ -70, 0, 70 }) do
				lightPanel(folder, at(x, wallH - 12, z), 12, beamY - 1.55 - (wallH - 12) - 0.25)
			end
		end
	end

	-- speakers in the corners
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local pos = ctx.origin + V(sx * (half - 8), wallH - 10, sz * (half - 3.4))
			speaker(folder, CFrame.lookAt(pos, pos + V(-sx * 0.4, -0.15, -sz)))
		end
	end

	-- motivational banner over the entrance
	local pos = ctx.origin + V(0, wallH - 8, half - 2.6)
	sign(folder, CFrame.lookAt(pos, pos + V(0, 0, -1)), V(56, 6, 0.6), "💪 TRAIN HARD  •  STAY HUMBLE  •  NEVER SKIP LEG DAY",
		WHITE, Color3.fromRGB(20, 20, 24), 0)
end

----------------------------------------------------------------------
-- Gate (areas 2..N): a solid slab, opened per-player on the client
----------------------------------------------------------------------
local function buildGate(ctx, world)
	local area, theme, folder = ctx.area, ctx.theme, ctx.folder
	local W = Config.World
	local half = W.RoomSize / 2
	local at = ctx.at
	local gateW, gateH = W.GateWidth, W.GateHeight

	local slab = add(folder, at(0, gateH / 2, half), V(0, 0, 0), V(gateW, gateH, 3), darker(theme.Accent, 0.45), "Metal", { Name = "Gate" })
	slab:SetAttribute("AreaId", area.Id)
	slab:AddTag("GymGate")
	-- decorative frame (does not move)
	for _, sx in ipairs({ -1, 1 }) do
		add(folder, at(sx * (gateW / 2 + 1.15), gateH / 2 + 1, half), V(0, 0, 0), V(2.4, gateH + 2, 4.9), theme.Accent, "Neon", { CanCollide = false, Name = "GateFrame" })
	end
	add(folder, at(0, gateH + 1.15, half), V(0, 0, 0), V(gateW + 6, 2.4, 5), theme.Accent, "Neon", { CanCollide = false, Name = "GateFrame" })
	-- chevrons on the slab so it reads as a heavy door
	for i = 0, 3 do
		add(folder, at(0, 5 + i * 8, half + 1.6), V(0, 0, 0), V(gateW - 4, 0.8, 0.3), theme.Accent, "Neon", { CanCollide = false, Name = "GateStripe" })
	end

	local prompt = add(folder, at(0, 4, half + 8), V(0, 0, 0), V(12, 8, 2), theme.Accent, "SmoothPlastic", { Transparency = 1, CanCollide = false, Name = "GatePrompt" })
	world.Gates[area.Id] = { Prompt = prompt, Gate = slab }
end

----------------------------------------------------------------------
-- Stations, Lucky Block, Protein Bar, orbs, spawn
----------------------------------------------------------------------
local function buildStations(ctx, world)
	local area, theme, folder = ctx.area, ctx.theme, ctx.folder
	local zList = { 62, 8, -46 }
	for tier, stationId in ipairs(area.StationIds) do
		local station = Config.StationsById[stationId]
		local z = zList[tier]
		local eqCF = ctx.at(-72, 0, z) * CFrame.Angles(0, math.rad(90), 0) -- faces -X, user stands to the east
		-- lifting platform under the equipment: rubber with a painted border
		add(folder, ctx.at(-66, 0.14, z), V(0, 0, 0), V(26, 0.08, 30), Color3.fromRGB(28, 29, 32), "Rubber", { CanCollide = false, Name = "Mat" })
		for _, dz in ipairs({ -14.6, 14.6 }) do
			add(folder, ctx.at(-66, 0.19, z + dz), V(0, 0, 0), V(26, 0.02, 0.5), theme.Accent, "SmoothPlastic", { CanCollide = false, Name = "MatBorder" })
		end
		local model, standY = EquipmentModels.Build(station.Kind, folder, eqCF, theme, tier)
		model.Name = station.Name
		model:SetAttribute("StationId", stationId)
		model:AddTag("GymStation")
		local stand = add(model, eqCF, V(0, standY, 5), V(4, 0.2, 4), theme.Accent, "SmoothPlastic", { Transparency = 1, CanCollide = false, Name = "Stand" })
		local prompt = add(model, eqCF, V(0, 3, 3), V(8, 6, 8), theme.Accent, "SmoothPlastic", { Transparency = 1, CanCollide = false, Name = "Prompt" })
		-- glowing pad on the floor where you stand
		local padY = standY &lt; 0.25 and 0.24 or standY + 0.02
		add(model, eqCF, V(0, padY, 5), V(5, 0.1, 5), theme.Accent, "Neon", { CanCollide = false, Name = "StandPad", Transparency = 0.25 })
		world.Stations[stationId] = { Prompt = prompt, Stand = stand }
	end
end

-- Eggs are shown as classic LUCKY BLOCKS: a golden cube with a "?" on every face.
local LUCKY_GOLD = Color3.fromRGB(255, 196, 28)
local LUCKY_EDGE = Color3.fromRGB(200, 120, 12)

local function questionFaces(part)
	for _, normal in ipairs(Enum.NormalId:GetEnumItems()) do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Face" .. normal.Name
		gui.Face = normal
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0.4
		gui.Parent = part
		local frame = Instance.new("Frame")
		frame.Size = UDim2.fromScale(0.78, 0.78)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BackgroundTransparency = 1
		frame.Parent = gui
		local border = Instance.new("UIStroke")
		border.Color = LUCKY_EDGE
		border.Thickness = 10
		border.Parent = frame
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Text = "?"
		label.TextScaled = true
		label.Font = Enum.Font.GothamBlack
		label.TextColor3 = WHITE
		label.TextStrokeColor3 = Color3.fromRGB(120, 64, 0)
		label.TextStrokeTransparency = 0
		label.Parent = frame
	end
end

local function buildEgg(ctx, world)
	local area, theme, folder = ctx.area, ctx.theme, ctx.folder
	local egg = Config.EggsById[area.EggId]
	local base = ctx.at(72, 0, 50)
	local model = Instance.new("Model")
	model.Name = egg.Name
	model:SetAttribute("EggId", egg.Id)
	model:AddTag("GymEgg")
	-- display podium
	cyl(model, base, V(0, 0.9, 0), "Y", 1.8, 15, STEEL_DARK, "Metal", { Name = "Pedestal" })
	cyl(model, base, V(0, 1.9, 0), "Y", 0.2, 14.2, theme.Accent, "Neon", { CanCollide = false, Name = "PedestalRing" })
	cyl(model, base, V(0, 2.05, 0), "Y", 0.3, 13, Color3.fromRGB(28, 28, 32), "Rubber", { CanCollide = false, Name = "PedestalTop" })
	-- everything that bobs/spins lives in "EggBody" so the client can animate it as one piece
	local body = Instance.new("Model")
	body.Name = "EggBody"
	body.Parent = model
	local size = 7
	local center = V(0, 8.5, 0)
	local block = add(body, base, center, V(size, size, size), LUCKY_GOLD, "SmoothPlastic", { CanCollide = false, Name = "LuckyBlock" })
	questionFaces(block)
	body.PrimaryPart = block
	-- bevelled edges + corner rivets so it reads as a solid block
	local e = size / 2
	local t = 0.55
	for _, a in ipairs({ -1, 1 }) do
		for _, b in ipairs({ -1, 1 }) do
			add(body, base, center + V(0, a * e, b * e), V(size - t, t, t), LUCKY_EDGE, "SmoothPlastic", { CanCollide = false, Name = "Edge" })
			add(body, base, center + V(a * e, 0, b * e), V(t, size - t, t), LUCKY_EDGE, "SmoothPlastic", { CanCollide = false, Name = "Edge" })
			add(body, base, center + V(a * e, b * e, 0), V(t, t, size - t), LUCKY_EDGE, "SmoothPlastic", { CanCollide = false, Name = "Edge" })
			for _, c in ipairs({ -1, 1 }) do
				add(body, base, center + V(a * e, b * e, c * e), V(0.9, 0.9, 0.9), Color3.fromRGB(255, 230, 140), "Metal", { CanCollide = false, Name = "Rivet" })
			end
		end
	end
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "Sparkle"
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 236, 150))
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Rate = 8
	sparkle.Speed = NumberRange.new(1, 3)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = block
	local glow = pointLight(block, Color3.fromRGB(255, 210, 90), 24, 1.6)
	glow.Name = "EggGlow"
	local prompt = add(model, base, V(0, 4, 0), V(14, 8, 14), theme.Accent, "SmoothPlastic", { Transparency = 1, CanCollide = false, Name = "Prompt" })
	model.Parent = ctx.folder
	world.Eggs[egg.Id] = { Prompt = prompt }
end

-- The Protein Bar: a real supplement / shake bar where you sell Strength.
local function buildSell(ctx, world)
	local theme, folder = ctx.theme, ctx.folder
	-- local +Z points at the walkway (world -X)
	local base = ctx.at(72, 0, -30) * CFrame.Angles(0, math.rad(-90), 0)
	local model = Instance.new("Model")
	model.Name = "Protein Bar"
	model:AddTag("GymSell")
	local accent = theme.Accent
	local counterTop = Color3.fromRGB(236, 236, 238)

	-- tiled floor of the bar
	add(model, base, V(0, 0.06, -2.5), V(26, 0.1, 20), Color3.fromRGB(226, 226, 230), "CeramicTiles", { CanCollide = false, Name = "BarFloor" })

	-- front counter (L-shaped with returns)
	add(model, base, V(0, 1.8, 0), V(16, 3.6, 3), WOOD_DARK, "Wood", { Name = "Counter" })
	add(model, base, V(0, 0.3, 1.52), V(16, 0.6, 0.06), STEEL_DARK, "Metal", { CanCollide = false, Name = "KickPlate" })
	add(model, base, V(0, 2.7, 1.53), V(16, 0.45, 0.06), accent, "SmoothPlastic", { CanCollide = false, Name = "CounterStripe" })
	add(model, base, V(0, 3.78, 0.1), V(15.8, 0.35, 3.6), counterTop, "Marble", { Name = "CounterTop" })
	for _, s in ipairs({ -1, 1 }) do
		add(model, base, V(s * 9.5, 1.8, -1), V(3, 3.6, 4), WOOD_DARK, "Wood", { Name = "CounterReturn" })
		add(model, base, V(s * 9.55, 3.78, -1), V(3.3, 0.35, 4.4), counterTop, "Marble", { Name = "CounterTop" })
	end
	-- counter-front sign
	local frontSign = base * CFrame.new(0, 1.55, 1.56) * CFrame.Angles(0, math.pi, 0)
	sign(model, frontSign, V(8, 1.4, 0.05), "SHAKES • BARS • SUPPS", WHITE, WOOD_DARK, 0)

	-- things on the counter
	add(model, base, V(-5, 4.25, -0.4), V(1.4, 0.6, 1.4), Color3.fromRGB(26, 26, 30), "SmoothPlastic", { CanCollide = false, Name = "BlenderBase" })
	cyl(model, base, V(-5, 5.45, -0.4), "Y", 1.8, 1.2, Color3.fromRGB(215, 235, 245), "Glass", { CanCollide = false, Transparency = 0.45, Name = "BlenderJar" })
	cyl(model, base, V(-5, 5.03, -0.4), "Y", 0.9, 1.05, Color3.fromRGB(160, 110, 70), "SmoothPlastic", { CanCollide = false, Name = "Shake" })
	add(model, base, V(4.8, 4.15, 0), V(1.6, 0.4, 1.2), Color3.fromRGB(30, 30, 34), "SmoothPlastic", { CanCollide = false, Name = "Register" })
	add(model, base, V(4.8, 4.85, -0.1), V(1.7, 1.1, 0.12), Color3.fromRGB(20, 22, 30), "SmoothPlastic",
		{ CanCollide = false, Name = "RegisterScreen", Rotation = CFrame.Angles(math.rad(-15), 0, 0) })
	barDisplay(model, base * CFrame.new(1.6, 3.96, 0.25), BRANDS[(ctx.area.Index % #BRANDS) + 1])
	for i, x in ipairs({ -2.5, -1.5 }) do
		shaker(model, base * CFrame.new(x, 3.96, 0.5), SUPPLEMENT[i + 2])
	end
	-- a few loose bars by the till
	for i = 0, 2 do
		proteinBar(model, base * CFrame.new(3.7 + i * 0.1, 4.08 + i * 0.23, 0.9) * CFrame.Angles(0, math.rad(8 - i * 12), 0), BRANDS[(i + ctx.area.Index) % #BRANDS + 1], i == 2)
	end

	-- back wall with supplement shelves
	add(model, base, V(0, 8.5, -7.6), V(22, 17, 0.6), darker(theme.Wall, 0.35), "SmoothPlastic", { Name = "BackWall" })
	for row, y in ipairs({ 4.6, 7.1, 9.6 }) do
		add(model, base, V(3.2, y, -6.6), V(13, 0.25, 1.6), WOOD_C, "WoodPlanks", { CanCollide = false, Name = "Shelf" })
		for i = 1, 8 do
			proteinTub(model, base, V(-2.4 + i * 1.45, y + 0.93, -6.6), BRANDS[(i + row * 3) % #BRANDS + 1], true)
		end
	end
	-- drink fridge
	local fridge = add(model, base, V(-6.8, 4.5, -5.9), V(5, 9, 2.8), Color3.fromRGB(236, 236, 240), "Metal", { Name = "Fridge" })
	fridge.CanCollide = true
	add(model, base, V(-6.8, 4.3, -4.45), V(4.4, 7.6, 0.1), Color3.fromRGB(200, 225, 240), "Glass", { CanCollide = false, Transparency = 0.55, Name = "FridgeDoor" })
	add(model, base, V(-6.8, 8.45, -4.45), V(4.4, 0.7, 0.12), accent, "Neon", { CanCollide = false, Name = "FridgeSign" })
	for r, y in ipairs({ 1.7, 3.9, 6.1 }) do
		for i = 1, 4 do
			cyl(model, base, V(-8.5 + i * 0.85, y, -4.9), "Y", 1.5, 0.55, SUPPLEMENT[(i + r) % #SUPPLEMENT + 1], "Glass",
				{ CanCollide = false, Transparency = 0.1, Name = "Bottle" })
		end
	end
	local fridgeLight = add(model, base, V(-6.8, 8.1, -5.2), V(4, 0.1, 1), LED_WHITE, "Neon", { CanCollide = false, Name = "FridgeLight" })
	pointLight(fridgeLight, Color3.fromRGB(220, 240, 255), 8, 0.8)

	-- menu board (the Sell options)
	local menuCF = base * CFrame.new(0, 14.5, -7.25) * CFrame.Angles(0, math.pi, 0)
	sign(model, menuCF, V(16, 5, 0.1),
		"🥤 WHEY SHAKE ..... 10%\n🍌 MASS GAINER .... 50%\n🔥 FULL STACK ..... 100%\nSELL STRENGTH FOR 💵",
		WHITE, Color3.fromRGB(18, 18, 22), 0, Enum.Font.GothamBold)

	-- canopy with the PROTEIN BAR fascia and pendant lights
	for _, s in ipairs({ -1, 1 }) do
		add(model, base, V(s * 10.7, 8.5, 3), V(0.6, 17, 0.6), STEEL_DARK, "Metal", { Name = "CanopyPost" })
	end
	add(model, base, V(0, 17.25, -2.3), V(22, 0.5, 11), STEEL_DARK, "Metal", { CanCollide = false, Name = "Canopy" })
	local fasciaCF = base * CFrame.new(0, 16, 3.2) * CFrame.Angles(0, math.pi, 0)
	sign(model, fasciaCF, V(21.8, 2.6, 0.4), "🥤  PROTEIN BAR  🥤", WHITE, darker(accent, 0.6), 0)
	for _, x in ipairs({ -5, 0, 5 }) do
		cyl(model, base, V(x, 15.25, 0.5), "Y", 3.5, 0.1, STEEL_DARK, "Metal", { CanCollide = false, Name = "PendantCable" })
		cyl(model, base, V(x, 13.2, 0.5), "Y", 0.8, 1.6, STEEL_DARK, "Metal", { CanCollide = false, Name = "PendantShade" })
		local bulb = ball(model, base, V(x, 12.7, 0.5), 0.7, Color3.fromRGB(255, 220, 160), "Neon", { CanCollide = false, Name = "PendantBulb" })
		pointLight(bulb, Color3.fromRGB(255, 214, 160), 14, 1)
	end

	-- bar stools
	for _, x in ipairs({ -4.5, -1.5, 1.5, 4.5 }) do
		cyl(model, base, V(x, 0.1, 4.4), "Y", 0.2, 2, CHROME_C, "Metal", { CanCollide = false, Name = "StoolBase" })
		cyl(model, base, V(x, 1.7, 4.4), "Y", 3.2, 0.35, CHROME_C, "Metal", { CanCollide = false, Name = "StoolPole" })
		cyl(model, base, V(x, 3.4, 4.4), "Y", 0.45, 1.9, PAD, "Leather", { CanCollide = false, Name = "StoolSeat" })
		cyl(model, base, V(x, 1.2, 4.4), "Y", 0.15, 1.5, CHROME_C, "Metal", { CanCollide = false, Name = "StoolFootRing" })
	end

	local prompt = add(model, base, V(0, 3, 3), V(12, 6, 8), accent, "SmoothPlastic", { Transparency = 1, CanCollide = false, Name = "Prompt" })
	model.Parent = folder
	world.Sell[#world.Sell + 1] = { Prompt = prompt }
end

-- open floor rectangles (world coords) where floating dumbbells may spawn; OrbService still
-- checks every random spot against the real parts so nothing spawns inside a prop
local function orbZones(ctx)
	local o = ctx.origin
	local zones = {}
	for _, r in ipairs({ { -48, 60, -110, 106 }, { 82, 112, -12, 40 }, { 82, 112, 58, 98 } }) do
		zones[#zones + 1] = { X0 = o.X + r[1], X1 = o.X + r[2], Z0 = o.Z + r[3], Z1 = o.Z + r[4], Y = o.Y + 4 }
	end
	return zones
end

local function orbPositions(ctx)
	local list = {}
	local layout = { { -30, 90 }, { 30, 60 }, { -30, 20 }, { 30, -10 }, { -30, -60 }, { 30, -95 } }
	for i = 1, math.min(Config.Orbs.PerArea, #layout) do
		list[i] = ctx.origin + V(layout[i][1], 4, layout[i][2])
	end
	return list
end

----------------------------------------------------------------------
-- Theme set-pieces
----------------------------------------------------------------------
-- open floor spots every room keeps free for theme props (x, z)
local SPOTS = { { -30, -108 }, { 30, -108 }, { 112, -66 }, { 112, 70 }, { -36, 108 }, { 36, 108 }, { 112, 36 }, { -40, -100 } }

local function boxingRing(folder, cf, accent)
	local s = 22
	add(folder, cf, V(0, 1, 0), V(s, 2, s), darker(accent, 0.45), "Fabric", { Name = "RingApron" })
	add(folder, cf, V(0, 2.05, 0), V(s - 0.4, 0.1, s - 0.4), Color3.fromRGB(226, 224, 216), "Fabric", { Name = "RingCanvas" })
	local cornerColors = { Color3.fromRGB(196, 36, 40), Color3.fromRGB(36, 70, 190), WHITE, WHITE }
	local k = 0
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			k = k + 1
			local p = V(sx * (s / 2 - 0.6), 0, sz * (s / 2 - 0.6))
			cyl(folder, cf, p + V(0, 4.65, 0), "Y", 5.2, 0.6, CHROME_C, "Metal", { Name = "RingPost" })
			add(folder, cf, p + V(0, 4.8, 0), V(1, 3.4, 1), cornerColors[k], "Leather", { CanCollide = false, Name = "CornerPad" })
		end
	end
	for _, y in ipairs({ 3.5, 4.7, 5.9 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, cf, V(0, y, sz * (s / 2 - 0.6)), "X", s - 1.2, 0.22, Color3.fromRGB(230, 230, 230), "Fabric", { Name = "Rope" })
			cyl(folder, cf, V(sz * (s / 2 - 0.6), y, 0), "Z", s - 1.2, 0.22, Color3.fromRGB(230, 230, 230), "Fabric", { Name = "Rope" })
		end
	end
	add(folder, cf, V(0, 0.5, s / 2 + 1), V(4, 1, 2), STEEL_DARK, "Metal", { Name = "RingStep" })
end

-- heavy bags hanging from a steel frame, bags along local X
local function bagStand(folder, cf, n, colors)
	local len = n * 5
	for _, x in ipairs({ -len / 2, len / 2 }) do
		add(folder, cf, V(x, 6, 0), V(0.6, 12, 0.6), STEEL_DARK, "Metal", { Name = "BagPost" })
		add(folder, cf, V(x, 0.2, 0), V(0.8, 0.4, 3.4), STEEL_DARK, "Metal", { Name = "BagFoot" })
	end
	add(folder, cf, V(0, 12, 0), V(len + 0.5, 0.56, 0.56), STEEL_DARK, "Metal", { Name = "BagBeam" })
	for i = 1, n do
		local x = -len / 2 + (i - 0.5) * (len / n)
		cyl(folder, cf, V(x, 10.6, 0), "Y", 2.4, 0.12, CHROME_C, "Metal", { CanCollide = false, Name = "Chain" })
		cyl(folder, cf, V(x, 6.8, 0), "Y", 5.2, 2.4, colors[(i - 1) % #colors + 1], "Leather", { Name = "HeavyBag" })
		cyl(folder, cf, V(x, 9.5, 0), "Y", 0.3, 2.5, PAD, "Leather", { CanCollide = false, Name = "BagCap" })
	end
end

local function trophyCabinet(folder, cf)
	add(folder, cf, V(0, 0.5, 0), V(12, 1, 3), WOOD_DARK, "Wood", { Name = "CabinetBase" })
	local glass = add(folder, cf, V(0, 5.5, 0), V(12, 9, 3), Color3.fromRGB(200, 222, 232), "Glass", { Transparency = 0.65, Name = "TrophyCase" })
	glass.Reflectance = 0.1
	add(folder, cf, V(0, 10.2, 0), V(12.4, 0.4, 3.4), WOOD_DARK, "Wood", { Name = "CabinetTop" })
	for _, y in ipairs({ 3.9, 6.9 }) do
		add(folder, cf, V(0, y, 0), V(11.6, 0.12, 2.6), Color3.fromRGB(200, 222, 232), "Glass", { CanCollide = false, Transparency = 0.4, Name = "GlassShelf" })
	end
	for _, y in ipairs({ 1.02, 4.02, 7.02 }) do -- just above the base / shelves (no shared faces)
		for _, x in ipairs({ -3.8, 0, 3.8 }) do
			add(folder, cf, V(x, y + 0.25, 0), V(0.9, 0.5, 0.9), Color3.fromRGB(240, 238, 232), "Marble", { CanCollide = false, Name = "TrophyBase" })
			cyl(folder, cf, V(x, y + 0.8, 0), "Y", 0.6, 0.3, Color3.fromRGB(230, 185, 60), "Metal", { CanCollide = false, Name = "TrophyStem" })
			local cup = cyl(folder, cf, V(x, y + 1.6, 0), "Y", 1.1, 1.2, Color3.fromRGB(240, 196, 70), "Metal", { CanCollide = false, Name = "TrophyCup" })
			cup.Reflectance = 0.3
		end
	end
end

local function sofa(folder, cf, color)
	add(folder, cf, V(0, 0.9, 0), V(9, 1.8, 3.4), color, "Leather", { Name = "SofaSeat" })
	add(folder, cf, V(0, 2.6, -1.3), V(8.96, 2.6, 0.88), color, "Leather", { Name = "SofaBack" })
	for _, s in ipairs({ -1, 1 }) do
		add(folder, cf, V(s * 4.9, 1.5, 0), V(0.9, 3, 3.5), color, "Leather", { Name = "SofaArm" })
	end
end

local function crystalCluster(folder, cf, rnd, colors, count, light)
	for k = 1, count do
		local hgt = rnd:NextInteger(5, 14)
		local g = add(folder, cf * CFrame.new(rnd:NextNumber(-3, 3), 0, rnd:NextNumber(-3, 3))
			* CFrame.Angles(rnd:NextNumber(-0.35, 0.35), rnd:NextNumber(0, 3), rnd:NextNumber(-0.35, 0.35)),
			V(0, hgt / 2, 0), V(rnd:NextNumber(1.6, 3), hgt, rnd:NextNumber(1.6, 3)), colors[k % #colors + 1], "Neon", { Transparency = 0.25, Name = "Crystal" })
		if k == 1 and light then
			pointLight(g, colors[1], 26, 1)
		end
	end
end

local decor = {}

function decor.Mats(ctx)
	local folder = ctx.folder
	-- stretching zone: yoga mats, stability balls, foam rollers
	local matColors = { Color3.fromRGB(64, 100, 160), Color3.fromRGB(110, 76, 140), Color3.fromRGB(56, 130, 120), Color3.fromRGB(84, 86, 96) }
	for i, x in ipairs({ -28, -18, 18, 28 }) do
		for j, z in ipairs({ -78, -96 }) do
			add(folder, ctx.at(x, 0.08, z), V(0, 0, 0), V(3, 0.16, 7.5), matColors[(i + j) % #matColors + 1], "Rubber", { CanCollide = false, Name = "YogaMat" })
		end
	end
	for i, p in ipairs({ { -36, -70 }, { 36, -74 }, { -36, -104 } }) do
		ball(folder, ctx.at(p[1], 2.2, p[2]), V(0, 0, 0), 4.4, matColors[i], "SmoothPlastic", { Name = "ExerciseBall" })
	end
	for _, side in ipairs({ -1, 1 }) do
		for k = 0, 2 do
			cyl(folder, ctx.at(side * (22 + k * 1.3), 0.5, -87), V(0, 0, 0), "Z", 3, 1, Color3.fromRGB(40, 40, 46), "Rubber", { Name = "FoamRoller" })
		end
	end
	-- office water coolers
	for _, x in ipairs({ -40, 40 }) do
		local cf = ctx.at(x, 0, 104)
		add(folder, cf, V(0, 2, 0), V(2.4, 4, 2.4), Color3.fromRGB(236, 236, 240), "SmoothPlastic", { Name = "Cooler" })
		cyl(folder, cf, V(0, 5.2, 0), "Y", 2.4, 2.2, Color3.fromRGB(120, 190, 240), "Glass", { Transparency = 0.35, CanCollide = false, Name = "CoolerBottle" })
	end
	-- "how to play" banner on an aluminium truss gantry over the turf lane
	tutorialBanner(ctx, 40)
	pottedPlant(folder, ctx.at(-30, 0, -108), 1.2)
	pottedPlant(folder, ctx.at(30, 0, -108), 1.2)
end

function decor.Skyline(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local rnd = Random.new(ctx.area.Index * 77)
	-- city blocks outside
	local URBAN = { Color3.fromRGB(150, 146, 140), Color3.fromRGB(120, 124, 132), Color3.fromRGB(170, 120, 96), Color3.fromRGB(96, 100, 110), Color3.fromRGB(190, 184, 170) }
	for i = 1, 22 do
		local side = (i % 2 == 0) and 1 or -1
		-- tiny per-building offsets: two random blocks never share a wall / roof plane (z-fighting)
		local x = side * (140 + rnd:NextInteger(10, 110)) + i * 0.043
		local z = rnd:NextInteger(-160, 160) + i * 0.029
		local hgt = rnd:NextInteger(50, 150) + i * 0.07
		local w = rnd:NextInteger(24, 44)
		add(folder, ctx.at(x, hgt / 2, z), V(0, 0, 0), V(w, hgt, w), URBAN[i % #URBAN + 1], "Concrete", { Name = "Building" })
		add(folder, ctx.at(x, hgt + 1, z), V(0, 0, 0), V(w + 2, 2, w + 2), STEEL_DARK, "Metal", { Name = "Roof" })
		for r = 1, 4 do
			local lit = (r + i) % 3 == 0
			add(folder, ctx.at(x - side * (w / 2 + 0.1), 12 + r * hgt / 5.5, z), V(0, 0, 0), V(0.3, 3, w - 6),
				lit and Color3.fromRGB(255, 226, 160) or Color3.fromRGB(70, 96, 120), lit and "Neon" or "Glass", { CanCollide = false, Name = "Windows" })
		end
	end
	-- boxing ring + heavy bags
	boxingRing(folder, ctx.at(-22, 0, -88), theme.Accent)
	bagStand(folder, face(ctx, 22, -80, "-X"), 3, { Color3.fromRGB(170, 30, 36), PAD, Color3.fromRGB(170, 30, 36) })
	-- street-art mural by the entrance
	local pos = ctx.origin + V(-60, 17, Config.World.RoomSize / 2 - 2.25)
	sign(folder, CFrame.lookAt(pos, pos + V(0, 0, -1)), V(36, 10, 0.2), "CITY GYM\nEST. 1998", Color3.fromRGB(255, 220, 60), Color3.fromRGB(40, 40, 48), 0, Enum.Font.PermanentMarker)
end

function decor.Trophies(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local wallH = Config.World.WallHeight
	-- competition lifting platform with a loaded barbell
	local platformCF = ctx.at(0, 0, -82)
	add(folder, platformCF, V(0, 0.15, 0), V(16, 0.3, 8), RUBBER_C, "Rubber", { CanCollide = false, Name = "PlatformRubber" })
	add(folder, platformCF, V(0, 0.17, 0), V(8, 0.32, 7.96), WOOD_C, "WoodPlanks", { CanCollide = false, Name = "PlatformWood" })
	barbell(folder, platformCF * CFrame.new(0, 2.25, 0), 14, 4.5)
	-- scoreboard over the platform
	local pos = ctx.origin + V(0, 24, -82)
	for _, x in ipairs({ -9, 9 }) do
		cyl(folder, ctx.at(x, 34, -82), V(0, 0, 0), "Y", 14, 0.15, STEEL_DARK, "Metal", { CanCollide = false, Name = "ScoreboardCable" })
	end
	sign(folder, CFrame.lookAt(pos, pos + V(0, 0, 1)), V(22, 6, 1), "SQUAT 250  •  BENCH 180  •  DEADLIFT 320", Color3.fromRGB(255, 70, 70), Color3.fromRGB(12, 12, 14), 0, Enum.Font.Arcade)
	-- trophy cabinets either side of the exit
	for _, x in ipairs({ -30, 30 }) do
		trophyCabinet(folder, face(ctx, x, -112, "+Z"))
	end
	-- championship banners hanging from the beams
	for i, z in ipairs({ -90, -45, 0, 45, 90 }) do
		for j, x in ipairs({ -40, 40 }) do
			local bpos = ctx.origin + V(x, wallH - 9, z + 1.2)
			local col = (i + j) % 2 == 0 and darker(theme.Accent, 0.7) or Color3.fromRGB(24, 24, 30)
			sign(folder, CFrame.lookAt(bpos, bpos + V(0, 0, 1)), V(6, 10, 0.2), "🏆\nCHAMPS\n'" .. (15 + i + j * 3), WHITE, col, 0)
		end
	end
end

function decor.Chandeliers(ctx)
	local folder = ctx.folder
	local wallH = Config.World.WallHeight
	local GOLD = Color3.fromRGB(212, 175, 72)
	-- crystal chandeliers
	for i = -2, 2 do
		local z = i * 44
		for _, x in ipairs({ -40, 40 }) do
			cyl(folder, ctx.at(x, wallH - 3.5, z), V(0, 0, 0), "Y", 7, 0.3, GOLD, "Metal", { CanCollide = false, Name = "Chain" })
			cyl(folder, ctx.at(x, 37, z), V(0, 0, 0), "Y", 0.5, 10, GOLD, "Metal", { CanCollide = false, Name = "ChandelierRing" })
			cyl(folder, ctx.at(x, 35.6, z), V(0, 0, 0), "Y", 0.4, 5.5, GOLD, "Metal", { CanCollide = false, Name = "ChandelierRing" })
			for k = 1, 10 do
				local a = k * math.pi / 5
				ball(folder, ctx.at(x + math.cos(a) * 4.7, 37.6, z + math.sin(a) * 4.7), V(0, 0, 0), 0.7, Color3.fromRGB(255, 232, 190), "Neon", { CanCollide = false, Name = "Candle" })
				add(folder, ctx.at(x + math.cos(a) * 4.7, 36, z + math.sin(a) * 4.7), V(0, 0, 0), V(0.35, 1.8, 0.35), Color3.fromRGB(230, 240, 255), "Glass",
					{ CanCollide = false, Transparency = 0.3, Name = "CrystalDrop" })
			end
			local core = ball(folder, ctx.at(x, 34.5, z), V(0, 0, 0), 2, Color3.fromRGB(235, 245, 255), "Glass", { CanCollide = false, Transparency = 0.2, Name = "CrystalCore" })
			pointLight(core, Color3.fromRGB(255, 228, 196), 50, 1.3)
		end
	end
	-- marble colonnade along the walkway
	for _, z in ipairs({ -100, -30, 40, 100 }) do
		for _, x in ipairs({ -44, 44 }) do
			cyl(folder, ctx.at(x, 20, z), V(0, 0, 0), "Y", 40, 4.4, Color3.fromRGB(242, 238, 232), "Marble", { Name = "Column" })
			add(folder, ctx.at(x, 0.6, z), V(0, 0, 0), V(6, 1.2, 6), Color3.fromRGB(230, 226, 220), "Marble", { Name = "ColumnBase" })
			add(folder, ctx.at(x, 40.3, z), V(0, 0, 0), V(6, 1, 6), GOLD, "Metal", { CanCollide = false, Name = "Capital" })
		end
	end
	-- marble fountain with a real water jet
	local f = ctx.at(0, 0, -75)
	cyl(folder, f, V(0, 1, 0), "Y", 2, 16, Color3.fromRGB(240, 236, 230), "Marble", { Name = "FountainBase" })
	cyl(folder, f, V(0, 1.9, 0), "Y", 0.3, 14.6, Color3.fromRGB(110, 170, 200), "Glass", { Transparency = 0.35, CanCollide = false, Name = "FountainWater" })
	cyl(folder, f, V(0, 3.5, 0), "Y", 3, 2.4, Color3.fromRGB(240, 236, 230), "Marble", { Name = "FountainPost" })
	cyl(folder, f, V(0, 5.2, 0), "Y", 0.6, 6, Color3.fromRGB(240, 236, 230), "Marble", { Name = "FountainBowl" })
	cyl(folder, f, V(0, 7.2, 0), "Y", 3.4, 0.5, Color3.fromRGB(190, 225, 245), "Glass", { Transparency = 0.5, CanCollide = false, Name = "WaterJet" })
	-- lounge sofas + plants
	for _, x in ipairs({ -24, 24 }) do
		sofa(folder, face(ctx, x, -100, x &lt; 0 and "+X" or "-X"), Color3.fromRGB(96, 70, 56))
	end
	for _, p in ipairs({ SPOTS[5], SPOTS[6], SPOTS[1], SPOTS[2] }) do
		pottedPlant(folder, ctx.at(p[1], 0, p[2]), 1.4)
	end
end

function decor.Gems(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local rnd = Random.new(505)
	local colors = { theme.Accent, Color3.fromRGB(150, 110, 240), Color3.fromRGB(200, 240, 255) }
	for i, p in ipairs(SPOTS) do
		crystalCluster(folder, ctx.at(p[1], 0, p[2]), rnd, colors, 4, i % 2 == 0)
	end
	-- strongman corner: tractor tyre, sledgehammer, atlas stones
	local tyre = ctx.at(0, 0, -80)
	cyl(folder, tyre, V(0, 1.1, 0), "Y", 2.2, 9, Color3.fromRGB(26, 26, 28), "Rubber", { Name = "Tyre" })
	cyl(folder, tyre, V(0, 1.15, 0), "Y", 2.3, 4.6, Color3.fromRGB(60, 58, 66), "Slate", { Name = "TyreHole" })
	add(folder, tyre, V(6, 3, 2), V(0.35, 6, 0.35), WOOD_C, "Wood", { Name = "SledgeHandle", Rotation = CFrame.Angles(0, 0, math.rad(-18)) })
	add(folder, tyre, V(5.1, 0.6, 2), V(1.6, 1, 1), STEEL_DARK, "Metal", { Name = "SledgeHead" })
	for i, d in ipairs({ 3.4, 3, 2.6 }) do
		ball(folder, ctx.at(-12 - i * 4.5, d / 2, -82), V(0, 0, 0), d, Color3.fromRGB(118, 114, 120), "Granite", { Name = "AtlasStone" })
	end
	-- rock boulders along the walls
	for i = 1, 8 do
		local p = SPOTS[i]
		local b = ball(folder, ctx.at(p[1] + (p[1] &gt; 0 and 4 or -4), 1.8, p[2] + 3), V(0, 0, 0), rnd:NextInteger(3, 5), Color3.fromRGB(80, 74, 90), "Rock", { Name = "Boulder" })
		b.Size = V(b.Size.X * 1.4, b.Size.Y, b.Size.Z)
	end
end

function decor.Asteroids(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local rnd = Random.new(606)
	local ROCK = { Color3.fromRGB(110, 104, 100), Color3.fromRGB(86, 82, 80), Color3.fromRGB(130, 120, 108) }
	for i = 1, 20 do
		local side = (i % 2 == 0) and 1 or -1
		local d = rnd:NextInteger(10, 40)
		local pos = V(side * rnd:NextInteger(170, 330), rnd:NextInteger(-30, 70), rnd:NextInteger(-260, 260))
		local a = ball(folder, ctx.at(pos.X, pos.Y, pos.Z), V(0, 0, 0), d, ROCK[i % #ROCK + 1], "Rock", { CanCollide = false, Name = "Asteroid" })
		a.Size = V(d * rnd:NextNumber(0.8, 1.3), d * rnd:NextNumber(0.7, 1), d)
	end
	-- ringed gas giant + cratered moon
	ball(folder, ctx.at(-260, 150, -120), V(0, 0, 0), 150, Color3.fromRGB(200, 150, 110), "Sand", { CanCollide = false, Name = "Planet" })
	cyl(folder, ctx.at(-260, 150, -120) * CFrame.Angles(0, 0, math.rad(20)), V(0, 0, 0), "Y", 1.5, 260, Color3.fromRGB(210, 190, 160), "SmoothPlastic", { CanCollide = false, Transparency = 0.4, Name = "PlanetRing" })
	local moonCF = ctx.at(260, 130, -60)
	ball(folder, moonCF, V(0, 0, 0), 70, Color3.fromRGB(190, 190, 196), "Slate", { CanCollide = false, Name = "Moon" })
	for i = 1, 6 do
		local a = i * 1.1
		ball(folder, moonCF, V(-30, math.sin(a) * 18, math.cos(a) * 18), rnd:NextInteger(6, 12), Color3.fromRGB(150, 150, 158), "Slate", { CanCollide = false, Name = "Crater" })
	end
	for _ = 1, 70 do
		ball(folder, ctx.at(rnd:NextInteger(-420, 420), rnd:NextInteger(90, 320), rnd:NextInteger(-420, 420)), V(0, 0, 0), rnd:NextInteger(1, 2), WHITE, "Neon", { CanCollide = false, Name = "Star" })
	end
	-- rocket on its launch pad
	local rocket = ctx.at(0, 0, -86)
	cyl(folder, rocket, V(0, 0.5, 0), "Y", 1, 14, Color3.fromRGB(70, 72, 78), "DiamondPlate", { Name = "LaunchPad" })
	cyl(folder, rocket, V(0, 10, 0), "Y", 18, 5, Color3.fromRGB(236, 236, 240), "Metal", { Name = "RocketBody" })
	cyl(folder, rocket, V(0, 15, 0), "Y", 1, 5.1, Color3.fromRGB(30, 30, 34), "Metal", { CanCollide = false, Name = "RocketBand" })
	cyl(folder, rocket, V(0, 19.8, 0), "Y", 1.6, 4, Color3.fromRGB(236, 236, 240), "Metal", { Name = "RocketNose" })
	cyl(folder, rocket, V(0, 21.2, 0), "Y", 1.2, 2.6, Color3.fromRGB(236, 236, 240), "Metal", { Name = "RocketNose" })
	ball(folder, rocket, V(0, 22, 0), 1.6, Color3.fromRGB(190, 40, 40), "Metal", { Name = "RocketTip" })
	cyl(folder, rocket, V(0, 13, 2.5), "Z", 0.2, 1.6, Color3.fromRGB(40, 60, 90), "Glass", { CanCollide = false, Name = "RocketWindow" })
	for i = 0, 3 do
		add(folder, rocket * CFrame.Angles(0, i * math.pi / 2, 0), V(3.2, 3.25, 0), V(2.4, 4.4, 0.4), Color3.fromRGB(60, 62, 70), "Metal", { Name = "RocketFin" })
	end
	for _, z in ipairs({ -80, 0, 80 }) do
		for _, x in ipairs({ -100, 100 }) do
			local orb = ball(folder, ctx.at(x, 16, z), V(0, 0, 0), 2.4, theme.Accent, "Neon", { CanCollide = false, Name = "HoverLamp" })
			pointLight(orb, theme.Accent, 30, 0.8)
		end
	end
end

function decor.Crystals(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local rnd = Random.new(707)
	local colors = { theme.Accent, Color3.fromRGB(190, 120, 255), Color3.fromRGB(120, 230, 200) }
	for i, p in ipairs(SPOTS) do
		crystalCluster(folder, ctx.at(p[1], 0, p[2]), rnd, colors, 3, i % 3 == 0)
	end
	-- specimen tank in the middle of the lab
	local tank = ctx.at(0, 0, -84)
	cyl(folder, tank, V(0, 0.8, 0), "Y", 1.6, 9, STEEL_DARK, "DiamondPlate", { Name = "TankBase" })
	cyl(folder, tank, V(0, 7.6, 0), "Y", 12, 7, Color3.fromRGB(180, 255, 200), "Glass", { Transparency = 0.6, Name = "TankGlass" })
	cyl(folder, tank, V(0, 7.4, 0), "Y", 11.4, 6.6, Color3.fromRGB(90, 255, 120), "Neon", { CanCollide = false, Transparency = 0.82, Name = "TankLiquid" })
	cyl(folder, tank, V(0, 14, 0), "Y", 1, 8, STEEL_DARK, "Metal", { Name = "TankCap" })
	cyl(folder, tank, V(0, 6, 0), "Y", 4.4, 1.6, Color3.fromRGB(70, 120, 70), "SmoothPlastic", { CanCollide = false, Name = "Specimen" })
	local head = ball(folder, tank, V(0, 9.4, 0), 2.6, Color3.fromRGB(70, 120, 70), "SmoothPlastic", { CanCollide = false, Name = "SpecimenHead" })
	head.Size = V(2.2, 2.8, 2.2)
	pointLight(head, Color3.fromRGB(110, 255, 140), 24, 1.2)
	for _, s in ipairs({ -1, 1 }) do
		cyl(folder, tank, V(s * 4.4, 8, 0), "Y", 14, 0.5, CHROME_C, "Metal", { CanCollide = false, Name = "Pipe" })
	end
end

function decor.Clouds(ctx)
	local folder, theme = ctx.folder, ctx.theme
	local rnd = Random.new(808)
	-- clouds stay out to the sides so they never drift into the neighbouring gyms
	for i = 1, 40 do
		local side = (i % 2 == 0) and 1 or -1
		local d = rnd:NextInteger(40, 90)
		local pos = V(side * rnd:NextInteger(200, 380), rnd:NextInteger(-50, 20), rnd:NextInteger(-300, 300))
		local c = ball(folder, ctx.at(pos.X, pos.Y, pos.Z), V(0, 0, 0), d, WHITE, "SmoothPlastic", { CanCollide = false, Name = "Cloud" })
		c.Size = V(d * 1.6, d * 0.6, d)
	end
	-- marble colonnade with gold bands
	for _, z in ipairs({ -95, -32, 32, 95 }) do
		for _, x in ipairs({ -44, 44 }) do
			cyl(folder, ctx.at(x, 20, z), V(0, 0, 0), "Y", 40, 5, Color3.fromRGB(246, 244, 238), "Marble", { Name = "GreekColumn" })
			for _, y in ipairs({ 1, 39.5 }) do
				add(folder, ctx.at(x, y, z), V(0, 0, 0), V(7, 1.2, 7), Color3.fromRGB(240, 236, 228), "Marble", { Name = "ColumnBlock" })
			end
			cyl(folder, ctx.at(x, 6, z), V(0, 0, 0), "Y", 0.6, 5.3, Color3.fromRGB(230, 190, 80), "Metal", { CanCollide = false, Name = "GoldBand" })
		end
	end
	cyl(folder, ctx.at(0, 60, 0), V(0, 0, 0), "Y", 1.5, 80, theme.Accent, "Neon", { CanCollide = false, Transparency = 0.6, Name = "Halo" })
	-- statue of a champion pressing a barbell overhead
	local st = ctx.at(0, 0, -84)
	local MARBLE = Color3.fromRGB(242, 240, 234)
	add(folder, st, V(0, 1.5, 0), V(8, 3, 8), Color3.fromRGB(230, 226, 218), "Marble", { Name = "StatuePlinth" })
	for _, s in ipairs({ -1, 1 }) do
		cyl(folder, st, V(s * 0.9, 5.5, 0), "Y", 5, 1.3, MARBLE, "Marble", { Name = "StatueLeg" })
		cyl(folder, st, V(s * 2.6, 12.5, 0), "Y", 4.4, 1, MARBLE, "Marble", { Name = "StatueArm", Rotation = CFrame.Angles(0, 0, math.rad(s * 15)) })
	end
	add(folder, st, V(0, 10, 0), V(3.8, 5, 2), MARBLE, "Marble", { Name = "StatueTorso" })
	ball(folder, st, V(0, 13.4, 0), 1.9, MARBLE, "Marble", { Name = "StatueHead" })
	barbell(folder, st * CFrame.new(0, 15, 0), 10, 3)
end

function decor.Candy(ctx)
	local folder = ctx.folder
	local SWEETS = { Color3.fromRGB(240, 80, 110), Color3.fromRGB(255, 170, 60), Color3.fromRGB(120, 200, 120), Color3.fromRGB(90, 160, 240), Color3.fromRGB(190, 120, 230) }
	local function lollipop(cf, height, color)
		cyl(folder, cf, V(0, height / 2, 0), "Y", height, 0.8, WHITE, "SmoothPlastic", { Name = "LollipopStick" })
		cyl(folder, cf, V(0, height + 3, 0), "Z", 1.2, 7, color, "SmoothPlastic", { CanCollide = false, Name = "LollipopHead" })
		cyl(folder, cf, V(0, height + 3, 0), "Z", 1.3, 4.5, WHITE, "SmoothPlastic", { CanCollide = false })
		cyl(folder, cf, V(0, height + 3, 0), "Z", 1.4, 2.2, color, "SmoothPlastic", { CanCollide = false })
	end
	for i = 1, 7 do
		local p = SPOTS[i]
		lollipop(ctx.at(p[1], 0, p[2]), 12 + (i % 3) * 3, SWEETS[i % #SWEETS + 1])
	end
	-- candy canes flanking the turf lane
	for _, p in ipairs({ { -40, 100 }, { 40, 100 }, { -40, -100 }, { 40, -100 } }) do
		for k = 0, 9 do
			cyl(folder, ctx.at(p[1], 0.8 + k * 1.6, p[2]), V(0, 0, 0), "Y", 1.6, 1.6, k % 2 == 0 and Color3.fromRGB(220, 44, 56) or WHITE, "SmoothPlastic", { Name = "CandyCane" })
		end
		for k = 0, 6 do
			local a = k / 6 * math.pi
			ball(folder, ctx.at(p[1] + 2 - math.cos(a) * 2, 16.5 + math.sin(a) * 2, p[2]), V(0, 0, 0), 1.7, k % 2 == 0 and WHITE or Color3.fromRGB(220, 44, 56), "SmoothPlastic", { Name = "CandyCaneHook" })
		end
	end
	-- cupcake centre-piece
	local cake = ctx.at(0, 0, -76)
	cyl(folder, cake, V(0, 2.5, 0), "Y", 5, 10, Color3.fromRGB(210, 160, 104), "SmoothPlastic", { Name = "CupcakeBase" })
	local frost = ball(folder, cake, V(0, 6.5, 0), 11, Color3.fromRGB(250, 186, 214), "SmoothPlastic", { Name = "Frosting" })
	frost.Size = V(11, 6, 11)
	ball(folder, cake, V(0, 10, 0), 3, Color3.fromRGB(200, 26, 50), "SmoothPlastic", { CanCollide = false, Name = "Cherry" })
end

----------------------------------------------------------------------
-- Corridors between rooms (steel bridge over black side floors)
----------------------------------------------------------------------
local BRIDGE_BLACK = Color3.fromRGB(18, 18, 22)

local function buildCorridor(world, index, parent)
	local area = Config.Areas[index]
	local nextArea = Config.Areas[index + 1]
	if not nextArea then
		return
	end
	local W = Config.World
	local half = W.RoomSize / 2
	local origin = Config.AreaCenter(index)
	local length = W.Stride - W.RoomSize
	local centerZ = origin.Z - half - length / 2
	local cw = W.CorridorWidth
	local accent = nextArea.Theme.Accent
	local folder = newFolder(parent, "Corridor_" .. area.Id .. "_" .. nextArea.Id)
	local function at(x, y, z)
		return CFrame.new(x, y, centerZ + z)
	end

	-- walkway: concrete with a rubber runner
	add(folder, at(0, -1, 0), V(0, 0, 0), V(cw, 2, length), Color3.fromRGB(150, 152, 156), "Concrete", { Name = "CorridorFloor" })
	add(folder, at(0, 0.04, 0), V(0, 0, 0), V(14, 0.08, length - 4), RUBBER_C, "Rubber", { CanCollide = false, Name = "Runner" })
	for _, x in ipairs({ -7.4, 7.4 }) do
		add(folder, at(x, 0.05, 0), V(0, 0, 0), V(0.6, 0.1, length - 4), SAFETY_YELLOW, "SmoothPlastic", { CanCollide = false, Name = "RunnerEdge" })
	end

	-- bridge sides: black floors + side walls
	local sideW = half - cw / 2 -- 105 with the default sizes
	for _, side in ipairs({ -1, 1 }) do
		add(folder, at(side * (cw / 2 + sideW / 2), -1, 0), V(0, 0, 0), V(sideW, 2, length), BRIDGE_BLACK, "SmoothPlastic", { Name = "SideFloor" })
		add(folder, at(side * (cw / 2 + 0.55), 0.05, 0), V(0, 0, 0), V(0.9, 0.3, length - 0.2), accent, "Neon", { Name = "EdgeTrim" })
		add(folder, at(side * half, W.WallHeight / 2, 0), V(0, 0, 0), V(4, W.WallHeight, length - 4), nextArea.Theme.Wall, nextArea.Theme.WallMat, { Name = "ConnectWall" })
		add(folder, at(side * half, W.WallHeight + 0.25, 0), V(0, 0, 0), V(4.4, 0.5, length - 4), accent, "Neon", { CanCollide = false, Name = "WallTopStrip" })
		-- steel guard rail with bollard lights
		add(folder, at(side * (cw / 2 + 0.3), 3.2, 0), V(0, 0, 0), V(0.5, 0.5, length), CHROME_C, "Metal", { CanCollide = false, Name = "CorridorRail" })
		add(folder, at(side * (cw / 2 + 0.3), 1.8, 0), V(0, 0, 0), V(0.3, 0.3, length), CHROME_C, "Metal", { CanCollide = false, Name = "CorridorRail" })
		for z = -length / 2 + 10, length / 2 - 10, 30 do
			add(folder, at(side * (cw / 2 + 0.3), 1.6, z), V(0, 0, 0), V(0.6, 3.2, 0.6), STEEL, "Metal", { Name = "RailPost" })
			ball(folder, at(side * (cw / 2 + 0.3), 3.6, z), V(0, 0, 0), 1, accent, "Neon", { CanCollide = false })
		end
		-- street lamps along the bridge
		for _, z in ipairs({ -50, 50 }) do
			cyl(folder, at(side * (cw / 2 + 4), 9, z), V(0, 0, 0), "Y", 18, 0.8, STEEL_DARK, "Metal", { Name = "LampPole" })
			add(folder, at(side * (cw / 2 + 2.5), 18, z), V(0, 0, 0), V(3.6, 0.6, 1.6), STEEL_DARK, "Metal", { CanCollide = false, Name = "LampArm" })
			local head = add(folder, at(side * (cw / 2 + 1.5), 17.6, z), V(0, 0, 0), V(1.6, 0.2, 1.2), LED_WHITE, "Neon", { CanCollide = false, Name = "LampHead" })
			surfaceLight(head, Enum.NormalId.Bottom, LED_WHITE, 26, 1, 110)
		end
	end

	-- steel archway announcing the next gym
	for _, sx in ipairs({ -1, 1 }) do
		add(folder, at(sx * (cw / 2 + 2), 14.45, 0), V(0, 0, 0), V(2, 28.9, 2), STEEL_DARK, "Metal", { Name = "ArchPost" })
	end
	local beam = add(folder, at(0, 26, 0), V(0, 0, 0), V(cw + 5.8, 6, 1), STEEL_DARK, "Metal", { Name = "ArchBeam" })
	local textPos = Vector3.new(0, 26, centerZ + 0.7)
	sign(folder, CFrame.lookAt(textPos, textPos + V(0, 0, 1)), V(cw, 5, 0.3),
		"➡ " .. string.upper(nextArea.Name) .. " • " .. Format.Number(nextArea.Required) .. " 💪", WHITE, darker(accent, 0.45), 0)
	local light = pointLight(beam, accent, 40, 1.2)
	light.Name = "ArchLight"
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function MapBuilder.Build()
	for _, oldName in ipairs({ "GymWorld", "BridgeSides" }) do
		local existing = Workspace:FindFirstChild(oldName)
		if existing then
			existing:Destroy()
		end
	end
	pcall(function()
		Workspace.FallenPartsDestroyHeight = -400
	end)

	local root = Instance.new("Folder")
	root.Name = "GymWorld"
	local world = {
		Folder = root,
		Stations = {},
		Eggs = {},
		Gates = {},
		Sell = {},
		OrbSpawns = {},
		OrbZones = {},
	}

	for _, area in ipairs(Config.Areas) do
		local origin = Config.AreaCenter(area.Index)
		local ctx = {
			area = area,
			theme = area.Theme,
			origin = origin,
			folder = newFolder(root, area.Id),
			at = function(x, y, z)
				return CFrame.new(origin + V(x, y, z))
			end,
		}
		buildShell(ctx)
		buildGymInterior(ctx)
		if area.Index &gt; 1 then
			buildGate(ctx, world)
		end
		buildStations(ctx, world)
		buildEgg(ctx, world)
		buildSell(ctx, world)
		world.OrbSpawns[area.Id] = orbPositions(ctx)
		world.OrbZones[area.Id] = orbZones(ctx)
		local d = decor[area.Theme.Decor]
		if d then
			d(ctx)
		end
		buildCorridor(world, area.Index, root)
	end

	-- spawn pad in the first gym
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GymSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.AllowTeamChangeOnTouch = false
	spawn.Size = V(12, 1, 12)
	spawn.CFrame = CFrame.new(Config.AreaCenter(1) + V(0, 0.5, 92))
	spawn.Material = mat("Rubber")
	spawn.Color = Color3.fromRGB(34, 35, 40)
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = root
	add(root, spawn.CFrame, V(0, 0.52, 0), V(10, 0.04, 10), Config.Areas[1].Theme.Accent, "Neon", { CanCollide = false, Name = "SpawnRing", Transparency = 0.6 })

	root.Parent = Workspace
	return world
end

function MapBuilder.Init(services) end

return MapBuilder
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX17">
        <Properties>
          <string name="Name">OrbService</string>
          <ProtectedString name="Source">--[[
	OrbService - golden coin orbs floating around every gym (the "activity" that pays coins).
	The server does the pick-up check by distance, pays out, and respawns the orb later.
]]
local Players = game:GetService("Players")

local OrbService = {}

local S, Config, Remotes
local orbs = {} -- list of { Area, Position, Part, RespawnAt }

-- Pickups are little red hex dumbbells (like the game's dumbbell logo). The root part
-- is invisible; the dumbbell pieces are welded to it so the client bob/spin moves them.
local RED = Color3.fromRGB(235, 30, 40)
local RED_DARK = Color3.fromRGB(170, 12, 24)

local function dumbbellPiece(root, size, color, offset)
	local p = Instance.new("Part")
	p.Name = "DumbbellPiece"
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Anchored = false
	p.Massless = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.CFrame = root.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = p
	w.Parent = p
	p.Parent = root
	return p
end

local function buildDumbbellLook(root)
	-- handle
	local handle = dumbbellPiece(root, Vector3.new(1.9, 0.5, 0.5), RED, CFrame.new())
	handle.Shape = Enum.PartType.Cylinder
	for _, side in ipairs({ -1, 1 }) do
		-- collar
		local collar = dumbbellPiece(root, Vector3.new(0.25, 0.75, 0.75), RED_DARK, CFrame.new(side * 0.98, 0, 0))
		collar.Shape = Enum.PartType.Cylinder
		-- inner (big) octagon plate = two squares rotated 45 degrees
		for _, a in ipairs({ 0, 45 }) do
			dumbbellPiece(root, Vector3.new(0.55, 1.75, 1.75), RED, CFrame.new(side * 1.38, 0, 0) * CFrame.Angles(math.rad(a), 0, 0))
		end
		-- outer (smaller) octagon plate
		for _, a in ipairs({ 0, 45 }) do
			dumbbellPiece(root, Vector3.new(0.45, 1.35, 1.35), RED_DARK, CFrame.new(side * 1.85, 0, 0) * CFrame.Angles(math.rad(a), 0, 0))
		end
	end
end

local function makeOrbPart(orb, folder)
	local part = Instance.new("Part")
	part.Name = "DumbbellPickup"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(2.8, 2.8, 2.8)
	part.Transparency = 1
	part.Material = Enum.Material.SmoothPlastic
	part.Color = RED
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.CFrame = CFrame.new(orb.Position) * CFrame.Angles(0, 0, math.rad(20))
	buildDumbbellLook(part)
	part:AddTag("GymOrb")
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 80, 80)
	light.Range = 12
	light.Brightness = 1.5
	light.Parent = part
	part.Parent = folder
	return part
end

-- Pick a random open spot in the gym: inside one of the area's open-floor zones, not inside
-- or touching any solid part / prompt, and not right next to another pickup.
local rng = Random.new()
local function randomSpot(areaId, world)
	local zones = world.OrbZones and world.OrbZones[areaId]
	if not zones or #zones == 0 then
		return nil
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { world.Folder }
	local total = 0
	for _, z in ipairs(zones) do
		total = total + (z.X1 - z.X0) * (z.Z1 - z.Z0)
	end
	for _ = 1, 30 do
		local pick = rng:NextNumber(0, total)
		local zone = zones[#zones]
		for _, z in ipairs(zones) do
			local a = (z.X1 - z.X0) * (z.Z1 - z.Z0)
			if pick &lt;= a then
				zone = z
				break
			end
			pick = pick - a
		end
		local pos = Vector3.new(rng:NextNumber(zone.X0, zone.X1), zone.Y + rng:NextNumber(-0.5, 1.5), rng:NextNumber(zone.Z0, zone.Z1))
		local ok = true
		for _, other in ipairs(orbs) do
			if other.Part and (other.Position - pos).Magnitude &lt; 9 then
				ok = false
				break
			end
		end
		if ok then
			for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(6, 7, 6), params)) do
				local solid = part.CanCollide and part.Name ~= "Floor"
				local prompt = part.Name == "Prompt" or part.Name == "GatePrompt"
				if (solid or prompt) and part.Name ~= "DumbbellPickup" then
					ok = false
					break
				end
			end
		end
		if ok then
			return pos
		end
	end
	return nil
end

local function respawn(orb, folder, world)
	orb.Position = randomSpot(orb.Area, world) or orb.Fallback
	orb.Part = makeOrbPart(orb, folder)
end

function OrbService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes
	local world = services.World
	local folder = world.Folder

	for areaId, positions in pairs(world.OrbSpawns) do
		for i = 1, Config.Orbs.PerArea do
			local fallback = positions[(i - 1) % #positions + 1]
			local orb = { Area = areaId, Position = fallback, Fallback = fallback, RespawnAt = 0 }
			orbs[#orbs + 1] = orb
			respawn(orb, folder, world)
		end
	end

	task.spawn(function()
		while true do
			task.wait(0.2)
			local now = os.clock()
			local roots = {}
			for _, player in ipairs(Players:GetPlayers()) do
				local root = S.ServerUtil.GetRoot(player)
				if root and S.ServerUtil.IsAlive(player) then
					roots[#roots + 1] = { Player = player, Position = root.Position }
				end
			end
			for _, orb in ipairs(orbs) do
				if orb.Part then
					for _, entry in ipairs(roots) do
						if (entry.Position - orb.Position).Magnitude &lt;= Config.Orbs.PickupRange
							and S.AreaService.IsUnlocked(entry.Player, orb.Area) then
							local coins = math.max(1, math.floor(Config.AreasById[orb.Area].OrbCoins * S.StatService.GetCoinMultiplier(entry.Player)))
							S.StatService.AddCoins(entry.Player, coins)
							S.QuestService.Record(entry.Player, "Orbs", 1)
							Remotes.Get("CoinPickup"):FireClient(entry.Player, orb.Position, coins)
							orb.Part:Destroy()
							orb.Part = nil
							orb.RespawnAt = now + Config.Orbs.RespawnSeconds
							break
						end
					end
				elseif now &gt;= orb.RespawnAt then
					respawn(orb, folder, world) -- a new random spot every time
				end
			end
		end
	end)
end

return OrbService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX18">
        <Properties>
          <string name="Name">PetService</string>
          <ProtectedString name="Source">--[[
	PetService - pet inventory, equipping, deleting, locking and slot limits.
	The client only ever sends a request ("Equip" + uid). The server validates everything.

	profile.Pets     = { ["12"] = { Id = "Beginner_Rare", Locked = false }, ... }
	profile.Equipped = { "12", "7", ... }   (max = pet slots)
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local PetService = {}

local S, Config, Remotes
local MAX_DELETE_BATCH = 60

local function profileOf(player)
	return S.DataService.Get(player)
end

local function countPets(profile)
	local n = 0
	for _ in pairs(profile.Pets) do
		n = n + 1
	end
	return n
end

local function equippedPetIds(profile)
	local ids = {}
	for _, uid in ipairs(profile.Equipped) do
		local pet = profile.Pets[uid]
		if pet then
			ids[#ids + 1] = pet.Id
		end
	end
	return ids
end

function PetService.GetSlots(player)
	local profile = profileOf(player)
	return profile and Formulas.PetSlots(profile.Upgrades) or Config.Game.BasePetSlots
end

function PetService.GetPetMultiplier(player)
	local profile = profileOf(player)
	if not profile then
		return 1
	end
	return Formulas.PetMultiplier(equippedPetIds(profile))
end

-- drop invalid / duplicate / over-limit entries from the equipped list
local function cleanEquipped(profile, slots)
	local seen, out = {}, {}
	for _, uid in ipairs(profile.Equipped) do
		if profile.Pets[uid] and not seen[uid] and #out &lt; slots then
			seen[uid] = true
			out[#out + 1] = uid
		end
	end
	profile.Equipped = out
end

-- Push the full inventory to the client + update the replicated "EquippedPets" attribute.
function PetService.Sync(player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local slots = PetService.GetSlots(player)
	cleanEquipped(profile, slots)
	local list = {}
	for uid, pet in pairs(profile.Pets) do
		list[#list + 1] = { u = uid, id = pet.Id, l = pet.Locked == true }
	end
	table.sort(list, function(a, b)
		return tonumber(a.u) &lt; tonumber(b.u)
	end)
	local equipped = {}
	for i, uid in ipairs(profile.Equipped) do
		equipped[i] = uid
	end
	Remotes.Get("SyncInventory"):FireClient(player, {
		Pets = list,
		Equipped = equipped,
		Slots = slots,
		Max = Config.Game.MaxPetsOwned,
	})
	player:SetAttribute("EquippedPets", table.concat(equippedPetIds(profile), ","))
	S.StatService.Refresh(player)
end

-- Adds a pet. Returns the new uid, or nil when the inventory is full.
function PetService.AddPet(player, petId)
	local profile = profileOf(player)
	if not profile or not Config.PetsById[petId] then
		return nil
	end
	if countPets(profile) &gt;= Config.Game.MaxPetsOwned then
		return nil
	end
	local uid = tostring(profile.NextPetUid)
	profile.NextPetUid = profile.NextPetUid + 1
	profile.Pets[uid] = { Id = petId, Locked = false }
	return uid
end

function PetService.FreeSpace(player)
	local profile = profileOf(player)
	if not profile then
		return 0
	end
	return Config.Game.MaxPetsOwned - countPets(profile)
end

function PetService.HasFreeSlot(player)
	local profile = profileOf(player)
	return profile ~= nil and #profile.Equipped &lt; PetService.GetSlots(player)
end

-- Equip if there is room (used to auto-equip fresh hatches). No sync.
function PetService.TryEquip(player, uid)
	local profile = profileOf(player)
	if not profile or not profile.Pets[uid] then
		return false
	end
	if table.find(profile.Equipped, uid) then
		return false
	end
	if #profile.Equipped &gt;= PetService.GetSlots(player) then
		return false
	end
	table.insert(profile.Equipped, uid)
	return true
end

local function removeFromEquipped(profile, uid)
	local i = table.find(profile.Equipped, uid)
	if i then
		table.remove(profile.Equipped, i)
	end
end

local actions = {}

function actions.Equip(player, profile, uid)
	if type(uid) ~= "string" or not profile.Pets[uid] then
		return S.ServerUtil.Fail("Pet not found.")
	end
	if table.find(profile.Equipped, uid) then
		return S.ServerUtil.Fail("That pet is already equipped.")
	end
	if #profile.Equipped &gt;= PetService.GetSlots(player) then
		return S.ServerUtil.Fail("No free pet slots! Unequip a pet or buy a slot in the Shop.")
	end
	table.insert(profile.Equipped, uid)
	return { Ok = true }
end

function actions.Unequip(player, profile, uid)
	if type(uid) ~= "string" or not table.find(profile.Equipped, uid) then
		return S.ServerUtil.Fail("That pet isn't equipped.")
	end
	removeFromEquipped(profile, uid)
	return { Ok = true }
end

function actions.Delete(player, profile, arg)
	local list = {}
	if type(arg) == "string" then
		list = { arg }
	elseif type(arg) == "table" then
		for i, uid in ipairs(arg) do
			if i &gt; MAX_DELETE_BATCH then
				break
			end
			if type(uid) == "string" then
				list[#list + 1] = uid
			end
		end
	else
		return S.ServerUtil.Fail("Nothing to delete.")
	end
	local deleted, lockedCount = 0, 0
	for _, uid in ipairs(list) do
		local pet = profile.Pets[uid]
		if pet then
			if pet.Locked then
				lockedCount = lockedCount + 1
			else
				profile.Pets[uid] = nil
				removeFromEquipped(profile, uid)
				deleted = deleted + 1
			end
		end
	end
	if deleted == 0 then
		return S.ServerUtil.Fail(lockedCount &gt; 0 and "That pet is locked. Unlock it first!" or "Pet not found.")
	end
	return { Ok = true, Deleted = deleted }
end

function actions.Lock(player, profile, uid)
	local pet = type(uid) == "string" and profile.Pets[uid]
	if not pet then
		return S.ServerUtil.Fail("Pet not found.")
	end
	pet.Locked = not pet.Locked
	return { Ok = true, Locked = pet.Locked }
end

function actions.EquipBest(player, profile)
	local uids = {}
	for uid in pairs(profile.Pets) do
		uids[#uids + 1] = uid
	end
	table.sort(uids, function(a, b)
		local ma = Config.PetsById[profile.Pets[a].Id].Mult
		local mb = Config.PetsById[profile.Pets[b].Id].Mult
		if ma == mb then
			return tonumber(a) &lt; tonumber(b)
		end
		return ma &gt; mb
	end)
	local slots = PetService.GetSlots(player)
	profile.Equipped = {}
	for i = 1, math.min(slots, #uids) do
		profile.Equipped[i] = uids[i]
	end
	return { Ok = true }
end

function actions.UnequipAll(player, profile)
	profile.Equipped = {}
	return { Ok = true }
end

function PetService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	Remotes.Get("PetAction").OnServerInvoke = function(player, action, arg)
		if type(action) ~= "string" or not actions[action] then
			return S.ServerUtil.Fail("Unknown action.")
		end
		if not S.ServerUtil.Allow(player, "PetAction", 0.08) then
			return S.ServerUtil.Fail("Slow down!")
		end
		local profile = profileOf(player)
		if not profile then
			return S.ServerUtil.Fail("Loading...")
		end
		local result = actions[action](player, profile, arg)
		if result.Ok then
			PetService.Sync(player)
			S.DataService.SaveSoon(player)
		end
		return result
	end
end

----------------------------------------------------------------------
-- Server-side helpers (admin tools). They reuse the same validated actions as the
-- PetAction remote, then sync + save exactly like a normal pet change.
----------------------------------------------------------------------
function PetService.Count(player)
	local profile = profileOf(player)
	return profile and countPets(profile) or 0
end

function PetService.RunAction(player, action, arg)
	local profile = profileOf(player)
	if not profile then
		return S.ServerUtil.Fail("Loading...")
	end
	if type(action) ~= "string" or not actions[action] then
		return S.ServerUtil.Fail("Unknown action.")
	end
	local result = actions[action](player, profile, arg)
	if result.Ok then
		PetService.Sync(player)
		S.DataService.SaveSoon(player)
	end
	return result
end

function PetService.SetLocked(player, uid, locked)
	local profile = profileOf(player)
	local pet = profile and type(uid) == "string" and profile.Pets[uid]
	if not pet then
		return false
	end
	pet.Locked = locked == true
	PetService.Sync(player)
	S.DataService.SaveSoon(player)
	return true
end

-- Removes every pet for which keep(uid, pet) returns false. Equipped entries of removed
-- pets are dropped too, so nothing ever points at a deleted pet. Returns how many were removed.
function PetService.RemovePets(player, shouldRemove)
	local profile = profileOf(player)
	if not profile then
		return 0
	end
	local removed = 0
	for uid, pet in pairs(profile.Pets) do
		if shouldRemove(uid, pet) then
			profile.Pets[uid] = nil
			removed = removed + 1
		end
	end
	cleanEquipped(profile, PetService.GetSlots(player))
	PetService.Sync(player)
	S.DataService.SaveSoon(player)
	return removed
end

function PetService.SetupPlayer(player, profile)
	cleanEquipped(profile, PetService.GetSlots(player))
	PetService.Sync(player)
end

return PetService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX19">
        <Properties>
          <string name="Name">QuestService</string>
          <ProtectedString name="Source">--[[
	QuestService - a chain of goals. Other services call QuestService.Record(player, stat, amount)
	whenever something quest-worthy happens. Progress and rewards are 100% server-side.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local QuestService = {}

local S, Config, Remotes

local function profileOf(player)
	return S.DataService.Get(player)
end

local function currentInfo(profile)
	return Formulas.QuestInfo(profile.Quest.Index, profile.Stations, profile.Upgrades)
end

function QuestService.GetView(player)
	local profile = profileOf(player)
	if not profile then
		return nil
	end
	local info = currentInfo(profile)
	local progress = math.min(profile.Quest.Progress, info.Goal)
	return {
		Text = info.Text,
		Stat = info.Stat,
		Goal = info.Goal,
		Progress = progress,
		Reward = info.Reward,
		Done = progress &gt;= info.Goal,
		Index = profile.Quest.Index,
	}
end

function QuestService.Record(player, stat, amount)
	local profile = profileOf(player)
	if not profile then
		return
	end
	profile.Stats[stat] = (profile.Stats[stat] or 0) + amount
	local info = currentInfo(profile)
	if info.Stat == stat and profile.Quest.Progress &lt; info.Goal then
		profile.Quest.Progress = math.min(info.Goal, profile.Quest.Progress + amount)
		S.StatService.MarkState(player)
		if profile.Quest.Progress &gt;= info.Goal then
			S.ServerUtil.Notify(player, "Quest complete! Open Quests to claim your reward 🎁", "Success")
			S.StatService.SyncNow(player)
		end
	end
end

-- Admin tools ------------------------------------------------------------
function QuestService.GetInfo(player)
	local profile = profileOf(player)
	return profile and currentInfo(profile) or nil
end

-- progress on the current quest, clamped to 0..goal
function QuestService.SetProgress(player, value)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(value) then
		return false
	end
	local info = currentInfo(profile)
	profile.Quest.Progress = math.clamp(math.floor(value), 0, info.Goal)
	S.StatService.SyncNow(player)
	return true
end

-- jump to a quest in the chain (the chain loops, so any index &gt;= 1 is valid); progress resets
function QuestService.SetIndex(player, index)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(index) then
		return false
	end
	profile.Quest.Index = math.clamp(math.floor(index), 1, Config.Admin and Config.Admin.MaxQuestIndex or 10000)
	profile.Quest.Progress = 0
	S.StatService.SyncNow(player)
	return true
end

function QuestService.SetStat(player, stat, value)
	local profile = profileOf(player)
	if not profile or type(stat) ~= "string" or profile.Stats[stat] == nil or not S.ServerUtil.IsNumber(value) then
		return false
	end
	profile.Stats[stat] = math.clamp(math.floor(value), 0, Config.Game.MaxValue)
	S.StatService.SyncNow(player)
	return true
end

function QuestService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes
	Remotes.Get("ClaimQuest").OnServerInvoke = function(player)
		if not S.ServerUtil.Allow(player, "ClaimQuest", 0.5) then
			return S.ServerUtil.Fail("Slow down!")
		end
		local profile = profileOf(player)
		if not profile then
			return S.ServerUtil.Fail("Loading...")
		end
		local info = currentInfo(profile)
		if profile.Quest.Progress &lt; info.Goal then
			return S.ServerUtil.Fail("Quest isn't finished yet!")
		end
		S.StatService.AddCoins(player, info.Reward)
		profile.Quest.Index = profile.Quest.Index + 1
		profile.Quest.Progress = 0
		S.StatService.SyncNow(player)
		S.DataService.SaveSoon(player)
		return { Ok = true, Reward = info.Reward }
	end
end

return QuestService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX20">
        <Properties>
          <string name="Name">RebirthService</string>
          <ProtectedString name="Source">--[[
	RebirthService - reset Strength for a permanent multiplier (x2 per rebirth by default).
	Kept forever: coins, pets, unlocked gyms, equipment. Upgrades are LOST on rebirth.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local RebirthService = {}

local S, Config, Remotes

function RebirthService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	Remotes.Get("Rebirth").OnServerInvoke = function(player)
		local Fail = S.ServerUtil.Fail
		if not S.ServerUtil.Allow(player, "Rebirth", 1.5) then
			return Fail("Slow down!")
		end
		local profile = S.DataService.Get(player)
		if not profile then
			return Fail("Loading...")
		end
		if profile.Rebirths &gt;= Config.Game.MaxRebirths then
			return Fail("You reached the maximum rebirths!")
		end
		local required = Formulas.RebirthRequirement(profile.Rebirths)
		if profile.Strength &lt; required then
			return Fail("You need more Strength to rebirth!")
		end

		S.TrainingService.EndTraining(player)
		profile.Rebirths = profile.Rebirths + 1
		S.StatService.SetStrength(player, 0)
		-- upgrades reset: walk speed and pet slots follow (extra equipped pets are unequipped)
		profile.Upgrades = {}
		S.StatService.ApplyWalkSpeed(player)
		S.PetService.Sync(player)
		S.QuestService.Record(player, "Rebirths", 1)
		S.StatService.Refresh(player)
		S.StatService.SyncNow(player)

		local mult = Formulas.RebirthMultiplier(profile.Rebirths)
		Remotes.Get("Rebirthed"):FireClient(player, profile.Rebirths, mult)
		S.ServerUtil.Announce(player.DisplayName .. " just reached Rebirth " .. profile.Rebirths .. "! ⭐", Color3.fromRGB(255, 200, 70))
		task.spawn(S.DataService.Save, player)
		return { Ok = true, Rebirths = profile.Rebirths }
	end
end

return RebirthService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX21">
        <Properties>
          <string name="Name">ServerUtil</string>
          <ProtectedString name="Source">--[[
	ServerUtil - small helpers shared by every server service:
	rate limiting, notifications, input validation, distance checks.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("GymShared"):WaitForChild("Remotes"))

local ServerUtil = {}

local lastCall = {} -- [player][key] = os.clock()

-- true if the player may perform `key` now (at most once per `interval` seconds)
function ServerUtil.Allow(player, key, interval)
	local now = os.clock()
	local t = lastCall[player]
	if not t then
		t = {}
		lastCall[player] = t
	end
	local prev = t[key]
	if prev and now - prev &lt; interval then
		return false
	end
	t[key] = now
	return true
end

function ServerUtil.Forget(player)
	lastCall[player] = nil
end

function ServerUtil.Notify(player, text, kind)
	Remotes.Get("Notify"):FireClient(player, text, kind or "Info")
end

function ServerUtil.Announce(text, color)
	Remotes.Get("Announce"):FireAllClients(text, color)
end

function ServerUtil.IsNumber(x)
	return type(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

function ServerUtil.GetRoot(player)
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

function ServerUtil.GetHumanoid(player)
	local character = player.Character
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function ServerUtil.IsAlive(player)
	local h = ServerUtil.GetHumanoid(player)
	return h ~= nil and h.Health &gt; 0
end

-- distance from the player's character to a world position (math.huge if no character)
function ServerUtil.DistanceTo(player, position)
	local root = ServerUtil.GetRoot(player)
	if not root then
		return math.huge
	end
	return (root.Position - position).Magnitude
end

function ServerUtil.Fail(message)
	return { Ok = false, Msg = message }
end

return ServerUtil
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX22">
        <Properties>
          <string name="Name">StatService</string>
          <ProtectedString name="Source">--[[
	StatService - the single place where Strength and Coins change.

	Everything here is server-authoritative:
	  * AddStrength / AddCoins / SpendCoins are the ONLY ways numbers move.
	  * Player attributes (Strength, Coins, ...) are replicated to clients for display only.
	  * Leaderboard (leaderstats), the floating name tag and the growing muscles are updated
	    in a throttled loop so hundreds of reps per second never spam the network.
]]
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local IconSlot = require(Shared.IconSlot)

local StatService = {}

local S, Config, Remotes
local dirtyVisual = {}   -- [player] = true
local dirtyState = {}    -- [player] = true
local lastStateSent = {} -- [player] = os.clock()
local tags = {}          -- [player] = { Name=, Rebirth=, Strength= }
local lastScale = {}     -- [player] = width scale last applied
local leaderstats = {}   -- [player] = { Gym=, Rebirths=, Strength=, Total=, Coins= }

local function profileOf(player)
	return S.DataService.Get(player)
end

----------------------------------------------------------------------
-- Multipliers
----------------------------------------------------------------------
function StatService.GetStrengthMultiplier(player)
	local profile = profileOf(player)
	if not profile then
		return 1
	end
	local petMult = S.PetService.GetPetMultiplier(player)
	return Formulas.StrengthMultiplier(profile.Rebirths, petMult, profile.Upgrades)
end

function StatService.GetCoinMultiplier(player)
	local profile = profileOf(player)
	if not profile then
		return 1
	end
	return Formulas.CoinMultiplier(profile.Upgrades)
end

----------------------------------------------------------------------
-- Dirty flags (flushed by the loop below)
----------------------------------------------------------------------
function StatService.MarkVisual(player)
	dirtyVisual[player] = true
end

function StatService.MarkState(player)
	dirtyState[player] = true
end

----------------------------------------------------------------------
-- Changing numbers
----------------------------------------------------------------------
function StatService.AddStrength(player, amount)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(amount) or amount &lt;= 0 then
		return
	end
	local old = profile.Strength
	local max = Config.Game.MaxValue
	profile.Strength = math.min(old + amount, max)
	profile.TotalStrength = math.min(profile.TotalStrength + amount, max)
	player:SetAttribute("Strength", profile.Strength)
	player:SetAttribute("TotalStrength", profile.TotalStrength)

	-- milestone every time Strength reaches a new power of ten (only ever a new record)
	if profile.Strength &gt;= 100 then
		local magnitude = math.floor(math.log10(profile.Strength))
		if magnitude &gt; profile.HighestMilestone then
			profile.HighestMilestone = magnitude
			Remotes.Get("Milestone"):FireClient(player, magnitude, profile.Strength)
		end
	end
	dirtyVisual[player] = true
end

-- Sets Strength directly (rebirth / selling). Never changes TotalStrength.
function StatService.SetStrength(player, value)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(value) then
		return
	end
	profile.Strength = math.clamp(value, 0, Config.Game.MaxValue)
	player:SetAttribute("Strength", profile.Strength)
	dirtyVisual[player] = true
end

-- Sets TotalStrength directly (admin tools). Never changes Strength.
function StatService.SetTotalStrength(player, value)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(value) then
		return false
	end
	profile.TotalStrength = math.clamp(value, 0, Config.Game.MaxValue)
	player:SetAttribute("TotalStrength", profile.TotalStrength)
	dirtyVisual[player] = true
	return true
end

-- Sets Coins directly (admin tools).
function StatService.SetCoins(player, value)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(value) then
		return false
	end
	profile.Coins = math.clamp(value, 0, Config.Game.MaxValue)
	player:SetAttribute("Coins", profile.Coins)
	dirtyVisual[player] = true
	return true
end

-- Sets Rebirths (whole number, 0..MaxRebirths) and recalculates everything derived from it:
-- rebirth / strength multipliers (Refresh), leaderstats, name tag and body size (visual flush).
function StatService.SetRebirths(player, value)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(value) then
		return false
	end
	profile.Rebirths = math.clamp(math.floor(value), 0, Config.Game.MaxRebirths)
	StatService.Refresh(player)
	return true
end

function StatService.AddCoins(player, amount)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(amount) or amount &lt;= 0 then
		return
	end
	profile.Coins = math.min(profile.Coins + amount, Config.Game.MaxValue)
	player:SetAttribute("Coins", profile.Coins)
	dirtyVisual[player] = true
end

-- returns true if the coins were available (and spent)
function StatService.SpendCoins(player, amount)
	local profile = profileOf(player)
	if not profile or not S.ServerUtil.IsNumber(amount) or amount &lt; 0 then
		return false
	end
	if profile.Coins &lt; amount then
		return false
	end
	profile.Coins = profile.Coins - amount
	player:SetAttribute("Coins", profile.Coins)
	dirtyVisual[player] = true
	return true
end

-- Recompute every derived attribute (after pets / upgrades / rebirth change)
function StatService.Refresh(player)
	local profile = profileOf(player)
	if not profile then
		return
	end
	local petMult = S.PetService.GetPetMultiplier(player)
	player:SetAttribute("Strength", profile.Strength)
	player:SetAttribute("TotalStrength", profile.TotalStrength)
	player:SetAttribute("Coins", profile.Coins)
	player:SetAttribute("Rebirths", profile.Rebirths)
	player:SetAttribute("RebirthMult", Formulas.RebirthMultiplier(profile.Rebirths))
	player:SetAttribute("PetMult", petMult)
	player:SetAttribute("StrengthMult", Formulas.StrengthMultiplier(profile.Rebirths, petMult, profile.Upgrades))
	player:SetAttribute("CoinMult", Formulas.CoinMultiplier(profile.Upgrades))
	player:SetAttribute("PetSlots", Formulas.PetSlots(profile.Upgrades))
	dirtyVisual[player] = true
end

----------------------------------------------------------------------
-- State sync (everything that is not a fast-changing number)
----------------------------------------------------------------------
local function copyFlat(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = v
	end
	return c
end

function StatService.BuildState(player)
	local profile = profileOf(player)
	if not profile then
		return nil
	end
	return {
		Areas = copyFlat(profile.UnlockedAreas),
		Stations = copyFlat(profile.Stations),
		Upgrades = copyFlat(profile.Upgrades),
		Quest = S.QuestService.GetView(player),
		AutoTrain = profile.AutoTrain == true,
		Perks = copyFlat(profile.Perks or {}),
		Donated = profile.Donated or 0,
		Stats = copyFlat(profile.Stats),
	}
end

function StatService.SyncNow(player)
	local state = StatService.BuildState(player)
	if state then
		lastStateSent[player] = os.clock()
		dirtyState[player] = nil
		Remotes.Get("SyncState"):FireClient(player, state)
	end
end

----------------------------------------------------------------------
-- Current gym / player-list status
----------------------------------------------------------------------
-- No team groupings on the player list (removes "For Hire" / "Gym 1" style headers).
local TeamsService = game:GetService("Teams")
local function clearTeams(player)
	TeamsService:ClearAllChildren()
	if player then
		player.Team = nil
		player.Neutral = true
	end
end

function StatService.SetCurrentGym(player, gymName)
	gymName = tostring(gymName or "Between Gyms")
	if player:GetAttribute("CurrentGym") ~= gymName then
		player:SetAttribute("CurrentGym", gymName)
	end
	local ls = leaderstats[player]
	if ls and ls.Gym then
		ls.Gym.Value = gymName
	end
end

----------------------------------------------------------------------
-- Character visuals
----------------------------------------------------------------------
function StatService.ApplyWalkSpeed(player)
	local profile = profileOf(player)
	local humanoid = S.ServerUtil.GetHumanoid(player)
	if not profile or not humanoid then
		return
	end
	-- Never freeze the player on a machine: walking away simply ends the session
	-- (TrainingService checks the distance), so you can go straight to a rack.
	local training = false
	humanoid.WalkSpeed = Formulas.WalkSpeed(profile.Upgrades)
	if humanoid.UseJumpPower then
		humanoid.JumpPower = training and 0 or 50
	else
		humanoid.JumpHeight = training and 0 or 7.2
	end
end

local function updateTag(player)
	local profile = profileOf(player)
	local t = tags[player]
	if not profile or not t then
		return
	end
	t.Rebirth.Text = "Rebirth " .. tostring(profile.Rebirths)
	t.Strength.Text = Format.Number(profile.Strength)
end

local function applyBodyScale(player, force)
	local profile = profileOf(player)
	local humanoid = S.ServerUtil.GetHumanoid(player)
	if not profile or not humanoid then
		return
	end
	local width, height = Formulas.BodyScale(profile.Strength, profile.Rebirths)
	if not force and lastScale[player] and math.abs(lastScale[player] - width) &lt; 0.01 then
		return
	end
	local function set(name, value)
		local v = humanoid:FindFirstChild(name)
		if v then
			v.Value = value
			return true
		end
		return false
	end
	if set("BodyWidthScale", width) then
		lastScale[player] = width
		set("BodyDepthScale", width)
		set("BodyHeightScale", height)
		set("HeadScale", height)
	end
end

local function buildTag(player, character)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local old = head:FindFirstChild("GymTag")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "GymTag"
	gui.Size = UDim2.fromOffset(280, 98)
	gui.StudsOffset = Vector3.new(0, 3.5, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 100
	gui.LightInfluence = 0
	gui.Adornee = head
	gui.Parent = head

	-- Same lettering as the HUD buttons: FredokaOne with a thick, rounded black outline
	-- (the old 1-pixel TextStroke looked thin and blurry).
	local function makeLabel(name, y, height, textSize, color, strokeThickness)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, height)
		l.Position = UDim2.fromOffset(0, y)
		l.Font = Enum.Font.FredokaOne
		l.TextSize = textSize
		l.TextColor3 = color
		l.TextStrokeTransparency = 1
		l.Text = ""
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(14, 14, 20)
		st.Thickness = strokeThickness or 2.5
		st.LineJoinMode = Enum.LineJoinMode.Round
		st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		st.Parent = l
		l.Parent = gui
		return l
	end
	local nameLabel = makeLabel("Name", 0, 28, 23, Color3.fromRGB(255, 255, 255), 2.6)
	nameLabel.Text = player.DisplayName

	-- [logo] value rows, centred. The logos are the same pictures the HUD uses (painted
	-- by each client, see IconSlot); the emoji inside the slot is only a fallback.
	local function iconRow(name, y, iconName, emoji, textSize, color)
		local row = Instance.new("Frame")
		row.Name = name .. "Row"
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 32)
		row.Position = UDim2.fromOffset(0, y)
		row.Parent = gui
		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 5)
		layout.Parent = row
		IconSlot.Make(row, iconName, emoji, UDim2.fromOffset(32, 32), 1)
		local l = makeLabel(name, 0, 32, textSize, color, 2.6)
		l.Size = UDim2.fromOffset(0, 32)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.LayoutOrder = 2
		l.Parent = row
		return l
	end
	local rebirthLabel = iconRow("Rebirth", 30, "RebirthStar", "⭐", 23, Color3.fromRGB(255, 206, 64))
	local strengthLabel = iconRow("Strength", 63, "Strength", "💪", 25, Color3.fromRGB(255, 104, 88))
	tags[player] = { Gui = gui, Name = nameLabel, Rebirth = rebirthLabel, Strength = strengthLabel }
	updateTag(player)
end

function StatService.OnCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	lastScale[player] = nil
	StatService.ApplyWalkSpeed(player)
	task.spawn(buildTag, player, character)
	-- R15 scale values appear a moment after spawning; retry briefly
	task.spawn(function()
		for _ = 1, 24 do
			if not humanoid.Parent then
				return
			end
			if humanoid:FindFirstChild("BodyWidthScale") then
				applyBodyScale(player, true)
				return
			end
			task.wait(0.25)
		end
	end)
end

----------------------------------------------------------------------
-- Setup / cleanup
----------------------------------------------------------------------
function StatService.SetupPlayer(player, profile)
	local old = player:FindFirstChild("leaderstats")
	if old then old:Destroy() end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local function stringStat(name, value)
		local v = Instance.new("StringValue")
		v.Name = name
		v.Value = tostring(value or "0")
		v.Parent = folder
		return v
	end

	-- Roblox shows at most 4 leaderstats columns: Money, Strength, Total, Rebirths.
	local coins = stringStat("Money", Format.Number(profile.Coins or 0))
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = profile.Rebirths or 0
	rebirths.Parent = folder
	local strength = stringStat("Strength", Format.Number(profile.Strength or 0))
	local total = stringStat("Total", Format.Number(profile.TotalStrength or 0))

	leaderstats[player] = {
		Rebirths = rebirths,
		Strength = strength,
		Total = total,
		Coins = coins,
	}
	folder.Parent = player
	player:SetAttribute("CurrentGym", "Beginner Gym")
	clearTeams(player)
	player:SetAttribute("NoSave", profile._noSave == true or nil)
	StatService.Refresh(player)
	StatService.SyncNow(player)
end

function StatService.PlayerLeaving(player)
	dirtyVisual[player] = nil
	dirtyState[player] = nil
	lastStateSent[player] = nil
	tags[player] = nil
	lastScale[player] = nil
	leaderstats[player] = nil
end

local function flush()
	for player in pairs(dirtyVisual) do
		dirtyVisual[player] = nil
		local profile = profileOf(player)
		local ls = leaderstats[player]
		if profile and ls then
			if ls.Gym then ls.Gym.Value = player:GetAttribute("CurrentGym") or "Between Gyms" end
			ls.Rebirths.Value = profile.Rebirths
			ls.Strength.Value = Format.Number(profile.Strength)
			ls.Total.Value = Format.Number(profile.TotalStrength)
			ls.Coins.Value = Format.Number(profile.Coins)
			updateTag(player)
			applyBodyScale(player, false)
		end
	end
	local now = os.clock()
	for player in pairs(dirtyState) do
		if now - (lastStateSent[player] or 0) &gt;= 0.4 then
			StatService.SyncNow(player)
		end
	end
end

function StatService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes
	task.spawn(function()
		while true do
			task.wait(0.25)
			flush()
		end
	end)
end

return StatService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX23">
        <Properties>
          <string name="Name">TrainingService</string>
          <ProtectedString name="Source">--[[
	TrainingService - station ownership, free-weight pickup, reps and selling Strength.

	Free weights (Dumbbell / Squat / Deadlift) are rack pickups, never Roblox Tools.
	That keeps them completely separate from the pet inventory. Switching from one
	free weight to another is an atomic server-side switch: the old session is cleared
	without sending a temporary "stopped" state, then the new session is sent once.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local TrainingService = {}

local S, Config, Remotes
local stationParts = {}
local sellParts = {}
local states = {} -- [player] = {StationId, Station, Stand, LastRep, Portable}

local FREE_WEIGHT = {
	Dumbbell = true,
	Squat = true,
	Deadlift = true,
}

local function profileOf(player)
	return S.DataService.Get(player)
end

local function isFreeWeight(station)
	return station and FREE_WEIGHT[station.Kind] == true
end

local function promptAction(station)
	if not station then return "Train" end
	if station.Kind == "Dumbbell" then return "Grab Dumbbells" end
	if station.Kind == "Squat" then return "Grab Barbell" end
	if station.Kind == "Deadlift" then return "Grab Barbell" end
	return "Train"
end

----------------------------------------------------------------------
-- Ending / starting a session
----------------------------------------------------------------------
local function clearState(player, fireClient)
	local oldState = states[player]
	local hadState = oldState ~= nil
		or player:GetAttribute("Training") ~= nil
		or player:GetAttribute("HeldEquipment") ~= nil

	states[player] = nil
	player:SetAttribute("Training", nil)
	player:SetAttribute("HeldEquipment", nil)
	player:SetAttribute("HeldEquipmentKind", nil)
	player:SetAttribute("HeldEquipmentArea", nil)
	player:SetAttribute("SweatUntil", nil)
	S.StatService.ApplyWalkSpeed(player)
	if oldState and oldState.Station and oldState.Station.Kind == "Treadmill" then
		local humanoid = S.ServerUtil.GetHumanoid(player)
		if humanoid then humanoid.AutoRotate = true end
	end

	if fireClient and hadState then
		Remotes.Get("TrainingState"):FireClient(player, false)
	end
	return hadState
end

function TrainingService.EndTraining(player)
	clearState(player, true)
end

local function startTraining(player, stationId)
	local station = Config.StationsById[stationId]
	local parts = stationParts[stationId]
	local character = player.Character
	if not station or not parts or not character or not S.ServerUtil.IsAlive(player) then return end

	-- IMPORTANT: switching equipment is one transaction. Do not send false then true;
	-- that old two-event sequence could race the local detach/attach animations and leave
	-- the player unable to use the next rack correctly.
	clearState(player, false)

	local portable = isFreeWeight(station)
	states[player] = {
		StationId = stationId,
		Station = station,
		Stand = parts.Stand,
		LastRep = 0,
		Portable = portable,
	}

	if portable then
		player:SetAttribute("HeldEquipment", stationId)
		player:SetAttribute("HeldEquipmentKind", station.Kind)
		player:SetAttribute("HeldEquipmentArea", station.Area)
		player:SetAttribute("Training", nil)
		S.StatService.ApplyWalkSpeed(player)
	else
		player:SetAttribute("HeldEquipment", nil)
		player:SetAttribute("Training", stationId)
		local humanoid = S.ServerUtil.GetHumanoid(player)
		local root = S.ServerUtil.GetRoot(player)
		local lift = 3
		if humanoid and root then
			lift = math.max(3, (humanoid.HipHeight or 2) + root.Size.Y / 2)
		end

		-- Treadmills are twelve studs long and their console is at local -Z. The shared
		-- station Stand is at local +Z for other equipment, so move treadmill users
		-- forward onto the front half of the belt instead of leaving them at the rear.
		local forwardOffset = station.Kind == "Treadmill" and -6.2 or 0
		character:PivotTo(parts.Stand.CFrame * CFrame.new(0, lift, forwardOffset))
		S.StatService.ApplyWalkSpeed(player)

		-- A treadmill session is intentionally planted: the avatar keeps running in
		-- place until Stop/another station, rather than walking off the moving belt.
		if station.Kind == "Treadmill" and humanoid then
			humanoid.WalkSpeed = 0
			humanoid.AutoRotate = false
			if humanoid.UseJumpPower then humanoid.JumpPower = 0 else humanoid.JumpHeight = 0 end
			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
		end
	end

	Remotes.Get("TrainingState"):FireClient(player, true, stationId)

	if portable then
		local action = station.Kind == "Dumbbell" and "curl"
			or station.Kind == "Deadlift" and "deadlift"
			or "shoulder press"
		Remotes.Get("Notify"):FireClient(player, station.Name .. " grabbed — click/tap or press Space to " .. action .. ".", "Success")
	end
end

----------------------------------------------------------------------
-- One rep
----------------------------------------------------------------------
local function doRep(player, state)
	local station = state.Station
	local strengthMult = S.StatService.GetStrengthMultiplier(player)
	local coinMult = S.StatService.GetCoinMultiplier(player)
	local crit = math.random() &lt; Config.Training.CritChance
	local factor = crit and Config.Training.CritMultiplier or 1
	local gain = station.Strength * strengthMult * factor
	local coins = station.Coins * coinMult * factor
	S.StatService.AddStrength(player, gain)
	S.StatService.AddCoins(player, coins)
	S.QuestService.Record(player, "Reps", 1)
	Remotes.Get("TrainResult"):FireClient(player, gain, coins, crit)
	-- keeps the sweaty aura on while reps keep coming (throttled so it isn't set every rep)
	local now = workspace:GetServerTimeNow()
	local sweatUntil = player:GetAttribute("SweatUntil")
	if type(sweatUntil) ~= "number" or sweatUntil &lt; now + 0.9 then
		player:SetAttribute("SweatUntil", now + 1.8)
	end
end

local function stillValid(player, state)
	if not S.ServerUtil.IsAlive(player) then return false end
	if state.Portable then
		local root = S.ServerUtil.GetRoot(player)
		if not root then return false end
		-- A weight pays only while the player remains in the gym it came from.
		return Config.AreaAt(root.Position) == state.Station.AreaIndex
	end
	return S.ServerUtil.DistanceTo(player, state.Stand.Position) &lt;= Config.Training.StandRange
end

----------------------------------------------------------------------
-- Station prompts
----------------------------------------------------------------------
local function onStationTriggered(player, stationId)
	if not S.ServerUtil.Allow(player, "StationPrompt", 0.25) then return end
	local profile = profileOf(player)
	local station = Config.StationsById[stationId]
	if not profile or not station then return end
	if not profile.UnlockedAreas[station.Area] then return end

	local current = states[player]
	if current and current.StationId == stationId then
		-- Press E on the same rack again to return the weight.
		if current.Portable then
			TrainingService.EndTraining(player)
			Remotes.Get("Notify"):FireClient(player, station.Name .. " put back on the rack.", "Info")
		end
		return
	end

	if not profile.Stations[stationId] then
		Remotes.Get("PromptEquipment"):FireClient(player, stationId)
		return
	end

	-- Different station while carrying another free weight = direct switch.
	-- startTraining clears the old state atomically before equipping the new one.
	startTraining(player, stationId)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function TrainingService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	for stationId, parts in pairs(services.World.Stations) do
		stationParts[stationId] = parts
		local station = Config.StationsById[stationId]
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "StationPrompt"
		prompt.ActionText = promptAction(station)
		prompt.ObjectText = station.Name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = Config.Training.PromptRange
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = parts.Prompt
		prompt.Triggered:Connect(function(player)
			onStationTriggered(player, stationId)
		end)
	end

	for _, sell in ipairs(services.World.Sell) do
		sellParts[#sellParts + 1] = sell.Prompt
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "SellPrompt"
		prompt.ActionText = "Order (Sell Strength)"
		prompt.ObjectText = "Protein Bar"
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = sell.Prompt
		prompt.Triggered:Connect(function(player)
			if S.ServerUtil.Allow(player, "SellPrompt", 0.5) then
				Remotes.Get("OpenSell"):FireClient(player)
			end
		end)
	end

	Remotes.Get("Train").OnServerEvent:Connect(function(player)
		local state = states[player]
		if not state then return end
		if not stillValid(player, state) then
			TrainingService.EndTraining(player)
			if state.Portable then
				Remotes.Get("Notify"):FireClient(player, "That weight belongs to " .. Config.AreasById[state.Station.Area].Name .. ". It was returned to the rack.", "Info")
			end
			return
		end
		local now = os.clock()
		if now - state.LastRep &lt; 1 / Config.Training.MaxRepsPerSecond then return end
		state.LastRep = now
		doRep(player, state)
	end)

	Remotes.Get("StopTraining").OnServerEvent:Connect(function(player)
		TrainingService.EndTraining(player)
	end)


	-- Buying unlocks the rack/machine. It never spawns a Tool or auto-equips it.
	Remotes.Get("BuyEquipment").OnServerInvoke = function(player, stationId)
		local Fail = S.ServerUtil.Fail
		if type(stationId) ~= "string" then return Fail("Bad request.") end
		local station = Config.StationsById[stationId]
		local parts = stationParts[stationId]
		local profile = profileOf(player)
		if not station or not parts or not profile then return Fail("Unknown equipment.") end
		if not S.ServerUtil.Allow(player, "BuyEquipment", 0.5) then return Fail("Slow down!") end
		if not profile.UnlockedAreas[station.Area] then return Fail("Unlock that gym first!") end
		if profile.Stations[stationId] then return Fail("You already own this!") end
		if S.ServerUtil.DistanceTo(player, parts.Stand.Position) &gt; 30 then return Fail("Walk up to the equipment first!") end
		if not S.StatService.SpendCoins(player, station.Price) then return Fail("Not enough coins!") end
		profile.Stations[stationId] = true
		S.StatService.SyncNow(player)
		S.DataService.SaveSoon(player)
		return { Ok = true, Msg = isFreeWeight(station) and "Purchased! Press E at the rack to grab it." or "Purchased! Press E to use it." }
	end

	Remotes.Get("SellStrength").OnServerInvoke = function(player, fraction)
		local Fail = S.ServerUtil.Fail
		if type(fraction) ~= "number" then return Fail("Bad request.") end
		local valid = false
		for _, option in ipairs(Config.Sell.Options) do
			if math.abs(option - fraction) &lt; 1e-6 then valid = true end
		end
		if not valid then return Fail("Bad amount.") end
		local profile = profileOf(player)
		if not profile then return Fail("Loading...") end
		if not S.ServerUtil.Allow(player, "Sell", 0.4) then return Fail("Slow down!") end
		local near = false
		for _, part in ipairs(sellParts) do
			if S.ServerUtil.DistanceTo(player, part.Position) &lt;= Config.Sell.Range then near = true; break end
		end
		if not near then return Fail("Walk up to the Protein Bar first!") end
		local sold = profile.Strength * fraction
		if sold &lt; 1 then return Fail("You don't have enough Strength to sell yet.") end
		local strengthMult = math.max(1, S.StatService.GetStrengthMultiplier(player))
		local coins = (sold / strengthMult) * Config.Training.CoinRatio * S.StatService.GetCoinMultiplier(player) * Config.Sell.Efficiency
		coins = math.max(1, math.floor(coins))
		S.StatService.SetStrength(player, profile.Strength - sold)
		S.StatService.AddCoins(player, coins)
		S.QuestService.Record(player, "Sells", 1)
		S.DataService.SaveSoon(player)
		return { Ok = true, Coins = coins, Sold = sold }
	end

	-- Auto training + immediately return a carried weight when its gym is left.
	task.spawn(function()
		while true do
			task.wait(Config.Training.AutoInterval)
			for player, state in pairs(states) do
				if not stillValid(player, state) then
					TrainingService.EndTraining(player)
				end
			end
		end
	end)
end

-- current station id (or nil) - admin dashboard
function TrainingService.GetSession(player)
	local state = states[player]
	return state and state.StationId or nil
end

function TrainingService.OnCharacter(player, character)
	-- Never carry a session across respawns.
	clearState(player, true)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		humanoid.Died:Connect(function()
			TrainingService.EndTraining(player)
		end)
	end
end

function TrainingService.PlayerLeaving(player)
	states[player] = nil
end

return TrainingService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX24">
        <Properties>
          <string name="Name">UpgradeService</string>
          <ProtectedString name="Source">--[[
	UpgradeService - the coin Shop (Power, Coin Magnet, Luck, Speed, Pet Slots, Triple Hatch, Auto Trainer).
	Add a new upgrade in Config.Upgrades and it appears in the Shop automatically.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local UpgradeService = {}

local S, Config, Remotes

-- Everything that depends on an upgrade level (used by the Shop and by admin tools).
local function applyUpgradeEffects(player, profile, id)
	if id == "Speed" then
		S.StatService.ApplyWalkSpeed(player) -- walk speed is always derived from the upgrade
	elseif id == "PetSlots" then
		S.PetService.Sync(player) -- trims the equipped list if there are fewer slots now
	end
	S.StatService.Refresh(player)
	S.StatService.SyncNow(player)
	S.DataService.SaveSoon(player)
end

-- Admin tool: set a level directly (0..def.Max). Returns ok, newLevel or error.
function UpgradeService.SetLevel(player, id, level)
	local def = type(id) == "string" and Config.UpgradesById[id]
	local profile = S.DataService.Get(player)
	if not def or not profile then
		return false, "Unknown upgrade."
	end
	if not S.ServerUtil.IsNumber(level) then
		return false, "Level must be a number."
	end
	level = math.clamp(math.floor(level), 0, def.Max)
	profile.Upgrades[id] = level &gt; 0 and level or nil
	applyUpgradeEffects(player, profile, id)
	return true, level
end

function UpgradeService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	Remotes.Get("BuyUpgrade").OnServerInvoke = function(player, id)
		local Fail = S.ServerUtil.Fail
		if type(id) ~= "string" then
			return Fail("Bad request.")
		end
		local def = Config.UpgradesById[id]
		if not def then
			return Fail("Unknown upgrade.")
		end
		if not S.ServerUtil.Allow(player, "BuyUpgrade", 0.15) then
			return Fail("Slow down!")
		end
		local profile = S.DataService.Get(player)
		if not profile then
			return Fail("Loading...")
		end
		local level = Formulas.Level(profile.Upgrades, id)
		if level &gt;= def.Max then
			return Fail("Already maxed out!")
		end
		local cost = Formulas.UpgradeCost(def, level)
		if not S.StatService.SpendCoins(player, cost) then
			return Fail("Not enough coins!")
		end
		profile.Upgrades[id] = level + 1
		S.QuestService.Record(player, "Upgrades", 1)
		applyUpgradeEffects(player, profile, id)
		return { Ok = true, Level = level + 1 }
	end
end

return UpgradeService
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX25">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <bool name="LoadCharacterAppearance">true</bool>
      <token name="AvatarType">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX27">
        <Properties>
          <string name="Name">GymClient</string>
          <ProtectedString name="Source">--[[
	GymClient  (LocalScript - the only script on the client; every ModuleScript next to it is a module)

	The client NEVER decides outcomes. It draws the world, sends requests (train, hatch, buy...)
	and plays effects for whatever the server answers.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("GymShared")

local C = {
	Player = player,
	Config = require(Shared.Config),
	Format = require(Shared.Format),
	Formulas = require(Shared.Formulas),
	Remotes = require(Shared.Remotes),
}

-- wait for the server to create the remotes, then hide Roblox's own UI we replace
C.Remotes.Get("SyncState")
pcall(function()
	local starterGui = game:GetService("StarterGui")
	starterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	starterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

----------------------------------------------------------------------
-- Screen: a scaled canvas (so the UI fits phones and big monitors) + an unscaled effects layer
----------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "GymUI"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 10

local canvas = Instance.new("Frame")
canvas.Name = "Canvas"
canvas.BackgroundTransparency = 1
canvas.Size = UDim2.fromScale(1, 1)
canvas.Parent = gui
local uiScale = Instance.new("UIScale")
uiScale.Parent = canvas

local effects = Instance.new("Frame")
effects.Name = "Effects"
effects.BackgroundTransparency = 1
effects.Size = UDim2.fromScale(1, 1)
effects.ZIndex = 100
effects.Parent = gui
gui.Parent = playerGui

C.Gui, C.Root, C.Effects = gui, canvas, effects

local function rescale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min(viewport.X / 1180, viewport.Y / 660), 0.55, 1.3)
	uiScale.Scale = scale
	canvas.Size = UDim2.fromScale(1 / scale, 1 / scale)
end
rescale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
end

----------------------------------------------------------------------
-- Modules (order matters: later ones use earlier ones)
----------------------------------------------------------------------
C.Store = require(script.Store)
C.Sfx = require(script.Sfx)
C.UIKit = require(script.UIKit)
C.UIKit.Sfx = C.Sfx
C.UIKit.Root = canvas -- dropdowns, tooltips and confirmation dialogs are drawn on the canvas
C.Fx = require(script.Fx)
C.PetVisuals = require(script.PetVisuals)
C.HUD = require(script.HUD)

function C.OpenPanel(name)
	local p = C.UIKit.Panels[name]
	if p then
		p.Open()
	end
end
function C.TogglePanel(name)
	local p = C.UIKit.Panels[name]
	if p then
		p.Toggle()
	end
end

C.Store.Init(C.Remotes)
C.Fx.Init(C)
C.PetVisuals.Init(C)
C.HUD.Init(C)

-- PanelAdmin only builds its panel + button after the SERVER confirms admin rights
for _, name in ipairs({ "PanelPets", "PanelEgg", "PanelShop", "PanelAreas", "PanelRebirth", "PanelQuests", "PanelRanks", "PanelSell", "PanelEquip", "PanelDonate", "PanelAdmin" }) do
	require(script[name]).Init(C)
end

C.SweatAura = require(script.SweatAura)
C.SweatAura.Init()
require(script.TrainingController).Init(C)
require(script.World).Init(C)
require(script.LightingController).Init(C)
require(script.Events).Init(C)
require(script.Leaderboard).Init(C)

-- everything is listening now: ask the server to (re)send our data
C.Remotes.Get("ClientReady"):FireServer()

print("[+1 Gym Game] Client ready")
</ProtectedString>
        </Properties>
<Item class="ModuleScript" referent="NEWMOD6"><Properties><string name="Name">PoseDriver</string><ProtectedString name="Source">--[[
	PoseDriver - plays code-driven poses on a character's Motor6D joints.

	Roblox's Animator rewrites Motor6D.Transform every frame, so tweening Transform with
	TweenService is erased before the frame is drawn (that is why the old punch / deadlift
	poses barely showed). This driver blends the pose itself and writes Transform in
	PreSimulation - after the Animator - so the pose is what actually renders.

	local d = PoseDriver.new(joints)        -- { RS = motor, LS = motor, ... }
	d:To({ RS = CFrame, ... }, 0.15)        -- blend to a pose (missing joints -&gt; neutral)
	d:SetLive(function(dt) return pose end) -- or drive a pose every frame (running, bouncing)
	d:Destroy()                             -- stop and give the joints back to the Animator
]]
local RunService = game:GetService("RunService")

local PoseDriver = {}
PoseDriver.__index = PoseDriver

local active = {}
local connection

local function ease(t)
	return t &lt; 0.5 and 2 * t * t or 1 - (-2 * t + 2) ^ 2 / 2
end

local function step(dt)
	for driver in pairs(active) do
		local live = driver.Live and driver.Live(dt)
		for name, motor in pairs(driver.Joints) do
			if motor.Parent then
				local cf
				if live then
					cf = live[name] or CFrame.new()
				else
					local b = driver.Blend[name]
					if b then
						b.T = math.min(1, b.T + dt / b.D)
						cf = b.From:Lerp(b.To, ease(b.T))
						driver.Current[name] = cf
					else
						cf = driver.Current[name] or CFrame.new()
					end
				end
				if driver.Extra then
					local extra = driver.Extra(name)
					if extra then
						cf = cf * extra
					end
				end
				motor.Transform = cf
			end
		end
	end
end

function PoseDriver.new(joints)
	local self = setmetatable({ Joints = {}, Current = {}, Blend = {} }, PoseDriver)
	for name, motor in pairs(joints or {}) do
		if motor then
			self.Joints[name] = motor
		end
	end
	active[self] = true
	if not connection then
		connection = RunService.PreSimulation:Connect(step)
	end
	return self
end

function PoseDriver:To(pose, duration)
	self.Live = nil
	for name in pairs(self.Joints) do
		local from = self.Current[name] or CFrame.new()
		self.Blend[name] = { From = from, To = pose[name] or CFrame.new(), T = 0, D = math.max(duration or 0.1, 0.01) }
	end
end

function PoseDriver:SetLive(fn)
	self.Live = fn
end

function PoseDriver:Destroy()
	active[self] = nil
	for _, motor in pairs(self.Joints) do
		if motor.Parent then
			motor.Transform = CFrame.new()
		end
	end
	if next(active) == nil and connection then
		connection:Disconnect()
		connection = nil
	end
end

return PoseDriver
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="NEWMOD5"><Properties><string name="Name">PanelDonate</string><ProtectedString name="Source">--[[
	PanelDonate - the Robux donation shop (the "Shop" button), in the admin-panel style.
	  * PERKS: permanent extras (the Auto Clicker)
	  * SUPPORT THE GAME: tips
	Buying opens Roblox's own purchase prompt; the SERVER grants the item in
	DonationService (ProcessReceipt). Items come from Config.Donations.
]]
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local PanelDonate = {}

local C, UIKit, Store, Config, Format
local panel
local ROBUX_GREEN = Color3.fromRGB(52, 184, 84)

local function buy(item)
	if not item.ProductId or item.ProductId &lt;= 0 then
		C.HUD.Toast(item.Name .. " isn't on sale yet - check back soon!", "Info")
		C.Sfx.Play("Error")
		return
	end
	local ok = pcall(function()
		MarketplaceService:PromptProductPurchase(Players.LocalPlayer, item.ProductId)
	end)
	if not ok then
		C.HUD.Toast("Purchases aren't available right now.", "Error")
	end
end

local function clear()
	for _, child in ipairs(panel.Content:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function itemCard(row, item, owned, width)
	local card = UIKit.Card({ Name = item.Id, Top = Color3.fromRGB(44, 64, 124), Bottom = Color3.fromRGB(26, 36, 78), Size = UDim2.fromOffset(width, 150),
		Radius = 14, OutlineThickness = 3, Rim = owned and UIKit.C.Good or UIKit.C.NavyEdge, ZIndex = 24, Parent = row })
	UIKit.Icon({ Icon = item.Icon, Emoji = item.Emoji, Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(8, 8), ZIndex = 25, Parent = card })
	UIKit.Text({ Text = item.Name, TextSize = 19, Size = UDim2.new(1, -72, 0, 24), Position = UDim2.fromOffset(66, 10), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.2, ZIndex = 25, Parent = card })
	UIKit.Text({ Text = item.Desc or "", TextSize = 13, Color = UIKit.C.Muted, Wrap = true, Size = UDim2.new(1, -72, 0, 50), Position = UDim2.fromOffset(66, 34),
		XAlign = Enum.TextXAlignment.Left, YAlign = Enum.TextYAlignment.Top, StrokeThickness = 1.2, ZIndex = 25, Parent = card })
	local b = UIKit.Button({ Name = "Buy", Text = owned and "OWNED" or ("R$ " .. item.Robux), Color = owned and UIKit.C.Gray or ROBUX_GREEN, TextSize = 20, Gloss = true,
		Size = UDim2.new(1, -16, 0, 44), Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), Radius = 12, ZIndex = 25, Parent = card,
		OnClick = function()
			if not owned then
				buy(item)
			end
		end })
	if owned then
		UIKit.SetDisabled(b, true, Color3.fromRGB(58, 120, 72))
	end
	return card
end

local function refresh()
	if not panel then
		return
	end
	clear()
	local perks = Store.State.Perks or {}
	local order = 0
	local function nextOrder()
		order = order + 1
		return order
	end
	local s = UIKit.Section(panel.Content, "PERKS  (FOREVER)", { Icon = "UPG_AutoTrain", Emoji = "🖱️", LayoutOrder = nextOrder() })
	local row
	local count = 0
	for _, item in ipairs(Config.Donations.Items) do
		if item.Kind == "Perk" then
			if count % 2 == 0 then
				row = s.Row(150)
			end
			count = count + 1
			itemCard(row, item, perks[item.Perk] == true, 300)
		end
	end
	local s2 = UIKit.Section(panel.Content, "SUPPORT THE GAME  ❤️", { Icon = "Money", Emoji = "💵", LayoutOrder = nextOrder(),
		Top = Color3.fromRGB(255, 130, 170), Bottom = Color3.fromRGB(214, 52, 104) })
	count = 0
	for _, item in ipairs(Config.Donations.Items) do
		if item.Kind == "Tip" then
			if count % 3 == 0 then
				row = s2.Row(150)
			end
			count = count + 1
			itemCard(row, item, false, 196)
		end
	end
	local donated = Store.State.Donated or 0
	local r = s2.Row(26)
	UIKit.Text({ Text = donated &gt; 0 and ("You've donated R$ " .. Format.Commas(donated) .. " - thank you! ❤️") or "Every Robux helps us add new gyms, pets and machines!",
		TextSize = 15, Color = UIKit.C.Muted, Size = UDim2.new(1, 0, 1, 0), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, ZIndex = 24, Parent = r })
end

function PanelDonate.Init(client)
	C = client
	UIKit, Store, Config, Format = C.UIKit, C.Store, C.Config, C.Format
	panel = UIKit.GoldPanel(C.Root, "Donate", "SHOP", Vector2.new(700, 540), { Icon = "Shop", Emoji = "🛒" })
	panel.OnOpen = refresh
	Store.StateChanged:Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
end

return PanelDonate
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="NEWMOD4"><Properties><string name="Name">PanelAdmin</string><ProtectedString name="Source">--[[
	PanelAdmin - the admin panel (CLIENT side): UI, input and display ONLY.

	  * Nothing in here changes game data. Every button sends a request through the two
	    admin remotes (AdminGetState / AdminAction) and shows the server's answer.
	  * The SERVER (AdminService) checks admin rights on every single request, validates
	    every value against Config and makes the change through the owning service.
	  * The panel (and the orange admin button) is only built after the server confirmed
	    that this player is an admin - that is cosmetic, not security.

	Layout (900 x 560, inside the scaled 1180 x 660 canvas):
	  header  : ADMIN PANEL logo, selected player, refresh, close
	  left    : searchable player list
	  right   : 9 tabs (Dashboard, Stats, Progression, Pets, Quests, Player, Moderation,
	            Server, Logs) above a scrolling content area
]]
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local PanelAdmin = {}

local C, UIKit, Config, Format, Remotes, IconLoader
local panel
local access -- what the server told us about our rank (Level, LevelName, BanPresets ...)
local ui = { TabButtons = {}, Selects = {} }
local state = {
	Players = {},
	Selected = nil,
	Detail = nil,
	DetailError = nil,
	Tab = "Dashboard",
	Search = "",
	Busy = false,
	Loading = false,
	ServerInfo = nil,
	Logs = nil,
	LogFilter = {},
	PetFilter = { Rarity = "All", Area = "All", Page = 1 },
	Give = { Area = nil, Rarity = nil },
	Announce = "Info",
	TeleportArea = nil,
	BanLookup = nil,
	Drafts = {}, -- text typed into the boxes survives re-renders
}

-- true while a player tab is rendered: edit buttons are disabled for protected players
local TABS_NEED_EDIT = false

local W, H = 900, 560
local LIST_W = 206
local GOLD_TOP, GOLD_BOTTOM = Color3.fromRGB(255, 212, 72), Color3.fromRGB(242, 128, 20)
local SECTION_TOP, SECTION_BOTTOM = Color3.fromRGB(32, 48, 98), Color3.fromRGB(18, 27, 60)
local COL -- colour roles, filled in Init (orange = admin, blue = neutral, green = grant, red = remove, purple = special)

local TABS = {
	{ Key = "Dashboard", Label = "DASHBOARD", Icon = "AdminShield", Emoji = "🛡️", NeedsPlayer = true },
	{ Key = "Stats", Label = "STATS", Icon = "Strength", Emoji = "💪", NeedsPlayer = true },
	{ Key = "Progression", Label = "PROGRESS", Icon = "GymMap", Emoji = "🗺️", NeedsPlayer = true },
	{ Key = "Pets", Label = "PETS", Icon = "Pets", Emoji = "🐾", NeedsPlayer = true },
	{ Key = "Quests", Label = "QUESTS", Icon = "Quests", Emoji = "📋", NeedsPlayer = true },
	{ Key = "Player", Label = "PLAYER", Icon = "AdmPlayer", Emoji = "🧍", NeedsPlayer = true },
	{ Key = "Moderation", Label = "MODERATION", Icon = "AdmHammer", Emoji = "🔨", NeedsPlayer = false },
	{ Key = "Server", Label = "SERVER", Icon = "AdmServer", Emoji = "🖥️", NeedsPlayer = false },
	{ Key = "Logs", Label = "LOGS", Icon = "AdmLogs", Emoji = "📜", NeedsPlayer = false },
}
local QUICK_ADDS = { { "+1K", 1e3 }, { "+10K", 1e4 }, { "+1M", 1e6 }, { "+1B", 1e9 }, { "+1T", 1e12 } }
local PETS_PER_PAGE = 18

----------------------------------------------------------------------
-- small helpers
----------------------------------------------------------------------
local layoutCounter = 0
local function nextOrder()
	layoutCounter = layoutCounter + 1
	return layoutCounter
end

local function clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- exact value for detail views: 1,234,567 (or 1.234568e+20 for huge numbers)
local function exact(n)
	if type(n) ~= "number" then
		return "-"
	end
	if math.abs(n) &gt;= 1e15 then
		return string.format("%.6e", n)
	end
	local whole = Format.Commas(n)
	local frac = n - math.floor(n)
	if frac &gt; 0.0001 then
		return whole .. string.sub(string.format("%.2f", frac), 2)
	end
	return whole
end

local function duration(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local d = math.floor(seconds / 86400)
	local h = math.floor((seconds % 86400) / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if d &gt; 0 then
		return string.format("%dd %02dh %02dm", d, h, m)
	end
	return string.format("%02d:%02d:%02d", h, m, s)
end

-- "14s", "3m 20s", "2h 5m"
local function ago(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	if seconds &lt; 60 then
		return seconds .. "s"
	elseif seconds &lt; 3600 then
		return math.floor(seconds / 60) .. "m " .. (seconds % 60) .. "s"
	end
	return math.floor(seconds / 3600) .. "h " .. math.floor((seconds % 3600) / 60) .. "m"
end

local function clockText(t)
	local ok, text = pcall(os.date, "%H:%M:%S", t)
	return ok and text or tostring(t)
end

local function dateText(t)
	local ok, text = pcall(os.date, "%Y-%m-%d %H:%M", t)
	return ok and text or tostring(t)
end

local function areaName(id)
	local a = Config.AreasById[id]
	return a and a.Name or tostring(id)
end

local function avatar(parent, userId, size, zIndex)
	local img = Instance.new("ImageLabel")
	img.Name = "Avatar"
	img.BackgroundColor3 = Color3.fromRGB(16, 22, 44)
	img.BorderSizePixel = 0
	img.Size = UDim2.fromOffset(size, size)
	img.Image = "rbxthumb://type=AvatarHeadShot&amp;id=" .. tostring(userId) .. "&amp;w=150&amp;h=150"
	img.ZIndex = zIndex
	UIKit.Corner(img, size)
	img:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
	UIKit.Stroke(img, UIKit.C.Outline, 2.5)
	img.Parent = parent
	return img
end

----------------------------------------------------------------------
-- talking to the server (read-only state + one action at a time)
----------------------------------------------------------------------
local function getState(kind, arg)
	local ok, result = pcall(function()
		return Remotes.Get("AdminGetState"):InvokeServer(kind, arg)
	end)
	if not ok or type(result) ~= "table" then
		return nil, "No answer from the server."
	end
	if not result.Ok then
		return nil, result.Message or "Request failed."
	end
	return result.Data
end

local render -- forward declarations
local refresh

-- our own toasts: the HUD's toasts sit underneath open panels
local function toast(text, kind)
	if not ui.Toasts or not panel or not panel.IsOpen then
		C.HUD.Toast(text, kind)
		return
	end
	local color = kind == "Error" and COL.Red or (kind == "Success" and COL.Green or COL.Blue)
	local list = ui.Toasts:GetChildren()
	local count = 0
	for _, child in ipairs(list) do
		if child:IsA("GuiObject") then
			count = count + 1
		end
	end
	if count &gt;= 3 then
		for _, child in ipairs(list) do
			if child:IsA("GuiObject") then
				child:Destroy()
				break
			end
		end
	end
	local t = UIKit.Card({ Name = "Toast", Top = UIKit.Shade(color, 1.1), Bottom = UIKit.Shade(color, 0.72), Size = UDim2.fromOffset(560, 40), Radius = 14,
		OutlineThickness = 3, Rim = UIKit.Shade(color, 1.45), ZIndex = 80, LayoutOrder = nextOrder(), Parent = ui.Toasts })
	UIKit.Text({ Text = text, TextSize = 17, Wrap = true, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), StrokeThickness = 2, ZIndex = 81, Parent = t })
	local scale = UIKit.Scale(t, 0.7)
	UIKit.Tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(3.4, function()
		if t.Parent then
			UIKit.Tween(scale, 0.16, { Scale = 0 })
			task.delay(0.18, function()
				t:Destroy()
			end)
		end
	end)
end

local function setBusy(busy)
	state.Busy = busy
	if ui.Busy then
		ui.Busy.Visible = busy
	end
end

-- Sends ONE admin action. The server validates and performs it; we show its answer and
-- re-fetch the data. opts.Target = a UserId (default: the selected player, 0 = server-wide).
local function act(action, args, opts)
	opts = opts or {}
	if state.Busy then
		toast("Still working on the last request...", "Info")
		return
	end
	local target = opts.Target
	if target == nil then
		target = state.Selected
	end
	if target == nil then
		toast("Pick a player first.", "Error")
		return
	end
	setBusy(true)
	local ok, result = pcall(function()
		return Remotes.Get("AdminAction"):InvokeServer(action, target, args or {})
	end)
	setBusy(false)
	if not ok or type(result) ~= "table" then
		toast("No answer from the server.", "Error")
		C.Sfx.Play("Error")
		return
	end
	toast(result.Message or (result.Ok and "Done." or "That didn't work."), result.Ok and "Success" or "Error")
	C.Sfx.Play(result.Ok and "Buy" or "Error")
	if opts.After then
		opts.After(result)
	end
	refresh()
	return result
end

-- confirmation modal first (Confirm = the value the server expects in args.Confirm)
local function confirmAct(action, args, modal, opts)
	UIKit.Confirm({
		Title = modal.Title,
		Message = modal.Message,
		ConfirmText = modal.ConfirmText or "CONFIRM",
		ConfirmColor = modal.Color or COL.Red,
		TypeToConfirm = modal.TypeToConfirm,
		HeaderTop = modal.HeaderTop,
		HeaderBottom = modal.HeaderBottom,
		OnConfirm = function()
			args = args or {}
			args.Confirm = modal.TypeToConfirm or true
			act(action, args, opts)
		end,
	})
end

local function numberFrom(box)
	local n = UIKit.ParseNumber(box.Text)
	if not n then
		toast("Type a number first (e.g. 250, 1.5K, 20M, 3e9).", "Error")
		C.Sfx.Play("Error")
	end
	return n
end

----------------------------------------------------------------------
-- content building blocks
----------------------------------------------------------------------
-- A section card with a gold title strip. s.Row(h) returns the next row frame.
local function section(title, icon, emoji, headerTop, headerBottom)
	local card = UIKit.Card({ Name = "Section", Top = SECTION_TOP, Bottom = SECTION_BOTTOM, Size = UDim2.new(1, -14, 0, 50), Radius = 16,
		OutlineThickness = 3, Rim = UIKit.C.NavyEdge, LayoutOrder = nextOrder(), ZIndex = 22, Parent = ui.Content })
	local strip = UIKit.Card({ Name = "Title", Top = headerTop or GOLD_TOP, Bottom = headerBottom or GOLD_BOTTOM, Size = UDim2.new(1, -12, 0, 30),
		Position = UDim2.fromOffset(6, 6), Radius = 12, OutlineThickness = 2, Rim = Color3.fromRGB(255, 236, 150), Shine = true, ZIndex = 23, Parent = card })
	strip:FindFirstChild("Rim"):FindFirstChildOfClass("UIStroke").Transparency = 0.35
	local x = 10
	if icon or emoji then
		UIKit.Icon({ Icon = icon, Emoji = emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 24, Parent = strip })
		x = 42
	end
	UIKit.Text({ Text = title, TextSize = 18, Size = UDim2.new(1, -x - 10, 1, 0), Position = UDim2.fromOffset(x, 0), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.4, ZIndex = 24, Parent = strip })
	local s = { Card = card, Strip = strip, Y = 44 }
	function s.Row(height, noList)
		local row = UIKit.Frame({ Name = "Row", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -24, 0, height), Position = UDim2.fromOffset(12, s.Y),
			ZIndex = 23, Parent = card })
		if not noList then
			UIKit.List(row, 8, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		end
		s.Y = s.Y + height + 8
		card.Size = UDim2.new(1, -14, 0, s.Y + 4)
		return row
	end
	return s
end

-- chunky button; disabled automatically when the selected player is protected (unless Safe)
local function button(parent, text, color, width, onClick, opts)
	opts = opts or {}
	local b = UIKit.Button({ Name = opts.Name or "Button", Text = text, Color = color, TextSize = opts.TextSize or 15, Size = UDim2.fromOffset(width, opts.Height or 34),
		Gloss = true, Radius = 10, ZIndex = 24, LayoutOrder = nextOrder(), Tooltip = opts.Tooltip, Icon = opts.Icon, Emoji = opts.Emoji,
		IconSize = opts.IconSize, Position = opts.Position, AnchorPoint = opts.AnchorPoint, Parent = parent, OnClick = onClick })
	local readOnly = not opts.Safe and state.Detail and state.Detail.CanEdit == false and TABS_NEED_EDIT
	if opts.Disabled or readOnly then
		UIKit.SetDisabled(b, true)
	end
	return b
end

local function input(parent, key, placeholder, width, onEnter, opts)
	opts = opts or {}
	local box = UIKit.Input({ Name = key, Placeholder = placeholder, Text = state.Drafts[key] or "", Size = UDim2.fromOffset(width, opts.Height or 34), TextSize = 16,
		ZIndex = 24, LayoutOrder = nextOrder(), Parent = parent, OnEnter = onEnter })
	box:GetPropertyChangedSignal("Text"):Connect(function()
		state.Drafts[key] = box.Text
	end)
	return box
end

local function label(parent, text, width, opts)
	opts = opts or {}
	local l = UIKit.Text({ Name = opts.Name or "Label", Text = text, TextSize = opts.TextSize or 15, Color = opts.Color or UIKit.C.Text, Size = UDim2.new(0, width, 1, 0),
		XAlign = opts.XAlign or Enum.TextXAlignment.Left, Wrap = opts.Wrap, Rich = opts.Rich, StrokeThickness = opts.StrokeThickness or 1.8, LayoutOrder = nextOrder(),
		ZIndex = 24, Parent = parent })
	l.TextTruncate = Enum.TextTruncate.AtEnd
	return l
end

local function chip(parent, text, color, opts)
	opts = opts or {}
	local c, l = UIKit.Chip({ Name = "Chip", Text = text, Color = color, TextColor = opts.TextColor, TextSize = opts.TextSize or 13, Icon = opts.Icon, Emoji = opts.Emoji,
		IconSize = opts.IconSize, Size = UDim2.fromOffset(10, opts.Height or 24), AutoWidth = true, LayoutOrder = nextOrder(), ZIndex = 24, Parent = parent })
	return c, l
end

-- stat tile: logo + small label + big value + exact value
local function tile(parent, width, opts)
	local t = UIKit.Card({ Name = "Tile", Top = opts.Top or Color3.fromRGB(44, 64, 124), Bottom = opts.Bottom or Color3.fromRGB(26, 36, 78),
		Size = UDim2.fromOffset(width, opts.Height or 70), Radius = 12, OutlineThickness = 2, LayoutOrder = nextOrder(), ZIndex = 24, Parent = parent })
	local x = 8
	if opts.Icon or opts.Emoji then
		UIKit.Icon({ Icon = opts.Icon, Emoji = opts.Emoji, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 6, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 25, Parent = t })
		x = 44
	end
	UIKit.Text({ Text = opts.Label, TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.new(1, -x - 6, 0, 16), Position = UDim2.fromOffset(x, 5),
		XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.2, ZIndex = 25, Parent = t })
	local v = UIKit.Text({ Text = opts.Value, TextSize = opts.ValueSize or 20, Color = opts.Color or UIKit.C.Text, Size = UDim2.new(1, -x - 6, 0, 24),
		Position = UDim2.fromOffset(x, 21), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 2.2, ZIndex = 25, Parent = t })
	v.TextTruncate = Enum.TextTruncate.AtEnd
	if opts.Sub then
		local s = UIKit.Text({ Text = opts.Sub, TextSize = 11, Color = UIKit.C.Muted, Size = UDim2.new(1, -x - 6, 0, 14), Position = UDim2.fromOffset(x, 47),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 25, Parent = t })
		s.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return t
end

local function select(parent, options, value, width, onChange)
	local s = UIKit.Select({ Options = options, Value = value, Size = UDim2.fromOffset(width, 34), TextSize = 15, ZIndex = 24, LayoutOrder = nextOrder(),
		Parent = parent, OnChange = onChange })
	table.insert(ui.Selects, s)
	return s
end

local function areaOptions(withAll)
	local list = {}
	if withAll then
		list[1] = { Value = "All", Text = "All gyms" }
	end
	for _, a in ipairs(Config.Areas) do
		list[#list + 1] = { Value = a.Id, Text = a.Icon .. " " .. a.Name }
	end
	return list
end

local function rarityOptions(withAll)
	local list = {}
	if withAll then
		list[1] = { Value = "All", Text = "All rarities" }
	end
	for _, r in ipairs(Config.RarityOrder) do
		list[#list + 1] = { Value = r, Text = Config.Rarities[r].Label }
	end
	return list
end

local function notice(text, color)
	local s = UIKit.Frame({ Name = "Notice", Color = UIKit.Shade(color or COL.Red, 0.45), Size = UDim2.new(1, -14, 0, 40), Radius = 12, Stroke = color or COL.Red,
		StrokeThickness = 2, LayoutOrder = nextOrder(), ZIndex = 22, Parent = ui.Content })
	UIKit.Text({ Text = text, TextSize = 15, Wrap = true, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), StrokeThickness = 1.8, ZIndex = 23, Parent = s })
	return s
end

----------------------------------------------------------------------
-- TABS
----------------------------------------------------------------------
local BUILD = {}

-- Dashboard ---------------------------------------------------------------
function BUILD.Dashboard(d)
	local s = section("PLAYER", "AdmPlayer", "🧍")
	local row = s.Row(80, true)
	avatar(row, d.UserId, 72, 24).Position = UDim2.fromOffset(0, 4)
	UIKit.Text({ Text = d.DisplayName, TextSize = 26, Size = UDim2.new(1, -90, 0, 30), Position = UDim2.fromOffset(84, 2), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.8, ZIndex = 24, Parent = row })
	UIKit.Text({ Text = "@" .. d.Name .. "   ·   UserId " .. d.UserId .. "   ·   account " .. Format.Commas(d.AccountAge or 0) .. " days old", TextSize = 14,
		Color = UIKit.C.Muted, Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(84, 32), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4,
		ZIndex = 24, Parent = row })
	local chips = UIKit.Frame({ Name = "Chips", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -90, 0, 24), Position = UDim2.fromOffset(84, 54),
		ZIndex = 24, Parent = row })
	UIKit.List(chips, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	chip(chips, string.upper(d.LevelName or "Player"), d.Level &gt; 0 and COL.Gold or UIKit.C.NavyLight, { Icon = d.Level &gt; 0 and "AdminShield" or nil, IconSize = 18 })
	if d.IsYou then
		chip(chips, "YOU", COL.Blue)
	end
	if d.CanEdit == false then
		chip(chips, "PROTECTED", COL.Red)
	end

	local st = d.Status or {}
	local status = s.Row(26)
	chip(status, st.Loaded and "PROFILE LOADED" or "LOADING...", st.Loaded and COL.Green or UIKit.C.Gray)
	if st.NoSave then
		chip(status, "NO SAVE (TEMPORARY DATA)", COL.Red)
	elseif st.Saving then
		chip(status, "SAVING...", COL.Blue)
	elseif st.LastSaveAgo then
		chip(status, "SAVED " .. string.upper(ago(st.LastSaveAgo)) .. " AGO", COL.Blue)
	else
		chip(status, "NOT SAVED YET", UIKit.C.Gray)
	end
	chip(status, d.Alive and ("ALIVE  " .. d.Health .. "/" .. d.MaxHealth) or "DEAD / RESPAWNING", d.Alive and COL.Green or COL.Red)
	local station = d.Training and Config.StationsById[d.Training]
	chip(status, station and ("TRAINING: " .. string.upper(station.Name)) or "NOT TRAINING", station and COL.Purple or UIKit.C.Gray)
	if d.Frozen then
		chip(status, "FROZEN", Color3.fromRGB(60, 190, 230))
	end

	local s2 = section("STATS", "Strength", "💪")
	local w = 142
	local r1 = s2.Row(70)
	tile(r1, w, { Label = "STRENGTH", Icon = "Strength", Emoji = "💪", Value = Format.Number(d.Strength or 0), Sub = exact(d.Strength), Color = UIKit.C.Strength })
	tile(r1, w, { Label = "TOTAL STRENGTH", Icon = "Strength", Emoji = "📈", Value = Format.Number(d.TotalStrength or 0), Sub = exact(d.TotalStrength), Color = Color3.fromRGB(120, 230, 140) })
	tile(r1, w, { Label = "COINS", Icon = "Money", Emoji = "💵", Value = Format.Number(d.Coins or 0), Sub = exact(d.Coins), Color = UIKit.C.Coins })
	tile(r1, w, { Label = "REBIRTHS", Icon = "RebirthStar", Emoji = "⭐", Value = tostring(d.Rebirths or 0) .. " / " .. Config.Game.MaxRebirths,
		Sub = "boost " .. Format.Mult(d.RebirthMult or 1), Color = Color3.fromRGB(210, 160, 255) })
	local r2 = s2.Row(58)
	for _, m in ipairs({ { "STRENGTH MULT", d.StrengthMult, UIKit.C.Strength }, { "COIN MULT", d.CoinMult, UIKit.C.Coins }, { "PET MULT", d.PetMult, UIKit.C.Mult },
		{ "REBIRTH MULT", d.RebirthMult, Color3.fromRGB(210, 160, 255) } }) do
		tile(r2, w, { Label = m[1], Value = Format.Mult(m[2] or 1), Color = m[3], Height = 58 })
	end

	local s3 = section("PROGRESS", "GymMap", "🗺️", Color3.fromRGB(150, 110, 255), Color3.fromRGB(96, 56, 214))
	local gyms, stations, pets = 0, 0, #(d.Pets or {})
	for _ in pairs(d.Areas or {}) do gyms = gyms + 1 end
	for _ in pairs(d.Stations or {}) do stations = stations + 1 end
	local r3 = s3.Row(58)
	tile(r3, w, { Label = "CURRENT GYM", Value = d.CurrentGym or "-", ValueSize = 16, Height = 58 })
	tile(r3, w, { Label = "GYMS UNLOCKED", Value = gyms .. " / " .. #Config.Areas, Height = 58 })
	tile(r3, w, { Label = "EQUIPMENT", Value = stations .. " / " .. #Config.Stations, Height = 58 })
	tile(r3, w, { Label = "PETS", Value = pets .. " / " .. Config.Game.MaxPetsOwned, Height = 58 })
	local r4 = s3.Row(58)
	tile(r4, w, { Label = "EQUIPPED PETS", Value = #(d.Equipped or {}) .. " / " .. (d.Slots or Config.Game.BasePetSlots), Height = 58 })
	local q = d.Quest
	tile(r4, w, { Label = "QUEST", Value = q and ("#" .. q.Index .. "  " .. Format.Number(q.Progress) .. "/" .. Format.Number(q.Goal)) or "-", ValueSize = 16, Height = 58 })
	tile(r4, w, { Label = "DONATED", Value = "R$ " .. Format.Commas(d.Donated or 0), Height = 58 })
	tile(r4, w, { Label = "LIFETIME REPS", Value = Format.Number(d.Stats and d.Stats.Reps or 0), Height = 58 })

	local s4 = section("QUICK ACTIONS", "AdminShield", "🛡️")
	local r5 = s4.Row(38)
	button(r5, "REFRESH", COL.Blue, 130, function() refresh(true) end, { Safe = true, Tooltip = "Fetch fresh data from the server" })
	button(r5, "SAVE PLAYER", COL.Green, 150, function() act("SavePlayer") end, { Safe = true, Tooltip = "Save this player's data to the DataStore now" })
	button(r5, "FORCE SYNC", COL.Gold, 140, function() act("ForceSync") end, { Safe = true, Tooltip = "Re-send stats, pets and progress to their client" })
end

-- Stats ------------------------------------------------------------------
local function numberStat(field, title, icon, emoji, color)
	local d = state.Detail
	local s = section(title, icon, emoji)
	local r1 = s.Row(40)
	local value = d[field] or 0
	local l = label(r1, Format.Number(value), 150, { TextSize = 26, Color = color, StrokeThickness = 2.6 })
	l.Size = UDim2.new(0, 150, 1, 0)
	label(r1, exact(value), 170, { TextSize = 13, Color = UIKit.C.Muted })
	local box = input(r1, "Set" .. field, "new value", 150)
	button(r1, "SET", COL.Gold, 80, function()
		local n = numberFrom(box)
		if n then act("Set" .. field, { Value = n }) end
	end, { Tooltip = "Set " .. title .. " to exactly this value" })
	local r2 = s.Row(34)
	for _, q in ipairs(QUICK_ADDS) do
		button(r2, q[1], COL.Green, 70, function() act("Add" .. field, { Amount = q[2] }) end, { TextSize = 15 })
	end
	local r3 = s.Row(34)
	local amount = input(r3, "Add" .. field, "amount (e.g. 2.5M)", 190)
	button(r3, "ADD", COL.Green, 90, function()
		local n = numberFrom(amount)
		if n then act("Add" .. field, { Amount = math.abs(n) }) end
	end)
	button(r3, "SUBTRACT", COL.Red, 120, function()
		local n = numberFrom(amount)
		if n then act("Add" .. field, { Amount = -math.abs(n) }) end
	end)
end

function BUILD.Stats(d)
	numberStat("Strength", "STRENGTH", "Strength", "💪", UIKit.C.Strength)
	numberStat("TotalStrength", "TOTAL STRENGTH (ALL-TIME)", "Strength", "📈", Color3.fromRGB(120, 230, 140))
	numberStat("Coins", "COINS", "Money", "💵", UIKit.C.Coins)

	local s = section("REBIRTHS", "RebirthStar", "⭐", Color3.fromRGB(190, 130, 255), Color3.fromRGB(120, 60, 220))
	local r1 = s.Row(40)
	label(r1, (d.Rebirths or 0) .. " / " .. Config.Game.MaxRebirths, 150, { TextSize = 26, Color = Color3.fromRGB(215, 170, 255), StrokeThickness = 2.6 })
	label(r1, "rebirth boost " .. Format.Mult(d.RebirthMult or 1) .. "  ·  strength " .. Format.Mult(d.StrengthMult or 1), 170, { TextSize = 13, Color = UIKit.C.Muted })
	local box = input(r1, "SetRebirths", "0 - " .. Config.Game.MaxRebirths, 150)
	button(r1, "SET", COL.Gold, 80, function()
		local n = numberFrom(box)
		if n then act("SetRebirths", { Value = n }) end
	end)
	local r2 = s.Row(34)
	button(r2, "-1", COL.Red, 70, function() act("AddRebirths", { Amount = -1 }) end, { Disabled = (d.Rebirths or 0) &lt;= 0 })
	button(r2, "+1", COL.Green, 70, function() act("AddRebirths", { Amount = 1 }) end, { Disabled = (d.Rebirths or 0) &gt;= Config.Game.MaxRebirths })
	button(r2, "MAX (" .. Config.Game.MaxRebirths .. ")", COL.Purple, 120, function() act("MaxRebirths") end, { Disabled = (d.Rebirths or 0) &gt;= Config.Game.MaxRebirths })
	label(r2, "Multipliers, name tag and body size update instantly.", 290, { TextSize = 12, Color = UIKit.C.Muted })
end

-- Progression ----------------------------------------------------------------
function BUILD.Progression(d)
	local areas = d.Areas or {}
	local stations = d.Stations or {}
	local unlocked = 0
	for _ in pairs(areas) do unlocked = unlocked + 1 end

	local s = section("GYMS  (" .. unlocked .. " / " .. #Config.Areas .. " UNLOCKED)", "GymMap", "🗺️")
	local top = s.Row(34)
	button(top, "UNLOCK ALL", COL.Green, 130, function() act("UnlockAllGyms") end, { Disabled = unlocked &gt;= #Config.Areas })
	button(top, "LOCK ALL", COL.Red, 110, function()
		confirmAct("LockAllGyms", {}, { Title = "Lock every gym?", Message = "Every gym except the " .. Config.Areas[1].Name .. " will be locked for "
			.. d.DisplayName .. ". Anyone inside a locked gym is sent back to the Beginner gym." })
	end, { Disabled = unlocked &lt;= 1 })
	label(top, "Teleport never enters a locked gym - use UNLOCK + TP.", 330, { TextSize = 12, Color = UIKit.C.Muted })
	for i, a in ipairs(Config.Areas) do
		local open = areas[a.Id] == true
		local r = s.Row(38)
		label(r, a.Icon, 28, { TextSize = 22, XAlign = Enum.TextXAlignment.Center })
		label(r, a.Name, 150, { TextSize = 16, Color = open and UIKit.C.Text or UIKit.C.Muted, StrokeThickness = 2 })
		local c = chip(r, i == 1 and "ALWAYS OPEN" or (open and "UNLOCKED" or "LOCKED"), open and COL.Green or UIKit.C.Gray, { TextSize = 12 })
		c.Size = UDim2.fromOffset(96, 24)
		c.AutomaticSize = Enum.AutomaticSize.None
		if i == 1 then
			button(r, "LOCK", COL.Gray, 76, function() end, { Disabled = true, Tooltip = "The Beginner gym is always unlocked" })
		elseif open then
			button(r, "LOCK", COL.Red, 76, function() act("LockGym", { AreaId = a.Id }) end)
		else
			button(r, "UNLOCK", COL.Green, 76, function() act("UnlockGym", { AreaId = a.Id }) end)
		end
		button(r, "TELEPORT", COL.Blue, 96, function() act("TeleportToGym", { AreaId = a.Id }) end, { Disabled = not open, Tooltip = open and nil or "Locked for this player" })
		button(r, "UNLOCK + TP", COL.Purple, 116, function() act("UnlockAndTeleport", { AreaId = a.Id }) end, { Disabled = open })
	end

	local owned = 0
	for _ in pairs(stations) do owned = owned + 1 end
	local s2 = section("EQUIPMENT  (" .. owned .. " / " .. #Config.Stations .. " OWNED)", "UPG_Power", "🏋️", Color3.fromRGB(150, 110, 255), Color3.fromRGB(96, 56, 214))
	local top2 = s2.Row(34)
	button(top2, "GRANT ALL", COL.Green, 130, function() act("GrantAllStations", {}) end, { Disabled = owned &gt;= #Config.Stations })
	button(top2, "REMOVE ALL", COL.Red, 130, function()
		confirmAct("RemoveAllStations", {}, { Title = "Remove all equipment?", Message = "Every machine except the starter equipment will be removed from "
			.. d.DisplayName .. "." })
	end, { Disabled = owned &lt;= 1 })
	label(top2, "Green = owned. Click a machine to grant / remove it.", 300, { TextSize = 12, Color = UIKit.C.Muted })
	local itemW = 190
	for _, a in ipairs(Config.Areas) do
		local head = s2.Row(26)
		label(head, a.Icon .. "  " .. string.upper(a.Name), 250, { TextSize = 15, Color = UIKit.C.Gold, StrokeThickness = 2 })
		button(head, "GRANT GYM", COL.Green, 110, function() act("GrantAllStations", { AreaId = a.Id }) end, { Height = 24, TextSize = 12 })
		button(head, "REMOVE GYM", COL.Red, 116, function() act("RemoveAllStations", { AreaId = a.Id, Confirm = true }) end, { Height = 24, TextSize = 12 })
		local r = s2.Row(36)
		for _, id in ipairs(a.StationIds) do
			local st = Config.StationsById[id]
			local has = stations[id] == true
			local starter = id == "Beginner_1"
			local tip = "Tier " .. st.Tier .. " · " .. ((Config.ExerciseNames and Config.ExerciseNames[st.Kind]) or st.Kind) .. " · +" .. Format.Number(st.Strength) .. " Strength"
			local b = button(r, st.Name, has and COL.Green or UIKit.C.NavyLight, itemW, function()
				act(has and "RemoveStation" or "GrantStation", { StationId = id })
			end, { TextSize = 13, Disabled = starter, Tooltip = starter and "Starter equipment - everyone keeps it" or tip })
			if starter then
				UIKit.SetButtonColor(b, Color3.fromRGB(58, 120, 72))
			end
		end
	end

	local s3 = section("UPGRADES", "UPG_Power", "⚡")
	for _, def in ipairs(Config.Upgrades) do
		local level = (d.Upgrades and d.Upgrades[def.Id]) or 0
		local r = s3.Row(40, true)
		UIKit.List(r, 6, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		UIKit.Icon({ Icon = "UPG_" .. def.Id, Emoji = def.Icon, Size = UDim2.fromOffset(36, 36), LayoutOrder = nextOrder(), ZIndex = 24, Parent = r })
		local info = UIKit.Frame({ Name = "Info", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(150, 38), LayoutOrder = nextOrder(), ZIndex = 24, Parent = r })
		UIKit.Text({ Text = def.Name, TextSize = 15, Size = UDim2.new(1, 0, 0, 20), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.8, ZIndex = 24, Parent = info })
		UIKit.Text({ Text = "LEVEL " .. level .. " / " .. def.Max, TextSize = 12, Color = level &gt;= def.Max and UIKit.C.Gold or UIKit.C.Muted, Size = UDim2.new(1, 0, 0, 16),
			Position = UDim2.fromOffset(0, 20), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.2, ZIndex = 24, Parent = info })
		button(r, "-", COL.Red, 38, function() act("StepUpgrade", { UpgradeId = def.Id, Delta = -1 }) end, { Disabled = level &lt;= 0, TextSize = 20 })
		button(r, "+", COL.Green, 38, function() act("StepUpgrade", { UpgradeId = def.Id, Delta = 1 }) end, { Disabled = level &gt;= def.Max, TextSize = 20 })
		local box = input(r, "Upg" .. def.Id, "0-" .. def.Max, 64)
		button(r, "SET", COL.Gold, 54, function()
			local n = numberFrom(box)
			if n then act("SetUpgrade", { UpgradeId = def.Id, Level = n }) end
		end)
		button(r, "MAX", COL.Purple, 58, function() act("MaxUpgrade", { UpgradeId = def.Id }) end, { Disabled = level &gt;= def.Max })
		button(r, "RESET", COL.Gray, 70, function() act("ResetUpgrade", { UpgradeId = def.Id }) end, { Disabled = level &lt;= 0 })
	end
	local rr = s3.Row(34)
	button(rr, "RESET ALL UPGRADES", COL.Red, 200, function()
		confirmAct("ResetAllUpgrades", {}, { Title = "Reset all upgrades?", Message = "Every upgrade of " .. d.DisplayName .. " goes back to level 0 (walk speed, pet slots and multipliers update)." })
	end)
end

-- Pets ---------------------------------------------------------------------
local function petDef(areaId, rarity)
	for _, p in ipairs(Config.Pets) do
		if p.Area == areaId and p.Rarity == rarity then
			return p
		end
	end
end

function BUILD.Pets(d)
	local pets = d.Pets or {}
	state.Give.Area = state.Give.Area or Config.Areas[1].Id
	state.Give.Rarity = state.Give.Rarity or Config.RarityOrder[1]

	local s = section("GIVE PET", "LuckyBlock", "🎁")
	local r1 = s.Row(34)
	select(r1, areaOptions(false), state.Give.Area, 180, function(v) state.Give.Area = v render() end)
	select(r1, rarityOptions(false), state.Give.Rarity, 150, function(v) state.Give.Rarity = v render() end)
	local count = input(r1, "GiveCount", "count 1-" .. (access.MaxGivePets or 25), 110)
	local def = petDef(state.Give.Area, state.Give.Rarity)
	button(r1, "GIVE", COL.Green, 100, function()
		if not def then return end
		local n = 1
		if count.Text ~= "" then
			n = numberFrom(count)
			if not n then return end
		end
		act("GivePet", { PetId = def.Id, Count = n })
	end, { Disabled = def == nil or #pets &gt;= Config.Game.MaxPetsOwned })
	local r2 = s.Row(28)
	if def then
		local rarity = Config.Rarities[def.Rarity]
		label(r2, def.Emoji .. "  " .. def.Name, 220, { TextSize = 17 })
		chip(r2, rarity.Label, rarity.Color, { TextSize = 12 })
		label(r2, Format.Mult(def.Mult) .. " strength  ·  " .. areaName(def.Area), 240, { TextSize = 13, Color = UIKit.C.Muted })
	end

	local s2 = section("INVENTORY", "Pets", "🐾")
	local r3 = s2.Row(28)
	chip(r3, "PETS " .. #pets .. " / " .. Config.Game.MaxPetsOwned, #pets &gt;= Config.Game.MaxPetsOwned and COL.Red or UIKit.C.NavyLight, { TextSize = 14 })
	chip(r3, "EQUIPPED " .. #(d.Equipped or {}) .. " / " .. (d.Slots or Config.Game.BasePetSlots), UIKit.C.NavyLight, { TextSize = 14 })
	chip(r3, "PET MULT " .. Format.Mult(d.PetMult or 1), UIKit.C.NavyLight, { TextSize = 14, TextColor = UIKit.C.Mult })
	local r4 = s2.Row(34)
	button(r4, "EQUIP BEST", COL.Blue, 120, function() act("EquipBestPets") end, { Disabled = #pets == 0 })
	button(r4, "UNEQUIP ALL", COL.Blue, 126, function() act("UnequipAllPets") end, { Disabled = #(d.Equipped or {}) == 0 })
	button(r4, "DELETE UNLOCKED", COL.Red, 160, function()
		confirmAct("DeleteUnlockedPets", {}, { Title = "Delete unlocked pets?", Message = "Every pet of " .. d.DisplayName .. " that is not locked will be deleted. Locked pets stay." })
	end, { Disabled = #pets == 0 })
	button(r4, "CLEAR ALL", COL.Red, 110, function()
		confirmAct("ClearPets", {}, { Title = "Clear the whole inventory?", Message = "ALL " .. #pets .. " pets of " .. d.DisplayName .. " will be deleted - locked ones too." })
	end, { Disabled = #pets == 0 })

	-- filters
	local f = state.PetFilter
	local filtered = {}
	for _, p in ipairs(pets) do
		local pd = Config.PetsById[p.Id]
		if pd and (f.Rarity == "All" or pd.Rarity == f.Rarity) and (f.Area == "All" or pd.Area == f.Area) then
			filtered[#filtered + 1] = p
		end
	end
	table.sort(filtered, function(a, b)
		if a.Equipped ~= b.Equipped then return a.Equipped end
		local ma, mb = Config.PetsById[a.Id].Mult, Config.PetsById[b.Id].Mult
		if ma ~= mb then return ma &gt; mb end
		return tonumber(a.Uid) &lt; tonumber(b.Uid)
	end)
	local pages = math.max(1, math.ceil(#filtered / PETS_PER_PAGE))
	f.Page = math.clamp(f.Page, 1, pages)
	local r5 = s2.Row(34)
	select(r5, rarityOptions(true), f.Rarity, 150, function(v) f.Rarity = v f.Page = 1 render() end)
	select(r5, areaOptions(true), f.Area, 170, function(v) f.Area = v f.Page = 1 render() end)
	button(r5, "&lt;", COL.Blue, 38, function() f.Page = f.Page - 1 render() end, { Safe = true, Disabled = f.Page &lt;= 1 })
	label(r5, "PAGE " .. f.Page .. " / " .. pages, 90, { TextSize = 14, XAlign = Enum.TextXAlignment.Center })
	button(r5, "&gt;", COL.Blue, 38, function() f.Page = f.Page + 1 render() end, { Safe = true, Disabled = f.Page &gt;= pages })

	if #filtered == 0 then
		local r = s2.Row(40)
		label(r, #pets == 0 and "This player has no pets." or "No pets match these filters.", 400, { TextSize = 16, Color = UIKit.C.Muted })
		return
	end
	local cardW = 190
	local row
	local first = (f.Page - 1) * PETS_PER_PAGE + 1
	for i = first, math.min(#filtered, first + PETS_PER_PAGE - 1) do
		if (i - first) % 3 == 0 then
			row = s2.Row(104)
		end
		local p = filtered[i]
		local pd = Config.PetsById[p.Id]
		local rarity = Config.Rarities[pd.Rarity]
		local card = UIKit.Card({ Name = "Pet", Top = p.Equipped and Color3.fromRGB(58, 110, 200) or Color3.fromRGB(40, 56, 108),
			Bottom = p.Equipped and Color3.fromRGB(30, 64, 150) or Color3.fromRGB(24, 32, 70), Size = UDim2.fromOffset(cardW, 104), Radius = 12,
			Outline = rarity.Color, OutlineThickness = 2, LayoutOrder = nextOrder(), ZIndex = 24, Parent = row })
		UIKit.Text({ Text = pd.Emoji, TextSize = 30, Stroke = false, Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(4, 4), ZIndex = 25, Parent = card })
		local name = UIKit.Text({ Text = pd.Name, TextSize = 15, Size = UDim2.new(1, -50, 0, 18), Position = UDim2.fromOffset(46, 4), XAlign = Enum.TextXAlignment.Left,
			StrokeThickness = 1.8, ZIndex = 25, Parent = card })
		name.TextTruncate = Enum.TextTruncate.AtEnd
		UIKit.Text({ Text = rarity.Label .. "  " .. Format.Mult(pd.Mult), TextSize = 12, Color = rarity.Color, Size = UDim2.new(1, -50, 0, 14), Position = UDim2.fromOffset(46, 22),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, ZIndex = 25, Parent = card })
		UIKit.Text({ Text = areaName(pd.Area) .. "  ·  #" .. p.Uid, TextSize = 11,
			Color = UIKit.C.Muted, Size = UDim2.new(1, -50, 0, 14), Position = UDim2.fromOffset(46, 36), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1,
			ZIndex = 25, Parent = card })
		local flags = {}
		if p.Equipped then flags[#flags + 1] = "EQUIPPED" end
		if p.Locked then flags[#flags + 1] = "LOCKED" end
		if #flags &gt; 0 then
			UIKit.Text({ Text = table.concat(flags, "  ·  "), TextSize = 11, Color = p.Locked and UIKit.C.Gold or Color3.fromRGB(150, 220, 255), Size = UDim2.new(1, -50, 0, 14),
				Position = UDim2.fromOffset(46, 50), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.2, ZIndex = 25, Parent = card })
		end
		local bar = UIKit.Frame({ Name = "Buttons", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 1, -36),
			ZIndex = 25, Parent = card })
		UIKit.List(bar, 5, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		button(bar, p.Equipped and "UNEQUIP" or "EQUIP", p.Equipped and COL.Gray or COL.Blue, 66, function()
			act(p.Equipped and "UnequipPet" or "EquipPet", { Uid = p.Uid })
		end, { Height = 28, TextSize = 12 })
		button(bar, p.Locked and "UNLOCK" or "LOCK", COL.Gold, 58, function()
			act(p.Locked and "UnlockPet" or "LockPet", { Uid = p.Uid })
		end, { Height = 28, TextSize = 12 })
		button(bar, "DELETE", COL.Red, 54, function() act("DeletePet", { Uid = p.Uid }) end,
			{ Height = 28, TextSize = 12, Disabled = p.Locked, Tooltip = p.Locked and "Unlock it first" or nil })
	end
end

-- Quests ---------------------------------------------------------------------
function BUILD.Quests(d)
	local q = d.Quest
	local s = section("CURRENT QUEST", "Quests", "📋")
	if not q then
		label(s.Row(30), "No quest data.", 300, { Color = UIKit.C.Muted })
		return
	end
	local r1 = s.Row(44)
	local medal = UIKit.Card({ Name = "Medal", Top = GOLD_TOP, Bottom = GOLD_BOTTOM, Size = UDim2.fromOffset(64, 40), Radius = 12, OutlineThickness = 2,
		LayoutOrder = nextOrder(), ZIndex = 24, Parent = r1 })
	UIKit.Text({ Text = "#" .. q.Index, TextSize = 20, StrokeThickness = 2.4, ZIndex = 25, Parent = medal })
	label(r1, q.Text or "", 330, { TextSize = 19, StrokeThickness = 2.2 })
	chip(r1, "TRACKS: " .. string.upper(q.Stat or "-"), UIKit.C.NavyLight, { TextSize = 12 })
	local r2 = s.Row(30, true)
	local track = UIKit.Card({ Name = "Track", Top = Color3.fromRGB(12, 18, 44), Bottom = Color3.fromRGB(8, 12, 30), Size = UDim2.new(1, -150, 1, 0), Radius = 14,
		OutlineThickness = 2, Clip = true, ZIndex = 24, Parent = r2 })
	local fraction = q.Goal &gt; 0 and math.clamp(q.Progress / q.Goal, 0, 1) or 1
	local fill = UIKit.Card({ Name = "Fill", Top = Color3.fromRGB(150, 245, 100), Bottom = Color3.fromRGB(40, 176, 60), Size = UDim2.new(fraction, 0, 1, 0), Radius = 14,
		OutlineThickness = 0, ZIndex = 24, Parent = track })
	fill:FindFirstChildOfClass("UIStroke").Enabled = false
	fill.Visible = fraction &gt; 0.01
	UIKit.Text({ Text = exact(q.Progress) .. " / " .. exact(q.Goal) .. (q.Done and "   DONE - ready to claim" or ""), TextSize = 14, StrokeThickness = 2, ZIndex = 25, Parent = track })
	UIKit.IconLabel({ Icon = "Money", Emoji = "💵", Text = "+" .. Format.Number(q.Reward or 0), TextSize = 17, IconSize = 26, Align = "Right", Color = UIKit.C.Coins,
		StrokeThickness = 2, Size = UDim2.new(0, 140, 1, 0), Position = UDim2.new(1, 0, 0, 0), AnchorPoint = Vector2.new(1, 0), ZIndex = 24, Parent = r2 })
	local r3 = s.Row(34)
	local prog = input(r3, "QuestProgress", "progress", 110)
	button(r3, "SET PROGRESS", COL.Gold, 140, function()
		local n = numberFrom(prog)
		if n then act("SetQuestProgress", { Value = n }) end
	end)
	button(r3, "COMPLETE", COL.Green, 110, function() act("CompleteQuest") end, { Disabled = q.Done })
	button(r3, "RESET", COL.Red, 90, function() act("ResetQuestProgress") end, { Disabled = q.Progress &lt;= 0 })
	local r4 = s.Row(34)
	button(r4, "&lt; PREVIOUS", COL.Blue, 120, function() act("PreviousQuest") end, { Disabled = q.Index &lt;= 1 })
	button(r4, "NEXT &gt;", COL.Blue, 96, function() act("NextQuest") end)
	local idx = input(r4, "QuestIndex", "quest #", 100)
	button(r4, "SET INDEX", COL.Gold, 110, function()
		local n = numberFrom(idx)
		if n then act("SetQuestIndex", { Index = n }) end
	end, { Tooltip = "The quest chain loops with harder goals after the last quest" })

	local s2 = section("LIFETIME STATS (ADVANCED)", "Strength", "📊", Color3.fromRGB(150, 110, 255), Color3.fromRGB(96, 56, 214))
	local keys = {}
	for k in pairs(d.Stats or {}) do
		keys[#keys + 1] = k
	end
	table.sort(keys)
	for _, k in ipairs(keys) do
		local r = s2.Row(34)
		label(r, string.upper(k), 120, { TextSize = 15, StrokeThickness = 2 })
		label(r, Format.Number(d.Stats[k]) .. "   (" .. exact(d.Stats[k]) .. ")", 200, { TextSize = 14, Color = UIKit.C.Muted })
		local box = input(r, "Stat" .. k, "new value", 120)
		button(r, "SET", COL.Gold, 64, function()
			local n = numberFrom(box)
			if n then act("SetLifetimeStat", { Stat = k, Value = n }) end
		end)
	end
end

-- Player -------------------------------------------------------------------
function BUILD.Player(d)
	local s = section("TELEPORT", "GymMap", "🗺️")
	local r1 = s.Row(34)
	button(r1, "TO BEGINNER GYM", COL.Blue, 170, function() act("TeleportToBeginner") end)
	state.TeleportArea = state.TeleportArea or Config.Areas[1].Id
	select(r1, areaOptions(false), state.TeleportArea, 190, function(v) state.TeleportArea = v end)
	button(r1, "TELEPORT", COL.Blue, 110, function() act("TeleportToGym", { AreaId = state.TeleportArea }) end,
		{ Tooltip = "Only into gyms this player has unlocked" })
	local r2 = s.Row(34)
	button(r2, "BRING TO ME", COL.Purple, 150, function() act("BringToAdmin") end, { Disabled = d.IsYou })
	button(r2, "GO TO PLAYER", COL.Purple, 150, function() act("GoToPlayer") end, { Safe = true, Disabled = d.IsYou })

	local s2 = section("CHARACTER", "AdmPlayer", "🧍")
	local r3 = s2.Row(26)
	chip(r3, d.Alive and ("HEALTH " .. d.Health .. " / " .. d.MaxHealth) or "DEAD", d.Alive and COL.Green or COL.Red)
	chip(r3, d.Frozen and "FROZEN" or "NOT FROZEN", d.Frozen and Color3.fromRGB(60, 190, 230) or UIKit.C.Gray)
	local station = d.Training and Config.StationsById[d.Training]
	chip(r3, station and ("TRAINING: " .. string.upper(station.Name)) or "NOT TRAINING", station and COL.Purple or UIKit.C.Gray)
	local r4 = s2.Row(34)
	button(r4, "RESPAWN", COL.Blue, 110, function() act("Respawn") end)
	button(r4, "HEAL", COL.Green, 80, function() act("Heal") end, { Disabled = not d.Alive })
	button(r4, "KILL", COL.Red, 76, function() act("Kill") end, { Disabled = not d.Alive })
	if d.Frozen then
		button(r4, "UNFREEZE", COL.Gold, 110, function() act("Unfreeze") end)
	else
		button(r4, "FREEZE", Color3.fromRGB(60, 170, 220), 100, function() act("Freeze") end, { Disabled = d.IsYou })
	end
	button(r4, "STOP TRAINING", COL.Gray, 150, function() act("StopTraining") end, { Disabled = not d.Training })

	-- every donation-shop item can be handed out here (Config.Donations)
	local sd = section("DONATION ITEMS  (DONATED R$ " .. Format.Commas(d.Donated or 0) .. ")", "Shop", "🛒")
	for _, item in ipairs(Config.Donations.Items) do
		local has = item.Kind == "Perk" and d.Perks and d.Perks[item.Perk] == true
		local r = sd.Row(34)
		label(r, item.Emoji .. "  " .. item.Name, 200, { TextSize = 15, StrokeThickness = 2 })
		chip(r, item.Kind == "Perk" and (has and "OWNED" or "NOT OWNED") or ("TIP  R$ " .. item.Robux), has and COL.Green or UIKit.C.Gray, { TextSize = 12 })
		button(r, "GIVE", COL.Green, 80, function() act("GrantDonation", { ItemId = item.Id }) end, { Disabled = has })
		if item.Kind == "Perk" then
			button(r, "REMOVE", COL.Red, 90, function() act("RevokeDonation", { ItemId = item.Id }) end, { Disabled = not has })
		end
	end

	local s4 = section("DANGER ZONE", "AdmHammer", "⚠️", Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 40, 50))
	local r6 = s4.Row(34)
	button(r6, "RESET PLAYER DATA", COL.Red, 200, function()
		confirmAct("ResetData", {}, { Title = "Reset ALL data?", Message = d.DisplayName .. " gets a brand-new profile (Strength, coins, rebirths, pets, gyms, upgrades, quests). This is saved right away and can't be undone.",
			TypeToConfirm = "RESET", ConfirmText = "RESET" })
	end)
	label(r6, "Type RESET to confirm.", 200, { TextSize = 12, Color = UIKit.C.Muted })
end

-- Moderation -----------------------------------------------------------------
function BUILD.Moderation(d)
	local presets = access.BanPresets or {}
	if d then
		if d.IsYou then
			notice("This is you - you can't kick or ban yourself.", COL.Gold)
		elseif not d.CanModerate then
			notice(d.DisplayName .. " has the same or a higher admin rank (" .. (d.LevelName or "?") .. ") - you can't kick or ban them.", COL.Red)
		end
	else
		notice("Pick a player on the left to kick or ban them. Unban works for any UserId.", COL.Blue)
	end
	local canMod = d ~= nil and d.CanModerate == true
	local who = d and d.DisplayName or "?"

	local s = section("KICK", "AdmHammer", "🥾")
	local r1 = s.Row(34)
	local kickReason = input(r1, "KickReason", "reason (shown to the player)", 360)
	button(r1, "KICK", COL.Red, 110, function()
		confirmAct("Kick", { Reason = kickReason.Text }, { Title = "Kick " .. who .. "?", Message = "They are removed from this server and can rejoin. Reason: "
			.. (kickReason.Text ~= "" and kickReason.Text or "No reason given"), ConfirmText = "KICK" })
	end, { Safe = true, Disabled = not canMod })

	local s2 = section("TEMPORARY BAN", "AdmHammer", "⏳")
	local r2 = s2.Row(34)
	local banReason = input(r2, "BanReason", "reason (shown to the player)", 480)
	local r3 = s2.Row(34)
	local function ban(minutes, text)
		confirmAct("Ban", { Minutes = minutes, Reason = banReason.Text }, { Title = "Ban " .. who .. " for " .. text .. "?",
			Message = "They are kicked now and can't join any server until the ban ends. Reason: " .. (banReason.Text ~= "" and banReason.Text or "No reason given"),
			ConfirmText = "BAN" })
	end
	for _, p in ipairs(presets) do
		button(r3, p.Label, COL.Red, 86, function() ban(p.Minutes, string.lower(p.Label)) end, { Safe = true, Disabled = not canMod, TextSize = 14 })
	end
	local r4 = s2.Row(34)
	local custom = input(r4, "BanMinutes", "minutes", 120)
	label(r4, "minutes (custom)", 130, { TextSize = 13, Color = UIKit.C.Muted })
	button(r4, "BAN", COL.Red, 90, function()
		local n = numberFrom(custom)
		if n then ban(n, Format.Commas(n) .. " minutes") end
	end, { Safe = true, Disabled = not canMod })

	local s3 = section("PERMANENT BAN", "AdmHammer", "⛔", Color3.fromRGB(255, 110, 110), Color3.fromRGB(190, 30, 40))
	local r5 = s3.Row(34)
	local permReason = input(r5, "PermReason", "reason (shown to the player)", 330)
	button(r5, "PERMANENT BAN", Color3.fromRGB(170, 20, 30), 170, function()
		-- double confirmation: are you sure -&gt; type PERMANENT
		UIKit.Confirm({ Title = "Permanently ban " .. who .. "?", Message = "They will never be able to join again (until someone unbans their UserId).",
			ConfirmText = "CONTINUE", HeaderTop = Color3.fromRGB(255, 110, 110), HeaderBottom = Color3.fromRGB(190, 30, 40),
			OnConfirm = function()
				UIKit.Confirm({ Title = "Last check", Message = "Type PERMANENT to ban " .. who .. " forever.", TypeToConfirm = "PERMANENT", ConfirmText = "BAN FOREVER",
					HeaderTop = Color3.fromRGB(255, 110, 110), HeaderBottom = Color3.fromRGB(190, 30, 40),
					OnConfirm = function()
						act("Ban", { Permanent = true, Reason = permReason.Text, Confirm = true, Confirm2 = "PERMANENT" })
					end })
			end })
	end, { Safe = true, Disabled = not canMod })

	local s4 = section("UNBAN / LOOK UP", "AdmLogs", "🔍", Color3.fromRGB(110, 210, 130), Color3.fromRGB(40, 150, 70))
	local r6 = s4.Row(34)
	local idBox = input(r6, "UnbanId", "UserId", 160)
	local function parsedId()
		local n = tonumber(idBox.Text)
		if not n or n % 1 ~= 0 or n == 0 then
			toast("Type a UserId (whole number).", "Error")
			return nil
		end
		return n
	end
	button(r6, "LOOK UP", COL.Blue, 110, function()
		local id = parsedId()
		if not id then return end
		local data, err = getState("Ban", id)
		state.BanLookup = data or { Error = err }
		render()
	end, { Safe = true })
	button(r6, "UNBAN", COL.Green, 100, function()
		local id = parsedId()
		if not id then return end
		act("Unban", {}, { Target = id, After = function() state.BanLookup = nil end })
	end, { Safe = true })
	local b = state.BanLookup
	if b then
		local r7 = s4.Row(40)
		local text
		if b.Error then
			text = b.Error
		elseif not b.Found then
			text = "@" .. tostring(b.Name) .. " (" .. b.UserId .. ") has no ban record."
		elseif not b.Active then
			text = "@" .. tostring(b.Name) .. " (" .. b.UserId .. ") is NOT banned (old or expired record)."
		else
			text = "@" .. tostring(b.Name) .. " (" .. b.UserId .. ") is BANNED " .. ((b.ExpiresAt or 0) &gt; 0 and ("until " .. dateText(b.ExpiresAt)) or "PERMANENTLY")
				.. " - " .. tostring(b.Reason or "no reason") .. " (by " .. tostring(b.ModeratorId) .. ")"
		end
		label(r7, text, 600, { TextSize = 14, Wrap = true, Color = b.Active and Color3.fromRGB(255, 150, 150) or UIKit.C.Muted })
	end
end

-- Server -------------------------------------------------------------------
function BUILD.Server()
	local info = state.ServerInfo
	local s = section("THIS SERVER", "AdmServer", "🖥️")
	if not info then
		label(s.Row(30), "Loading server info...", 300, { Color = UIKit.C.Muted })
	else
		local w = 142
		local r1 = s.Row(58)
		tile(r1, w, { Label = "PLAYERS", Value = info.PlayerCount .. " / " .. info.MaxPlayers, Height = 58 })
		tile(r1, w, { Label = "UPTIME", Value = duration(info.Uptime), ValueSize = 17, Height = 58 })
		tile(r1, w, { Label = "PLACE ID", Value = tostring(info.PlaceId), ValueSize = 15, Sub = "version " .. tostring(info.PlaceVersion), Height = 58 })
		tile(r1, w, { Label = "MODE", Value = info.IsStudio and "STUDIO" or "LIVE", Color = info.IsStudio and UIKit.C.Gold or UIKit.C.Good, Height = 58 })
		local r2 = s.Row(26)
		chip(r2, "JOB " .. tostring(info.JobId), UIKit.C.NavyLight, { TextSize = 12 })
		chip(r2, info.BanStore and "BAN STORE OK" or "BAN STORE OFFLINE", info.BanStore and COL.Green or COL.Red, { TextSize = 12 })
		chip(r2, "LOG ENTRIES " .. tostring(info.LogCount), UIKit.C.NavyLight, { TextSize = 12 })
		if info.ShuttingDown then
			chip(r2, "SHUTTING DOWN", COL.Red, { TextSize = 12 })
		end
	end

	local s2 = section("ANNOUNCEMENT", "AdmServer", "📢")
	local r3 = s2.Row(34)
	local text = input(r3, "AnnounceText", "message for everyone (max 150 characters)", 340)
	select(r3, { { Value = "Info", Text = "INFO" }, { Value = "Success", Text = "SUCCESS" }, { Value = "Warning", Text = "WARNING" } }, state.Announce, 120,
		function(v) state.Announce = v end)
	button(r3, "SEND", COL.Gold, 90, function()
		if text.Text == "" then
			toast("Type a message first.", "Error")
			return
		end
		act("Announce", { Text = text.Text, Kind = state.Announce }, { Target = 0, After = function(r)
			if r.Ok then state.Drafts.AnnounceText = "" end
		end })
	end, { Safe = true })

	local s3 = section("DATA", "AdmServer", "💾", Color3.fromRGB(110, 210, 130), Color3.fromRGB(40, 150, 70))
	local r4 = s3.Row(34)
	button(r4, "SAVE SELECTED", COL.Green, 150, function() act("SavePlayer") end, { Safe = true, Disabled = state.Selected == nil })
	button(r4, "SAVE ALL", COL.Green, 120, function() act("SaveAll", {}, { Target = 0 }) end, { Safe = true })
	button(r4, "FORCE SYNC ALL", COL.Blue, 160, function() act("SyncAll", {}, { Target = 0 }) end, { Safe = true })

	local s4 = section("DANGER ZONE", "AdmHammer", "⚠️", Color3.fromRGB(255, 110, 110), Color3.fromRGB(200, 40, 50))
	local r5 = s4.Row(34)
	button(r5, "RETURN EVERYONE TO BEGINNER", COL.Purple, 280, function()
		confirmAct("ReturnAllToBeginner", {}, { Title = "Send everyone back?", Message = "Every player in this server is teleported to the " .. Config.Areas[1].Name .. ".",
			Color = COL.Purple }, { Target = 0 })
	end, { Safe = true })
	local r6 = s4.Row(34)
	local msg = input(r6, "ShutdownMessage", "message shown when players are kicked", 330)
	button(r6, "SHUT DOWN SERVER", Color3.fromRGB(170, 20, 30), 190, function()
		confirmAct("Shutdown", { Message = msg.Text }, { Title = "Shut down this server?", Message = "Everyone is saved first, then kicked with your message. Type SHUTDOWN to confirm.",
			TypeToConfirm = "SHUTDOWN", ConfirmText = "SHUT DOWN" }, { Target = 0 })
	end, { Safe = true })
end

-- Logs ---------------------------------------------------------------------
function BUILD.Logs()
	local s = section("FILTER", "AdmLogs", "🔍")
	local r1 = s.Row(34)
	local fa = input(r1, "LogAdmin", "admin", 130)
	local ft = input(r1, "LogTarget", "target", 130)
	local fx = input(r1, "LogAction", "action", 130)
	button(r1, "APPLY", COL.Gold, 90, function()
		state.LogFilter = { Admin = fa.Text, Target = ft.Text, Action = fx.Text }
		refresh(true)
	end, { Safe = true })
	button(r1, "CLEAR", COL.Gray, 86, function()
		state.LogFilter = {}
		state.Drafts.LogAdmin, state.Drafts.LogTarget, state.Drafts.LogAction = "", "", ""
		refresh(true)
	end, { Safe = true })

	local logs = state.Logs
	local s2 = section("AUDIT LOG" .. (logs and ("  (" .. #logs.Entries .. " SHOWN / " .. logs.Total .. " KEPT)") or ""), "AdmLogs", "📜")
	if not logs then
		label(s2.Row(30), "Loading...", 200, { Color = UIKit.C.Muted })
		return
	end
	if #logs.Entries == 0 then
		label(s2.Row(30), "No log entries yet.", 300, { Color = UIKit.C.Muted })
		return
	end
	for _, e in ipairs(logs.Entries) do
		local r = s2.Row(40, true)
		local bg = UIKit.Frame({ Name = "Entry", Color = e.Ok and Color3.fromRGB(26, 38, 80) or Color3.fromRGB(70, 24, 34), Size = UDim2.fromScale(1, 1), Radius = 10,
			ZIndex = 23, Parent = r })
		UIKit.Text({ Text = clockText(e.Time), TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.fromOffset(62, 18), Position = UDim2.fromOffset(8, 3),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 24, Parent = bg })
		local head = UIKit.Text({ Text = e.Action .. "   " .. tostring(e.AdminName) .. " -&gt; " .. (e.TargetName ~= "" and tostring(e.TargetName) or "server"),
			TextSize = 14, Color = e.Ok and UIKit.C.Text or Color3.fromRGB(255, 160, 160), Size = UDim2.new(1, -80, 0, 18), Position = UDim2.fromOffset(72, 3),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.6, ZIndex = 24, Parent = bg })
		head.TextTruncate = Enum.TextTruncate.AtEnd
		local change = ""
		if e.OldValue ~= nil or e.NewValue ~= nil then
			local function v(x)
				if x == nil then
					return "-"
				end
				return type(x) == "number" and exact(x) or tostring(x)
			end
			change = v(e.OldValue) .. " -&gt; " .. v(e.NewValue) .. "   "
		end
		local sub = UIKit.Text({ Text = change .. (e.Details or ""), TextSize = 12, Color = UIKit.C.Muted, Size = UDim2.new(1, -80, 0, 16), Position = UDim2.fromOffset(72, 21),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 24, Parent = bg })
		sub.TextTruncate = Enum.TextTruncate.AtEnd
	end
end

----------------------------------------------------------------------
-- rendering
----------------------------------------------------------------------
local function tabDef(key)
	for _, t in ipairs(TABS) do
		if t.Key == key then
			return t
		end
	end
end

local function closeSelects()
	for _, s in ipairs(ui.Selects) do
		s.Close()
	end
	ui.Selects = {}
end

local function renderHeader()
	local d = state.Detail
	clear(ui.HeaderPlayer)
	if d then
		avatar(ui.HeaderPlayer, d.UserId, 34, 24).Position = UDim2.new(0, 4, 0.5, 0)
		ui.HeaderPlayer:FindFirstChild("Avatar").AnchorPoint = Vector2.new(0, 0.5)
		local name = UIKit.Text({ Text = d.DisplayName, TextSize = 17, Size = UDim2.new(1, -48, 0, 20), Position = UDim2.fromOffset(44, 3), XAlign = Enum.TextXAlignment.Left,
			StrokeThickness = 2, ZIndex = 24, Parent = ui.HeaderPlayer })
		name.TextTruncate = Enum.TextTruncate.AtEnd
		UIKit.Text({ Text = "@" .. d.Name, TextSize = 12, Color = Color3.fromRGB(255, 240, 200), Size = UDim2.new(1, -48, 0, 14), Position = UDim2.fromOffset(44, 22),
			XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1.4, ZIndex = 24, Parent = ui.HeaderPlayer })
	else
		UIKit.Text({ Text = "no player selected", TextSize = 15, Color = Color3.fromRGB(255, 240, 200), StrokeThickness = 1.6, ZIndex = 24, Parent = ui.HeaderPlayer })
	end
end

local function renderPlayers()
	clear(ui.PlayerScroll)
	local q = string.lower(state.Search or "")
	local shown = 0
	for _, p in ipairs(state.Players) do
		local match = q == "" or string.find(string.lower(p.DisplayName), q, 1, true) or string.find(string.lower(p.Name), q, 1, true)
			or string.find(tostring(p.UserId), q, 1, true)
		if match then
			shown = shown + 1
			local selected = p.UserId == state.Selected
			local b = UIKit.Button({ Name = "Player", Text = "", Color = selected and COL.Gold or UIKit.C.NavyLight, Size = UDim2.new(1, -10, 0, 54), Radius = 12,
				ZIndex = 24, LayoutOrder = shown, Parent = ui.PlayerScroll, Silent = false, OnClick = function()
					if state.Selected ~= p.UserId then
						state.Selected = p.UserId
						state.Detail = nil
						state.Loading = true
						renderPlayers()
						render()
						refresh(true)
					end
				end })
			if selected then
				UIKit.OutlineOf(b).Color = Color3.new(1, 1, 1)
			end
			local av = avatar(b, p.UserId, 40, 25)
			av.Position = UDim2.new(0, 6, 0.5, 0)
			av.AnchorPoint = Vector2.new(0, 0.5)
			local dot = UIKit.Frame({ Name = "Online", Color = Color3.fromRGB(80, 230, 110), Size = UDim2.fromOffset(12, 12), Position = UDim2.new(1, 1, 1, 1),
				AnchorPoint = Vector2.new(1, 1), Radius = 12, Stroke = UIKit.C.Outline, StrokeThickness = 2, ZIndex = 26, Parent = av })
			dot:FindFirstChildOfClass("UICorner").CornerRadius = UDim.new(0.5, 0)
			local name = UIKit.Text({ Text = p.DisplayName, TextSize = 15, Size = UDim2.new(1, -60, 0, 18), Position = UDim2.fromOffset(52, 5), XAlign = Enum.TextXAlignment.Left,
				StrokeThickness = 1.8, ZIndex = 25, Parent = b })
			name.TextTruncate = Enum.TextTruncate.AtEnd
			local sub = UIKit.Text({ Text = "@" .. p.Name, TextSize = 11, Color = selected and Color3.fromRGB(255, 244, 210) or UIKit.C.Muted, Size = UDim2.new(1, -60, 0, 13),
				Position = UDim2.fromOffset(52, 23), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 25, Parent = b })
			sub.TextTruncate = Enum.TextTruncate.AtEnd
			UIKit.Text({ Text = "ID " .. p.UserId, TextSize = 10, Color = selected and Color3.fromRGB(255, 244, 210) or UIKit.C.Muted, Size = UDim2.new(1, -60, 0, 12),
				Position = UDim2.fromOffset(52, 37), XAlign = Enum.TextXAlignment.Left, StrokeThickness = 1, ZIndex = 25, Parent = b })
			local tag = p.IsYou and "YOU" or (p.Level &gt; 0 and string.upper(p.LevelName) or nil)
			if tag then
				local c = UIKit.Chip({ Name = "Rank", Text = tag, Color = p.IsYou and COL.Blue or COL.Purple, TextSize = 10, Size = UDim2.fromOffset(10, 16), AutoWidth = true,
					Position = UDim2.new(1, -4, 0, 4), AnchorPoint = Vector2.new(1, 0), ZIndex = 26, Parent = b })
				c.Name = "Rank"
			end
			if p.Frozen then
				UIKit.Text({ Text = "FROZEN", TextSize = 10, Color = Color3.fromRGB(140, 230, 255), Size = UDim2.fromOffset(50, 12), Position = UDim2.new(1, -6, 1, -4),
					AnchorPoint = Vector2.new(1, 1), XAlign = Enum.TextXAlignment.Right, StrokeThickness = 1, ZIndex = 26, Parent = b })
			end
		end
	end
	if shown == 0 then
		UIKit.Empty(ui.PlayerScroll, #state.Players == 0 and "Loading players..." or "No player matches that search.", 24)
	end
	ui.PlayerCount.Text = #state.Players .. " ONLINE"
end

function render()
	if not panel then
		return
	end
	for key, b in pairs(ui.TabButtons) do
		local active = key == state.Tab
		UIKit.SetButtonColor(b, active and COL.Gold or UIKit.C.NavyLight)
		local o = UIKit.OutlineOf(b)
		if o then
			o.Color = active and Color3.new(1, 1, 1) or UIKit.C.Outline
		end
	end
	renderHeader()
	local keep = ui.Content.CanvasPosition
	local sameTab = ui.LastTab == state.Tab and ui.LastPlayer == state.Selected
	closeSelects()
	clear(ui.Content)
	layoutCounter = 0
	local def = tabDef(state.Tab)
	local d = state.Detail
	TABS_NEED_EDIT = def.NeedsPlayer
	if def.NeedsPlayer and not d then
		if state.Loading and state.Selected then
			UIKit.Spinner(ui.Content, "Loading player...", 24)
		else
			UIKit.Empty(ui.Content, state.DetailError or "Pick a player on the left.", 24, 1)
		end
	else
		if def.NeedsPlayer and d.CanEdit == false then
			notice(d.DisplayName .. " is protected (" .. tostring(d.LevelName) .. "). You can look, but only a higher rank can change their data.", COL.Red)
		end
		BUILD[state.Tab](d)
	end
	if sameTab then
		task.defer(function()
			ui.Content.CanvasPosition = keep
		end)
	end
	ui.LastTab, ui.LastPlayer = state.Tab, state.Selected
end

-- fetch fresh data (player list + selected player + the open tab's extra data), then re-render
local refreshing, again = false, false
function refresh(force)
	if not panel then
		return
	end
	if refreshing then
		again = true -- run once more when the current refresh finishes
		return
	end
	refreshing = true
	task.spawn(function()
		local list = getState("Players")
		if list then
			state.Players = list
			if state.Selected == nil then
				for _, p in ipairs(list) do
					if p.IsYou then
						state.Selected = p.UserId
					end
				end
			end
		end
		if state.Selected then
			local d, err = getState("Player", state.Selected)
			state.Detail = d
			state.DetailError = d == nil and err or nil
			state.Loading = false
		end
		if state.Tab == "Server" or force then
			state.ServerInfo = getState("Server") or state.ServerInfo
		end
		if state.Tab == "Logs" then
			state.Logs = getState("Logs", state.LogFilter) or state.Logs
		end
		refreshing = false
		renderPlayers()
		render()
		if again then
			again = false
			refresh(force)
		end
	end)
end

----------------------------------------------------------------------
-- building the panel (only for admins)
----------------------------------------------------------------------
local function build()
	panel = UIKit.Panel(C.Root, "Admin", "ADMIN PANEL", Vector2.new(W, H), COL.Gold, { Icon = "AdminShield", Emoji = "🛡️", Top = GOLD_TOP, Bottom = GOLD_BOTTOM,
		Rim = Color3.fromRGB(255, 240, 150), Accent = Color3.fromRGB(56, 96, 196), Body = UIKit.C.Navy })
	local header = panel.Header
	-- selected player + refresh (left of the close button)
	UIKit.Button({ Name = "Refresh", Icon = "AdmRefresh", Emoji = "🔄", IconOnly = true, IconPadding = 6, Color = COL.Blue, Size = UDim2.fromOffset(44, 40),
		Position = UDim2.new(1, -60, 0, 7), AnchorPoint = Vector2.new(1, 0), ZIndex = 23, Tooltip = "Refresh", Parent = header, OnClick = function() refresh(true) end })
	ui.HeaderPlayer = UIKit.Card({ Name = "Selected", Top = Color3.fromRGB(150, 70, 10), Bottom = Color3.fromRGB(110, 44, 6), Size = UDim2.fromOffset(230, 42),
		Position = UDim2.new(1, -112, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), Radius = 12, OutlineThickness = 2, ZIndex = 23, Parent = header })
	ui.Busy = UIKit.Text({ Name = "Busy", Text = "WORKING...", TextSize = 14, Color = Color3.fromRGB(255, 250, 210), Size = UDim2.fromOffset(100, 20),
		Position = UDim2.new(1, -350, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), StrokeThickness = 1.8, Visible = false, ZIndex = 24, Parent = header })

	local body = panel.Body
	body.BackgroundColor3 = Color3.fromRGB(10, 18, 44)
	-- left: player list
	local left = UIKit.Card({ Name = "Players", Top = Color3.fromRGB(26, 40, 84), Bottom = Color3.fromRGB(14, 22, 52), Size = UDim2.new(0, LIST_W, 1, -16),
		Position = UDim2.fromOffset(8, 8), Radius = 14, OutlineThickness = 3, Rim = UIKit.C.NavyEdge, ZIndex = 22, Parent = body })
	UIKit.Text({ Text = "PLAYERS", TextSize = 17, Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(10, 6), XAlign = Enum.TextXAlignment.Left,
		StrokeThickness = 2.2, ZIndex = 23, Parent = left })
	ui.PlayerCount = UIKit.Text({ Text = "", TextSize = 12, Color = Color3.fromRGB(120, 240, 140), Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(6, 6),
		XAlign = Enum.TextXAlignment.Right, StrokeThickness = 1.4, ZIndex = 23, Parent = left })
	local search = UIKit.Input({ Name = "Search", Placeholder = "search name / id", Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 34), TextSize = 15,
		ZIndex = 23, Parent = left })
	search:GetPropertyChangedSignal("Text"):Connect(function()
		state.Search = search.Text
		renderPlayers()
	end)
	ui.PlayerScroll = UIKit.Scroll(left, { Name = "List", Position = UDim2.fromOffset(6, 76), Size = UDim2.new(1, -8, 1, -82), ZIndex = 23 })
	UIKit.List(ui.PlayerScroll, 6)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingLeft = UDim.new(0, 4)
	pad.Parent = ui.PlayerScroll

	-- right: tabs + content
	local main = UIKit.Frame({ Name = "Main", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, -(LIST_W + 24), 1, -16),
		Position = UDim2.fromOffset(LIST_W + 16, 8), ZIndex = 22, Parent = body })
	local tabs = UIKit.Frame({ Name = "Tabs", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.new(1, 0, 0, 52), ZIndex = 22, Parent = main })
	UIKit.List(tabs, 4, Enum.FillDirection.Horizontal, Enum.HorizontalAlignment.Center)
	local tabW = math.floor((W - 20 - LIST_W - 24 - 8 * 4) / #TABS)
	for i, t in ipairs(TABS) do
		local b = UIKit.Button({ Name = t.Key, Text = "", Color = UIKit.C.NavyLight, Size = UDim2.fromOffset(tabW, 52), Radius = 10, LayoutOrder = i, ZIndex = 23,
			Gloss = true, Tooltip = t.Key == "Progression" and "Gyms, equipment and upgrades" or nil, Parent = tabs,
			OnClick = function()
				state.Tab = t.Key
				render()
				if t.Key == "Server" or t.Key == "Logs" then
					refresh(true)
				end
			end })
		UIKit.Icon({ Icon = t.Icon, Emoji = t.Emoji, Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0.5, 0, 0, 4), AnchorPoint = Vector2.new(0.5, 0), ZIndex = 24, Parent = b })
		local l = UIKit.Text({ Text = t.Label, TextSize = 11, Scaled = true, Size = UDim2.new(1, -6, 0, 14), Position = UDim2.new(0.5, 0, 1, -4), AnchorPoint = Vector2.new(0.5, 1),
			StrokeThickness = 1.4, ZIndex = 24, Parent = b })
		local cap = Instance.new("UITextSizeConstraint")
		cap.MaxTextSize = 12
		cap.Parent = l
		ui.TabButtons[t.Key] = b
	end
	ui.Content = UIKit.Scroll(main, { Name = "Content", Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 1, -60), ZIndex = 22 })
	UIKit.List(ui.Content, 10)
	local cpad = Instance.new("UIPadding")
	cpad.PaddingTop = UDim.new(0, 4)
	cpad.PaddingBottom = UDim.new(0, 12)
	cpad.PaddingLeft = UDim.new(0, 2)
	cpad.Parent = ui.Content

	-- toasts float over the bottom of the panel
	ui.Toasts = UIKit.Frame({ Name = "AdminToasts", Color = Color3.new(0, 0, 0), Transparency = 1, Size = UDim2.fromOffset(560, 140), Position = UDim2.new(0.5, 0, 1, -14),
		AnchorPoint = Vector2.new(0.5, 1), ZIndex = 80, Parent = panel.Frame })
	UIKit.List(ui.Toasts, 6, Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Bottom)

	panel.OnOpen = function()
		render()
		refresh(true)
	end
	panel.OnClose = function()
		closeSelects()
	end

	-- keep the list (and the dashboard) fresh while the panel is open; never re-render
	-- under the admin's cursor while they type or pick from a dropdown
	task.spawn(function()
		while true do
			task.wait(3)
			if panel.IsOpen and not state.Busy then
				local focused = UserInputService:GetFocusedTextBox()
				local typing = focused ~= nil and focused:IsDescendantOf(panel.Frame)
				local list = getState("Players")
				if list then
					state.Players = list
					renderPlayers()
				end
				if state.Tab == "Dashboard" and state.Selected and not typing and #ui.Selects == 0 then
					local d = getState("Player", state.Selected)
					if d then
						state.Detail = d
						render()
					end
				end
			end
		end
	end)
end

-- the orange admin button (bottom right, next to the sound button)
local function buildButton()
	local hud = C.Root:FindFirstChild("HUD") or C.Root
	local b = UIKit.Button({ Name = "AdminButton", Text = "🛡️", Color = Color3.fromRGB(255, 150, 30), TextSize = 40, Size = UDim2.fromOffset(78, 78),
		Position = UDim2.new(1, -84, 1, -12), AnchorPoint = Vector2.new(1, 1), Radius = 8, Tooltip = "ADMIN", ZIndex = 3, Parent = hud,
		OnClick = function()
			panel.Toggle()
		end })
	if IconLoader then
		IconLoader.Skin(b, "Admin")
	end
	ui.Button = b
	return b
end

function PanelAdmin.Init(client)
	C = client
	UIKit, Config, Format, Remotes = C.UIKit, C.Config, C.Format, C.Remotes
	local ok, il = pcall(function()
		return require(script.Parent:WaitForChild("IconLoader"))
	end)
	IconLoader = ok and il or nil
	COL = {
		Gold = Color3.fromRGB(255, 160, 28),
		Blue = Color3.fromRGB(52, 132, 240),
		Green = Color3.fromRGB(52, 184, 84),
		Red = Color3.fromRGB(226, 60, 70),
		Purple = Color3.fromRGB(146, 84, 240),
		Gray = UIKit.C.Gray,
	}
	-- Ask the server once whether we are an admin. Non-admins never get the panel or
	-- the button (cosmetic - the server re-checks every request anyway).
	task.spawn(function()
		for attempt = 1, 2 do
			local data = getState("Access")
			if data then
				access = data
				build()
				buildButton()
				return
			end
			if attempt == 1 then
				task.wait(12) -- a group-rank lookup may have failed; ask once more
			end
		end
	end)
end

-- for the preview harness / debugging
PanelAdmin._state = state
PanelAdmin._render = function()
	renderPlayers()
	render()
end
PanelAdmin._refresh = function()
	refresh(true)
end

return PanelAdmin
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="NEWMOD0"><Properties><string name="Name">SweatAura</string><ProtectedString name="Source">--[[
	SweatAura - a sweaty aura around anyone who is lifting.

	What you see while repping:
	  * Glow     - a pale-blue Highlight around the whole body (the "aura")
	  * Steam    - heat rising off the shoulders and head
	  * Glisten  - quick sparkles running over the body (sweat catching the light)
	  * Drops    - sweat flicked off the head and shoulders, falling with gravity
	It builds up the longer you keep repping and fades a second after you stop.

	Your own aura is driven directly by your reps (SweatAura.Pulse from TrainingController),
	so it never waits on the network. Other players' auras use the "SweatUntil" attribute
	the server stamps on every rep (TrainingService).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local SweatAura = {}

local SWEAT_BLUE = Color3.fromRGB(140, 210, 255)
local GLOW_BLUE = Color3.fromRGB(120, 200, 255)
local STEAM_WHITE = Color3.fromRGB(235, 245, 255)
local HOLD_TIME = 1.6       -- aura stays this long after the last rep
local HEAT_PER_REP = 0.14   -- how fast the aura builds up
local HEAT_DECAY = 0.35     -- per second, once you stop

local rigs = {}              -- [player] = rig
local localHeat, localLastRep = 0, -math.huge

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	for k, v in pairs(props) do
		e[k] = v
	end
	e.Enabled = false
	e.Parent = parent
	return e
end

local function attachment(part, name, position)
	local a = part:FindFirstChild(name)
	if not a then
		a = Instance.new("Attachment")
		a.Name = name
		a.Position = position or Vector3.zero
		a.Parent = part
	end
	return a
end

local function numberSeq(a, b, c)
	if c then
		return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(0.35, b), NumberSequenceKeypoint.new(1, c) })
	end
	return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) })
end

local function build(character)
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	if not torso or not head then
		return nil
	end
	local shoulders = attachment(torso, "SweatAuraShoulders", Vector3.new(0, torso.Size.Y * 0.4, 0))
	local crown = attachment(head, "SweatAuraHead", Vector3.new(0, head.Size.Y * 0.35, 0))

	local rig = { Character = character, Level = 0 }

	local glow = Instance.new("Highlight")
	glow.Name = "SweatGlow"
	glow.Adornee = character
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.FillColor = GLOW_BLUE
	glow.OutlineColor = Color3.fromRGB(200, 240, 255)
	glow.FillTransparency = 1
	glow.OutlineTransparency = 1
	glow.Enabled = false
	glow.Parent = character
	rig.Glow = glow

	local steam = {
		Name = "SweatSteam",
		Texture = "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(STEAM_WHITE),
		LightEmission = 0.35,
		LightInfluence = 0.4,
		Transparency = numberSeq(1, 0.55, 1),
		Size = numberSeq(1.2, 3.6),
		Lifetime = NumberRange.new(1.0, 1.6),
		Speed = NumberRange.new(2, 3.5),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 2, 0),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-50, 50),
	}
	rig.Steam = emitter(shoulders, steam)
	steam.Name = "SweatSteamHead"
	rig.SteamHead = emitter(crown, steam)

	rig.Glisten = emitter(torso, { -- parented to the torso part so the Box shape covers the whole chest
		Name = "SweatGlisten",
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(230, 248, 255)),
		LightEmission = 1,
		LockedToPart = true,
		Shape = Enum.ParticleEmitterShape.Box,
		ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume,
		Transparency = numberSeq(0.1, 1),
		Size = numberSeq(0.55, 0),
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(0, 0),
		Rotation = NumberRange.new(0, 90),
	})

	local drops = {
		Name = "SweatDrops",
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
		Color = ColorSequence.new(SWEAT_BLUE),
		LightEmission = 0.6,
		Transparency = numberSeq(0, 0.85),
		Size = numberSeq(0.45, 0.18),
		Lifetime = NumberRange.new(0.55, 0.9),
		Speed = NumberRange.new(5, 8),
		SpreadAngle = Vector2.new(65, 65),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, -34, 0),
		Drag = 0.8,
	}
	rig.Drops = emitter(crown, drops)
	drops.Name = "SweatSpray"
	rig.Spray = emitter(shoulders, drops)
	return rig
end

-- level 0..1 -&gt; how strong every effect is
local function apply(rig, level)
	local on = level &gt; 0.02
	rig.Glow.Enabled = on
	rig.Glow.FillTransparency = 1 - 0.28 * level
	rig.Glow.OutlineTransparency = 1 - 0.75 * level
	for _, key in ipairs({ "Steam", "SteamHead", "Glisten", "Drops", "Spray" }) do
		local e = rig[key]
		if e and e.Parent then
			e.Enabled = on
		end
	end
	if on then
		rig.Steam.Rate = 4 + 14 * level
		rig.SteamHead.Rate = 2 + 8 * level
		rig.Glisten.Rate = 4 + 12 * level
		rig.Drops.Rate = 3 + 13 * level
		rig.Spray.Rate = 2 + 8 * level
	end
end

-- 0..1: how "heated up" your own set is (the HUD workout card shows it as intensity)
function SweatAura.GetHeat()
	return localHeat
end

-- Called for every one of YOUR reps: builds the aura up and splashes some drops.
function SweatAura.Pulse(strength)
	localHeat = math.min(1, localHeat + HEAT_PER_REP * (strength or 1))
	localLastRep = os.clock()
	local rig = rigs[Players.LocalPlayer]
	if rig and rig.Drops.Parent then
		rig.Drops:Emit(5 + math.floor(localHeat * 6))
		rig.Spray:Emit(3)
		rig.Steam:Emit(1)
	end
end

function SweatAura.Init()
	RunService.Heartbeat:Connect(function(dt)
		local serverNow = Workspace:GetServerTimeNow()
		local now = os.clock()
		if now - localLastRep &gt; HOLD_TIME then
			localHeat = math.max(0, localHeat - HEAT_DECAY * dt)
		end
		for _, player in ipairs(Players:GetPlayers()) do
			local character = player.Character
			local rig = rigs[player]
			if character and (not rig or rig.Character ~= character or not rig.Glow.Parent) then
				rig = build(character)
				rigs[player] = rig
			end
			if rig then
				-- server-stamped reps (other players, and your own Auto Train reps)
				local sweatUntil = player:GetAttribute("SweatUntil")
				local target = (type(sweatUntil) == "number" and sweatUntil &gt; serverNow) and 0.7 or 0
				if player == Players.LocalPlayer then
					local active = now - localLastRep &lt;= HOLD_TIME
					target = math.max(target, active and math.max(0.35, localHeat) or localHeat * 0.5)
				end
				-- ease towards the target so it swells and fades instead of popping
				rig.Level = rig.Level + (target - rig.Level) * math.min(1, dt * 6)
				apply(rig, rig.Level)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		rigs[player] = nil
	end)
end

return SweatAura
</ProtectedString></Properties></Item>
        <Item class="ModuleScript" referent="RBX28">
          <Properties>
            <string name="Name">DumbbellAnim</string>
            <ProtectedString name="Source">--[[
	DumbbellAnim - free-weight visuals and procedural R6/R15 animations.

	This module intentionally does NOT create Roblox Tools. Pet inventory and gym
	equipment therefore stay completely separate.

	Dumbbell : two plated dumbbells, centred in the avatar palms.
	Squat    : a plated barbell is held at shoulder height and pressed overhead.
	Deadlift : the same hand-held barbell follows the lifter through a deadlift.

	The server owns training state/payout. Everything here is local presentation.
]]
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GymShared"):WaitForChild("Config"))
local BarbellDesign = require(ReplicatedStorage:WaitForChild("GymShared"):WaitForChild("BarbellDesign"))

local function materialOf(name)
	local ok, material = pcall(function()
		return Enum.Material[name]
	end)
	return ok and material or Enum.Material.SmoothPlastic
end

local FreeweightAnim = {}

local FREE_WEIGHT = {
	Dumbbell = true,
	Squat = true,
	Deadlift = true,
}

local IRON = Color3.fromRGB(24, 25, 30)
local IRON_2 = Color3.fromRGB(43, 46, 55)
local CHROME = Color3.fromRGB(205, 212, 224)
local GRIP = Color3.fromRGB(120, 126, 138)
local CLIP_RED = Color3.fromRGB(242, 64, 64)
local CLIP_RED_DARK = Color3.fromRGB(187, 34, 34)
local CLIP_BLACK = Color3.fromRGB(28, 31, 37)

local activeCharacter = nil
local activeStation = nil
local joints = {}
local baseC0 = {}
local visualModels = {}
local gripMotors = {}
local jointTweens = {}
local gripTweens = {}
local deadliftTweens = {}
local deadliftBaseTransform = {}
local activeGripLow = nil
local activeGripHigh = nil
local pressRender = nil
local pressPoseConnection = nil
local pressCore = nil
local pressAnimateScript = nil
local pressAnimateWasDisabled = nil
local PRESS_BIND_NAME = "GymLegendsShoulderPress"
local pressSteppedConn = nil
local PRESS_KEYS = { "RS", "LS", "RE", "LE", "RW", "LW", "Waist" }
local pressTorso = nil
local pressRightHand = nil
local pressLeftHand = nil
local pressRightGrip = nil
local pressLeftGrip = nil
local pressIK = {}
local pressTargets = {}
local pressAlpha = 0
local pressFromAlpha = 0
local pressToAlpha = 0
local pressAnimStart = 0
local pressAnimDuration = 0
local pressAnimating = false
local repBusy = false
local generation = 0
local pressSweatGui = nil
local pressSweatLayer = nil
local pressSweatActive = false
local pressLastSweat = 0
local pressSweatSequence = 0
local HEAD_SWEAT_DROPS = false

local A = math.rad
local function ang(x, y, z)
	return CFrame.Angles(A(x or 0), A(y or 0), A(z or 0))
end

local function setupPart(part)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = true
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function newAssembly(name)
	local model = Instance.new("Model")
	model.Name = name

	local core = setupPart(Instance.new("Part"))
	core.Name = "Core"
	core.Size = Vector3.new(0.08, 0.08, 0.08)
	core.Transparency = 1
	core.CastShadow = false
	core.CFrame = CFrame.new()
	core.Parent = model
	model.PrimaryPart = core
	return model, core
end

local function addPart(model, core, name, size, color, material, relative, shape)
	local p = setupPart(Instance.new("Part"))
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	if shape then p.Shape = shape end
	p.CFrame = core.CFrame * (relative or CFrame.new())
	p.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Name = "VisualWeld"
	weld.Part0 = core
	weld.Part1 = p
	weld.Parent = p
	return p
end

local function cylinder(model, core, name, length, diameter, relative, color, material)
	return addPart(
		model,
		core,
		name,
		Vector3.new(length, diameter, diameter),
		color or IRON,
		material or Enum.Material.Metal,
		relative,
		Enum.PartType.Cylinder
	)
end

-- Plates are kept visually separate so they read cleanly from third person.
local function quickClip(model, core, side, x, scale)
	local clipX = side * x
	local body = cylinder(model, core, "QuickClipBody", 0.26 * scale, 0.76 * scale,
		CFrame.new(clipX, 0, 0), CLIP_RED, Enum.Material.SmoothPlastic)
	cylinder(model, core, "QuickClipRubber", 0.28 * scale, 0.54 * scale,
		CFrame.new(clipX, 0, 0), CLIP_BLACK, Enum.Material.SmoothPlastic)
	for _, yz in ipairs({
		{ 0.23,  0.23 },
		{ 0.23, -0.23 },
		{-0.23,  0.23 },
		{-0.23, -0.23 },
	}) do
		addPart(model, core, "QuickClipBoltTab",
			Vector3.new(0.09 * scale, 0.11 * scale, 0.11 * scale),
			CLIP_RED_DARK, Enum.Material.SmoothPlastic,
			CFrame.new(clipX + side * 0.015 * scale, yz[1] * scale, yz[2] * scale))
	end
	addPart(model, core, "QuickClipLeverArm",
		Vector3.new(0.16 * scale, 0.42 * scale, 0.40 * scale),
		CLIP_RED_DARK, Enum.Material.SmoothPlastic,
		CFrame.new(clipX + side * 0.14 * scale, 0.05 * scale, 0))
	addPart(model, core, "QuickClipLeverPad",
		Vector3.new(0.24 * scale, 0.52 * scale, 0.46 * scale),
		CLIP_RED, Enum.Material.SmoothPlastic,
		CFrame.new(clipX + side * 0.25 * scale, -0.02 * scale, 0))
	for _, grooveY in ipairs({-0.13, 0, 0.13}) do
		addPart(model, core, "QuickClipLeverGroove",
			Vector3.new(0.03 * scale, 0.05 * scale, 0.26 * scale),
			CLIP_RED_DARK, Enum.Material.SmoothPlastic,
			CFrame.new(clipX + side * 0.265 * scale, grooveY * scale, 0))
	end
	return body
end

local function plateText(part, side, text)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PlateLabel"
	gui.Face = side &gt; 0 and Enum.NormalId.Right or Enum.NormalId.Left
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 38
	gui.LightInfluence = 0.25
	gui.AlwaysOnTop = false
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = Color3.fromRGB(232, 232, 236)
	label.TextStrokeColor3 = Color3.fromRGB(20, 20, 24)
	label.TextStrokeTransparency = 0.25
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = gui
end

local CAST_FONT_5X7 = {
	["A"] = {"01110","10001","10001","11111","10001","10001","10001"},
	["B"] = {"11110","10001","10001","11110","10001","10001","11110"},
	["D"] = {"11110","10001","10001","10001","10001","10001","11110"},
	["E"] = {"11111","10000","10000","11110","10000","10000","11111"},
	["G"] = {"01110","10001","10000","10111","10001","10001","01110"},
	["K"] = {"10001","10010","10100","11000","10100","10010","10001"},
	["L"] = {"10000","10000","10000","10000","10000","10000","11111"},
	["N"] = {"10001","11001","10101","10011","10001","10001","10001"},
	["R"] = {"11110","10001","10001","11110","10100","10010","10001"},
	["S"] = {"01111","10000","10000","01110","00001","00001","11110"},
	["T"] = {"11111","00100","00100","00100","00100","00100","00100"},
	["2"] = {"01110","10001","00001","00010","00100","01000","11111"},
	["5"] = {"11111","10000","10000","11110","00001","00001","11110"},
	[" "] = {"00000","00000","00000","00000","00000","00000","00000"},
}

local function addEmbossedGlyph(model, core, side, faceX, text, centerY, centerZ, cell, depth, color, rotDeg)
	local rows, cols = 7, 5
	local charGap = cell * 1.6
	local textW = (#text * cols + math.max(0, #text - 1) * 2) * cell
	local startZ = centerZ - textW * 0.5 + cell * 0.5
	local rot = CFrame.Angles(0, 0, math.rad(rotDeg or 0))
	for idx = 1, #text do
		local ch = string.sub(text, idx, idx)
		local glyph = CAST_FONT_5X7[ch] or CAST_FONT_5X7[" "]
		local charBaseZ = startZ + ((idx - 1) * (cols * cell + charGap))
		for r = 1, rows do
			local row = glyph[r]
			for c = 1, cols do
				if string.sub(row, c, c) == "1" then
					local y = centerY + ((rows + 1) / 2 - r) * cell
					local z = charBaseZ + (c - 1) * cell
					addPart(model, core, "Emboss", Vector3.new(depth, cell * 0.92, cell * 0.92), color, Enum.Material.Metal, CFrame.new(faceX, y, side * z) * rot)
				end
			end
		end
	end
end

local function addEmbossedMultiLine(model, core, side, faceX, lines, centerY, centerZ, lineGap, cell, depth, color, rotDeg)
	local totalH = (#lines - 1) * lineGap
	for i, line in ipairs(lines) do
		addEmbossedGlyph(model, core, side, faceX, line, centerY + totalH * 0.5 - (i - 1) * lineGap, centerZ, cell, depth, color, rotDeg)
	end
end

local function castIronPlateLabels(model, core, side, faceX, diameter, scale)
	local textColor = Color3.fromRGB(232, 232, 236)
	local smallCell = 0.062 * scale
	local bigCell = 0.072 * scale
	local depth = 0.040 * scale
	addEmbossedGlyph(model, core, side, faceX, "BARBELL", diameter * 0.29, 0, smallCell, depth, textColor, 0)
	addEmbossedMultiLine(model, core, side, faceX, {"25", "KGS"}, 0, -diameter * 0.28, 0.34 * scale, bigCell, depth, textColor, 0)
	addEmbossedMultiLine(model, core, side, faceX, {"55", "LBS"}, 0, diameter * 0.28, 0.34 * scale, bigCell, depth, textColor, 0)
	addEmbossedGlyph(model, core, side, faceX, "STANDARD", -diameter * 0.29, 0, smallCell, depth, textColor, 180)
end

local function addCastIronPlate(model, core, side, x, diameter, thickness, scale, showLabels)
	local BLACK = Color3.fromRGB(24, 24, 24)
	local BLACK_2 = Color3.fromRGB(34, 34, 34)
	local BLACK_3 = Color3.fromRGB(12, 12, 14)

	-- Rough cast-iron body.
	local body = cylinder(
		model, core, "CastIronPlate", thickness, diameter, CFrame.new(x, 0, 0),
		BLACK, Enum.Material.Slate
	)

	local faceX = x + side * (thickness * 0.52)

	-- Raised rim and recessed field.
	cylinder(model, core, "OuterRim", 0.085 * scale, diameter * 0.985,
		CFrame.new(faceX, 0, 0), BLACK_2, Enum.Material.Metal)
	cylinder(model, core, "RecessedFace", 0.092 * scale, diameter * 0.855,
		CFrame.new(faceX + side * 0.018 * scale, 0, 0), BLACK, Enum.Material.Slate)

	-- Big raised center boss + steel bore.
	cylinder(model, core, "CenterBoss", 0.115 * scale, diameter * 0.31,
		CFrame.new(faceX + side * 0.038 * scale, 0, 0), BLACK_2, Enum.Material.Metal)
	cylinder(model, core, "CenterBoreShadow", 0.125 * scale, diameter * 0.135,
		CFrame.new(faceX + side * 0.052 * scale, 0, 0), BLACK_3, Enum.Material.Metal)
	cylinder(model, core, "CenterBore", 0.132 * scale, diameter * 0.082,
		CFrame.new(faceX + side * 0.062 * scale, 0, 0), CHROME, Enum.Material.Metal)

	-- Four raised diagonal reinforcing ribs, like the user's reference plate.
	for _, angleDeg in ipairs({45, 135, 225, 315}) do
		local a = math.rad(angleDeg)
		local r = diameter * 0.255
		local y = math.sin(a) * r
		local z = math.cos(a) * r
		addPart(
			model, core, "RaisedRib",
			Vector3.new(0.105 * scale, diameter * 0.055, diameter * 0.38),
			BLACK_2, Enum.Material.Metal,
			CFrame.new(faceX + side * 0.060 * scale, y, z) * CFrame.Angles(a, 0, 0)
		)
	end

	-- A second thin ring just inside the outer lip makes the recess obvious.
	cylinder(model, core, "InnerRim", 0.102 * scale, diameter * 0.925,
		CFrame.new(faceX + side * 0.045 * scale, 0, 0), BLACK_3, Enum.Material.Metal)
	cylinder(model, core, "InnerField", 0.108 * scale, diameter * 0.865,
		CFrame.new(faceX + side * 0.054 * scale, 0, 0), BLACK, Enum.Material.Slate)

	-- Re-add the ribs above the inner field so they remain visibly raised.
	for _, angleDeg in ipairs({45, 135, 225, 315}) do
		local a = math.rad(angleDeg)
		local r = diameter * 0.255
		local y = math.sin(a) * r
		local z = math.cos(a) * r
		addPart(
			model, core, "RaisedRibTop",
			Vector3.new(0.040 * scale, diameter * 0.048, diameter * 0.36),
			Color3.fromRGB(42, 42, 42), Enum.Material.Metal,
			CFrame.new(faceX + side * 0.112 * scale, y, z) * CFrame.Angles(a, 0, 0)
		)
	end

	-- Bring the boss back above the ribs.
	cylinder(model, core, "CenterBossTop", 0.125 * scale, diameter * 0.29,
		CFrame.new(faceX + side * 0.120 * scale, 0, 0), BLACK_2, Enum.Material.Slate)
	cylinder(model, core, "CenterBoreTop", 0.135 * scale, diameter * 0.082,
		CFrame.new(faceX + side * 0.136 * scale, 0, 0), CHROME, Enum.Material.Metal)

	if showLabels then
		castIronPlateLabels(model, core, side, faceX + side * 0.155 * scale, diameter, scale)
	end
	return body
end

local function addPlateStack(model, core, side, innerX, count, plateT, plateD, gap, scale, color, labelText)
	local colored = color ~= nil
	local faceColor = colored and color:Lerp(Color3.new(1, 1, 1), 0.10) or IRON_2
	for i = 1, count do
		local x = side * (innerX + (i - 0.5) * plateT + (i - 1) * gap)
		local diameter = plateD * (1 - (i - 1) * 0.025)
		local plateColor = colored and color or ((i % 2 == 0) and IRON_2 or IRON)
		local p = cylinder(model, core, "WeightPlate", plateT, diameter, CFrame.new(x, 0, 0), plateColor, Enum.Material.Metal)
		local faceX = x + side * (plateT * 0.52)

		-- Solid plate: raised lip, flat face, embossed ring and a chrome hub that fills the
		-- centre (no dark recess / bore, which used to look like a hole in the metal).
		local ringColor = plateColor:Lerp(Color3.new(0, 0, 0), 0.18)
		cylinder(model, core, "PlateOuterLip", 0.060 * scale, diameter * 0.98, CFrame.new(faceX, 0, 0), faceColor, Enum.Material.Metal)
		cylinder(model, core, "PlateFace", 0.070 * scale, diameter * 0.84, CFrame.new(faceX + side * 0.006 * scale, 0, 0), plateColor, Enum.Material.Metal)
		cylinder(model, core, "PlateEmbossRing", 0.080 * scale, diameter * 0.60, CFrame.new(faceX + side * 0.012 * scale, 0, 0), ringColor, Enum.Material.Metal)
		cylinder(model, core, "PlateField", 0.090 * scale, diameter * 0.52, CFrame.new(faceX + side * 0.016 * scale, 0, 0), faceColor, Enum.Material.Metal)
		cylinder(model, core, "PlateHub", 0.120 * scale, math.max(0.30 * scale, diameter * 0.26), CFrame.new(faceX + side * 0.024 * scale, 0, 0), CHROME, Enum.Material.Metal)

		if labelText and i == count then
			plateText(p, side, labelText)
		end
	end
end

local function buildDumbbell(scale, plateCount)
	local model, core = newAssembly("HeldDumbbell")
	local gripLen = 1.02 * scale
	local gripD = 0.18 * scale
	local sleeveLen = 0.24 * scale
	local sleeveD = 0.28 * scale
	local plateT = 0.17 * scale
	local plateD = 0.88 * scale
	local gap = 0.045 * scale

	cylinder(model, core, "KnurledGrip", gripLen, gripD, CFrame.new(), GRIP, Enum.Material.DiamondPlate)
	for _, side in ipairs({ -1, 1 }) do
		local sleeveX = side * (gripLen * 0.5 + sleeveLen * 0.5)
		cylinder(model, core, "Sleeve", sleeveLen, sleeveD, CFrame.new(sleeveX, 0, 0), CHROME, Enum.Material.Metal)
		local innerX = gripLen * 0.5 + sleeveLen
		addPlateStack(model, core, side, innerX, plateCount, plateT, plateD, gap, scale)
		local endX = innerX + plateCount * plateT + math.max(0, plateCount - 1) * gap + 0.08 * scale
		cylinder(model, core, "Collar", 0.13 * scale, 0.43 * scale, CFrame.new(side * endX, 0, 0), CHROME, Enum.Material.Metal)
	end
	return model, core
end

local function buildBarbell(scale, plateCount, squat, plateColor)
	local model, core = newAssembly(squat and "HeldShoulderPressBar" or "HeldDeadliftBar")

	if true then -- deadlift and shoulder press use the exact same bar
		-- The same round competition bar as the one on the rack (see GymShared.BarbellDesign).
		local pieces, labels = BarbellDesign.PressBar(scale)
		local built = {}
		for _, piece in ipairs(pieces) do
			local material = materialOf(piece.Material)
			if piece.Shape == "Cyl" then
				local rel = CFrame.new(piece.Pos)
				if piece.Axis == "Y" then
					rel = rel * CFrame.Angles(0, 0, math.rad(90))
				end
				built[piece] = cylinder(model, core, piece.Name, piece.Len, piece.D, rel, piece.Color, material)
			else
				built[piece] = addPart(model, core, piece.Name, piece.Size, piece.Color, material, CFrame.new(piece.Pos), Enum.PartType.Ball)
			end
		end
		for _, label in ipairs(labels) do
			BarbellDesign.Label(built[label.Piece], label.Side)
		end
	else
		local barLen = 8.05 * scale
		local barD = 0.16 * scale
		local sleeveLen = 1.72 * scale
		local sleeveD = 0.28 * scale
		local plateT = 0.34 * scale
		local plateD = 2.00 * scale
		local gap = 0.055 * scale
		local count = math.clamp(plateCount, 2, 4)

		cylinder(model, core, "Bar", barLen, barD, CFrame.new(), GRIP, Enum.Material.DiamondPlate)
		for _, side in ipairs({-1, 1}) do
			local sleeveCenter = side * (3.10 * scale)
			cylinder(model, core, "Sleeve", sleeveLen, sleeveD,
				CFrame.new(sleeveCenter, 0, 0), CHROME, Enum.Material.Metal)
			local innerX = 2.40 * scale
			addPlateStack(model, core, side, innerX, count, plateT, plateD, gap, scale, plateColor, nil)
			local endX = innerX + count * plateT + math.max(0, count - 1) * gap + 0.10 * scale
			cylinder(model, core, "Collar", 0.16 * scale, 0.42 * scale,
				CFrame.new(side * endX, 0, 0), CHROME, Enum.Material.Metal)
		end
	end

	return model, core
end

local function findMotor(character, partNames, motorNames)
	-- Roblox rigs do not always parent Motor6Ds under the same body part. Search the
	-- expected places first, then fall back to the entire character hierarchy.
	for _, partName in ipairs(partNames) do
		local part = character:FindFirstChild(partName)
		if part then
			for _, motorName in ipairs(motorNames) do
				local motor = part:FindFirstChild(motorName)
				if motor and motor:IsA("Motor6D") then return motor end
			end
		end
	end
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("Motor6D") then
			for _, motorName in ipairs(motorNames) do
				if obj.Name == motorName then return obj end
			end
		end
	end
	return nil
end

local function grabJoints(character)
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then return {}, {} end
	local j = {}
	if hum.RigType == Enum.HumanoidRigType.R15 then
		j.RS = findMotor(character, { "RightUpperArm", "UpperTorso" }, { "RightShoulder", "Right Shoulder" })
		j.RE = findMotor(character, { "RightLowerArm", "RightUpperArm" }, { "RightElbow", "Right Elbow" })
		j.RW = findMotor(character, { "RightHand", "RightLowerArm" }, { "RightWrist", "Right Wrist" })
		j.LS = findMotor(character, { "LeftUpperArm", "UpperTorso" }, { "LeftShoulder", "Left Shoulder" })
		j.LE = findMotor(character, { "LeftLowerArm", "LeftUpperArm" }, { "LeftElbow", "Left Elbow" })
		j.LW = findMotor(character, { "LeftHand", "LeftLowerArm" }, { "LeftWrist", "Left Wrist" })
		j.RH = findMotor(character, { "RightUpperLeg", "LowerTorso" }, { "RightHip", "Right Hip" })
		j.LH = findMotor(character, { "LeftUpperLeg", "LowerTorso" }, { "LeftHip", "Left Hip" })
		j.RK = findMotor(character, { "RightLowerLeg", "RightUpperLeg" }, { "RightKnee", "Right Knee" })
		j.LK = findMotor(character, { "LeftLowerLeg", "LeftUpperLeg" }, { "LeftKnee", "Left Knee" })
		j.Waist = findMotor(character, { "UpperTorso", "LowerTorso" }, { "Waist" })
		j.Root = findMotor(character, { "LowerTorso", "HumanoidRootPart" }, { "Root", "RootJoint" })
	else
		j.RS = findMotor(character, { "Torso" }, { "Right Shoulder" })
		j.LS = findMotor(character, { "Torso" }, { "Left Shoulder" })
		j.RH = findMotor(character, { "Torso" }, { "Right Hip" })
		j.LH = findMotor(character, { "Torso" }, { "Left Hip" })
		j.Root = findMotor(character, { "HumanoidRootPart", "Torso" }, { "RootJoint", "Root" })
	end

	local base = {}
	for key, motor in pairs(j) do
		if motor then base[key] = motor.C0 end
	end
	return j, base
end

local function cancelTween(map, key)
	local t = map[key]
	if t then
		t:Cancel()
		map[key] = nil
	end
end

local function tweenJoint(key, offset, duration, easingDirection)
	local motor = joints[key]
	local base = baseC0[key]
	if not motor or not motor.Parent or not base then return end
	cancelTween(jointTweens, key)
	local t = TweenService:Create(
		motor,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, easingDirection or Enum.EasingDirection.Out),
		{ C0 = base * (offset or CFrame.new()) }
	)
	jointTweens[key] = t
	t:Play()
end

local function applyPose(pose, duration, direction)
	for key in pairs(joints) do
		tweenJoint(key, pose[key] or CFrame.new(), duration, direction)
	end
end

-- Deadlift uses Motor6D.Transform instead of C0. Studio reports C0 as read-only
-- for the live character joints in this place, so using Transform keeps the
-- free-weight animation writable and prevents attach/rep/reset errors.
-- Poses are deliberately stronger than the old ones so the movement is obvious
-- from the normal Roblox third-person camera.
local READY = {
	Dumbbell = {
		-- Hammer-curl start: arms hang by the sides, palms facing in (neutral grip).
		RS = ang(4, 0, 6), LS = ang(4, 0, -6),
		RE = ang(10), LE = ang(10),
		RW = ang(0), LW = ang(0),
		Waist = ang(-1),
	},
	Squat = {
		-- Front-rack start: upper chest/shoulder height, elbows under/slightly forward.
		RS = ang(47, 0, 34), LS = ang(47, 0, -34),
		RE = ang(118, 0, 0), LE = ang(118, 0, 0),
		RW = ang(6, 0, 5), LW = ang(6, 0, -5),
		Waist = ang(-3),
	},
	Deadlift = {
		RS = ang(11, -2, 7), LS = ang(11, 2, -7),
		RE = ang(6), LE = ang(6),
		RW = ang(0, 0, 4), LW = ang(0, 0, -4),
		Waist = ang(-7),
	},
}

local hammerSide = "Right"

local REP = {
	Dumbbell = {
		-- Curl top: upper arm stays near the body, forearm comes up to the shoulder.
		RS = ang(14, 0, 8), LS = ang(14, 0, -8),
		RE = ang(125), LE = ang(125),
		RW = ang(-10), LW = ang(-10),
		Waist = ang(-4),
	},
	Squat = {
		-- Near lockout overhead: symmetrical arms with soft elbows and aligned wrists.
		RS = ang(166, 0, 9), LS = ang(166, 0, -9),
		RE = ang(7), LE = ang(7),
		RW = ang(-2, 0, 2), LW = ang(-2, 0, -2),
		Waist = ang(2),
	},
	DeadliftLow = {
		RS = ang(20, -2, 6), LS = ang(20, 2, -6),
		RE = ang(4), LE = ang(4),
		RH = ang(51), LH = ang(51), RK = ang(-62), LK = ang(-62),
		Waist = ang(-48), Root = CFrame.new(0, -0.92, 0.28),
	},
}

-- R6 has one rigid part per arm, so curls/presses use the shoulder motors directly.
-- These are intentionally classic/blocky rather than trying to fake an R15 elbow.
local READY_R6 = {
	Dumbbell = { RS = ang(0, 0, 8), LS = ang(0, 0, -8) },
	-- R6: arms out to the sides holding the bar on the back (X = sideways on R6 shoulders).
	-- R6 press start: straight arms forward at shoulder height (Z = forward on R6 shoulders).
	Squat = { RS = ang(0, 0, 95), LS = ang(0, 0, -95) },
	Deadlift = { RS = ang(0, 0, 10), LS = ang(0, 0, -10) },
}
local REP_R6 = {
	Dumbbell = { RS = ang(0, 0, 95), LS = ang(0, 0, -95) },
	-- R6 squat: thighs come forward (+Z right hip / -Z left hip) and the body drops.
	-- R6 press lockout: arms straight up overhead.
	Squat = { RS = ang(0, 0, 176), LS = ang(0, 0, -176) },
	DeadliftLow = { RS = ang(0, 0, 40), LS = ang(0, 0, -40), RH = ang(0, 0, 40), LH = ang(0, 0, -40), Root = CFrame.new(0, 0.2, -0.7) },
}

-- Deadlift: the same technique as the working shoulder press - the pose is written to the
-- joints' C0 every frame from a render step (after the Animator), blended between the
-- lockout pose (READY) and the bottom of the lift (REP.DeadliftLow).
local DEADLIFT_BIND_NAME = "PlusOneGymDeadlift"
local deadlift = nil -- { Ready = pose, Low = pose, Alpha, From, To, Start, Dur }

local function deadliftStep()
	local d = deadlift
	if not d then return end
	local t = d.Dur &gt; 0 and math.clamp((os.clock() - d.Start) / d.Dur, 0, 1) or 1
	local e = t * t * (3 - 2 * t)
	d.Alpha = d.From + (d.To - d.From) * e
	for key, motor in pairs(joints) do
		local base = baseC0[key]
		if motor and motor.Parent and base then
			local a = d.Ready[key] or CFrame.new()
			local b = d.Low[key] or CFrame.new()
			pcall(function() motor.C0 = base * a:Lerp(b, d.Alpha) end)
		end
	end
end

local function cacheDeadliftTransforms(r6)
	deadlift = { Ready = r6 and READY_R6.Deadlift or READY.Deadlift, Low = r6 and REP_R6.DeadliftLow or REP.DeadliftLow,
		Alpha = 0, From = 0, To = 0, Start = os.clock(), Dur = 0 }
	RunService:UnbindFromRenderStep(DEADLIFT_BIND_NAME)
	RunService:BindToRenderStep(DEADLIFT_BIND_NAME, Enum.RenderPriority.Character.Value + 20, deadliftStep)
end

-- target: 0 = standing lockout, 1 = bottom of the lift
local function driveDeadlift(target, duration)
	if not deadlift then return end
	deadlift.From = deadlift.Alpha
	deadlift.To = target
	deadlift.Start = os.clock()
	deadlift.Dur = duration
end

local function resetDeadliftTransforms()
	RunService:UnbindFromRenderStep(DEADLIFT_BIND_NAME)
	deadlift = nil
end

local function bodyScale(character)
	local hum = character:FindFirstChildOfClass("Humanoid")
	local width = hum and hum:FindFirstChild("BodyWidthScale")
	return math.clamp(width and width.Value or 1, 0.85, 1.65)
end

local function handGripFrame(hand, side, upOffset, forwardOffset, r6)
	if r6 then
		-- Classic R6 arms are 2 studs tall; the palm is at the lower end of the arm.
		-- Keep the center of the handle physically inside the blocky hand area.
		return CFrame.new(0, -(hand.Size.Y * 0.46) + (upOffset or 0), forwardOffset or 0)
	end
	local attachmentName = side == "Right" and "RightGripAttachment" or "LeftGripAttachment"
	local attachment = hand:FindFirstChild(attachmentName)
	local base
	if attachment and attachment:IsA("Attachment") then
		base = attachment.CFrame
	else
		base = CFrame.new(0, -(hand.Size.Y * 0.34), 0)
	end
	return base * CFrame.new(0, upOffset or 0, forwardOffset or 0)
end

local function dumbbellGripFrame(hand, side, scale, r6)
	return handGripFrame(hand, side, r6 and 0.03 * scale or 0.10 * scale, 0, r6)
end

local function barGripFrame(hand, side, scale, r6)
	return handGripFrame(hand, side, r6 and 0.02 * scale or 0.14 * scale, r6 and -0.02 * scale or 0.04 * scale, r6)
end

-- Held weights are NOT joined to the character with physics joints any more (those
-- could break loose and drop the weight on the floor). The weight's core is anchored
-- and snapped to the hand every frame, so it can never fall.
local followers = {}

-- World position of a hand's palm (R15 grip attachment, or the bottom of an R6 arm).
local function palmPosition(hand)
	local att = hand:FindFirstChild("RightGripAttachment") or hand:FindFirstChild("LeftGripAttachment")
	if att and att:IsA("Attachment") then
		return att.WorldPosition
	end
	return (hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.45, 0)).Position
end

local function snapFollowers()
	for i = #followers, 1, -1 do
		local f = followers[i]
		if f.TwoHand then
			if f.Right.Parent and f.Left.Parent and f.Bar.Parent and f.Torso.Parent then
				-- Bar stays centered between both palms and level relative to the torso.
				local r, l = palmPosition(f.Right), palmPosition(f.Left)
				f.Bar.CFrame = CFrame.fromMatrix(
					(r + l) * 0.5,
					f.Torso.CFrame.RightVector,
					f.Torso.CFrame.UpVector,
					-f.Torso.CFrame.LookVector
				)
			else
				table.remove(followers, i)
			end
		elseif f.Part0.Parent and f.Part1.Parent then
			f.Part1.CFrame = f.Part0.CFrame * f.C0 * f.C1Inv
		else
			table.remove(followers, i)
		end
	end
end
RunService.RenderStepped:Connect(snapFollowers)
RunService.Stepped:Connect(snapFollowers)

local function newTwoHandGrip(rightHand, leftHand, torso, bar)
	bar.Anchored = true
	local rec = { TwoHand = true, Right = rightHand, Left = leftHand, Torso = torso, Bar = bar }
	followers[#followers + 1] = rec
	return rec
end

local function newGrip(part0, part1, name, c0, c1)
	part1.Anchored = true
	local rec = { Name = name, Part0 = part0, Part1 = part1, C0 = c0 or CFrame.new(), C1Inv = (c1 or CFrame.new()):Inverse() }
	followers[#followers + 1] = rec
	part1.CFrame = part0.CFrame * rec.C0 * rec.C1Inv
	return rec
end

-- Shoulder press controller.
-- R15 is driven with IKControl so the normal Animator can keep locomotion on the
-- lower body while the hands stay attached to a stable, symmetrical shoulder-press
-- path.  The target attachments move from upper-chest height to overhead lockout.
-- R6 uses a Motor6D.Transform fallback written during PreSimulation.
local pressMoveState = nil
local pressR6 = false
local pressGripHalf = 0.82
local pressHumanoid = nil

local PRESS_PATH = {
	-- Torso-relative hand path. The pole values below are intentionally low so
	-- the elbows prefer to stay underneath the wrists instead of kicking sideways.
	{ Alpha = 0.00, Y = 0.18, Z = -0.60, PoleY = -1.18, PoleZ = -0.78 },
	{ Alpha = 0.28, Y = 0.78, Z = -0.50, PoleY = -1.18, PoleZ = -0.78 },
	{ Alpha = 0.60, Y = 1.62, Z = -0.26, PoleY = -1.18, PoleZ = -0.78 },
	{ Alpha = 0.84, Y = 2.40, Z = -0.10, PoleY = -1.18, PoleZ = -0.78 },
	{ Alpha = 1.00, Y = 2.96, Z = -0.04, PoleY = -1.18, PoleZ = -0.78 },
}

local function smooth01(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function pathValues(alpha)
	alpha = math.clamp(alpha, 0, 1)
	local a, b = PRESS_PATH[1], PRESS_PATH[#PRESS_PATH]
	for i = 1, #PRESS_PATH - 1 do
		if alpha &gt;= PRESS_PATH[i].Alpha and alpha &lt;= PRESS_PATH[i + 1].Alpha then
			a, b = PRESS_PATH[i], PRESS_PATH[i + 1]
			break
		end
	end
	local span = math.max(0.0001, b.Alpha - a.Alpha)
	local t = smooth01((alpha - a.Alpha) / span)
	return
		a.Y + (b.Y - a.Y) * t,
		a.Z + (b.Z - a.Z) * t,
		a.PoleY + (b.PoleY - a.PoleY) * t,
		a.PoleZ + (b.PoleZ - a.PoleZ) * t
end

local function destroyPressIK()
	for _, ik in pairs(pressIK) do
		if ik and ik.Parent then ik:Destroy() end
	end
	for _, target in pairs(pressTargets) do
		if target and target.Parent then target:Destroy() end
	end
	table.clear(pressIK)
	table.clear(pressTargets)
	pressHumanoid = nil
end

local function setPressAlpha(alpha)
	pressAlpha = math.clamp(alpha, 0, 1)
	if pressR6 then return end
	local y, z = pathValues(pressAlpha)
	local rt = pressTargets.Right
	local lt = pressTargets.Left
	local rp = pressTargets.RightPole
	local lp = pressTargets.LeftPole
	if rt and rt.Parent then rt.CFrame = CFrame.new( pressGripHalf, y, z) end
	if lt and lt.Parent then lt.CFrame = CFrame.new(-pressGripHalf, y, z) end
	-- FLIPPED bend direction: keep the pole on the same-side wrist X, but move it
	-- behind the torso instead of in front. This makes the IK chain choose the
	-- opposite elbow plane without changing the working hand/bar path.
	local fixedPoleY = -0.82
	local fixedPoleZ = 0.96
	if rp and rp.Parent then rp.CFrame = CFrame.new( pressGripHalf, fixedPoleY, fixedPoleZ) end
	if lp and lp.Parent then lp.CFrame = CFrame.new(-pressGripHalf, fixedPoleY, fixedPoleZ) end
end

local function setupPressIK(character, humanoid, torso, rightHand, leftHand)
	destroyPressIK()
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then return false end
	local rightUpper = character:FindFirstChild("RightUpperArm")
	local leftUpper = character:FindFirstChild("LeftUpperArm")
	if not rightUpper or not leftUpper or not rightHand or not leftHand then return false end

	local rightTarget = Instance.new("Attachment")
	rightTarget.Name = "GymPressRightTarget"
	rightTarget.Parent = torso
	local leftTarget = Instance.new("Attachment")
	leftTarget.Name = "GymPressLeftTarget"
	leftTarget.Parent = torso
	local rightPole = Instance.new("Attachment")
	rightPole.Name = "GymPressRightPole"
	rightPole.Parent = torso
	local leftPole = Instance.new("Attachment")
	leftPole.Name = "GymPressLeftPole"
	leftPole.Parent = torso
	pressTargets.Right = rightTarget
	pressTargets.Left = leftTarget
	pressTargets.RightPole = rightPole
	pressTargets.LeftPole = leftPole

	local rightIK = Instance.new("IKControl")
	rightIK.Name = "GymShoulderPressRightIK"
	rightIK.Type = Enum.IKControlType.Position
	rightIK.ChainRoot = rightUpper
	rightIK.EndEffector = rightHand
	rightIK.Target = rightTarget
	rightIK.Pole = rightPole
	rightIK.Weight = 1
	rightIK.SmoothTime = 0.025
	rightIK.Priority = 100
	rightIK.Parent = humanoid

	local leftIK = Instance.new("IKControl")
	leftIK.Name = "GymShoulderPressLeftIK"
	leftIK.Type = Enum.IKControlType.Position
	leftIK.ChainRoot = leftUpper
	leftIK.EndEffector = leftHand
	leftIK.Target = leftTarget
	leftIK.Pole = leftPole
	leftIK.Weight = 1
	leftIK.SmoothTime = 0.025
	leftIK.Priority = 100
	leftIK.Parent = humanoid

	pressIK.Right = rightIK
	pressIK.Left = leftIK
	pressHumanoid = humanoid
	setPressAlpha(0)
	return true
end

local function clearScreenSweatDrops()
	if not pressSweatLayer then return end
	for _, child in ipairs(pressSweatLayer:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end
end

local function setupPressSweat(character)
	if pressSweatGui and pressSweatGui.Parent then pressSweatGui:Destroy() end
	pressSweatGui = nil
	pressSweatLayer = nil
	pressSweatActive = false
	pressLastSweat = 0
	pressSweatSequence = 0

	-- The 💧 pictures next to the head were replaced by the SweatAura module (a particle
	-- aura every player can see), so no head billboard is created any more.
	local head = character and character:FindFirstChild("Head")
	if not head or not HEAD_SWEAT_DROPS then return end

	local gui = Instance.new("BillboardGui")
	gui.Name = "GymPressHeadSweatFX"
	gui.Adornee = head
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 80
	gui.Size = UDim2.fromOffset(150, 110)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 0.55, 0)
	gui.Enabled = true
	gui.Parent = head

	local layer = Instance.new("Frame")
	layer.Name = "SweatLayer"
	layer.BackgroundTransparency = 1
	layer.BorderSizePixel = 0
	layer.Size = UDim2.fromScale(1, 1)
	layer.ClipsDescendants = false
	layer.Parent = gui

	pressSweatGui = gui
	pressSweatLayer = layer
end

local function makeHeadSweatDrop(side, yOffset)
	if not pressSweatLayer or not pressSweatLayer.Parent then return end
	local drop = Instance.new("TextLabel")
	drop.Name = "SweatDrop"
	drop.AnchorPoint = Vector2.new(0.5, 0.5)
	drop.BackgroundTransparency = 1
	drop.BorderSizePixel = 0
	drop.Size = UDim2.fromOffset(34, 42)
	drop.Position = UDim2.new(side &gt; 0 and 0.82 or 0.18, 0, 0.28 + yOffset, 0)
	drop.Text = "💧"
	drop.TextScaled = true
	drop.Font = Enum.Font.GothamBold
	drop.TextColor3 = Color3.fromRGB(38, 184, 255)
	drop.TextStrokeColor3 = Color3.fromRGB(3, 24, 74)
	drop.TextStrokeTransparency = 0.20
	drop.TextTransparency = 0
	drop.ZIndex = 10
	drop.Parent = pressSweatLayer

	local endX = side &gt; 0 and 0.92 or 0.08
	local tween = TweenService:Create(drop, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(endX, 0, 0.82 + yOffset * 0.4, 0),
		Rotation = side * 12,
		TextTransparency = 0.48,
		TextStrokeTransparency = 0.72,
	})
	tween:Play()
	task.delay(0.82, function()
		if drop and drop.Parent then drop:Destroy() end
	end)
end

local function emitVisibleSweat(force)
	if not pressSweatActive or not pressSweatGui or not pressSweatGui.Parent then return end
	local now = os.clock()
	if not force and pressLastSweat &gt; 0 and now - pressLastSweat &lt; 0.48 then return end
	pressLastSweat = now
	pressSweatSequence = pressSweatSequence + 1
	local side = (pressSweatSequence % 2 == 0) and 1 or -1
	local y = ((pressSweatSequence % 3) - 1) * 0.08
	makeHeadSweatDrop(side, y)
end

local function setPressSweat(on)
	pressSweatActive = on == true
	if pressSweatGui then pressSweatGui.Enabled = true end
	if pressSweatActive then
		pressLastSweat = 0
		pressSweatSequence = 0
		emitVisibleSweat(true)
	else
		clearScreenSweatDrops()
	end
end

local function lockPressMovement()
	if pressMoveState or not activeCharacter then return end
	local hum = activeCharacter:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	pressMoveState = {
		Humanoid = hum,
		WalkSpeed = hum.WalkSpeed,
		AutoRotate = hum.AutoRotate,
		UseJumpPower = hum.UseJumpPower,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum:Move(Vector3.zero, false)
	hum.WalkSpeed = 0
	hum.AutoRotate = false
	if hum.UseJumpPower then hum.JumpPower = 0 else hum.JumpHeight = 0 end
	local root = activeCharacter:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

local function unlockPressMovement()
	local state = pressMoveState
	pressMoveState = nil
	if not state then return end
	local hum = state.Humanoid
	if not hum or not hum.Parent then return end
	hum.WalkSpeed = state.WalkSpeed
	hum.AutoRotate = state.AutoRotate
	if state.UseJumpPower then hum.JumpPower = state.JumpPower else hum.JumpHeight = state.JumpHeight end
end

local function getPressGripPosition(hand, attachmentName)
	if not hand or not hand.Parent then return nil end
	local attachment = hand:FindFirstChild(attachmentName)
	if attachment and attachment:IsA("Attachment") then return attachment.WorldPosition end
	return (hand.CFrame * CFrame.new(0, -hand.Size.Y * 0.38, 0)).Position
end

local function updateHeldPressBar()
	if not pressCore or not pressCore.Parent or not pressTorso or not pressTorso.Parent then return end
	local right = getPressGripPosition(pressRightHand, "RightGripAttachment")
	local left = getPressGripPosition(pressLeftHand, "LeftGripAttachment")
	if (not right or not left) and not pressR6 and pressTargets.Right and pressTargets.Left then
		right = pressTargets.Right.WorldPosition
		left = pressTargets.Left.WorldPosition
	end
	if not right or not left then return end
	local center = (right + left) * 0.5
	local xAxis = right - left
	if xAxis.Magnitude &lt; 0.001 then return end
	xAxis = xAxis.Unit
	local upGuess = pressTorso.CFrame.UpVector
	local zAxis = xAxis:Cross(upGuess)
	if zAxis.Magnitude &lt; 0.001 then
		zAxis = xAxis:Cross(pressTorso.CFrame.LookVector)
	end
	zAxis = zAxis.Unit
	local yAxis = zAxis:Cross(xAxis).Unit
	pressCore.CFrame = CFrame.fromMatrix(center, pressTorso.CFrame.RightVector, pressTorso.CFrame.UpVector, -pressTorso.CFrame.LookVector)
end

local function applyPressVisualPose()
	if not activeStation or activeStation.Kind ~= "Squat" then return end
	if pressR6 then
		local t = smooth01(pressAlpha)
		local rs = READY_R6.Squat.RS:Lerp(REP_R6.Squat.RS, t)
		local ls = READY_R6.Squat.LS:Lerp(REP_R6.Squat.LS, t)
		if joints.RS and joints.RS.Parent then joints.RS.Transform = rs end
		if joints.LS and joints.LS.Parent then joints.LS.Transform = ls end
	end

	if pressAnimating then
		local now = os.clock()
		local effort = 0.75 + 0.25 * math.sin(math.pi * math.clamp(pressAlpha, 0, 1)) ^ 2
		-- Visible strain tremble while the rep is active. Keep it small enough to
		-- read as effort rather than a broken rig, but strong enough to notice.
		local hipR = math.rad(math.sin(now * 42.0) * 6.2 * effort)
		local hipL = math.rad(math.sin(now * 42.0 + math.pi) * 6.2 * effort)
		local kneeR = math.rad(math.sin(now * 55.0 + 0.35) * 4.6 * effort)
		local kneeL = math.rad(math.sin(now * 55.0 + 3.50) * 4.6 * effort)
		local sideR = math.rad(math.sin(now * 34.0 + 0.6) * 1.5 * effort)
		local sideL = math.rad(math.sin(now * 34.0 + 3.7) * 1.5 * effort)
		if joints.RH and joints.RH.Parent and baseC0.RH then joints.RH.C0 = baseC0.RH * CFrame.Angles(hipR, 0, sideR) end
		if joints.LH and joints.LH.Parent and baseC0.LH then joints.LH.C0 = baseC0.LH * CFrame.Angles(hipL, 0, sideL) end
		if joints.RK and joints.RK.Parent and baseC0.RK then joints.RK.C0 = baseC0.RK * CFrame.Angles(kneeR, 0, 0) end
		if joints.LK and joints.LK.Parent and baseC0.LK then joints.LK.C0 = baseC0.LK * CFrame.Angles(kneeL, 0, 0) end
		if joints.Waist and joints.Waist.Parent and baseC0.Waist then
			local roll = math.rad(math.sin(now * 36.0) * 1.7 * effort)
			local pitch = math.rad(math.sin(now * 44.0 + 0.8) * 0.8 * effort)
			joints.Waist.C0 = baseC0.Waist * CFrame.Angles(pitch, 0, roll)
		end
		if joints.Root and joints.Root.Parent and baseC0.Root then
			local bob = math.sin(now * 48.0) * 0.018 * effort
			local sway = math.sin(now * 37.0 + 1.2) * 0.012 * effort
			joints.Root.C0 = baseC0.Root * CFrame.new(sway, bob, 0)
		end
		emitVisibleSweat()
	else
		for _, key in ipairs({"RH","LH","RK","LK","Waist","Root"}) do
			local motor = joints[key]
			local base = baseC0[key]
			if motor and motor.Parent and base then motor.C0 = base end
		end
	end
end

local function bindShoulderPressRender()
	RunService:UnbindFromRenderStep(PRESS_BIND_NAME)
	RunService:BindToRenderStep(PRESS_BIND_NAME, Enum.RenderPriority.Character.Value + 20, function()
		applyPressVisualPose()
		updateHeldPressBar()
	end)
	if pressPoseConnection then
		pressPoseConnection:Disconnect()
		pressPoseConnection = nil
	end
end

local function unbindShoulderPressRender()
	RunService:UnbindFromRenderStep(PRESS_BIND_NAME)
	if pressPoseConnection then
		pressPoseConnection:Disconnect()
		pressPoseConnection = nil
	end
	if pressSteppedConn then
		pressSteppedConn:Disconnect()
		pressSteppedConn = nil
	end
end

local function drivePressAlpha(target, duration, myGeneration)
	local startAlpha = pressAlpha
	local elapsed = 0
	while elapsed &lt; duration do
		if generation ~= myGeneration or not activeStation or activeStation.Kind ~= "Squat" then return false end
		elapsed = elapsed + RunService.Heartbeat:Wait()
		local t = math.clamp(elapsed / math.max(duration, 0.01), 0, 1)
		setPressAlpha(startAlpha + (target - startAlpha) * smooth01(t))
	end
	setPressAlpha(target)
	return true
end

local function clearTweenMaps()
	for key, tween in pairs(jointTweens) do
		tween:Cancel()
		jointTweens[key] = nil
	end
	for key, tween in pairs(gripTweens) do
		tween:Cancel()
		gripTweens[key] = nil
	end
end

----------------------------------------------------------------------
-- HAMMER CURL (R15: IKControl, the same system the working shoulder press uses)
--
-- Tweening Motor6D.C0 does not move the arms in this place, so the curl drives each
-- hand with an IKControl of type Transform: the target is the hand's pose for a given
-- curl angle. The elbow stays pinned under the shoulder, the forearm swings up in front
-- and the hand keeps a neutral (thumb-up) grip, so the dumbbell ends up vertical at the
-- top exactly like a real hammer curl. Arms alternate; a crit curls both together.
-- R6 falls back to writing the shoulder Motor6D.Transform every frame.
----------------------------------------------------------------------
local CURL_BIND_NAME = "PlusOneGymHammerCurl"
local CURL_REST = math.rad(10)
local CURL_TOP = math.rad(142)
local curl = {
	Active = false, R6 = false, Character = nil, Torso = nil,
	IK = {}, Targets = {}, Poles = {},
	Phi = { Right = CURL_REST, Left = CURL_REST },
	Busy = { Right = false, Left = false },
}

-- Joint positions of one arm, read from the rig's own attachments every frame (they
-- change when the body scales up with Strength).
local function curlArm(character, side)
	local torso = character:FindFirstChild("UpperTorso")
	local upper = character:FindFirstChild(side .. "UpperArm")
	local lower = character:FindFirstChild(side .. "LowerArm")
	local hand = character:FindFirstChild(side .. "Hand")
	if not (torso and upper and lower and hand) then
		return nil
	end
	local sT = torso:FindFirstChild(side .. "ShoulderRigAttachment")
	local sU = upper:FindFirstChild(side .. "ShoulderRigAttachment")
	local eU = upper:FindFirstChild(side .. "ElbowRigAttachment")
	local eL = lower:FindFirstChild(side .. "ElbowRigAttachment")
	local wL = lower:FindFirstChild(side .. "WristRigAttachment")
	local wH = hand:FindFirstChild(side .. "WristRigAttachment")
	if not (sT and sU and eU and eL and wL and wH) then
		return nil
	end
	return {
		Shoulder = sT.Position,               -- shoulder joint, in UpperTorso space
		UpperVec = eU.Position - sU.Position, -- shoulder -&gt; elbow with the arm hanging
		ForeVec = wL.Position - eL.Position,  -- elbow -&gt; wrist
		HandVec = -wH.Position,               -- wrist -&gt; hand centre
	}
end

-- Hand pose (UpperTorso space) for a curl angle phi (0 = arm hanging straight down).
local function curlHandCFrame(d, phi, side)
	local out = side == "Right" and 0.06 or -0.06
	local s = math.sin(phi)
	local elbow = d.Shoulder + d.UpperVec + Vector3.new(out, 0.04 * s, -0.12 * s) -- elbow drifts a touch forward/up at the top
	local rot = CFrame.Angles(phi, 0, 0)
	local wrist = elbow + rot:VectorToWorldSpace(d.ForeVec)
	local hand = wrist + rot:VectorToWorldSpace(d.HandVec)
	return CFrame.new(hand) * rot
end

local function updateCurl()
	if not curl.Active then
		return
	end
	if curl.R6 then
		-- R6: one rigid arm, raise it forward from the shoulder
		local span = CURL_TOP - CURL_REST
		local tR = math.clamp((curl.Phi.Right - CURL_REST) / span, 0, 1)
		local tL = math.clamp((curl.Phi.Left - CURL_REST) / span, 0, 1)
		if joints.RS and joints.RS.Parent then joints.RS.Transform = CFrame.Angles(0, 0, math.rad(6 + 94 * tR)) end
		if joints.LS and joints.LS.Parent then joints.LS.Transform = CFrame.Angles(0, 0, -math.rad(6 + 94 * tL)) end
		return
	end
	local character = curl.Character
	if not character or not character.Parent then
		return
	end
	for _, side in ipairs({ "Right", "Left" }) do
		local target, pole = curl.Targets[side], curl.Poles[side]
		local d = target and target.Parent and curlArm(character, side)
		if d then
			target.CFrame = curlHandCFrame(d, curl.Phi[side], side)
			-- pole behind the elbow keeps the elbow pointing backwards (pinned to the side)
			local elbow = d.Shoulder + d.UpperVec
			pole.Position = Vector3.new(elbow.X * 1.15, elbow.Y, elbow.Z + 2.5)
		end
	end
end

local function destroyCurlIK()
	for _, list in ipairs({ curl.IK, curl.Targets, curl.Poles }) do
		for key, inst in pairs(list) do
			if inst and inst.Parent then
				inst:Destroy()
			end
			list[key] = nil
		end
	end
end

local function stopCurl()
	curl.Active = false
	RunService:UnbindFromRenderStep(CURL_BIND_NAME)
	destroyCurlIK()
	curl.Busy.Right, curl.Busy.Left = false, false
	curl.Phi.Right, curl.Phi.Left = CURL_REST, CURL_REST
end

local function setupCurl(character, humanoid, r6)
	stopCurl()
	curl.Character = character
	curl.R6 = r6
	curl.Active = true
	if not r6 then
		local torso = character:FindFirstChild("UpperTorso")
		for _, side in ipairs({ "Right", "Left" }) do
			local upper = character:FindFirstChild(side .. "UpperArm")
			local hand = character:FindFirstChild(side .. "Hand")
			if torso and upper and hand then
				local target = Instance.new("Attachment")
				target.Name = "GymCurl" .. side .. "Target"
				target.Parent = torso
				local pole = Instance.new("Attachment")
				pole.Name = "GymCurl" .. side .. "Pole"
				pole.Parent = torso
				local ik = Instance.new("IKControl")
				ik.Name = "GymHammerCurl" .. side .. "IK"
				ik.Type = Enum.IKControlType.Transform
				ik.ChainRoot = upper
				ik.EndEffector = hand
				ik.Target = target
				ik.Pole = pole
				ik.Weight = 1
				ik.SmoothTime = 0.02
				ik.Priority = 100
				ik.Parent = humanoid
				curl.IK[side], curl.Targets[side], curl.Poles[side] = ik, target, pole
			end
		end
		curl.Torso = torso
	end
	RunService:UnbindFromRenderStep(CURL_BIND_NAME)
	RunService:BindToRenderStep(CURL_BIND_NAME, Enum.RenderPriority.Character.Value + 20, updateCurl)
	updateCurl()
end

-- Swing one or both arms to `goal` over `duration` (smoothstep), frame by frame.
local function driveCurl(sides, goal, duration, myGeneration)
	local start = {}
	for _, side in ipairs(sides) do
		start[side] = curl.Phi[side]
	end
	local elapsed = 0
	while elapsed &lt; duration do
		if generation ~= myGeneration or not curl.Active then
			return false
		end
		elapsed = elapsed + RunService.Heartbeat:Wait()
		local t = smooth01(elapsed / math.max(duration, 0.01))
		for _, side in ipairs(sides) do
			curl.Phi[side] = start[side] + (goal - start[side]) * t
		end
	end
	for _, side in ipairs(sides) do
		curl.Phi[side] = goal
	end
	return true
end

-- One hammer-curl rep. Returns false if both arms are still moving.
local function curlRep(crit, myGeneration)
	local sides
	if crit then
		if curl.Busy.Right or curl.Busy.Left then
			return false
		end
		sides = { "Right", "Left" }
	else
		local side = hammerSide
		if curl.Busy[side] then
			side = side == "Right" and "Left" or "Right"
		end
		if curl.Busy[side] then
			return false
		end
		hammerSide = side == "Right" and "Left" or "Right"
		sides = { side }
	end
	for _, side in ipairs(sides) do
		curl.Busy[side] = true
	end
	local upTime, hold, downTime = crit and 0.22 or 0.27, crit and 0.1 or 0.07, crit and 0.24 or 0.29
	task.spawn(function()
		local ok = driveCurl(sides, CURL_TOP, upTime, myGeneration)
		if ok then
			task.wait(hold) -- squeeze at the top
			ok = generation == myGeneration
		end
		if ok then
			driveCurl(sides, CURL_REST, downTime, myGeneration)
		end
		for _, side in ipairs(sides) do
			curl.Busy[side] = false
		end
	end)
	return true
end

function FreeweightAnim.IsFreeWeight(kind)
	return FREE_WEIGHT[kind] == true
end

function FreeweightAnim.Detach()
	generation = generation + 1
	repBusy = false
	stopCurl()
	clearTweenMaps()
	resetDeadliftTransforms()

	-- IMPORTANT: restore immediately. Tweening out during an equipment switch lets the
	-- previous animation keep writing C0 after the next weight has been attached.
	for key, motor in pairs(joints) do
		local base = baseC0[key]
		if motor and motor.Parent and base then
			local ok = pcall(function() motor.C0 = base end)
			if not ok then motor.Transform = CFrame.new() end
		end
	end
	table.clear(followers)
	for _, model in ipairs(visualModels) do
		if model and model.Parent then model:Destroy() end
	end
	pressAnimating = false
	pressAlpha = 0
	setPressSweat(false)
	if pressSweatGui and pressSweatGui.Parent then pressSweatGui:Destroy() end
	pressSweatGui = nil
	pressSweatLayer = nil
	unlockPressMovement()
	unbindShoulderPressRender()
	destroyPressIK()
	if joints.RS and joints.RS.Parent then joints.RS.Transform = CFrame.new() end
	if joints.LS and joints.LS.Parent then joints.LS.Transform = CFrame.new() end
	if joints.Waist and joints.Waist.Parent then joints.Waist.Transform = CFrame.new() end
	if joints.Root and joints.Root.Parent then joints.Root.Transform = CFrame.new() end
	if joints.RH and joints.RH.Parent then joints.RH.Transform = CFrame.new() end
	if joints.LH and joints.LH.Parent then joints.LH.Transform = CFrame.new() end
	if joints.RK and joints.RK.Parent then joints.RK.Transform = CFrame.new() end
	if joints.LK and joints.LK.Parent then joints.LK.Transform = CFrame.new() end
	pressCore = nil
	pressTorso = nil
	pressRightHand = nil
	pressLeftHand = nil
	pressRightGrip = nil
	pressLeftGrip = nil

	activeCharacter = nil
	activeStation = nil
	joints = {}
	baseC0 = {}
	visualModels = {}
	gripMotors = {}
	activeGripLow = nil
	activeGripHigh = nil
end

function FreeweightAnim.Attach(character, station)
	FreeweightAnim.Detach()
	if not character or not character.Parent or not station or not FREE_WEIGHT[station.Kind] then return false end

	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local r6 = hum.RigType == Enum.HumanoidRigType.R6
	local rightHand = r6 and character:FindFirstChild("Right Arm") or character:FindFirstChild("RightHand")
	local leftHand = r6 and character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftHand")

	-- Standard rigs use RightHand/LeftHand (R15) or Right Arm/Left Arm (R6).
	-- Keep a conservative fallback for blocky/custom R15 avatars so the shoulder
	-- press never silently equips with no visible bar.
	if not rightHand then
		rightHand = character:FindFirstChild("RightLowerArm") or character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
	end
	if not leftHand then
		leftHand = character:FindFirstChild("LeftLowerArm") or character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
	end
	if not rightHand or not leftHand then return false end

	activeCharacter = character
	activeStation = station
	hammerSide = "Right"
	joints, baseC0 = grabJoints(character)
	generation = generation + 1
	repBusy = false

	local baseScale = r6 and 1 or bodyScale(character)
	local scale = baseScale * math.clamp(0.90 + (station.AreaIndex or 1) * 0.018, 0.90, 1.08)
	local plateCount = math.clamp(2 + math.floor(((station.AreaIndex or 1) - 1) / 2), 2, 4)
	local area = Config.AreasById[station.Area]
	local plateColor = area and area.Theme and area.Theme.Accent or Color3.fromRGB(92, 60, 205)

	if station.Kind == "Dumbbell" then
		local dumbbellScale = scale * (r6 and 0.70 or 0.72)
		local rightModel, rightCore = buildDumbbell(dumbbellScale, plateCount)
		rightModel.Parent = character
		local leftModel, leftCore = buildDumbbell(dumbbellScale, plateCount)
		leftModel.Parent = character
		visualModels = { rightModel, leftModel }

		-- R6 keeps the dumbbell's X axis horizontal across the palm. R15 uses its
		-- GripAttachment orientation. In both cases the handle center is in the hand.
		local rightC1 = r6 and CFrame.new() or CFrame.Angles(0, 0, math.rad(90))
		local leftC1 = r6 and CFrame.new() or CFrame.Angles(0, 0, math.rad(-90))
		gripMotors = {
			newGrip(rightHand, rightCore, "RightFreeWeightGrip", dumbbellGripFrame(rightHand, "Right", dumbbellScale, r6), rightC1),
			newGrip(leftHand, leftCore, "LeftFreeWeightGrip", dumbbellGripFrame(leftHand, "Left", dumbbellScale, r6), leftC1),
		}
		setupCurl(character, hum, r6)

	elseif station.Kind == "Squat" then
		local model, core = buildBarbell(scale * 0.96, 1, true, plateColor)
		model.Parent = character
		visualModels = { model }

		local torso = r6 and character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
		torso = torso or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
		if not torso then
			FreeweightAnim.Detach()
			return false
		end

		core.Anchored = true
		pressCore = core
		pressTorso = torso
		pressRightHand = rightHand
		pressLeftHand = leftHand
		pressR6 = r6
		pressAnimating = false
		setupPressSweat(character)
		if r6 then
			pressGripHalf = 0.96
		else
			local rightShoulder = torso:FindFirstChild("RightShoulderRigAttachment")
			local leftShoulder = torso:FindFirstChild("LeftShoulderRigAttachment")
			local shoulderHalf = torso.Size.X * 0.50
			if rightShoulder and leftShoulder and rightShoulder:IsA("Attachment") and leftShoulder:IsA("Attachment") then
				shoulderHalf = math.max(math.abs(rightShoulder.Position.X), math.abs(leftShoulder.Position.X))
			end
			-- Slightly outside shoulder width, but still within the actual R15 chain reach.
			-- This stays wide like the reference without making the top target unreachable.
			pressGripHalf = math.clamp(shoulderHalf + 0.28 * bodyScale(character), 1.16, 1.36)
		end
		setPressAlpha(0)

		if not r6 then
			setupPressIK(character, hum, torso, rightHand, leftHand)
		end
		bindShoulderPressRender()
		updateHeldPressBar()
	elseif station.Kind == "Deadlift" then
		local model, core = buildBarbell(scale * 0.96, 1, false, plateColor)
		model.Parent = character
		visualModels = { model }

		-- The old deadlift visual was anchored from only the right hand. That let the
		-- bar drift/twist away from the left hand and could leave the character in a
		-- broken-looking pose when switching equipment. Track both palms instead.
		local torso = r6 and character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
		torso = torso or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
		if not torso then
			FreeweightAnim.Detach()
			return false
		end
		core.Anchored = true
		gripMotors = { newTwoHandGrip(rightHand, leftHand, torso, core) }
		cacheDeadliftTransforms(r6)
	end

	return true
end

function FreeweightAnim.Rep(crit)
	if repBusy or not activeCharacter or not activeCharacter.Parent or not activeStation then return false end
	repBusy = true
	local myGeneration = generation
	local kind = activeStation.Kind
	local up = crit and 0.14 or 0.19
	local down = crit and 0.14 or 0.20
	local hold = crit and 0.025 or 0.045

	local hum = activeCharacter:FindFirstChildOfClass("Humanoid")
	local r6 = hum and hum.RigType == Enum.HumanoidRigType.R6

	if kind == "Dumbbell" then
		-- alternating hammer curls (right, left, right ...); a crit curls both arms.
		-- Each arm has its own busy flag, so fast clicking alternates arms smoothly.
		repBusy = false
		return curlRep(crit, myGeneration)

	elseif kind == "Squat" then
		pressR6 = r6 == true
		pressAnimating = true
		setPressSweat(true)
		lockPressMovement()
		local upTime = crit and 0.52 or 0.72
		local topHold = crit and 0.08 or 0.13
		local downTime = crit and 0.50 or 0.68

		-- Keep the input path responsive: run the visual sequence asynchronously,
		-- while repBusy prevents another rep until the bar is back at the shoulders.
		task.spawn(function()
			local ok = drivePressAlpha(1, upTime, myGeneration)
			if ok and topHold &gt; 0 then task.wait(topHold) end
			if ok then ok = drivePressAlpha(0, downTime, myGeneration) end
			if generation == myGeneration then
				pressAnimating = false
				setPressSweat(false)
				if joints.Waist and joints.Waist.Parent then joints.Waist.Transform = CFrame.new() end
				if joints.Root and joints.Root.Parent then joints.Root.Transform = CFrame.new() end
				repBusy = false
				unlockPressMovement()
			end
		end)
	elseif kind == "Deadlift" then
		local lowerTime = crit and 0.20 or 0.28
		local riseTime = crit and 0.22 or 0.32
		driveDeadlift(1, lowerTime)
		task.delay(lowerTime + hold, function()
			if generation ~= myGeneration or not activeStation or activeStation.Kind ~= "Deadlift" then return end
			driveDeadlift(0, riseTime)
			task.delay(riseTime, function()
				if generation == myGeneration and activeStation and activeStation.Kind == "Deadlift" then
					repBusy = false
				end
			end)
		end)
	else
		repBusy = false
	end
	return true
end

return FreeweightAnim
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX29">
          <Properties>
            <string name="Name">Events</string>
            <ProtectedString name="Source">--[[
	Events - reacts to one-shot messages from the server (notifications, rebirth, milestones,
	orb pick-ups). Gate / area events live in World.lua because they need the gate objects.
]]
local Events = {}

function Events.Init(C)
	local Remotes, Fx, Sfx, HUD, Format, UIKit = C.Remotes, C.Fx, C.Sfx, C.HUD, C.Format, C.UIKit

	Remotes.Get("Notify").OnClientEvent:Connect(function(text, kind)
		HUD.Toast(text, kind)
		if kind == "Error" then
			Sfx.Play("Error")
		elseif kind == "Success" then
			Sfx.Play("LevelUp")
		end
	end)

	Remotes.Get("Announce").OnClientEvent:Connect(function(text, color)
		HUD.Toast(text, "Info", color, 5.5)
		Sfx.Play("Reveal", 0.8, 0.5)
	end)

	Remotes.Get("Milestone").OnClientEvent:Connect(function(magnitude, strength)
		HUD.Toast("💪 Strength reached " .. Format.Number(10 ^ magnitude) .. "!", "Success", UIKit.C.Strength)
		Sfx.Play("LevelUp")
		local pos = Fx.CharacterPosition()
		if pos then
			Fx.Ring(pos - Vector3.new(0, 2.8, 0), UIKit.C.Strength, 24, 0.6)
			Fx.Burst(pos + Vector3.new(0, 2, 0), UIKit.C.Strength, 30, 26, 1)
			Fx.FloatText(pos + Vector3.new(0, 5, 0), "STRENGTH " .. Format.Number(10 ^ magnitude) .. "!", Color3.fromRGB(255, 150, 90), 40, 1.6, 7)
		end
	end)

	Remotes.Get("CoinPickup").OnClientEvent:Connect(function(position, coins)
		Fx.Burst(position, Color3.fromRGB(255, 214, 70), 14, 24, 0.7)
		Fx.FloatText(position + Vector3.new(0, 2, 0), "+" .. Format.Number(coins) .. " 💵", Color3.fromRGB(255, 214, 70), 28, 1, 5)
		Fx.CoinFly(position, coins)
		Sfx.Play("Coin", 1.2)
	end)

	Remotes.Get("Rebirthed").OnClientEvent:Connect(function(rebirths, mult)
		Sfx.Play("Rebirth")
		Fx.Flash(Color3.new(1, 1, 1), 0, 1.4)
		Fx.Confetti(120)
		Fx.Shake(1.2, 0.9)
		Fx.FovPunch(14, 0.8)
		Fx.Banner("⭐ REBIRTH " .. rebirths .. " ⭐", Format.Mult(mult) .. " Strength forever!", UIKit.C.Rebirth, 3.6)
		local pos = Fx.CharacterPosition()
		if pos then
			for i = 1, 3 do
				task.delay(i * 0.18, function()
					Fx.Ring(pos - Vector3.new(0, 2.8, 0), Color3.fromHSV((i * 0.2) % 1, 0.7, 1), 40 + i * 25, 1.1)
				end)
			end
			Fx.Burst(pos + Vector3.new(0, 2, 0), UIKit.C.Rebirth, 70, 48, 1.4)
		end
	end)
end

return Events
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX30">
          <Properties>
            <string name="Name">Fx</string>
            <ProtectedString name="Source">--[[
	Fx - all the "juice": floating numbers, particle bursts, screen flashes, camera shake,
	FOV punches, confetti, shock-wave rings, big banners and coins flying into the HUD.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local Fx = {}

local C -- client context (set in Init)
local UIKit
local fxFolder
local activeFloaters = 0
local shakeUntil, shakeTotal, shakeMagnitude = 0, 1, 0
local baseFov = 70
local activeCoins = 0

local function camera()
	return Workspace.CurrentCamera
end

local function makeAnchor(position, lifetime)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Position = position
	part.Parent = fxFolder
	Debris:AddItem(part, lifetime)
	return part
end

function Fx.Init(client)
	C = client
	UIKit = client.UIKit
	fxFolder = Instance.new("Folder")
	fxFolder.Name = "GymFx"
	fxFolder.Parent = Workspace
	local cam = camera()
	if cam then
		baseFov = cam.FieldOfView
	end
	RunService.RenderStepped:Connect(function()
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local now = os.clock()
		if now &lt; shakeUntil then
			local m = shakeMagnitude * ((shakeUntil - now) / shakeTotal)
			humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * 2 * m, (math.random() - 0.5) * 2 * m, 0)
		elseif humanoid.CameraOffset.Magnitude &gt; 0 then
			humanoid.CameraOffset = Vector3.new()
		end
	end)
end

function Fx.CharacterPosition()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

----------------------------------------------------------------------
-- World effects
----------------------------------------------------------------------
-- floating "+1.2K" that rises and fades
function Fx.FloatText(position, text, color, textSize, lifetime, rise)
	if activeFloaters &gt; 45 then
		return
	end
	activeFloaters = activeFloaters + 1
	lifetime = lifetime or 0.9
	local anchor = makeAnchor(position, lifetime + 0.2)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(260, 60)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = anchor
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextSize = textSize or 30
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(20, 20, 40)
	label.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = label
	TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(anchor, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = position + Vector3.new(0, rise or 5, 0) }):Play()
	task.delay(lifetime * 0.55, function()
		TweenService:Create(label, TweenInfo.new(lifetime * 0.45), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end)
	task.delay(lifetime + 0.1, function()
		activeFloaters = activeFloaters - 1
	end)
end

function Fx.Burst(position, color, count, speed, life)
	local anchor = makeAnchor(position, (life or 0.8) + 0.5)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new((life or 0.8) * 0.6, life or 0.8)
	emitter.Speed = NumberRange.new((speed or 20) * 0.5, speed or 20)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 0.8
	emitter.Rate = 0
	emitter.Drag = 3
	emitter.Parent = anchor
	emitter:Emit(count or 12)
end

-- expanding shock-wave ring on the floor
function Fx.Ring(position, color, size, duration)
	duration = duration or 0.7
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	ring.Transparency = 0.15
	ring.Parent = fxFolder
	TweenService:Create(ring, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, size or 40, size or 40),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, duration + 0.1)
end

function Fx.Shake(magnitude, duration)
	if os.clock() &lt; shakeUntil and magnitude &lt; shakeMagnitude * 0.5 then
		return
	end
	shakeMagnitude = magnitude
	shakeTotal = duration
	shakeUntil = os.clock() + duration
end

function Fx.FovPunch(amount, duration)
	local cam = camera()
	if not cam then
		return
	end
	cam.FieldOfView = baseFov + amount
	TweenService:Create(cam, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { FieldOfView = baseFov }):Play()
end

----------------------------------------------------------------------
-- Screen effects
----------------------------------------------------------------------
function Fx.Flash(color, startTransparency, duration)
	local f = Instance.new("Frame")
	f.Size = UDim2.fromScale(1, 1)
	f.BackgroundColor3 = color or Color3.new(1, 1, 1)
	f.BackgroundTransparency = startTransparency or 0.5
	f.BorderSizePixel = 0
	f.ZIndex = 100
	f.Parent = C.Effects
	local t = TweenService:Create(f, TweenInfo.new(duration or 0.4), { BackgroundTransparency = 1 })
	t:Play()
	Debris:AddItem(f, (duration or 0.4) + 0.1)
end

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 92, 92), Color3.fromRGB(255, 208, 56), Color3.fromRGB(80, 232, 140),
	Color3.fromRGB(80, 170, 255), Color3.fromRGB(200, 120, 255), Color3.fromRGB(255, 140, 220),
}

function Fx.Confetti(count)
	for i = 1, count or 60 do
		local piece = Instance.new("Frame")
		piece.Size = UDim2.fromOffset(math.random(8, 16), math.random(12, 22))
		piece.BackgroundColor3 = CONFETTI_COLORS[math.random(#CONFETTI_COLORS)]
		piece.BorderSizePixel = 0
		piece.Rotation = math.random(0, 360)
		local x = math.random()
		piece.Position = UDim2.new(x, 0, -0.1, 0)
		piece.ZIndex = 90
		piece.Parent = C.Effects
		local fall = 1.4 + math.random() * 1.6
		TweenService:Create(piece, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(math.clamp(x + (math.random() - 0.5) * 0.3, 0, 1), 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-540, 540),
		}):Play()
		Debris:AddItem(piece, fall + 0.1)
	end
end

local currentBanner
function Fx.Banner(title, subtitle, color, duration)
	if currentBanner then
		currentBanner:Destroy()
	end
	color = color or Color3.fromRGB(255, 200, 60)
	local banner = UIKit.Frame({
		Name = "Banner",
		Color = UIKit.Shade(color, 0.55),
		Size = UDim2.fromOffset(620, subtitle and 116 or 84),
		Position = UDim2.fromScale(0.5, -0.2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Radius = 22,
		Stroke = color,
		StrokeThickness = 5,
		ZIndex = 60,
		Parent = C.Root,
	})
	UIKit.Gradient(banner, Color3.new(1, 1, 1), UIKit.Shade(Color3.new(1, 1, 1), 0.65), 90)
	UIKit.Text({
		Text = title,
		TextSize = 44,
		Size = UDim2.new(1, -20, 0, subtitle and 66 or 84),
		Position = UDim2.fromOffset(10, subtitle and 6 or 0),
		Scaled = false,
		ZIndex = 61,
		Parent = banner,
	})
	if subtitle then
		UIKit.Text({
			Text = subtitle,
			TextSize = 24,
			Color = UIKit.Shade(color, 1.0),
			Size = UDim2.new(1, -20, 0, 36),
			Position = UDim2.fromOffset(10, 70),
			ZIndex = 61,
			Parent = banner,
		})
	end
	currentBanner = banner
	UIKit.Tween(banner, 0.45, { Position = UDim2.fromScale(0.5, 0.2) }, Enum.EasingStyle.Back)
	task.delay(duration or 2.6, function()
		if banner.Parent then
			UIKit.Tween(banner, 0.35, { Position = UDim2.fromScale(0.5, -0.2) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.4, function()
				banner:Destroy()
			end)
		end
	end)
end

-- a 💵 that flies from a world position into the coins counter
function Fx.CoinFly(worldPosition, amount)
	local cam = camera()
	if not cam or activeCoins &gt; 12 or not C.CoinTarget then
		return
	end
	local vp, onScreen = cam:WorldToViewportPoint(worldPosition)
	if not onScreen then
		return
	end
	activeCoins = activeCoins + 1
	local IconLoader = require(script.Parent:WaitForChild("IconLoader"))
	local coin = IconLoader.Make("Money", C.Config and C.Config.Icons and C.Config.Icons.Money)
	if coin then
		coin.Size = UDim2.fromOffset(44, 44)
	else
		coin = Instance.new("TextLabel")
		coin.Text = "💵"
		coin.TextSize = 34
	end
	coin.BackgroundTransparency = 1
	coin.Size = UDim2.fromOffset(44, 44)
	coin.AnchorPoint = Vector2.new(0.5, 0.5)
	coin.Position = UDim2.fromOffset(vp.X, vp.Y)
	coin.ZIndex = 80
	coin.Parent = C.Effects
	local target = C.CoinTarget.AbsolutePosition + C.CoinTarget.AbsoluteSize / 2
	local flight = TweenService:Create(coin, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.fromOffset(target.X, target.Y),
		Size = UDim2.fromOffset(28, 28),
	})
	flight:Play()
	task.delay(0.72, function()
		coin:Destroy()
		activeCoins = activeCoins - 1
		if C.Sfx then
			C.Sfx.Play("Coin", 1 + math.random() * 0.4, 0.6)
		end
		if C.CoinTarget.Parent then
			UIKit.Bump(C.CoinTarget.Parent, 1.12)
		end
	end)
end

return Fx
</ProtectedString>
          </Properties>
        </Item>
