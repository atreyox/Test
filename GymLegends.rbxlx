  <Item class="ServerScriptService" referent="RBX10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX11">
      <Properties>
        <string name="Name">GymServer</string>
        <ProtectedString name="Source">--[[
	GymServer  (the only Script on the server; every ModuleScript next to it is a "service")

	Start-up order:
	  1. create the remotes
	  2. require every service
	  3. build the world (map) -&gt; services attach prompts to it
	  4. Init every service
	  5. handle players joining / leaving

	To add a feature: create a ModuleScript service with an Init(services) function,
	add its name to SERVICES below, and call it from the places you need.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

Remotes.Init()

local SERVICES = {
	"ServerUtil",
	"DataService",
	"StatService",
	"PetService",
	"EggService",
	"AreaService",
	"TrainingService",
	"RebirthService",
	"UpgradeService",
	"QuestService",
	"OrbService",
	"DonationService", -- Robux donation shop (ProcessReceipt)
	"AdminService", -- admin panel: the only entry point for admin remotes
	"MapBuilder",
}

local Services = { Config = Config, Remotes = Remotes }
for _, name in ipairs(SERVICES) do
	Services[name] = require(script[name])
end

-- EDITOR VISIBILITY ONLY:
-- Workspace contains a full snapshot of the real generated GymWorld so the gyms
-- are visible in Studio before Play. Remove that snapshot when the server starts,
-- then build the live world with the original MapBuilder exactly as normal.
local editorWorldSnapshot = workspace:FindFirstChild("GymWorld")
if editorWorldSnapshot then
	editorWorldSnapshot:Destroy()
end
local editorPetPreview = workspace:FindFirstChild("EditorPetPreview")
if editorPetPreview then
	editorPetPreview:Destroy()
end

Services.World = Services.MapBuilder.Build()

for _, name in ipairs(SERVICES) do
	local service = Services[name]
	if service.Init then
		service.Init(Services)
	end
end

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------
local joining = {}
local styledCharacters = setmetatable({}, { __mode = "k" })

-- Every player uses R15, but their body package is replaced with Roblox's square/blocky
-- R15 body. Their actual avatar cosmetics stay on the character: classic shirt/pants,
-- T-shirt, face, hair, hats and accessories are all preserved by the description.
local function makeBlockyR15Description(desc)
	if not desc then return nil end

	-- 0 means the default Roblox body piece rather than a custom body/package part.
	desc.Head = 0
	desc.Torso = 0
	desc.LeftArm = 0
	desc.RightArm = 0
	desc.LeftLeg = 0
	desc.RightLeg = 0

	-- Remove anthropomorphic scaling. This gives the familiar square/blocky R15 shape
	-- while retaining the 15-joint rig needed by curls and the shoulder-press IK.
	desc.BodyTypeScale = 0
	desc.ProportionScale = 0
	desc.HeightScale = 1
	desc.WidthScale = 1
	desc.DepthScale = 1
	desc.HeadScale = 1

	return desc
end

local function getCurrentAppearance(player, humanoid)
	-- Prefer the description Roblox already put on this spawned character. This avoids
	-- the blank-grey-avatar problem caused by replacing the whole character too early.
	local okApplied, applied = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if okApplied and applied then
		return applied
	end

	-- Fallback only if the applied description cannot be read.
	local okUser, userDesc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
	end)
	if okUser and userDesc then
		return userDesc
	end
	return nil
end

local function ensureBlockyR15(player, character)
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	if styledCharacters[character] then return true end

	-- StarterPlayer.AvatarType is R15, so normally the character is already R15.
	-- If Studio hands us anything else, leave it alive rather than deleting appearance;
	-- the next spawn will use the forced R15 setting.
	if hum.RigType ~= Enum.HumanoidRigType.R15 then
		warn("[+1 Gym Game] Expected R15 character for", player.Name, "but received", hum.RigType.Name)
		styledCharacters[character] = true
		return true
	end

	-- CharacterAdded can run just before the final accessories/clothing finish loading.
	-- Give Roblox a short bounded window to finish, then read the already-applied look.
	local deadline = os.clock() + 4
	repeat
		local loaded = false
		pcall(function()
			loaded = player:HasAppearanceLoaded()
		end)
		if loaded then break end
		task.wait(0.05)
	until os.clock() &gt;= deadline or not player.Parent or player.Character ~= character

	if not player.Parent or player.Character ~= character or not hum.Parent then
		return false
	end

	local desc = getCurrentAppearance(player, hum)
	if desc then
		makeBlockyR15Description(desc)
		local ok, err = pcall(function()
			hum:ApplyDescriptionReset(desc)
		end)
		if not ok then
			warn("[+1 Gym Game] Could not apply blocky R15 body for", player.Name, err)
		end
	end

	styledCharacters[character] = true
	return true
end

local function onPlayerAdded(player)
	if joining[player] then
		return -- already being set up (Studio can report the same player twice)
	end
	joining[player] = true
	-- bans are checked BEFORE the profile loads (separate ban DataStore)
	if not Services.AdminService.CheckBan(player) then
		return
	end
	local profile = Services.DataService.Load(player)
	if not profile or not player.Parent then
		return
	end

	Services.StatService.SetupPlayer(player, profile)
	Services.PetService.SetupPlayer(player, profile)

	local function onCharacter(character)
		-- Force a square/blocky R15 body after Roblox finishes loading the player cosmetics.
		if not ensureBlockyR15(player, character) then return end
		task.spawn(Services.StatService.OnCharacter, player, character)
		task.spawn(Services.TrainingService.OnCharacter, player, character)
		task.spawn(Services.AreaService.OnCharacter, player, character)
		task.spawn(Services.AdminService.OnCharacter, player, character) -- re-applies an admin freeze
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

local function onPlayerRemoving(player)
	Services.TrainingService.PlayerLeaving(player)
	Services.AreaService.PlayerLeaving(player)
	Services.StatService.PlayerLeaving(player)
	Services.AdminService.PlayerLeaving(player)
	Services.DataService.Release(player) -- saves, then forgets
	Services.ServerUtil.Forget(player)
	joining[player] = nil
end

-- The client tells us once its listeners exist; re-send everything it may have missed.
Remotes.Get("ClientReady").OnServerEvent:Connect(function(player)
	if not Services.ServerUtil.Allow(player, "ClientReady", 1) then
		return
	end
	if Services.DataService.Get(player) then
		Services.StatService.SyncNow(player)
		Services.PetService.Sync(player)
	end
end)

Players.PlayerAdded:Connect(function(player)
	task.spawn(onPlayerAdded, player)
end)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

print("[+1 Gym Game] Server ready - " .. #Config.Areas .. " gyms, " .. #Config.Stations .. " machines, " .. #Config.Pets .. " pets.")
</ProtectedString>
      </Properties>
<Item class="ModuleScript" referent="NEWMOD7"><Properties><string name="Name">DonationService</string><ProtectedString name="Source">--[[
	DonationService - the Robux donation shop (Config.Donations).

	  * Robux purchases are Developer Products. ProcessReceipt is the ONLY place a purchase
	    is granted; each PurchaseId is remembered on the profile so a retried receipt is
	    never granted twice, and the profile is saved before Roblox is told it succeeded.
	  * Perks (e.g. the Auto Clicker) are saved on the profile. Admins can grant / remove
	    any item from the admin panel (AdminService -&gt; DonationService.Grant / Revoke).
]]
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")

local DonationService = {}

local S, Config
local byProduct = {} -- [ProductId] = item
local MAX_RECEIPTS = 60

local function profileOf(player)
	return S.DataService.Get(player)
end

-- Gives an item. source = "Purchase" or "Admin". Returns true if something changed.
function DonationService.Grant(player, itemId, source)
	local profile = profileOf(player)
	local item = type(itemId) == "string" and Config.DonationsById[itemId]
	if not profile or not item then
		return false
	end
	if item.Kind == "Perk" then
		if profile.Perks[item.Perk] and source ~= "Purchase" then
			return false
		end
		profile.Perks[item.Perk] = true
	end
	if source == "Purchase" then
		profile.Donated = math.min((profile.Donated or 0) + (item.Robux or 0), Config.Game.MaxValue)
	end
	S.StatService.SyncNow(player)
	return true
end

function DonationService.Revoke(player, itemId)
	local profile = profileOf(player)
	local item = type(itemId) == "string" and Config.DonationsById[itemId]
	if not profile or not item or item.Kind ~= "Perk" or not profile.Perks[item.Perk] then
		return false
	end
	profile.Perks[item.Perk] = nil
	S.StatService.SyncNow(player)
	return true
end

function DonationService.HasPerk(player, perk)
	local profile = profileOf(player)
	return profile ~= nil and profile.Perks[perk] == true
end

local function processReceipt(receipt)
	local item = byProduct[receipt.ProductId]
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not item then
		warn("[+1 Gym Game] Unknown product " .. tostring(receipt.ProductId) .. " - add it to Config.Donations")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = player and profileOf(player)
	if not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- granted when they come back
	end
	if table.find(profile.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already granted earlier
	end
	DonationService.Grant(player, item.Id, "Purchase")
	table.insert(profile.Receipts, receipt.PurchaseId)
	while #profile.Receipts &gt; MAX_RECEIPTS do
		table.remove(profile.Receipts, 1)
	end
	if not profile._noSave and not S.DataService.Save(player) then
		-- could not save: undo nothing visible, but let Roblox retry later
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	S.ServerUtil.Notify(player, "Thank you for the " .. item.Name .. "! ❤️", "Success")
	S.ServerUtil.Announce(player.DisplayName .. " supported the gym with " .. item.Robux .. " Robux! ❤️", Color3.fromRGB(255, 120, 160))
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function DonationService.Init(services)
	S = services
	Config = services.Config
	for _, item in ipairs(Config.Donations.Items) do
		if item.ProductId and item.ProductId &gt; 0 then
			byProduct[item.ProductId] = item
		end
	end
	MarketplaceService.ProcessReceipt = processReceipt
end

return DonationService
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="NEWMOD3"><Properties><string name="Name">AdminService</string><ProtectedString name="Source">--[[
	AdminService - the server side of the admin panel, and its ONLY entry point.

	SECURITY MODEL (read this before changing anything)
	  * The client can only ASK. Two RemoteFunctions exist (see Remotes.Functions):
	        AdminGetState(kind, arg)                     read-only data for the panel
	        AdminAction(actionName, targetUserId, args)  one action from the Actions table
	  * EVERY call re-checks AdminService.GetLevel(player) here on the server. Hiding the
	    admin button on the client is cosmetic only: a non-admin firing these remotes by hand
	    gets { Ok = false, Message = "Not authorized." } and the attempt is logged.
	  * Actions are an explicit whitelist (the Actions table). There is NO generic
	    "set any stat / table path / property" action, no loadstring, no Instance editing.
	  * Every argument is validated here (type, NaN / infinity, range, Config ids) and every
	    change goes through the service that owns the data (StatService, PetService,
	    AreaService, UpgradeService, QuestService, TrainingService, DataService). Those
	    services clamp again, recalculate multipliers, sync the client and save.
	  * Protected ranks: nobody can kick / ban someone with the same or a higher admin level,
	    and normal admins can't edit the owner or super admins. Owners / super admins are
	    never blocked by a ban record.
	  * Everything that runs is written to the server-side audit log (the client only ever
	    reads it, it can't add to it).

	Every action returns { Ok = bool, Message = string, Data = table? }.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")
local TextService = game:GetService("TextService")
local MessagingService = game:GetService("MessagingService")
local GroupService = game:GetService("GroupService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local AdminService = {}

local S, Config, Remotes, Cfg
local MAX -- Config.Game.MaxValue

-- Admin levels (higher = more power)
local LEVEL = { None = 0, Tester = 1, Admin = 2, SuperAdmin = 3, Owner = 4 }
local LEVEL_NAMES = { [0] = "Player", [1] = "Studio Tester", [2] = "Admin", [3] = "Super Admin", [4] = "Owner" }
AdminService.Levels = LEVEL

local adminIds, superIds = {}, {}
local levelCache = {}  -- [player] = { Level = n, Until = os.clock() }
local frozen = {}      -- [userId] = true (re-applied on every respawn, cleared when they leave)
local lastDenied = {}  -- [player] = os.clock() of the last logged unauthorized call
local auditLog = {}    -- oldest first, at most Cfg.LogSize entries
local nextLogId = 1
local banStore
local localBans = {}   -- [userId] = ban record written by THIS server (used if the DataStore fails)
local shuttingDown = false
local startedAt = os.clock()
local MESSAGE_TOPIC = "PlusOneGymAdmin_v1"
local STARTER_STATION = "Beginner_1" -- every profile keeps it (see DataService.sanitize)

local ANNOUNCE_COLORS = {
	Info = Color3.fromRGB(64, 148, 255),
	Success = Color3.fromRGB(64, 200, 104),
	Warning = Color3.fromRGB(255, 150, 40),
}

----------------------------------------------------------------------
-- Permissions
----------------------------------------------------------------------
local function toSet(list)
	local set = {}
	if type(list) == "table" then
		for _, id in ipairs(list) do
			if type(id) == "number" then
				set[id] = true
			end
		end
	end
	return set
end

-- Works out a player's level. Explicit UserIds never need a web call; group checks can
-- fail, in which case the result is only cached briefly ("certain" = false).
local function computeLevel(player)
	local userId = player.UserId
	local certain = true
	if Cfg.AllowGameCreator then
		if game.CreatorType == Enum.CreatorType.User then
			if game.CreatorId &gt; 0 and userId == game.CreatorId then
				return LEVEL.Owner, true
			end
		elseif game.CreatorId &gt; 0 then
			-- group-owned game: the group's owner (rank 255) owns the game
			local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
			if ok and rank == 255 then
				return LEVEL.Owner, true
			end
			certain = certain and ok
		end
	end
	if superIds[userId] then
		return LEVEL.SuperAdmin, true
	end
	if adminIds[userId] then
		return LEVEL.Admin, true
	end
	if (Cfg.GroupId or 0) &gt; 0 then
		local ok, rank = pcall(player.GetRankInGroup, player, Cfg.GroupId)
		if ok and type(rank) == "number" and rank &gt;= (Cfg.MinimumGroupRank or 255) then
			return LEVEL.Admin, true
		end
		certain = certain and ok
	end
	if Cfg.AllowStudioTesting and RunService:IsStudio() then
		return LEVEL.Tester, true
	end
	return LEVEL.None, certain
end

function AdminService.GetLevel(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
		return LEVEL.None
	end
	local now = os.clock()
	local cached = levelCache[player]
	if cached and now &lt; cached.Until then
		return cached.Level
	end
	local level, certain = computeLevel(player)
	levelCache[player] = { Level = level, Until = now + (certain and 60 or 10) }
	return level
end

-- The one check every admin remote goes through. Never trust anything the client says
-- about its own rights.
function AdminService.IsAdmin(player)
	return AdminService.GetLevel(player) &gt; LEVEL.None
end

-- Level of any account (it may be offline). Returns level, certain.
local function levelOfUserId(userId)
	local online = Players:GetPlayerByUserId(userId)
	if online then
		return AdminService.GetLevel(online), true
	end
	if Cfg.AllowGameCreator and game.CreatorType == Enum.CreatorType.User and game.CreatorId &gt; 0 and userId == game.CreatorId then
		return LEVEL.Owner, true
	end
	if superIds[userId] then
		return LEVEL.SuperAdmin, true
	end
	if adminIds[userId] then
		return LEVEL.Admin, true
	end
	local groupGame = Cfg.AllowGameCreator and game.CreatorType == Enum.CreatorType.Group and game.CreatorId &gt; 0
	if not groupGame and (Cfg.GroupId or 0) &lt;= 0 then
		return LEVEL.None, true
	end
	local ok, groups = pcall(GroupService.GetGroupsAsync, GroupService, userId)
	if not ok or type(groups) ~= "table" then
		return LEVEL.None, false
	end
	local level = LEVEL.None
	for _, g in ipairs(groups) do
		if groupGame and g.Id == game.CreatorId and g.Rank == 255 then
			return LEVEL.Owner, true
		end
		if (Cfg.GroupId or 0) &gt; 0 and g.Id == Cfg.GroupId and g.Rank &gt;= (Cfg.MinimumGroupRank or 255) then
			level = LEVEL.Admin
		end
	end
	return level, true
end

----------------------------------------------------------------------
-- Audit log (server memory; printed to the server output too)
----------------------------------------------------------------------
local function logValue(v)
	local t = type(v)
	if t == "number" or t == "boolean" or t == "nil" then
		return v
	end
	return string.sub(tostring(v), 1, 120)
end

local function audit(e)
	local entry = {
		Id = nextLogId,
		Time = os.time(),
		AdminUserId = e.Admin and e.Admin.UserId or 0,
		AdminName = e.Admin and e.Admin.Name or "?",
		TargetUserId = e.TargetUserId,
		TargetName = e.TargetName or "",
		Action = e.Action,
		OldValue = logValue(e.Old),
		NewValue = logValue(e.New),
		Details = e.Details and string.sub(tostring(e.Details), 1, 200) or nil,
		Ok = e.Ok ~= false,
	}
	nextLogId = nextLogId + 1
	auditLog[#auditLog + 1] = entry
	while #auditLog &gt; (Cfg.LogSize or 300) do
		table.remove(auditLog, 1)
	end
	print(string.format("[+1 Gym Game][Admin] %s %s -&gt; %s%s%s", entry.AdminName, entry.Action,
		entry.TargetName ~= "" and entry.TargetName or "server",
		entry.Ok and "" or " (FAILED)", entry.Details and (": " .. entry.Details) or ""))
end

-- A non-admin called an admin remote. Rejected either way; logged at most every 10s per
-- player so an exploiter can't flush the real log out of the ring buffer.
local function noteUnauthorized(player, what, detail)
	local now = os.clock()
	if lastDenied[player] and now - lastDenied[player] &lt; 10 then
		return
	end
	lastDenied[player] = now
	-- only echo the request name if it looks like one (never show exploiter-typed text)
	local name = type(detail) == "string" and #detail &lt;= 40 and string.match(detail, "^[%w_]+$") or "?"
	warn(string.format("[+1 Gym Game][Admin] Rejected %s (%s) from non-admin %s (%d)", what, name, player.Name, player.UserId))
	audit({ Admin = player, Action = "UNAUTHORIZED", TargetName = "", Details = what .. " " .. name, Ok = false })
end

----------------------------------------------------------------------
-- Argument validation (the client may send anything)
----------------------------------------------------------------------
local function isNumber(x)
	return S.ServerUtil.IsNumber(x)
end

local function isUserId(x)
	return isNumber(x) and x % 1 == 0 and x ~= 0 and math.abs(x) &lt; 2 ^ 53
end

-- Rejects anything that isn't a real finite number (strings, NaN, +-inf), then clamps.
local function numberArg(args, key, min, max, whole)
	local v = args[key]
	if not isNumber(v) then
		return nil, key .. " must be a number."
	end
	if whole then
		v = v &gt;= 0 and math.floor(v) or math.ceil(v)
	end
	return math.clamp(v, min, max)
end

-- A short piece of text: no control characters, valid UTF-8, trimmed, max `maxLen` characters.
local function textArg(args, key, maxLen)
	local v = args[key]
	if type(v) ~= "string" or #v &gt; maxLen * 4 or utf8.len(v) == nil then
		return nil
	end
	v = string.gsub(v, "%c", " ")
	v = string.match(v, "^%s*(.-)%s*$")
	if v == "" then
		return nil
	end
	if utf8.len(v) &gt; maxLen then
		v = string.sub(v, 1, utf8.offset(v, maxLen + 1) - 1)
	end
	return v
end

local function idArg(args, key, map, what)
	local id = args[key]
	local def = type(id) == "string" and #id &lt;= 64 and map[id]
	if not def then
		return nil, "Unknown " .. what .. "."
	end
	return def
end

local function uidArg(args)
	local uid = args.Uid
	if type(uid) ~= "string" or #uid &gt; 12 or not string.match(uid, "^%d+$") then
		return nil, "Unknown pet."
	end
	return uid
end

-- Roblox requires filtering any typed text other players will see (announcements,
-- kick / ban reasons). Returns nil if the filter isn't reachable.
local function filterText(text, fromUserId)
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, fromUserId, Enum.TextFilterContext.PublicChat)
	end)
	if not ok or not result then
		return nil
	end
	local ok2, filtered = pcall(function()
		return result:GetNonChatStringForBroadcastAsync()
	end)
	return ok2 and filtered or nil
end

local function done(message, data, old, new, details)
	return { Ok = true, Message = message, Data = data, Old = old, New = new, Details = details }
end

local function fail(message)
	return { Ok = false, Message = message }
end

local function unauthorized()
	return { Ok = false, Message = "Not authorized." }
end

----------------------------------------------------------------------
-- Bans (separate DataStore: never mixed into the progression saves)
--   key "Ban_&lt;UserId&gt;" = { Banned, Reason, ModeratorId, CreatedAt, ExpiresAt (0 = permanent) }
----------------------------------------------------------------------
local function banActive(record, now)
	if type(record) ~= "table" or record.Banned ~= true then
		return false
	end
	local expires = tonumber(record.ExpiresAt) or 0
	return expires &lt;= 0 or expires &gt; (now or os.time())
end

local function durationText(seconds)
	seconds = math.max(0, math.floor(seconds))
	local d = math.floor(seconds / 86400)
	local h = math.floor((seconds % 86400) / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if d &gt; 0 then
		return d .. "d " .. h .. "h"
	elseif h &gt; 0 then
		return h .. "h " .. m .. "m"
	end
	return math.max(1, m) .. "m"
end

local function banMessage(record)
	local expires = tonumber(record.ExpiresAt) or 0
	return "You are banned from " .. Config.Game.Title .. ".\nReason: " .. tostring(record.Reason or "No reason given")
		.. (expires &gt; 0 and ("\nYour ban ends in " .. durationText(expires - os.time()) .. ".") or "\nThis ban is permanent.")
end

-- Returns the stored record (or nil). `fresh` skips this server's local copy.
local function readBan(userId, fresh)
	if not fresh and localBans[userId] then
		return localBans[userId]
	end
	if not banStore then
		return localBans[userId]
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return banStore:GetAsync("Ban_" .. userId)
		end)
		if ok then
			return type(result) == "table" and result or nil
		end
		warn("[+1 Gym Game][Admin] Ban lookup failed (" .. attempt .. "/3): " .. tostring(result))
		task.wait(0.5 * attempt)
	end
	return localBans[userId] -- fail open: an outage must not lock everyone out
end

local function writeBan(userId, record)
	localBans[userId] = record
	if not banStore then
		return false
	end
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			banStore:SetAsync("Ban_" .. userId, record)
		end)
		if ok then
			return true
		end
		warn("[+1 Gym Game][Admin] Ban save failed (" .. attempt .. "/3): " .. tostring(err))
		task.wait(0.5 * attempt)
	end
	return false
end

-- Called by GymServer BEFORE the player's profile loads.
function AdminService.CheckBan(player)
	if shuttingDown then
		player:Kick("This server is shutting down. Please join another server!")
		return false
	end
	if AdminService.GetLevel(player) &gt;= LEVEL.SuperAdmin then
		return true -- owners / super admins can never lock themselves out
	end
	local record = readBan(player.UserId)
	if record and banActive(record) then
		player:Kick(banMessage(record))
		return false
	end
	return true
end

local function nameOf(userId)
	local online = Players:GetPlayerByUserId(userId)
	if online then
		return online.Name
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	return ok and name or tostring(userId)
end

----------------------------------------------------------------------
-- Helpers used by several actions
----------------------------------------------------------------------
local function applyFreeze(player)
	local root = S.ServerUtil.GetRoot(player)
	if root then
		-- anchoring on the server takes physics ownership away from the client, so an
		-- exploiter can't un-freeze themselves locally
		root.Anchored = frozen[player.UserId] == true
	end
	player:SetAttribute("AdminFrozen", frozen[player.UserId] == true or nil)
end

local function sendToBeginner(player)
	return S.AreaService.SendTo(player, Config.Areas[1].Id)
end

-- a gym the player may stand in (nil = between gyms, always fine)
local function areaAllowed(player, position)
	local index = Config.AreaAt(position)
	if not index then
		return true
	end
	local area = Config.Areas[index]
	return S.AreaService.IsUnlocked(player, area.Id), area
end

local function syncProgress(target)
	S.StatService.SyncNow(target)
	S.DataService.SaveSoon(target)
end

local function saveAll(timeout)
	local result = { Saved = 0, Failed = 0, Skipped = 0 }
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		local status = S.DataService.GetStatus(player)
		if status.Loaded and not status.NoSave and status.StoreAvailable then
			pending = pending + 1
			task.spawn(function()
				if S.DataService.Save(player) then
					result.Saved = result.Saved + 1
				else
					result.Failed = result.Failed + 1
				end
				pending = pending - 1
			end)
		else
			result.Skipped = result.Skipped + 1
		end
	end
	local waited = 0
	while pending &gt; 0 and waited &lt; timeout do
		task.wait(0.1)
		waited = waited + 0.1
	end
	result.Pending = pending
	return result
end

----------------------------------------------------------------------
-- ACTIONS (the whitelist)
--   Target = "Online" : the target must be in this server with a loaded profile
--            "UserId" : any account (bans / unbans work for offline players too)
--            "None"   : server-wide
--   Kind   = "Edit"     : changes the target (protected ranks need a higher level)
--            "Moderate" : kick / ban (needs a strictly higher level, never yourself)
--            "Safe"     : doesn't change the target's progress (save, sync, go to)
--   Confirm = value args.Confirm must have (destructive actions; the panel asks first)
--   Run(ctx, args): ctx = { Admin, Level, Target, TargetUserId, TargetLevel, Profile }
----------------------------------------------------------------------
local Actions = {}

-- Dashboard ---------------------------------------------------------------
Actions.SavePlayer = { Target = "Online", Kind = "Safe", Run = function(ctx)
	local status = S.DataService.GetStatus(ctx.Target)
	if status.NoSave then
		return fail("This player is on temporary data (NoSave) - nothing can be saved.")
	end
	if not status.StoreAvailable then
		return fail("DataStores are unavailable in this server.")
	end
	if S.DataService.Save(ctx.Target) then
		return done("Saved " .. ctx.Target.Name .. "'s data.")
	end
	return fail("Save failed - check the server output.")
end }

Actions.ForceSync = { Target = "Online", Kind = "Safe", Run = function(ctx)
	S.PetService.Sync(ctx.Target) -- inventory + multipliers (calls StatService.Refresh)
	S.StatService.Refresh(ctx.Target)
	S.StatService.ApplyWalkSpeed(ctx.Target)
	S.StatService.SyncNow(ctx.Target)
	return done("Re-sent all data to " .. ctx.Target.Name .. ".")
end }

-- Stats: Strength / TotalStrength / Coins ------------------------------------
-- Set&lt;Stat&gt; {Value} and Add&lt;Stat&gt; {Amount} (negative = subtract). Strength and
-- TotalStrength are separate on purpose: setting one never touches the other.
local NUMBER_STATS = {
	{ Field = "Strength", Label = "Strength", Set = function(p, v) S.StatService.SetStrength(p, v) end },
	{ Field = "TotalStrength", Label = "Total Strength", Set = function(p, v) S.StatService.SetTotalStrength(p, v) end },
	{ Field = "Coins", Label = "Coins", Set = function(p, v) S.StatService.SetCoins(p, v) end },
}
for _, stat in ipairs(NUMBER_STATS) do
	Actions["Set" .. stat.Field] = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
		local value, err = numberArg(args, "Value", 0, MAX)
		if not value then
			return fail(err)
		end
		local old = ctx.Profile[stat.Field]
		stat.Set(ctx.Target, value)
		S.DataService.SaveSoon(ctx.Target)
		local new = ctx.Profile[stat.Field]
		return done(stat.Label .. " set to " .. Format.Number(new) .. ".", nil, old, new)
	end }
	Actions["Add" .. stat.Field] = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
		local amount, err = numberArg(args, "Amount", -MAX, MAX)
		if not amount then
			return fail(err)
		end
		if amount == 0 then
			return fail("Amount can't be 0.")
		end
		local old = ctx.Profile[stat.Field]
		stat.Set(ctx.Target, math.clamp(old + amount, 0, MAX))
		S.DataService.SaveSoon(ctx.Target)
		local new = ctx.Profile[stat.Field]
		return done(string.format("%s %s%s -&gt; %s", stat.Label, amount &gt;= 0 and "+" or "-", Format.Number(math.abs(amount)), Format.Number(new)),
			nil, old, new)
	end }
end

-- Rebirths (0..MaxRebirths). StatService.SetRebirths recalculates the multipliers,
-- leaderstats, name tag and body size.
local function setRebirths(ctx, value)
	local old = ctx.Profile.Rebirths
	S.StatService.SetRebirths(ctx.Target, value)
	S.StatService.SyncNow(ctx.Target)
	S.DataService.SaveSoon(ctx.Target)
	local new = ctx.Profile.Rebirths
	return done("Rebirths " .. old .. " -&gt; " .. new .. " (" .. Format.Mult(Formulas.RebirthMultiplier(new)) .. " rebirth boost).", nil, old, new)
end

Actions.SetRebirths = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local value, err = numberArg(args, "Value", 0, Config.Game.MaxRebirths, true)
	if not value then
		return fail(err)
	end
	return setRebirths(ctx, value)
end }

Actions.AddRebirths = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local amount, err = numberArg(args, "Amount", -Config.Game.MaxRebirths, Config.Game.MaxRebirths, true)
	if not amount then
		return fail(err)
	end
	local target = math.clamp(ctx.Profile.Rebirths + amount, 0, Config.Game.MaxRebirths)
	if amount == 0 or target == ctx.Profile.Rebirths then
		return fail(amount &gt; 0 and "Already at the maximum rebirths." or "Already at 0 rebirths.")
	end
	return setRebirths(ctx, target)
end }

Actions.MaxRebirths = { Target = "Online", Kind = "Edit", Run = function(ctx)
	if ctx.Profile.Rebirths &gt;= Config.Game.MaxRebirths then
		return fail("Already at the maximum rebirths.")
	end
	return setRebirths(ctx, Config.Game.MaxRebirths)
end }

-- Progression: gyms ------------------------------------------------------------
Actions.UnlockGym = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local area, err = idArg(args, "AreaId", Config.AreasById, "gym")
	if not area then
		return fail(err)
	end
	if not S.AreaService.SetUnlocked(ctx.Target, area.Id, true) then
		return fail(area.Name .. " is already unlocked.")
	end
	syncProgress(ctx.Target)
	return done(area.Name .. " unlocked.", nil, false, true, area.Id)
end }

Actions.LockGym = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local area, err = idArg(args, "AreaId", Config.AreasById, "gym")
	if not area then
		return fail(err)
	end
	if area.Index == 1 then
		return fail("The " .. area.Name .. " is always unlocked.")
	end
	if not S.AreaService.SetUnlocked(ctx.Target, area.Id, false) then
		return fail(area.Name .. " is already locked.")
	end
	syncProgress(ctx.Target)
	return done(area.Name .. " locked.", nil, true, false, area.Id)
end }

-- Teleport never enters a locked gym (use UnlockAndTeleport for that).
Actions.TeleportToGym = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local area, err = idArg(args, "AreaId", Config.AreasById, "gym")
	if not area then
		return fail(err)
	end
	if not S.AreaService.IsUnlocked(ctx.Target, area.Id) then
		return fail(area.Name .. " is locked for this player. Use Unlock + Teleport.")
	end
	local ok, why = S.AreaService.SendTo(ctx.Target, area.Id)
	if not ok then
		return fail(why)
	end
	return done("Teleported " .. ctx.Target.Name .. " to " .. area.Name .. ".", nil, nil, nil, area.Id)
end }

Actions.UnlockAndTeleport = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local area, err = idArg(args, "AreaId", Config.AreasById, "gym")
	if not area then
		return fail(err)
	end
	local changed = S.AreaService.SetUnlocked(ctx.Target, area.Id, true)
	syncProgress(ctx.Target)
	local ok, why = S.AreaService.SendTo(ctx.Target, area.Id)
	if not ok then
		return fail((changed and area.Name .. " unlocked, but " or "") .. why)
	end
	return done((changed and "Unlocked + teleported to " or "Teleported to ") .. area.Name .. ".", nil, nil, nil, area.Id)
end }

Actions.UnlockAllGyms = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local count = 0
	for _, area in ipairs(Config.Areas) do
		if S.AreaService.SetUnlocked(ctx.Target, area.Id, true) then
			count = count + 1
		end
	end
	if count == 0 then
		return fail("Every gym is already unlocked.")
	end
	syncProgress(ctx.Target)
	return done("Unlocked " .. count .. " gym" .. (count == 1 and "" or "s") .. ".", nil, nil, count)
end }

Actions.LockAllGyms = { Target = "Online", Kind = "Edit", Confirm = true, Run = function(ctx)
	local count = 0
	for i = #Config.Areas, 2, -1 do -- the Beginner gym (index 1) always stays open
		if S.AreaService.SetUnlocked(ctx.Target, Config.Areas[i].Id, false) then
			count = count + 1
		end
	end
	if count == 0 then
		return fail("Only the Beginner Gym is unlocked already.")
	end
	syncProgress(ctx.Target)
	return done("Locked " .. count .. " gym" .. (count == 1 and "" or "s") .. " (Beginner stays open).", nil, nil, count)
end }

-- Progression: equipment ------------------------------------------------------
local function stationsOf(args)
	if args.AreaId == nil then
		return Config.Stations, nil
	end
	local area, err = idArg(args, "AreaId", Config.AreasById, "gym")
	if not area then
		return nil, err
	end
	local list = {}
	for _, id in ipairs(area.StationIds) do
		list[#list + 1] = Config.StationsById[id]
	end
	return list, nil, area
end

local function dropStation(ctx, id)
	if S.TrainingService.GetSession(ctx.Target) == id then
		S.TrainingService.EndTraining(ctx.Target)
	end
	ctx.Profile.Stations[id] = nil
end

Actions.GrantStation = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local station, err = idArg(args, "StationId", Config.StationsById, "equipment")
	if not station then
		return fail(err)
	end
	if ctx.Profile.Stations[station.Id] then
		return fail("They already own " .. station.Name .. ".")
	end
	ctx.Profile.Stations[station.Id] = true
	syncProgress(ctx.Target)
	return done("Gave " .. station.Name .. ".", nil, false, true, station.Id)
end }

Actions.RemoveStation = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local station, err = idArg(args, "StationId", Config.StationsById, "equipment")
	if not station then
		return fail(err)
	end
	if station.Id == STARTER_STATION then
		return fail(station.Name .. " is the starter equipment - everyone keeps it.")
	end
	if not ctx.Profile.Stations[station.Id] then
		return fail("They don't own " .. station.Name .. ".")
	end
	dropStation(ctx, station.Id)
	syncProgress(ctx.Target)
	return done("Removed " .. station.Name .. ".", nil, true, false, station.Id)
end }

Actions.GrantAllStations = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local list, err, area = stationsOf(args)
	if not list then
		return fail(err)
	end
	local count = 0
	for _, station in ipairs(list) do
		if not ctx.Profile.Stations[station.Id] then
			ctx.Profile.Stations[station.Id] = true
			count = count + 1
		end
	end
	if count == 0 then
		return fail("They already own all of that equipment.")
	end
	syncProgress(ctx.Target)
	return done("Gave " .. count .. " machines" .. (area and (" in " .. area.Name) or "") .. ".", nil, nil, count, area and area.Id or "all")
end }

Actions.RemoveAllStations = { Target = "Online", Kind = "Edit", Confirm = true, Run = function(ctx, args)
	local list, err, area = stationsOf(args)
	if not list then
		return fail(err)
	end
	local count = 0
	for _, station in ipairs(list) do
		if station.Id ~= STARTER_STATION and ctx.Profile.Stations[station.Id] then
			dropStation(ctx, station.Id)
			count = count + 1
		end
	end
	if count == 0 then
		return fail("Nothing to remove (the starter equipment always stays).")
	end
	syncProgress(ctx.Target)
	return done("Removed " .. count .. " machines" .. (area and (" in " .. area.Name) or "") .. ".", nil, nil, count, area and area.Id or "all")
end }

-- Progression: upgrades (limits come from Config.Upgrades; UpgradeService.SetLevel clamps
-- to 0..def.Max and applies walk speed / pet slots / multipliers, then syncs + saves).
local function setUpgrade(ctx, def, level)
	local old = Formulas.Level(ctx.Profile.Upgrades, def.Id)
	local ok, newLevel = S.UpgradeService.SetLevel(ctx.Target, def.Id, level)
	if not ok then
		return fail(newLevel)
	end
	return done(def.Name .. ": level " .. old .. " -&gt; " .. newLevel .. " / " .. def.Max .. ".", nil, old, newLevel, def.Id)
end

Actions.SetUpgrade = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local def, err = idArg(args, "UpgradeId", Config.UpgradesById, "upgrade")
	if not def then
		return fail(err)
	end
	local level, err2 = numberArg(args, "Level", 0, def.Max, true)
	if not level then
		return fail(err2)
	end
	return setUpgrade(ctx, def, level)
end }

Actions.StepUpgrade = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local def, err = idArg(args, "UpgradeId", Config.UpgradesById, "upgrade")
	if not def then
		return fail(err)
	end
	if args.Delta ~= 1 and args.Delta ~= -1 then
		return fail("Delta must be 1 or -1.")
	end
	local level = Formulas.Level(ctx.Profile.Upgrades, def.Id) + args.Delta
	if level &lt; 0 or level &gt; def.Max then
		return fail(def.Name .. (level &lt; 0 and " is already at level 0." or " is already maxed."))
	end
	return setUpgrade(ctx, def, level)
end }

Actions.MaxUpgrade = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local def, err = idArg(args, "UpgradeId", Config.UpgradesById, "upgrade")
	if not def then
		return fail(err)
	end
	return setUpgrade(ctx, def, def.Max)
end }

Actions.ResetUpgrade = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local def, err = idArg(args, "UpgradeId", Config.UpgradesById, "upgrade")
	if not def then
		return fail(err)
	end
	return setUpgrade(ctx, def, 0)
end }

Actions.ResetAllUpgrades = { Target = "Online", Kind = "Edit", Confirm = true, Run = function(ctx)
	local count = 0
	for _, def in ipairs(Config.Upgrades) do
		if Formulas.Level(ctx.Profile.Upgrades, def.Id) &gt; 0 then
			S.UpgradeService.SetLevel(ctx.Target, def.Id, 0)
			count = count + 1
		end
	end
	if count == 0 then
		return fail("They have no upgrades.")
	end
	return done("Reset " .. count .. " upgrade" .. (count == 1 and "" or "s") .. " to level 0.", nil, nil, 0)
end }

-- Pets (all through PetService: equipped lists are cleaned, slots respected) ----------
local function petsChanged(ctx)
	S.StatService.Refresh(ctx.Target)
	S.StatService.SyncNow(ctx.Target)
end

Actions.GivePet = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local pet, err = idArg(args, "PetId", Config.PetsById, "pet")
	if not pet then
		return fail(err)
	end
	local count = 1
	if args.Count ~= nil then
		local c, err2 = numberArg(args, "Count", 1, Cfg.MaxGivePets or 25, true)
		if not c then
			return fail(err2)
		end
		count = c
	end
	local free = S.PetService.FreeSpace(ctx.Target)
	if free &lt;= 0 then
		return fail("Their pet inventory is full (" .. Config.Game.MaxPetsOwned .. "/" .. Config.Game.MaxPetsOwned .. ").")
	end
	local given = 0
	for _ = 1, math.min(count, free) do
		if S.PetService.AddPet(ctx.Target, pet.Id) then
			given = given + 1
		end
	end
	S.PetService.Sync(ctx.Target)
	petsChanged(ctx)
	S.DataService.SaveSoon(ctx.Target)
	return done("Gave " .. given .. "x " .. pet.Name .. " (" .. pet.Rarity .. ")" .. (given &lt; count and " - inventory is now full." or "."),
		nil, nil, given, pet.Id)
end }

local function petAction(action, needsUid)
	return function(ctx, args)
		local uid
		if needsUid then
			local err
			uid, err = uidArg(args)
			if not uid then
				return fail(err)
			end
		end
		local pet = uid and ctx.Profile.Pets[uid] -- read before a Delete removes it
		local label = pet and Config.PetsById[pet.Id] and Config.PetsById[pet.Id].Name
		local result = S.PetService.RunAction(ctx.Target, action, uid)
		if not result.Ok then
			return fail(result.Msg or "That didn't work.")
		end
		petsChanged(ctx)
		return done(action .. (label and (" " .. label) or "") .. ": done.", nil, nil, nil, uid)
	end
end

Actions.EquipPet = { Target = "Online", Kind = "Edit", Run = petAction("Equip", true) }
Actions.UnequipPet = { Target = "Online", Kind = "Edit", Run = petAction("Unequip", true) }
Actions.DeletePet = { Target = "Online", Kind = "Edit", Run = petAction("Delete", true) } -- locked pets are refused
Actions.EquipBestPets = { Target = "Online", Kind = "Edit", Run = petAction("EquipBest", false) }
Actions.UnequipAllPets = { Target = "Online", Kind = "Edit", Run = petAction("UnequipAll", false) }

local function lockAction(locked)
	return function(ctx, args)
		local uid, err = uidArg(args)
		if not uid then
			return fail(err)
		end
		local pet = ctx.Profile.Pets[uid]
		if not pet then
			return fail("Pet not found.")
		end
		if (pet.Locked == true) == locked then
			return fail(locked and "That pet is already locked." or "That pet isn't locked.")
		end
		S.PetService.SetLocked(ctx.Target, uid, locked)
		petsChanged(ctx)
		return done((locked and "Locked " or "Unlocked ") .. Config.PetsById[pet.Id].Name .. ".", nil, not locked, locked, uid)
	end
end

Actions.LockPet = { Target = "Online", Kind = "Edit", Run = lockAction(true) }
Actions.UnlockPet = { Target = "Online", Kind = "Edit", Run = lockAction(false) }

Actions.DeleteUnlockedPets = { Target = "Online", Kind = "Edit", Confirm = true, Run = function(ctx)
	local before = S.PetService.Count(ctx.Target)
	local removed = S.PetService.RemovePets(ctx.Target, function(_, pet)
		return pet.Locked ~= true
	end)
	petsChanged(ctx)
	return done("Deleted " .. removed .. " unlocked pet" .. (removed == 1 and "" or "s") .. ".", nil, before, before - removed)
end }

Actions.ClearPets = { Target = "Online", Kind = "Edit", Confirm = true, Run = function(ctx)
	local before = S.PetService.Count(ctx.Target)
	local removed = S.PetService.RemovePets(ctx.Target, function()
		return true
	end)
	petsChanged(ctx)
	return done("Cleared the pet inventory (" .. removed .. " pets).", nil, before, 0)
end }

-- Quests -------------------------------------------------------------------
local function questDone(ctx, message, old, new)
	S.DataService.SaveSoon(ctx.Target)
	return done(message, nil, old, new)
end

Actions.SetQuestProgress = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local value, err = numberArg(args, "Value", 0, MAX, true)
	if not value then
		return fail(err)
	end
	local old = ctx.Profile.Quest.Progress
	S.QuestService.SetProgress(ctx.Target, value) -- clamps to the quest's goal
	return questDone(ctx, "Quest progress " .. Format.Number(old) .. " -&gt; " .. Format.Number(ctx.Profile.Quest.Progress) .. ".", old, ctx.Profile.Quest.Progress)
end }

Actions.CompleteQuest = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local info = S.QuestService.GetInfo(ctx.Target)
	local old = ctx.Profile.Quest.Progress
	if old &gt;= info.Goal then
		return fail("That quest is already complete - they can claim it.")
	end
	S.QuestService.SetProgress(ctx.Target, info.Goal)
	return questDone(ctx, "Quest #" .. ctx.Profile.Quest.Index .. " completed (ready to claim).", old, info.Goal)
end }

Actions.ResetQuestProgress = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local old = ctx.Profile.Quest.Progress
	S.QuestService.SetProgress(ctx.Target, 0)
	return questDone(ctx, "Quest progress reset.", old, 0)
end }

local function setQuestIndex(ctx, index)
	local old = ctx.Profile.Quest.Index
	S.QuestService.SetIndex(ctx.Target, index)
	return questDone(ctx, "Now on quest #" .. ctx.Profile.Quest.Index .. ".", old, ctx.Profile.Quest.Index)
end

Actions.PreviousQuest = { Target = "Online", Kind = "Edit", Run = function(ctx)
	if ctx.Profile.Quest.Index &lt;= 1 then
		return fail("Already on the first quest.")
	end
	return setQuestIndex(ctx, ctx.Profile.Quest.Index - 1)
end }

Actions.NextQuest = { Target = "Online", Kind = "Edit", Run = function(ctx)
	return setQuestIndex(ctx, ctx.Profile.Quest.Index + 1)
end }

Actions.SetQuestIndex = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local index, err = numberArg(args, "Index", 1, Cfg.MaxQuestIndex or 10000, true)
	if not index then
		return fail(err)
	end
	return setQuestIndex(ctx, index)
end }

Actions.SetLifetimeStat = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local stat = args.Stat
	if type(stat) ~= "string" or not table.find(S.DataService.StatKeys, stat) then
		return fail("Unknown stat.")
	end
	local value, err = numberArg(args, "Value", 0, MAX, true)
	if not value then
		return fail(err)
	end
	local old = ctx.Profile.Stats[stat]
	S.QuestService.SetStat(ctx.Target, stat, value)
	S.DataService.SaveSoon(ctx.Target)
	return done("Lifetime " .. stat .. " set to " .. Format.Number(ctx.Profile.Stats[stat]) .. ".", nil, old, ctx.Profile.Stats[stat], stat)
end }

-- Player -------------------------------------------------------------------
local function humanoidOf(ctx)
	local humanoid = S.ServerUtil.GetHumanoid(ctx.Target)
	if not humanoid then
		return nil, "They have no character right now."
	end
	return humanoid
end

Actions.TeleportToBeginner = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local ok, why = sendToBeginner(ctx.Target)
	if not ok then
		return fail(why)
	end
	return done("Sent " .. ctx.Target.Name .. " to the " .. Config.Areas[1].Name .. ".")
end }

Actions.BringToAdmin = { Target = "Online", Kind = "Edit", Run = function(ctx)
	if ctx.Target == ctx.Admin then
		return fail("That's you!")
	end
	local adminRoot = S.ServerUtil.GetRoot(ctx.Admin)
	if not adminRoot or not S.ServerUtil.IsAlive(ctx.Admin) then
		return fail("You need a living character to bring someone.")
	end
	if not ctx.Target.Character or not S.ServerUtil.IsAlive(ctx.Target) then
		return fail("They have no living character right now.")
	end
	local allowed, area = areaAllowed(ctx.Target, adminRoot.Position)
	if not allowed then
		return fail("They haven't unlocked " .. area.Name .. " (where you are). Unlock it for them first.")
	end
	S.TrainingService.EndTraining(ctx.Target)
	ctx.Target.Character:PivotTo(adminRoot.CFrame * CFrame.new(0, 0, -4) * CFrame.Angles(0, math.pi, 0))
	return done("Brought " .. ctx.Target.Name .. " to you.")
end }

Actions.GoToPlayer = { Target = "Online", Kind = "Safe", Run = function(ctx)
	if ctx.Target == ctx.Admin then
		return fail("That's you!")
	end
	local targetRoot = S.ServerUtil.GetRoot(ctx.Target)
	if not targetRoot then
		return fail("They have no character right now.")
	end
	if not ctx.Admin.Character or not S.ServerUtil.IsAlive(ctx.Admin) then
		return fail("You need a living character.")
	end
	local allowed, area = areaAllowed(ctx.Admin, targetRoot.Position)
	if not allowed then
		return fail("They're in " .. area.Name .. ", which is locked for YOU. Unlock it on your own account first.")
	end
	S.TrainingService.EndTraining(ctx.Admin)
	ctx.Admin.Character:PivotTo(targetRoot.CFrame * CFrame.new(0, 0, -4) * CFrame.Angles(0, math.pi, 0))
	return done("Teleported you to " .. ctx.Target.Name .. ".")
end }

Actions.Respawn = { Target = "Online", Kind = "Edit", Run = function(ctx)
	S.TrainingService.EndTraining(ctx.Target) -- clean up weights / machine state first
	task.spawn(function()
		ctx.Target:LoadCharacter()
	end)
	return done("Respawned " .. ctx.Target.Name .. ".")
end }

Actions.Heal = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local humanoid, err = humanoidOf(ctx)
	if not humanoid then
		return fail(err)
	end
	if humanoid.Health &lt;= 0 then
		return fail("They're dead - use Respawn.")
	end
	humanoid.Health = humanoid.MaxHealth
	return done("Healed " .. ctx.Target.Name .. ".")
end }

Actions.Kill = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local humanoid, err = humanoidOf(ctx)
	if not humanoid then
		return fail(err)
	end
	S.TrainingService.EndTraining(ctx.Target)
	humanoid.Health = 0
	return done("Killed " .. ctx.Target.Name .. ".")
end }

Actions.Freeze = { Target = "Online", Kind = "Edit", Run = function(ctx)
	if ctx.Target == ctx.Admin then
		return fail("You can't freeze yourself.")
	end
	if frozen[ctx.Target.UserId] then
		return fail("Already frozen.")
	end
	frozen[ctx.Target.UserId] = true
	S.TrainingService.EndTraining(ctx.Target)
	applyFreeze(ctx.Target)
	return done("Froze " .. ctx.Target.Name .. " (stays frozen after respawning).", nil, false, true)
end }

Actions.Unfreeze = { Target = "Online", Kind = "Edit", Run = function(ctx)
	if not frozen[ctx.Target.UserId] then
		return fail("They aren't frozen.")
	end
	frozen[ctx.Target.UserId] = nil
	applyFreeze(ctx.Target)
	return done("Unfroze " .. ctx.Target.Name .. ".", nil, true, false)
end }

Actions.StopTraining = { Target = "Online", Kind = "Edit", Run = function(ctx)
	local session = S.TrainingService.GetSession(ctx.Target)
	if not session then
		return fail("They aren't training.")
	end
	S.TrainingService.EndTraining(ctx.Target)
	return done("Stopped their training.", nil, session, nil)
end }

-- Donation shop items (perks like the Auto Clicker, tips) ---------------------------
Actions.GrantDonation = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local item, err = idArg(args, "ItemId", Config.DonationsById, "donation item")
	if not item then
		return fail(err)
	end
	if not S.DonationService.Grant(ctx.Target, item.Id, "Admin") then
		return fail("They already have " .. item.Name .. ".")
	end
	S.DataService.SaveSoon(ctx.Target)
	return done("Gave " .. item.Name .. ".", nil, nil, item.Id, item.Id)
end }

Actions.RevokeDonation = { Target = "Online", Kind = "Edit", Run = function(ctx, args)
	local item, err = idArg(args, "ItemId", Config.DonationsById, "donation item")
	if not item then
		return fail(err)
	end
	if not S.DonationService.Revoke(ctx.Target, item.Id) then
		return fail(item.Kind == "Perk" and "They don't have " .. item.Name .. "." or "Tips can't be removed.")
	end
	S.DataService.SaveSoon(ctx.Target)
	return done("Removed " .. item.Name .. ".", nil, item.Id, nil, item.Id)
end }

-- Reset player data (typed confirmation). Same defaults as a brand-new player.
Actions.ResetData = { Target = "Online", Kind = "Edit", Confirm = "RESET", Run = function(ctx)
	local target = ctx.Target
	local old = Format.Number(ctx.Profile.Strength) .. " Strength, " .. ctx.Profile.Rebirths .. " rebirths"
	S.TrainingService.EndTraining(target)
	local profile = S.DataService.ResetProfile(target)
	if not profile then
		return fail("Their profile isn't loaded.")
	end
	S.PetService.Sync(target) -- empty inventory + equipped list
	S.StatService.Refresh(target) -- multipliers, pet slots, leaderstats, tag, body size
	S.StatService.ApplyWalkSpeed(target) -- Sprint Shoes are gone
	S.StatService.SyncNow(target) -- gyms, equipment, upgrades, quest, auto train
	-- every gym but Beginner is locked again: move them out (or respawn if dead)
	if S.ServerUtil.IsAlive(target) then
		local root = S.ServerUtil.GetRoot(target)
		if root and not areaAllowed(target, root.Position) then
			sendToBeginner(target)
		end
	else
		task.spawn(function()
			target:LoadCharacter()
		end)
	end
	local saved = S.DataService.Save(target) -- destructive: save right away
	return done("Reset " .. target.Name .. "'s data" .. (saved and " and saved it." or " (not saved: temporary data / DataStore offline)."),
		nil, old, "fresh profile")
end }

-- Moderation ------------------------------------------------------------------
local function reasonOf(args, admin)
	local raw = textArg(args, "Reason", 200)
	if not raw then
		return "No reason given"
	end
	return filterText(raw, admin.UserId) or "Rule violation"
end

Actions.Kick = { Target = "Online", Kind = "Moderate", Confirm = true, Run = function(ctx, args)
	local reason = reasonOf(args, ctx.Admin)
	ctx.Target:Kick("You were kicked from " .. Config.Game.Title .. " by an admin.\nReason: " .. reason)
	return done("Kicked " .. ctx.Target.Name .. ".", nil, nil, nil, reason)
end }

Actions.Ban = { Target = "UserId", Kind = "Moderate", Confirm = true, Run = function(ctx, args)
	local userId = ctx.TargetUserId
	if userId &lt; 0 and not ctx.Target then
		return fail("Invalid UserId.")
	end
	local permanent = args.Permanent == true
	local minutes
	if permanent then
		if args.Confirm2 ~= "PERMANENT" then
			return fail("A permanent ban needs the second confirmation.")
		end
	else
		local err
		minutes, err = numberArg(args, "Minutes", 1, Cfg.MaxBanMinutes or 2628000, true)
		if not minutes then
			return fail(err)
		end
	end
	local reason = reasonOf(args, ctx.Admin)
	local now = os.time()
	local record = {
		Banned = true,
		Reason = reason,
		ModeratorId = ctx.Admin.UserId,
		CreatedAt = now,
		ExpiresAt = permanent and 0 or now + minutes * 60,
	}
	local saved = writeBan(userId, record)
	if ctx.Target then
		ctx.Target:Kick(banMessage(record))
	else
		-- they may be in another server of this game: tell every server to re-check
		task.spawn(pcall, MessagingService.PublishAsync, MessagingService, MESSAGE_TOPIC, { Type = "Ban", UserId = userId })
	end
	local length = permanent and "permanently" or ("for " .. durationText(minutes * 60))
	return done("Banned " .. (ctx.TargetName or tostring(userId)) .. " " .. length .. "."
		.. (saved and "" or " WARNING: the ban could not be saved to the DataStore - it only applies to this server."),
		nil, nil, permanent and "permanent" or (minutes .. " min"), reason)
end }

Actions.Unban = { Target = "UserId", Kind = "Safe", Run = function(ctx)
	local userId = ctx.TargetUserId
	local record = readBan(userId, true) or localBans[userId]
	if not record or not banActive(record) then
		localBans[userId] = nil
		return fail("UserId " .. userId .. " isn't banned.")
	end
	local updated = {
		Banned = false,
		Reason = record.Reason,
		ModeratorId = ctx.Admin.UserId,
		CreatedAt = record.CreatedAt,
		ExpiresAt = record.ExpiresAt,
		UnbannedAt = os.time(),
	}
	local saved = writeBan(userId, updated)
	return done("Unbanned " .. (ctx.TargetName or tostring(userId)) .. "." .. (saved and "" or " (DataStore offline: only this server knows.)"),
		nil, true, false)
end }

-- Server ---------------------------------------------------------------------
Actions.Announce = { Target = "None", Kind = "Safe", Run = function(ctx, args)
	local text = textArg(args, "Text", 150)
	if not text then
		return fail("Type a message first.")
	end
	local kind = ANNOUNCE_COLORS[args.Kind] and args.Kind or "Info"
	local filtered = filterText(text, ctx.Admin.UserId)
	if not filtered then
		return fail("The chat filter is unavailable right now. Try again in a moment.")
	end
	S.ServerUtil.Announce("📢 " .. filtered, ANNOUNCE_COLORS[kind])
	return done("Announcement sent.", nil, nil, nil, kind .. ": " .. filtered)
end }

Actions.SaveAll = { Target = "None", Kind = "Safe", Run = function()
	local r = saveAll(20)
	return done(string.format("Saved %d player(s)%s%s%s.", r.Saved, r.Failed &gt; 0 and (", " .. r.Failed .. " failed") or "",
		r.Skipped &gt; 0 and (", " .. r.Skipped .. " skipped (not saveable)") or "", r.Pending &gt; 0 and (", " .. r.Pending .. " still saving") or ""),
		r, nil, r.Saved)
end }

Actions.SyncAll = { Target = "None", Kind = "Safe", Run = function()
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService.Get(player) then
			S.PetService.Sync(player)
			S.StatService.Refresh(player)
			S.StatService.SyncNow(player)
			count = count + 1
		end
	end
	return done("Re-synced " .. count .. " player(s).", nil, nil, count)
end }

Actions.ReturnAllToBeginner = { Target = "None", Kind = "Safe", Confirm = true, Run = function()
	local count = 0
	for _, player in ipairs(Players:GetPlayers()) do
		if S.DataService.Get(player) and sendToBeginner(player) then
			count = count + 1
		end
	end
	return done("Sent " .. count .. " player(s) to the " .. Config.Areas[1].Name .. ".", nil, nil, count)
end }

Actions.Shutdown = { Target = "None", Kind = "Safe", Confirm = "SHUTDOWN", MinLevel = LEVEL.Admin, Run = function(ctx, args)
	if shuttingDown then
		return fail("Already shutting down.")
	end
	local message = "The server is restarting. Please rejoin!"
	local custom = textArg(args, "Message", 150)
	if custom then
		message = filterText(custom, ctx.Admin.UserId) or message
	end
	shuttingDown = true
	task.spawn(function()
		S.ServerUtil.Announce("⚠️ This server is shutting down in 5 seconds - your progress is being saved!", ANNOUNCE_COLORS.Warning)
		task.wait(5)
		saveAll(25) -- save everyone BEFORE kicking
		for _, player in ipairs(Players:GetPlayers()) do
			player:Kick(message)
		end
	end)
	return done("Shutting down: saving everyone, then kicking with your message.", nil, nil, nil, message)
end }

AdminService.Actions = Actions -- exposed for the test harness (read-only use)

----------------------------------------------------------------------
-- Dispatch
----------------------------------------------------------------------
local function resolve(admin, level, spec, targetUserId)
	local ctx = { Admin = admin, Level = level }
	if spec.Target == "None" then
		return ctx
	end
	if not isUserId(targetUserId) then
		return nil, "Invalid UserId."
	end
	ctx.TargetUserId = targetUserId
	ctx.Target = Players:GetPlayerByUserId(targetUserId) -- resolved on the server, never sent by the client
	if spec.Target == "Online" then
		if not ctx.Target then
			return nil, "That player isn't in this server."
		end
		ctx.Profile = S.DataService.Get(ctx.Target)
		if not ctx.Profile then
			return nil, "That player's data is still loading."
		end
	end
	ctx.TargetName = ctx.Target and ctx.Target.Name or nil
	if spec.Kind == "Safe" then
		return ctx
	end
	-- protected ranks
	if targetUserId == admin.UserId then
		if spec.Kind == "Moderate" then
			return nil, "You can't use that on yourself."
		end
		return ctx
	end
	local targetLevel, certain = levelOfUserId(targetUserId)
	if not certain then
		return nil, "Couldn't check that player's rank right now. Try again."
	end
	ctx.TargetLevel = targetLevel
	if spec.Kind == "Moderate" and level &lt;= targetLevel then
		return nil, "You can't moderate a " .. LEVEL_NAMES[targetLevel] .. "."
	end
	if spec.Kind == "Edit" and targetLevel &gt;= LEVEL.SuperAdmin and level &lt;= targetLevel then
		return nil, "That player is protected (" .. LEVEL_NAMES[targetLevel] .. ")."
	end
	return ctx
end

function AdminService.RunAction(admin, actionName, targetUserId, args)
	-- 1. admin check FIRST: nothing below runs for a non-admin
	local level = AdminService.GetLevel(admin)
	if level &lt;= LEVEL.None then
		noteUnauthorized(admin, "AdminAction", actionName)
		return unauthorized()
	end
	if not S.ServerUtil.Allow(admin, "AdminAction", Cfg.ActionCooldown or 0.1) then
		return fail("Slow down!")
	end
	-- 2. whitelisted action + well-formed arguments
	local spec = type(actionName) == "string" and rawget(Actions, actionName)
	if not spec then
		return fail("Unknown action.")
	end
	if args == nil then
		args = {}
	elseif type(args) ~= "table" then
		return fail("Bad arguments.")
	end
	if spec.MinLevel and level &lt; spec.MinLevel then
		return fail("Your admin rank can't do that.")
	end
	if spec.Confirm ~= nil and args.Confirm ~= spec.Confirm then
		return fail(type(spec.Confirm) == "string" and ("Type " .. spec.Confirm .. " to confirm.") or "This action needs confirmation.")
	end
	-- 3. target resolved + permission checked on the server
	local ctx, err = resolve(admin, level, spec, targetUserId)
	if not ctx then
		audit({ Admin = admin, Action = actionName, TargetUserId = isUserId(targetUserId) and targetUserId or nil,
			TargetName = isUserId(targetUserId) and tostring(targetUserId) or "", Details = err, Ok = false })
		return fail(err)
	end
	if spec.Target == "UserId" and not ctx.TargetName then
		ctx.TargetName = nameOf(ctx.TargetUserId)
	end
	-- 4. run it (validation + the change itself happen inside, through the owning services)
	local ok, result = pcall(spec.Run, ctx, args)
	if not ok then
		warn("[+1 Gym Game][Admin] " .. actionName .. " errored: " .. tostring(result))
		result = fail("That action failed on the server (see the server output).")
	end
	-- 5. audit log (successes and refusals)
	audit({
		Admin = admin, Action = actionName, TargetUserId = ctx.TargetUserId, TargetName = ctx.TargetName or "",
		Old = result.Old, New = result.New, Details = result.Ok and result.Details or result.Message, Ok = result.Ok,
	})
	return { Ok = result.Ok == true, Message = result.Message, Data = result.Data }
end

----------------------------------------------------------------------
-- Read-only state for the panel
----------------------------------------------------------------------
local function copyFlat(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = v
	end
	return c
end

local function canEdit(level, admin, player, targetLevel)
	return player == admin or targetLevel &lt; LEVEL.SuperAdmin or level &gt; targetLevel
end

local function playerDetails(admin, level, player)
	local profile = S.DataService.Get(player)
	local humanoid = S.ServerUtil.GetHumanoid(player)
	local targetLevel = AdminService.GetLevel(player)
	local d = {
		UserId = player.UserId,
		Name = player.Name,
		DisplayName = player.DisplayName,
		AccountAge = player.AccountAge,
		Level = targetLevel,
		LevelName = LEVEL_NAMES[targetLevel],
		IsYou = player == admin,
		CanEdit = canEdit(level, admin, player, targetLevel),
		CanModerate = player ~= admin and level &gt; targetLevel,
		Status = S.DataService.GetStatus(player),
		Alive = humanoid ~= nil and humanoid.Health &gt; 0,
		Health = humanoid and math.floor(humanoid.Health) or 0,
		MaxHealth = humanoid and math.floor(humanoid.MaxHealth) or 0,
		Training = S.TrainingService.GetSession(player),
		Frozen = frozen[player.UserId] == true,
		CurrentGym = player:GetAttribute("CurrentGym"),
	}
	if profile then
		local petMult = S.PetService.GetPetMultiplier(player)
		d.Strength = profile.Strength
		d.TotalStrength = profile.TotalStrength
		d.Coins = profile.Coins
		d.Rebirths = profile.Rebirths
		d.RebirthMult = Formulas.RebirthMultiplier(profile.Rebirths)
		d.PetMult = petMult
		d.StrengthMult = S.StatService.GetStrengthMultiplier(player)
		d.CoinMult = S.StatService.GetCoinMultiplier(player)
		d.Areas = copyFlat(profile.UnlockedAreas)
		d.Stations = copyFlat(profile.Stations)
		d.Upgrades = copyFlat(profile.Upgrades)
		d.Slots = S.PetService.GetSlots(player)
		d.Equipped = copyFlat(profile.Equipped)
		local pets = {}
		local equipped = {}
		for _, uid in ipairs(profile.Equipped) do
			equipped[uid] = true
		end
		for uid, pet in pairs(profile.Pets) do
			pets[#pets + 1] = { Uid = uid, Id = pet.Id, Locked = pet.Locked == true, Equipped = equipped[uid] == true }
		end
		table.sort(pets, function(a, b)
			return tonumber(a.Uid) &lt; tonumber(b.Uid)
		end)
		d.Pets = pets
		d.Quest = S.QuestService.GetView(player)
		d.Stats = copyFlat(profile.Stats)
		d.Perks = copyFlat(profile.Perks or {})
		d.Donated = profile.Donated or 0
	end
	return d
end

local STATE = {}

STATE.Access = function(admin, level)
	return {
		Level = level,
		LevelName = LEVEL_NAMES[level],
		UserId = admin.UserId,
		BanPresets = Cfg.BanPresets,
		MaxGivePets = Cfg.MaxGivePets,
		MaxBanMinutes = Cfg.MaxBanMinutes,
	}
end

STATE.Players = function(admin)
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = S.DataService.Get(player)
		local level = AdminService.GetLevel(player)
		list[#list + 1] = {
			UserId = player.UserId,
			Name = player.Name,
			DisplayName = player.DisplayName,
			Level = level,
			LevelName = LEVEL_NAMES[level],
			Loaded = profile ~= nil,
			Strength = profile and profile.Strength or 0,
			Rebirths = profile and profile.Rebirths or 0,
			Frozen = frozen[player.UserId] == true,
			IsYou = player == admin,
		}
	end
	table.sort(list, function(a, b)
		if a.IsYou ~= b.IsYou then
			return a.IsYou
		end
		return string.lower(a.DisplayName) &lt; string.lower(b.DisplayName)
	end)
	return list
end

STATE.Player = function(admin, level, userId)
	if not isUserId(userId) then
		error("Invalid UserId.", 0)
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		error("That player isn't in this server.", 0)
	end
	return playerDetails(admin, level, player)
end

STATE.Logs = function(_, _, filter)
	local function wanted(key)
		local v = type(filter) == "table" and filter[key]
		return type(v) == "string" and #v &gt; 0 and #v &lt;= 40 and string.lower(v) or nil
	end
	local byAdmin, byTarget, byAction = wanted("Admin"), wanted("Target"), wanted("Action")
	local out = {}
	for i = #auditLog, 1, -1 do
		local e = auditLog[i]
		if (not byAdmin or string.find(string.lower(e.AdminName .. " " .. e.AdminUserId), byAdmin, 1, true))
			and (not byTarget or string.find(string.lower(tostring(e.TargetName) .. " " .. tostring(e.TargetUserId)), byTarget, 1, true))
			and (not byAction or string.find(string.lower(e.Action), byAction, 1, true)) then
			out[#out + 1] = e
			if #out &gt;= 100 then
				break
			end
		end
	end
	return { Entries = out, Total = #auditLog }
end

STATE.Server = function()
	return {
		JobId = game.JobId ~= "" and game.JobId or "Studio",
		PlaceId = game.PlaceId,
		PlaceVersion = game.PlaceVersion,
		PlayerCount = #Players:GetPlayers(),
		MaxPlayers = Players.MaxPlayers,
		Uptime = math.floor(os.clock() - startedAt),
		IsStudio = RunService:IsStudio(),
		ShuttingDown = shuttingDown,
		BanStore = banStore ~= nil,
		LogCount = #auditLog,
	}
end

STATE.Ban = function(_, _, userId)
	if not isUserId(userId) then
		error("Invalid UserId.", 0)
	end
	local record = readBan(userId, true) or localBans[userId]
	return {
		UserId = userId,
		Name = nameOf(userId),
		Found = record ~= nil,
		Active = record ~= nil and banActive(record),
		Reason = record and record.Reason or nil,
		ModeratorId = record and record.ModeratorId or nil,
		CreatedAt = record and record.CreatedAt or nil,
		ExpiresAt = record and record.ExpiresAt or nil,
	}
end

function AdminService.GetState(admin, kind, arg)
	local level = AdminService.GetLevel(admin)
	if level &lt;= LEVEL.None then
		if kind ~= "Access" then -- every client asks "Access" once to decide on the button
			noteUnauthorized(admin, "AdminGetState", kind)
		end
		return unauthorized()
	end
	local handler = type(kind) == "string" and rawget(STATE, kind)
	if not handler then
		return fail("Unknown request.")
	end
	if not S.ServerUtil.Allow(admin, "AdminState_" .. kind, Cfg.StateCooldown or 0.15) then
		return fail("Slow down!")
	end
	local ok, data = pcall(handler, admin, level, arg)
	if not ok then
		return fail(tostring(data))
	end
	return { Ok = true, Data = data }
end

----------------------------------------------------------------------
-- Player hooks (called by GymServer)
----------------------------------------------------------------------
function AdminService.OnCharacter(player, character)
	if not frozen[player.UserId] then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.3) -- AreaService.OnCharacter may still move the new character
	if root and frozen[player.UserId] and player.Character == character then
		root.Anchored = true
		player:SetAttribute("AdminFrozen", true)
	end
end

function AdminService.PlayerLeaving(player)
	levelCache[player] = nil
	lastDenied[player] = nil
	frozen[player.UserId] = nil
end

function AdminService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes
	Cfg = Config.Admin or {}
	MAX = Config.Game.MaxValue
	adminIds = toSet(Cfg.UserIds)
	superIds = toSet(Cfg.SuperAdminUserIds)

	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Cfg.BanDataStoreName or "GymLegends_AdminBans_v1")
	end)
	if ok then
		banStore = result
	else
		warn("[+1 Gym Game][Admin] Ban DataStore unavailable: " .. tostring(result))
	end

	-- a ban made in another server kicks the player here too (re-checked against the store)
	task.spawn(function()
		local subscribed, err = pcall(function()
			MessagingService:SubscribeAsync(MESSAGE_TOPIC, function(message)
				local data = message.Data
				if type(data) ~= "table" or data.Type ~= "Ban" or not isUserId(data.UserId) then
					return
				end
				local player = Players:GetPlayerByUserId(data.UserId)
				if player and AdminService.GetLevel(player) &lt; LEVEL.SuperAdmin then
					local record = readBan(data.UserId, true)
					if record and banActive(record) then
						player:Kick(banMessage(record))
					end
				end
			end)
		end)
		if not subscribed then
			warn("[+1 Gym Game][Admin] Cross-server bans unavailable: " .. tostring(err))
		end
	end)

	-- The ONLY two admin remotes. Both check admin rights on every single call.
	Remotes.Get("AdminGetState").OnServerInvoke = function(player, kind, arg)
		return AdminService.GetState(player, kind, arg)
	end
	Remotes.Get("AdminAction").OnServerInvoke = function(player, actionName, targetUserId, args)
		return AdminService.RunAction(player, actionName, targetUserId, args)
	end
end

return AdminService
</ProtectedString></Properties></Item>
      <Item class="ModuleScript" referent="RBX12">
        <Properties>
          <string name="Name">AreaService</string>
          <ProtectedString name="Source">--[[
	AreaService - gates, area unlocking, teleporting and zone enforcement.

	  * A gate is a solid wall. Pushing it (ProximityPrompt) checks the player's Strength ON THE SERVER.
	  * Unlocked areas are saved forever (they stay open after a rebirth).
	  * Every 0.5s the server checks where each player is standing; anyone inside a gym they have
	    not unlocked is teleported back out. So noclip / teleport exploits can't skip gates.
]]
local Players = game:GetService("Players")

local AreaService = {}

local S, Config, Remotes
local lastArea = {} -- [player] = areaId chosen by teleport (session only)

local function profileOf(player)
	return S.DataService.Get(player)
end

function AreaService.IsUnlocked(player, areaId)
	local profile = profileOf(player)
	return profile ~= nil and profile.UnlockedAreas[areaId] == true
end

local function unlock(player, profile, area)
	profile.UnlockedAreas[area.Id] = true
	S.QuestService.Record(player, "Areas", 1)
	Remotes.Get("AreaUnlocked"):FireClient(player, area.Id)
	S.StatService.SyncNow(player)
	task.spawn(S.DataService.Save, player)
end

local function onGateTriggered(player, area)
	if not S.ServerUtil.Allow(player, "Gate", 0.8) then
		return
	end
	local profile = profileOf(player)
	if not profile then
		return
	end
	if profile.UnlockedAreas[area.Id] then
		S.ServerUtil.Notify(player, area.Name .. " is already open - just walk in!", "Info")
		return
	end
	-- the previous gym must be open (you can't reach a later gate anyway, this is belt and braces)
	local previous = Config.Areas[area.Index - 1]
	if previous and not profile.UnlockedAreas[previous.Id] then
		S.ServerUtil.Notify(player, "Unlock " .. previous.Name .. " first!", "Error")
		return
	end
	if profile.Strength &gt;= area.Required then
		unlock(player, profile, area)
	else
		Remotes.Get("GateDenied"):FireClient(player, area.Id, area.Required, profile.Strength)
	end
end

-- Moves an alive character to a gym's spawn. The gym must be unlocked for that player
-- (so zone enforcement never has to bounce them straight back out). No rate limit here:
-- callers (the TeleportArea remote, admin tools) do their own checks.
function AreaService.SendTo(player, areaId)
	local area = Config.AreasById[areaId]
	if not area then
		return false, "Unknown gym."
	end
	if not AreaService.IsUnlocked(player, areaId) then
		return false, area.Name .. " is locked for that player."
	end
	local character = player.Character
	if not character or not S.ServerUtil.IsAlive(player) then
		return false, "That player has no living character right now."
	end
	S.TrainingService.EndTraining(player)
	character:PivotTo(CFrame.new(Config.AreaSpawn(area.Index)))
	lastArea[player] = areaId
	S.StatService.SetCurrentGym(player, area.Name)
	return true
end

-- Admin tools: open / close a gym for one player without the Strength check.
-- Returns true when something changed. The caller syncs + saves once afterwards, so
-- "unlock all" sends one state update instead of one per gym. The client opens / closes
-- the gate itself from the synced state (no unlock banner for admin grants).
-- The Beginner gym can never be locked; a player standing in a gym that gets locked is
-- sent back to the Beginner gym first.
function AreaService.SetUnlocked(player, areaId, unlocked)
	local profile = profileOf(player)
	local area = Config.AreasById[areaId]
	if not profile or not area or type(unlocked) ~= "boolean" then
		return false
	end
	if not unlocked and area.Index == 1 then
		return false
	end
	if (profile.UnlockedAreas[areaId] == true) == unlocked then
		return false
	end
	if unlocked then
		profile.UnlockedAreas[areaId] = true
	else
		local root = S.ServerUtil.GetRoot(player)
		if root and Config.AreaAt(root.Position) == area.Index then
			AreaService.SendTo(player, Config.Areas[1].Id)
		end
		profile.UnlockedAreas[areaId] = nil
		if lastArea[player] == areaId then
			lastArea[player] = nil
		end
	end
	return true
end

function AreaService.Teleport(player, areaId)
	local Fail = S.ServerUtil.Fail
	if type(areaId) ~= "string" then
		return Fail("Bad request.")
	end
	local area = Config.AreasById[areaId]
	if not area then
		return Fail("Unknown gym.")
	end
	if not S.ServerUtil.Allow(player, "Teleport", 2) then
		return Fail("Wait a moment before teleporting again.")
	end
	if not AreaService.IsUnlocked(player, areaId) then
		return Fail("That gym is still locked!")
	end
	if not player.Character or not S.ServerUtil.IsAlive(player) then
		return Fail("You can't teleport right now.")
	end
	local ok, err = AreaService.SendTo(player, areaId)
	if not ok then
		return Fail(err)
	end
	return { Ok = true }
end

function AreaService.OnCharacter(player, character)
	local areaId = lastArea[player]
	local initial = areaId and Config.AreasById[areaId]
	S.StatService.SetCurrentGym(player, initial and initial.Name or "Beginner Gym")
	if areaId and areaId ~= "Beginner" and AreaService.IsUnlocked(player, areaId) then
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root then
			task.wait(0.1)
			character:PivotTo(CFrame.new(Config.AreaSpawn(Config.AreaIndex[areaId])))
		end
	end
end

function AreaService.PlayerLeaving(player)
	lastArea[player] = nil
end

local function enforceZones()
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = profileOf(player)
		local root = S.ServerUtil.GetRoot(player)
		if profile and root then
			local index = Config.AreaAt(root.Position)
			if index then
				local area = Config.Areas[index]
				if not profile.UnlockedAreas[area.Id] then
					player.Character:PivotTo(CFrame.new(Config.GateFront(index)))
					S.StatService.SetCurrentGym(player, "Between Gyms")
					if S.ServerUtil.Allow(player, "ZoneWarn", 3) then
						S.ServerUtil.Notify(player, "🔒 " .. area.Name .. " is locked! Push its gate with enough Strength.", "Error")
					end
				else
					S.StatService.SetCurrentGym(player, area.Name)
				end
			else
				S.StatService.SetCurrentGym(player, "Between Gyms")
			end
		end
	end
end

function AreaService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	for areaId, gate in pairs(services.World.Gates) do
		local area = Config.AreasById[areaId]
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "GatePrompt"
		prompt.ActionText = "Push Gate"
		prompt.ObjectText = area.Name
		prompt.HoldDuration = 0.6
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = gate.Prompt
		prompt.Triggered:Connect(function(player)
			onGateTriggered(player, area)
		end)
	end

	Remotes.Get("TeleportArea").OnServerInvoke = function(player, areaId)
		return AreaService.Teleport(player, areaId)
	end

	task.spawn(function()
		while true do
			task.wait(0.5)
			enforceZones()
		end
	end)
end

return AreaService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX13">
        <Properties>
          <string name="Name">DataService</string>
          <ProtectedString name="Source">--[[
	DataService - loads / saves each player's profile (DataStore) and hands it to other services.

	* The profile is a plain table that ONLY the server ever touches.
	* If DataStores are unavailable in Studio (API access off) the game still works,
	  the data just isn't saved. In a live game a failed load kicks the player instead of
	  risking overwriting their real save with an empty one.
	* Everything is saved every AutosaveSeconds, when the player leaves, and on server shutdown.
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local DataStoreService = game:GetService("DataStoreService")

local DataService = {}

local S, Config
local store
local profiles = {} -- [player] = profile
local savingNow = {}   -- [player] = true while a save is running
local lastSave = {}    -- [player] = os.clock() of the last save
local pendingSave = {} -- [player] = true if a delayed save is queued
local activeSaves = 0  -- how many saves are in flight (BindToClose waits for 0)

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in pairs(t) do
		c[k] = deepCopy(v)
	end
	return c
end

local function buildTemplate()
	return {
		Version = 1,
		Strength = 0,
		TotalStrength = 0,
		Coins = Config.Game.StartCoins,
		Rebirths = 0,
		HighestMilestone = 0,
		Pets = {},            -- [uid string] = { Id = petId, Locked = bool }
		Equipped = {},        -- array of uid strings
		NextPetUid = 1,
		UnlockedAreas = { Beginner = true },
		Stations = { Beginner_1 = true },
		Upgrades = {},        -- [upgradeId] = level
		Quest = { Index = 1, Progress = 0 },
		Stats = { Reps = 0, Hatches = 0, Orbs = 0, Sells = 0, Upgrades = 0, Rebirths = 0, Areas = 0 },
		AutoTrain = false,
		Perks = {},           -- [perk] = true (donation shop perks, e.g. AutoClicker)
		Donated = 0,          -- Robux donated (tips + perks)
		Receipts = {},        -- recent Robux purchase ids (so a purchase is never granted twice)
	}
end

-- add any missing keys from the template (so old saves get new features safely)
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and next(v) ~= nil and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
end

local function sanitizeNumber(value, default)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return default
	end
	return math.clamp(value, 0, Config.Game.MaxValue)
end

local function sanitize(profile)
	profile.Strength = sanitizeNumber(profile.Strength, 0)
	profile.TotalStrength = sanitizeNumber(profile.TotalStrength, 0)
	profile.Coins = sanitizeNumber(profile.Coins, 0)
	profile.Rebirths = math.floor(sanitizeNumber(profile.Rebirths, 0))
	-- drop pets / stations / areas that no longer exist in Config
	for uid, pet in pairs(profile.Pets) do
		if type(pet) ~= "table" or not Config.PetsById[pet.Id] then
			profile.Pets[uid] = nil
		end
	end
	for id in pairs(profile.Stations) do
		if not Config.StationsById[id] then
			profile.Stations[id] = nil
		end
	end
	for id in pairs(profile.UnlockedAreas) do
		if not Config.AreasById[id] then
			profile.UnlockedAreas[id] = nil
		end
	end
	for id in pairs(profile.Upgrades) do
		if not Config.UpgradesById[id] then
			profile.Upgrades[id] = nil -- removed upgrades (e.g. the old Auto Trainer)
		end
	end
	profile.AutoTrain = false
	for perk in pairs(profile.Perks) do
		if not Config.DonationPerks or not Config.DonationPerks[perk] then
			profile.Perks[perk] = nil
		end
	end
	profile.Donated = sanitizeNumber(profile.Donated, 0)
	if type(profile.Receipts) ~= "table" then
		profile.Receipts = {}
	end
	profile.UnlockedAreas.Beginner = true
	profile.Stations.Beginner_1 = true
end

function DataService.Init(services)
	S = services
	Config = services.Config
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Game.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[+1 Gym Game] DataStore unavailable: " .. tostring(result))
	end

	-- autosave loop
	task.spawn(function()
		while true do
			task.wait(Config.Game.AutosaveSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				task.spawn(DataService.Save, player)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		-- save everyone still in the server, then wait for ALL saves (including ones started
		-- when players left) to finish, so stopping a Studio test never loses progress
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.Save, player)
		end
		local waited = 0
		task.wait(0.2)
		while activeSaves &gt; 0 and waited &lt; 28 do
			task.wait(0.2)
			waited = waited + 0.2
		end
	end)
end

-- Yields until the profile is loaded. Returns the profile, or nil (player left / was kicked).
function DataService.Load(player)
	local profile
	local loaded = false
	local noSave = false
	if store then
		local key = "Player_" .. player.UserId
		local maxAttempts = RunService:IsStudio() and 2 or 4
		for attempt = 1, maxAttempts do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				profile = result
				loaded = true
				break
			end
			warn("[+1 Gym Game] Load attempt " .. attempt .. " failed for " .. player.Name .. ": " .. tostring(result))
			task.wait(RunService:IsStudio() and 1 or 1.5 * attempt)
			if not player.Parent then
				return nil
			end
		end
	end
	if not loaded then
		if RunService:IsStudio() then
			warn("[+1 Gym Game] Could not reach DataStore (enable Studio Access to API Services). Using temporary data - progress will NOT be saved.")
			noSave = true
		else
			player:Kick("We couldn't load your save data. Please rejoin in a moment!")
			return nil
		end
	end
	if not player.Parent then
		return nil
	end
	if type(profile) ~= "table" then
		profile = buildTemplate()
	end
	reconcile(profile, buildTemplate())
	sanitize(profile)
	profile._noSave = noSave
	profiles[player] = profile
	return profile
end

function DataService.Get(player)
	return profiles[player]
end

-- the lifetime counters every profile has (used by quests / admin tools)
DataService.StatKeys = { "Reps", "Hatches", "Orbs", "Sells", "Upgrades", "Rebirths", "Areas" }

-- Replaces a loaded profile with a brand-new one (the exact defaults a new player gets).
-- The table is reset IN PLACE so nothing holding a reference ends up with stale data.
function DataService.ResetProfile(player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local noSave = profile._noSave
	for k in pairs(profile) do
		profile[k] = nil
	end
	for k, v in pairs(buildTemplate()) do
		profile[k] = v
	end
	sanitize(profile)
	profile._noSave = noSave
	return profile
end

-- For the admin dashboard: is the profile loaded, saving, or temporary (NoSave)?
function DataService.GetStatus(player)
	local profile = profiles[player]
	return {
		Loaded = profile ~= nil,
		NoSave = profile ~= nil and profile._noSave == true,
		Saving = savingNow[player] == true,
		StoreAvailable = store ~= nil,
		LastSaveAgo = lastSave[player] and math.floor(os.clock() - lastSave[player]) or nil,
	}
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or profile._noSave or not store then
		return false
	end
	-- one save at a time per player (a second caller waits, then saves the newest data)
	while savingNow[player] do
		task.wait(0.1)
	end
	profile = profiles[player]
	if not profile then
		return false
	end
	savingNow[player] = true
	activeSaves = activeSaves + 1
	local payload = {}
	for k, v in pairs(profile) do
		if string.sub(k, 1, 1) ~= "_" then
			payload[k] = v
		end
	end
	payload = deepCopy(payload)
	local key = "Player_" .. player.UserId
	local saved = false
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			store:UpdateAsync(key, function()
				return payload
			end)
		end)
		if ok then
			saved = true
			break
		end
		warn("[+1 Gym Game] Save attempt " .. attempt .. " failed for " .. player.Name .. ": " .. tostring(err))
		task.wait(1)
	end
	lastSave[player] = os.clock()
	savingNow[player] = nil
	activeSaves = activeSaves - 1
	return saved
end

-- Save soon (but never more than once every 10 seconds). Call after important changes
-- (purchases, hatches, rebirth...) so progress is safe even if the server stops suddenly.
function DataService.SaveSoon(player)
	local profile = profiles[player]
	if not profile or profile._noSave then
		return
	end
	local now = os.clock()
	local since = lastSave[player] and (now - lastSave[player]) or math.huge
	if since &gt;= 10 then
		lastSave[player] = now
		task.spawn(DataService.Save, player)
	elseif not pendingSave[player] then
		pendingSave[player] = true
		task.delay(10 - since, function()
			pendingSave[player] = nil
			if profiles[player] then
				DataService.Save(player)
			end
		end)
	end
end

-- called when a player leaves: save, then forget
function DataService.Release(player)
	DataService.Save(player)
	profiles[player] = nil
	lastSave[player] = nil
	pendingSave[player] = nil
end

return DataService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX14">
        <Properties>
          <string name="Name">EggService</string>
          <ProtectedString name="Source">--[[
	EggService - hatching. The server rolls the pets, takes the coins and gives the pets.
	The client just asks "hatch 1 or 3 of this egg" and plays the animation with the result.
]]
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Formulas = require(Shared.Formulas)

local EggService = {}

local S, Config, Remotes
local eggStands = {} -- [eggId] = Part (position used for range checks)

local function profileOf(player)
	return S.DataService.Get(player)
end

function EggService.Init(services)
	S = services
	Config = services.Config
	Remotes = services.Remotes

	for eggId, stand in pairs(services.World.Eggs) do
		eggStands[eggId] = stand.Prompt
		local egg = Config.EggsById[eggId]
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "EggPrompt"
		prompt.ActionText = "Open Lucky Block"
		prompt.ObjectText = egg.Name
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = stand.Prompt
		prompt.Triggered:Connect(function(player)
			if S.AreaService.IsUnlocked(player, egg.Area) and S.ServerUtil.Allow(player, "EggPrompt", 0.5) then
				Remotes.Get("OpenEgg"):FireClient(player, eggId)
			end
		end)
	end

	Remotes.Get("HatchEgg").OnServerInvoke = function(player, eggId, count)
		return EggService.Hatch(player, eggId, count)
	end
end

function EggService.Hatch(player, eggId, count)
	local Fail = S.ServerUtil.Fail
	if type(eggId) ~= "string" or type(count) ~= "number" then
		return Fail("Bad request.")
	end
	local egg = Config.EggsById[eggId]
	if not egg then
		return Fail("Unknown Lucky Block.")
	end
	if count ~= 1 and count ~= 3 then
		return Fail("You can open 1 or 3 Lucky Blocks.")
	end
	local profile = profileOf(player)
	if not profile then
		return Fail("Loading...")
	end
	if not S.ServerUtil.Allow(player, "Hatch", Config.Egg.Cooldown) then
		return Fail("Slow down a little!")
	end
	if count == 3 and Formulas.Level(profile.Upgrades, "MultiHatch") &lt; 1 then
		return Fail("Buy 'Triple Open' in the Shop first!")
	end
	if not profile.UnlockedAreas[egg.Area] then
		return Fail("Unlock that gym first!")
	end
	local stand = eggStands[eggId]
	if not stand or S.ServerUtil.DistanceTo(player, stand.Position) &gt; Config.Egg.Range then
		return Fail("Stand closer to the Lucky Block!")
	end
	if S.PetService.FreeSpace(player) &lt; count then
		return Fail("Your pet inventory is full! Delete some pets first.")
	end
	local total = egg.Price * count
	if not S.StatService.SpendCoins(player, total) then
		return Fail("Not enough coins!")
	end

	local luck = Formulas.Luck(profile.Upgrades)
	local results = {}
	for _ = 1, count do
		local pet = Formulas.RollPet(egg, luck, math.random)
		local uid = S.PetService.AddPet(player, pet.Id)
		if uid then
			results[#results + 1] = { PetId = pet.Id, Uid = uid }
			S.PetService.TryEquip(player, uid) -- fill empty slots automatically
			S.QuestService.Record(player, "Hatches", 1)
			local rarity = Config.Rarities[pet.Rarity]
			if rarity.Order &gt;= 6 then
				S.ServerUtil.Announce(
					player.DisplayName .. " got a " .. rarity.Label .. " " .. pet.Emoji .. " " .. pet.Name .. "!",
					rarity.Color
				)
			end
		end
	end
	S.PetService.Sync(player)
	S.StatService.SyncNow(player)
	S.DataService.SaveSoon(player)
	return { Ok = true, Results = results }
end

return EggService
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX15">
        <Properties>
          <string name="Name">EquipmentModels</string>
          <ProtectedString name="Source">--[[
	EquipmentModels - builds gym equipment out of plain Parts (no uploaded assets needed).

	Every builder gets:  model, cf (floor-level CFrame; the user stands at +Z looking toward -Z),
	                     theme (colors of the current gym), s (size scale grows with tier)
	and returns the height (Y) of the floor the user stands on (standY).

	Each kind creates a "Mover" child Model. The CLIENT animates it on every rep:
	    MoverKind = "Lift"  -&gt; moves up/down     (attribute Amp = studs)
	    MoverKind = "Swing" -&gt; swings like a bag (attribute Amp = radians)
	    MoverKind = "Flow"  -&gt; scrolls forward   (treadmill belt stripes)
	    SpinSpeed (optional attribute) -&gt; keeps rotating around Y
]]
local EquipmentModels = {}
local BarbellDesign = require(game:GetService("ReplicatedStorage"):WaitForChild("GymShared").BarbellDesign)

local METAL = Color3.fromRGB(72, 76, 90)
local DARK = Color3.fromRGB(38, 40, 50)
local CHROME = Color3.fromRGB(205, 210, 222)
local CLIP_RED = Color3.fromRGB(242, 64, 64)
local CLIP_RED_DARK = Color3.fromRGB(187, 34, 34)
local CLIP_BLACK = Color3.fromRGB(28, 31, 37)
local WOOD = Color3.fromRGB(150, 104, 62)
local LEATHER = Color3.fromRGB(46, 40, 44)

-- Unknown material names (e.g. newer materials on an older client) fall back to SmoothPlastic
local function mat(name)
	if type(name) == "string" then
		local ok, m = pcall(function()
			return Enum.Material[name]
		end)
		return ok and m or Enum.Material.SmoothPlastic
	end
	return name
end

-- generic part
local function add(parent, cf, offset, size, color, material, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Name = opts.Name or "Part"
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	local rotation = opts.Rotation or CFrame.new()
	p.CFrame = cf * CFrame.new(offset) * rotation
	p.Color = color
	p.Material = mat(material or "SmoothPlastic")
	p.Transparency = opts.Transparency or 0
	p.CanCollide = opts.CanCollide ~= false
	if opts.Shape then
		p.Shape = opts.Shape
	end
	p.Parent = parent
	return p
end

-- cylinder along an axis: "X" (default), "Y" (standing) or "Z"
local function cyl(parent, cf, offset, axis, length, diameter, color, material, opts)
	opts = opts or {}
	local rotation = CFrame.new()
	if axis == "Y" then
		rotation = CFrame.Angles(0, 0, math.rad(90))
	elseif axis == "Z" then
		rotation = CFrame.Angles(0, math.rad(90), 0)
	end
	local o = {}
	for k, v in pairs(opts) do
		o[k] = v
	end
	o.Rotation = rotation
	o.Shape = Enum.PartType.Cylinder
	return add(parent, cf, offset, Vector3.new(length, diameter, diameter), color, material, o)
end

local function ball(parent, cf, offset, diameter, color, material, opts)
	opts = opts or {}
	local o = {}
	for k, v in pairs(opts) do
		o[k] = v
	end
	o.Shape = Enum.PartType.Ball
	return add(parent, cf, offset, Vector3.new(diameter, diameter, diameter), color, material, o)
end

local function newMover(parent, kind, amp)
	local m = Instance.new("Model")
	m.Name = "Mover"
	m:SetAttribute("MoverKind", kind)
	m:SetAttribute("Amp", amp)
	m.Parent = parent
	return m
end

-- ============================================================
-- REALISTIC DUMBBELL / BARBELL BUILDER
-- Matches the reference image:
--   * Large black iron plates with visible inner/outer rings,
--     a sunken hub, and 3 radial spokes (like a real HEX plate)
--   * Thick chrome knurled handle (center cylinder)
--   * Chrome sleeves between the handle and first plate
--   * Chrome collars (clamps) outside the last plate
--   * Angled end caps
-- Everything is non-colliding so it doesn't affect physics
-- ============================================================
local IRON   = Color3.fromRGB(22, 22, 26)       -- near-black cast iron
local IRON2  = Color3.fromRGB(36, 36, 42)       -- slightly lighter ring
local SPOKE  = Color3.fromRGB(48, 48, 58)       -- spokes inside the plate
local CHROME = Color3.fromRGB(210, 214, 224)    -- chrome bar / collars
local KNURL  = Color3.fromRGB(155, 160, 170)    -- knurled handle (slightly darker)
local CAP    = Color3.fromRGB(195, 200, 210)    -- end caps

-- Build one realistic weight plate centered at `offset`, stacked along X.
-- d = outer diameter,  t = total thickness (X depth)
local function plate(parent, cf, offset, d, t)
	-- Solid cast-iron plate: lip, raised face, embossed ring and a chrome hub that fills
	-- the centre (no dark bore, so it never reads as a hole through the metal).
	local nc = { CanCollide = false, Name = "Plate" }
	cyl(parent, cf, offset, "X", t, d, Color3.fromRGB(34, 34, 40), "Metal", nc)
	cyl(parent, cf, offset, "X", t + 0.04, d * 0.86, IRON, "Metal", { CanCollide = false, Name = "PlateFace" })
	cyl(parent, cf, offset, "X", t + 0.07, d * 0.62, SPOKE, "Metal", { CanCollide = false, Name = "PlateRing" })
	cyl(parent, cf, offset, "X", t + 0.09, d * 0.54, IRON2, "Metal", { CanCollide = false, Name = "PlateField" })
	cyl(parent, cf, offset, "X", t + 0.16, math.max(0.62, d * 0.24), CHROME, "Metal", { CanCollide = false, Name = "PlateHub" })
end

-- Build a complete dumbbell along the X axis, centered at `offset`.
-- handleLen = total length, pd = plate outer diameter, nPlates = plates per side
local function dumbbell(parent, cf, offset, handleLen, pd, nPlates)
	pd = pd or 2.8
	nPlates = nPlates or 3
	local pt  = 0.44           -- plate thickness
	local sl  = 0.9            -- chrome sleeve length per side
	local colW = 0.26          -- collar width
	local innerEdge = handleLen * 0.5 - sl   -- where plates start
	local nc = { CanCollide = false }

	-- ── Handle ──────────────────────────────────────────────────
	-- knurled centre grip (slightly smaller diameter than sleeves)
	cyl(parent, cf, offset, "X", handleLen, 0.60, KNURL, "DiamondPlate", { CanCollide = false, Name = "Handle" })
	-- thicker chrome sleeves either side of the grip
	for side = -1, 1, 2 do
		cyl(parent, cf, offset + Vector3.new(side * (innerEdge + sl * 0.5), 0, 0), "X", sl, 0.76, CHROME, "Metal", { CanCollide = false, Name = "Sleeve" })
		-- chrome end cap
		cyl(parent, cf, offset + Vector3.new(side * (handleLen * 0.5 + colW * 0.5 + pt * nPlates + 0.04), 0, 0),
			"X", colW * 0.6, 0.88, CAP, "Metal", { CanCollide = false, Name = "Cap" })
		-- collar ring (the "lock" clamp)
		cyl(parent, cf, offset + Vector3.new(side * (innerEdge + pt * nPlates + sl + colW * 0.5), 0, 0),
			"X", colW, 0.92, CHROME, "SmoothPlastic", { CanCollide = false, Name = "Collar" })
		-- collar detail: a thin dark groove
		cyl(parent, cf, offset + Vector3.new(side * (innerEdge + pt * nPlates + sl + colW * 0.5), 0, 0),
			"X", colW * 0.3, 0.96, IRON2, "Metal", { CanCollide = false, Name = "CollarGroove" })
		-- stack the plates outward from the sleeve
		for i = 1, nPlates do
			local x = side * (innerEdge + sl + pt * (i - 0.5))
			-- make outer plates slightly smaller so you can see the inner ones (depth effect)
			local diam = pd - (nPlates - i) * 0.0
			plate(parent, cf, offset + Vector3.new(x, 0, 0), diam, pt)
		end
	end
end

local builders = {}

----------------------------------------------------------------------
-- DUMBBELL STATION: a steel rack holding 3 rows of HEX dumbbells
-- Each dumbbell is a knurled handle + two HEX plates (like the reference image).

local CAST_FONT_5X7 = {
	["A"] = {"01110","10001","10001","11111","10001","10001","10001"},
	["B"] = {"11110","10001","10001","11110","10001","10001","11110"},
	["D"] = {"11110","10001","10001","10001","10001","10001","11110"},
	["E"] = {"11111","10000","10000","11110","10000","10000","11111"},
	["G"] = {"01110","10001","10000","10111","10001","10001","01110"},
	["K"] = {"10001","10010","10100","11000","10100","10010","10001"},
	["L"] = {"10000","10000","10000","10000","10000","10000","11111"},
	["N"] = {"10001","11001","10101","10011","10001","10001","10001"},
	["R"] = {"11110","10001","10001","11110","10100","10010","10001"},
	["S"] = {"01111","10000","10000","01110","00001","00001","11110"},
	["T"] = {"11111","00100","00100","00100","00100","00100","00100"},
	["2"] = {"01110","10001","00001","00010","00100","01000","11111"},
	["5"] = {"11111","10000","10000","11110","00001","00001","11110"},
	[" "] = {"00000","00000","00000","00000","00000","00000","00000"},
}

local function embossedText(parent, cf, side, faceX, text, centerY, centerZ, cell, depth, color, rotDeg)
	local rows, cols = 7, 5
	local charGap = cell * 1.6
	local textW = (#text * cols + math.max(0, #text - 1) * 2) * cell
	local startZ = centerZ - textW * 0.5 + cell * 0.5
	local rot = CFrame.Angles(0, 0, math.rad(rotDeg or 0))
	for idx = 1, #text do
		local ch = string.sub(text, idx, idx)
		local glyph = CAST_FONT_5X7[ch] or CAST_FONT_5X7[" "]
		local charBaseZ = startZ + ((idx - 1) * (cols * cell + charGap))
		for r = 1, rows do
			local row = glyph[r]
			for c = 1, cols do
				if string.sub(row, c, c) == "1" then
					local y = centerY + ((rows + 1) / 2 - r) * cell
					local z = charBaseZ + (c - 1) * cell
					add(parent, cf, Vector3.new(faceX, y, side * z), Vector3.new(depth, cell * 0.92, cell * 0.92), color, "Metal", { CanCollide = false, Name = "Emboss", Rotation = rot })
				end
			end
		end
	end
end

local function embossedMulti(parent, cf, side, faceX, lines, centerY, centerZ, lineGap, cell, depth, color, rotDeg)
	local totalH = (#lines - 1) * lineGap
	for i, line in ipairs(lines) do
		embossedText(parent, cf, side, faceX, line, centerY + totalH * 0.5 - (i - 1) * lineGap, centerZ, cell, depth, color, rotDeg)
	end
end

local function addCastIron3DMarkings(parent, cf, side, faceX, diameter, s)
	do return end -- plate lettering removed (it was mis-aligned / mirrored on the plates)
	local textColor = Color3.fromRGB(235,235,235)
	local smallCell = 0.065 * s
	local bigCell = 0.075 * s
	local depth = 0.045 * s
	embossedText(parent, cf, side, faceX, "BARBELL", diameter * 0.29, 0, smallCell, depth, textColor, 0)
	embossedMulti(parent, cf, side, faceX, {"25","KGS"}, 0, -diameter * 0.28, 0.34 * s, bigCell, depth, textColor, 0)
	embossedMulti(parent, cf, side, faceX, {"55","LBS"}, 0, diameter * 0.28, 0.34 * s, bigCell, depth, textColor, 0)
	embossedText(parent, cf, side, faceX, "STANDARD", -diameter * 0.29, 0, smallCell, depth, textColor, 180)
end

function builders.Dumbbell(model, cf, theme, s)
	local rackW = 16 * s
	local rackD = 3.8

	-- Heavy 3-tier rack frame.
	add(model, cf, Vector3.new(-rackW/2, 4.1, -rackD/2), Vector3.new(1.0, 8.2, rackD+1.0), DARK, "Metal", {Name="Upright"})
	add(model, cf, Vector3.new( rackW/2, 4.1, -rackD/2), Vector3.new(1.0, 8.2, rackD+1.0), DARK, "Metal", {Name="Upright"})
	add(model, cf, Vector3.new(0, 4.1, -rackD), Vector3.new(rackW+1.5, 8.6, 0.5), DARK, "Metal", {Name="Back"})
	-- shelves sit between the uprights and stop at the back panel (no shared faces = no flicker)
	for _, y in ipairs({0.85, 3.25, 5.70}) do
		add(model, cf, Vector3.new(0, y, -rackD/2 + 0.15), Vector3.new(rackW - 0.9, 0.45, rackD - 0.2), METAL, "Metal", {Name="Shelf"})
	end

	-- Each rack dumbbell has a centre grip, chrome sleeves and MULTIPLE individual
	-- plates per side. Small gaps make every plate visible from normal camera distance.
	local function rackDumbbell(offset, sc, count)
		local gripLen = 1.20 * sc
		local gripD = 0.25 * sc
		local sleeveLen = 0.24 * sc
		local sleeveD = 0.35 * sc
		local plateT = 0.17 * sc
		local plateD = 1.12 * sc
		local gap = 0.05 * sc
		local nc = {CanCollide=false}

		cyl(model, cf, offset, "X", gripLen, gripD, KNURL, "DiamondPlate", {CanCollide=false, Name="Grip"})
		for _, side in ipairs({-1, 1}) do
			local sleeveX = side * (gripLen*0.5 + sleeveLen*0.5)
			cyl(model, cf, offset + Vector3.new(sleeveX,0,0), "X", sleeveLen, sleeveD, CHROME, "Metal", {CanCollide=false, Name="Sleeve"})
			local inner = gripLen*0.5 + sleeveLen
			for i = 1, count do
				local x = side * (inner + (i-0.5)*plateT + (i-1)*gap)
				local d = plateD * (1 - (i-1)*0.025)
				cyl(model, cf, offset + Vector3.new(x,0,0), "X", plateT, d, IRON, "Metal", {CanCollide=false, Name="WeightPlate"})
				local faceX = x + side*(plateT*0.52)
				cyl(model, cf, offset + Vector3.new(faceX,0,0), "X", 0.035*sc, d*0.84, IRON2, "DiamondPlate", {CanCollide=false, Name="PlateFace"})
				cyl(model, cf, offset + Vector3.new(faceX + side*0.01,0,0), "X", 0.045*sc, 0.28*sc, CHROME, "Metal", nc)
			end
			local endX = inner + count*plateT + math.max(0,count-1)*gap + 0.07*sc
			cyl(model, cf, offset + Vector3.new(side*endX,0,0), "X", 0.12*sc, 0.42*sc, CHROME, "Metal", {CanCollide=false, Name="Collar"})
		end
	end

	local rows = {
		{y=1.55, sc=0.78, plates=2},
		{y=3.95, sc=0.92, plates=3},
		{y=6.35, sc=1.05, plates=4},
	}
	local xs = {-rackW*0.30, 0, rackW*0.30}
	for _, row in ipairs(rows) do
		for _, x in ipairs(xs) do
			rackDumbbell(Vector3.new(x, row.y, -rackD/2+0.42), row.sc, row.plates)
		end
	end

	-- No floating "demo" dumbbell in front of the rack. The real held pair is created
	-- by the client only after this rack's proximity prompt is used.
	return 0
end

-- BENCH PRESS: realistic bench + barbell
function builders.Bench(model, cf, theme, s)
	-- bench body
	add(model, cf, Vector3.new(0, 2.4, -2), Vector3.new(4.4, 1.2, 10.5), LEATHER, "Fabric")  -- pad
	add(model, cf, Vector3.new(0, 1.0, -2), Vector3.new(1.4, 2.0,  8.5), METAL, "Metal")
	add(model, cf, Vector3.new(-2.0, 0.5, -5.0), Vector3.new(0.8, 1.0, 0.8), DARK, "Metal")
	add(model, cf, Vector3.new( 2.0, 0.5, -5.0), Vector3.new(0.8, 1.0, 0.8), DARK, "Metal")
	add(model, cf, Vector3.new(-2.0, 0.5,  1.0), Vector3.new(0.8, 1.0, 0.8), DARK, "Metal")
	add(model, cf, Vector3.new( 2.0, 0.5,  1.0), Vector3.new(0.8, 1.0, 0.8), DARK, "Metal")
	-- uprights
	add(model, cf, Vector3.new(-5.0 * s, 4.0, -3.5), Vector3.new(0.9, 8.0, 0.9), DARK, "Metal")
	add(model, cf, Vector3.new( 5.0 * s, 4.0, -3.5), Vector3.new(0.9, 8.0, 0.9), DARK, "Metal")
	-- j-hooks
	add(model, cf, Vector3.new(-5.0 * s, 8.8, -3.2), Vector3.new(1.0, 0.5, 1.5), METAL, "Metal")
	add(model, cf, Vector3.new( 5.0 * s, 8.8, -3.2), Vector3.new(1.0, 0.5, 1.5), METAL, "Metal")
	-- safety bars
	add(model, cf, Vector3.new(-5.0 * s, 4.5, -3.0), Vector3.new(0.8, 0.5, 4.0), METAL, "Metal")
	add(model, cf, Vector3.new( 5.0 * s, 4.5, -3.0), Vector3.new(0.8, 0.5, 4.0), METAL, "Metal")
	-- barbell (animated)
	local mover = newMover(model, "Lift", 1.6)
	local handle = cyl(mover, cf, Vector3.new(0, 5.0, 3.0), "X", 11.0 * s, 0.60, KNURL, "DiamondPlate", { CanCollide = false, Name = "Bar" })
	-- sleeves
	for side = -1, 1, 2 do
		cyl(mover, cf, Vector3.new(side * (4.9 * s), 5.0, 3.0), "X", 1.5, 0.76, CHROME, "Metal", { CanCollide = false })
		cyl(mover, cf, Vector3.new(side * (5.8 * s), 5.0, 3.0), "X", 0.3, 0.9,  CHROME, "Metal", { CanCollide = false })  -- collar
		for i = 1, 3 do
			plate(mover, cf, Vector3.new(side * (3.8 * s + i * 0.48), 5.0, 3.0), 2.9, 0.44)
		end
	end
	mover.PrimaryPart = handle
	return 0
end

-- TREADMILL
function builders.Treadmill(model, cf, theme, s)
	add(model, cf, Vector3.new(0, 0.3, 0), Vector3.new(5.2, 0.6, 12), DARK, "Metal", { Name = "Deck" })
	add(model, cf, Vector3.new(-2.5, 0.9, 0), Vector3.new(0.5, 0.8, 11.9), METAL, "Metal")
	add(model, cf, Vector3.new( 2.5, 0.9, 0), Vector3.new(0.5, 0.8, 11.9), METAL, "Metal")
	add(model, cf, Vector3.new(-2.4, 3, -5.4), Vector3.new(0.5, 6, 0.5), METAL, "Metal")
	add(model, cf, Vector3.new( 2.4, 3, -5.4), Vector3.new(0.5, 6, 0.5), METAL, "Metal")
	add(model, cf, Vector3.new(0, 5.8, -5.4), Vector3.new(5.4, 2.2, 0.8), DARK, "SmoothPlastic")
	add(model, cf, Vector3.new(0, 5.8, -4.95), Vector3.new(4.6, 1.5, 0.1), theme.Accent, "Neon", { CanCollide = false })
	add(model, cf, Vector3.new(0, 3.5, -5.4), Vector3.new(4.8, 0.4, 0.4), CHROME, "Metal")
	local mover = newMover(model, "Flow", 2)
	local first
	for i = 0, 5 do
		local stripe = add(mover, cf, Vector3.new(0, 0.62, -5 + i * 2), Vector3.new(4.2, 0.05, 0.5), theme.Accent, "Neon", { CanCollide = false })
		first = first or stripe
	end
	mover.PrimaryPart = first
	return 0.6
end

local function quickClip(model, cf, pos, scale)
	cyl(model, cf, pos, "X", 0.26 * scale, 0.76 * scale, CLIP_RED, "SmoothPlastic", { CanCollide = false, Name = "QuickClipBody" })
	cyl(model, cf, pos, "X", 0.28 * scale, 0.54 * scale, CLIP_BLACK, "SmoothPlastic", { CanCollide = false, Name = "QuickClipRubber" })
	for _, yz in ipairs({
		{ 0.23,  0.23 },
		{ 0.23, -0.23 },
		{-0.23,  0.23 },
		{-0.23, -0.23 },
	}) do
		add(model, cf, pos + Vector3.new(0.015 * scale, yz[1] * scale, yz[2] * scale), Vector3.new(0.09 * scale, 0.11 * scale, 0.11 * scale), CLIP_RED_DARK, "SmoothPlastic", { CanCollide = false, Name = "QuickClipBoltTab" })
	end
	add(model, cf, pos + Vector3.new(0.14 * scale, 0.05 * scale, 0), Vector3.new(0.16 * scale, 0.42 * scale, 0.40 * scale), CLIP_RED_DARK, "SmoothPlastic", { CanCollide = false, Name = "QuickClipLeverArm" })
	add(model, cf, pos + Vector3.new(0.25 * scale, -0.02 * scale, 0), Vector3.new(0.24 * scale, 0.52 * scale, 0.46 * scale), CLIP_RED, "SmoothPlastic", { CanCollide = false, Name = "QuickClipLeverPad" })
	for _, grooveY in ipairs({-0.13, 0, 0.13}) do
		add(model, cf, pos + Vector3.new(0.265 * scale, grooveY * scale, 0), Vector3.new(0.03 * scale, 0.05 * scale, 0.26 * scale), CLIP_RED_DARK, "SmoothPlastic", { CanCollide = false, Name = "QuickClipLeverGroove" })
	end
end

-- SQUAT RACK / SHOULDER-PRESS PICKUP
function builders.Squat(model, cf, theme, s)
	local rackS = math.clamp(0.94 + (s - 1) * 0.42, 0.94, 1.08)
	local barS = math.clamp(0.96 + (s - 1) * 0.20, 0.96, 1.04)
	local RACK_BLACK = Color3.fromRGB(23, 24, 29)
	local RACK_EDGE = Color3.fromRGB(52, 55, 64)
	local HOLE = Color3.fromRGB(7, 8, 10)
	local BLUE = Color3.fromRGB(20, 103, 222)
	local BLUE_DARK = Color3.fromRGB(10, 55, 139)
	local BLUE_EDGE = Color3.fromRGB(34, 146, 255)

	add(model, cf, Vector3.new(0, 0.07, 0.45), Vector3.new(8.8 * rackS, 0.14, 8.5), RACK_BLACK, "SmoothPlastic", { Name = "RackMat", CanCollide = false })
	local uprightXs = { -2.72 * rackS, 2.72 * rackS }
	for _, x in ipairs(uprightXs) do
		add(model, cf, Vector3.new(x, 0.20, 0.48), Vector3.new(0.70, 0.40, 7.7), RACK_BLACK, "Metal", { Name = "RackFoot" })
		add(model, cf, Vector3.new(x, 0.39, -3.16), Vector3.new(1.48, 0.32, 0.82), RACK_BLACK, "Metal", { Name = "RearFoot" })
		add(model, cf, Vector3.new(x, 0.39, 4.10), Vector3.new(1.48, 0.32, 0.82), RACK_BLACK, "Metal", { Name = "FrontFoot" })
		add(model, cf, Vector3.new(x, 4.80, -1.05), Vector3.new(0.72, 9.45, 0.72), RACK_BLACK, "Metal", { Name = "Upright" })
		add(model, cf, Vector3.new(x, 0.78, -1.58), Vector3.new(0.62, 1.12, 2.05), RACK_EDGE, "Metal", { Name = "BaseBrace" })
		for i = 0, 10 do
			local y = 1.18 + i * 0.69
			cyl(model, cf, Vector3.new(x, y, -0.675), "Z", 0.060, 0.14, HOLE, "SmoothPlastic", { Name = "RackHole", CanCollide = false })
			cyl(model, cf, Vector3.new(x, y, -1.425), "Z", 0.060, 0.14, HOLE, "SmoothPlastic", { Name = "RackHole", CanCollide = false })
		end
		add(model, cf, Vector3.new(x, 4.82, -0.47), Vector3.new(0.58, 0.20, 1.18), CHROME, "Metal", { Name = "JHook", CanCollide = false })
		add(model, cf, Vector3.new(x, 5.10, 0.02), Vector3.new(0.54, 0.56, 0.18), CHROME, "Metal", { Name = "JHookLip", CanCollide = false })
		add(model, cf, Vector3.new(x, 3.08, 0.40), Vector3.new(0.62, 0.22, 3.05), RACK_EDGE, "Metal", { Name = "SafetyArm", CanCollide = false })
		add(model, cf, Vector3.new(x, 3.08, 1.92), Vector3.new(0.68, 0.28, 0.16), CHROME, "Metal", { Name = "SafetyCap", CanCollide = false })
		local inward = x &lt; 0 and 1 or -1
		add(model, cf, Vector3.new(x + inward * 0.37, 8.55, -1.05), Vector3.new(0.08, 0.86, 0.76), theme.Accent, "Neon", { Name = "AreaAccent", CanCollide = false })
	end
	add(model, cf, Vector3.new(0, 9.32, -1.05), Vector3.new(5.95 * rackS, 0.42, 0.42), RACK_BLACK, "Metal", { Name = "TopCross" })
	add(model, cf, Vector3.new(0, 0.29, -3.16), Vector3.new(5.95 * rackS, 0.30, 0.40), RACK_BLACK, "Metal", { Name = "RearCross" })

	-- the bar on the rack: the exact same round competition bar the player picks up
	local mover = newMover(model, "Lift", 0.9)
	local barY, barZ = 5.04, -0.10
	local pieces, labels = BarbellDesign.PressBar(barS)
	local built, handle = {}, nil
	for _, piece in ipairs(pieces) do
		local offset = Vector3.new(piece.Pos.X, barY + piece.Pos.Y, barZ + piece.Pos.Z)
		local part
		if piece.Shape == "Cyl" then
			part = cyl(mover, cf, offset, piece.Axis, piece.Len, piece.D, piece.Color, piece.Material, { CanCollide = false, Name = piece.Name })
		else
			part = ball(mover, cf, offset, 1, piece.Color, piece.Material, { CanCollide = false, Name = piece.Name })
			part.Size = piece.Size
		end
		built[piece] = part
		if piece.Name == "Bar" then
			handle = part
		end
	end
	for _, label in ipairs(labels) do
		BarbellDesign.Label(built[label.Piece], label.Side)
	end
	mover.PrimaryPart = handle
	return 0.2
end

-- PUNCHING BAG
function builders.Bag(model, cf, theme, s)
	add(model, cf, Vector3.new(0, 0.25, 2.4), Vector3.new(13, 0.5, 5), DARK, "Metal", { Name = "Base" })
	add(model, cf, Vector3.new(-5.5, 5.5, 2.4), Vector3.new(0.9, 11, 0.9), METAL, "Metal")
	add(model, cf, Vector3.new( 5.5, 5.5, 2.4), Vector3.new(0.9, 11, 0.9), METAL, "Metal")
	add(model, cf, Vector3.new(0, 11, 2.4), Vector3.new(12, 0.86, 0.86), METAL, "Metal")
	local mover = newMover(model, "Swing", 0.5)
	local pivot = add(mover, cf, Vector3.new(0, 10.4, 2.4), Vector3.new(0.6, 0.6, 0.6), CHROME, "Metal", { Transparency = 1, CanCollide = false, Name = "Pivot" })
	mover.PrimaryPart = pivot
	cyl(mover, cf, Vector3.new(0, 6.9, 2.4), "Y", 7, 3.2 * (0.9 + 0.1 * s), theme.Accent, "Fabric", { CanCollide = false, Name = "BagBody" })
	cyl(mover, cf, Vector3.new(0, 10.2, 2.4), "Y", 0.8, 0.5, CHROME, "Metal", { CanCollide = false })
	cyl(mover, cf, Vector3.new(0, 6.9, 2.4), "Y", 0.5, 3.4 * (0.9 + 0.1 * s), CHROME, "Metal", { CanCollide = false })
	return 0.5
end

-- DEADLIFT PLATFORM
function builders.Deadlift(model, cf, theme, s)
	add(model, cf, Vector3.new(0, 0.25, 1.5), Vector3.new(11 * s, 0.5, 9), WOOD, "Wood", { Name = "Platform" })
	add(model, cf, Vector3.new(0, 0.55, 1.5), Vector3.new(8 * s, 0.1, 6), DARK, "Fabric", { CanCollide = false })
	-- plate storage tree
	for i = 0, 4 do
		cyl(model, cf, Vector3.new(-7 * s, 0.4 + i * 0.7, -1), "Y", 0.6, 3.4, IRON, "Metal")
	end
	add(model, cf, Vector3.new(6 * s, 0.9, -1), Vector3.new(1.6, 1.8, 1.6), theme.Accent, "Concrete")
	-- spare plate lying on the mat next to the tree
	cyl(model, cf, Vector3.new(-3 * s, 0.85, -1.2), "Y", 0.5, 3.0, IRON, "Metal", { Name = "SparePlate" })
	cyl(model, cf, Vector3.new(-3 * s, 1.12, -1.2), "Y", 0.06, 2.6, IRON2, "DiamondPlate", { CanCollide = false })
	-- animated barbell
	local mover = newMover(model, "Lift", 1.4)
	local handle = cyl(mover, cf, Vector3.new(0, 1.7, 4.3), "X", 9 * s, 0.60, KNURL, "DiamondPlate", { CanCollide = false, Name = "Bar" })
	for side = -1, 1, 2 do
		cyl(mover, cf, Vector3.new(side * (3.8 * s), 1.7, 4.3), "X", 1.2, 0.76, CHROME, "Metal", { CanCollide = false })
		cyl(mover, cf, Vector3.new(side * (4.5 * s), 1.7, 4.3), "X", 0.28, 0.92, CHROME, "Metal", { CanCollide = false })
		for i = 1, 3 do
			plate(mover, cf, Vector3.new(side * (3.0 * s + i * 0.47), 1.7, 4.3), 3.2, 0.44)
		end
	end
	mover.PrimaryPart = handle
	return 0.5
end

-- GIANT MACHINE
function builders.Giant(model, cf, theme, s)
	add(model, cf, Vector3.new(0, 0.5, 0), Vector3.new(18 * s, 1, 9), METAL, "DiamondPlate", { Name = "Platform" })
	add(model, cf, Vector3.new(-8.5 * s, 5, -3), Vector3.new(1.4, 10, 1.4), DARK, "Metal")
	add(model, cf, Vector3.new( 8.5 * s, 5, -3), Vector3.new(1.4, 10, 1.4), DARK, "Metal")
	add(model, cf, Vector3.new(0, 10, -3), Vector3.new(18 * s, 1.2, 1.5), theme.Accent, "Metal")
	local mover = newMover(model, "Lift", 1.8)
	local handle = cyl(mover, cf, Vector3.new(0, 6.4, 0.6), "X", 15 * s, 0.60, KNURL, "DiamondPlate", { CanCollide = false, Name = "Bar" })
	for side = -1, 1, 2 do
		cyl(mover, cf, Vector3.new(side * (6.4 * s), 6.4, 0.6), "X", 1.5, 0.78, CHROME, "Metal", { CanCollide = false })
		cyl(mover, cf, Vector3.new(side * (7.2 * s), 6.4, 0.6), "X", 0.3, 0.92, CHROME, "Metal", { CanCollide = false })
		for i = 1, 3 do
			plate(mover, cf, Vector3.new(side * (5.4 * s + i * 0.48), 6.4, 0.6), 6.4, 0.44)
		end
	end
	mover.PrimaryPart = handle
	return 1
end


function builders.Machine(model, cf, theme, s)
	cyl(model, cf, Vector3.new(0, 0.4, 0), "Y", 0.8, 15, DARK, "Metal", { Name = "Base" })
	cyl(model, cf, Vector3.new(0, 0.85, 0), "Y", 0.15, 14, theme.Accent, "Neon", { CanCollide = false })
	add(model, cf, Vector3.new(-5.5, 5.5, -1), Vector3.new(1.6, 10, 1.6), METAL, "Metal")
	add(model, cf, Vector3.new(5.5, 5.5, -1), Vector3.new(1.6, 10, 1.6), METAL, "Metal")
	add(model, cf, Vector3.new(-5.5, 10.4, -1), Vector3.new(1.9, 0.5, 1.9), theme.Accent, "Neon", { CanCollide = false })
	add(model, cf, Vector3.new(5.5, 10.4, -1), Vector3.new(1.9, 0.5, 1.9), theme.Accent, "Neon", { CanCollide = false })
	add(model, cf, Vector3.new(0, 8, -3.2), Vector3.new(6, 3, 0.4), theme.Accent, "Neon", { CanCollide = false, Transparency = 0.35 })
	local mover = newMover(model, "Lift", 1.6)
	mover:SetAttribute("SpinSpeed", 2.5)
	local core = ball(mover, cf, Vector3.new(0, 5.5, 1.2), 3.6, theme.Accent, "Neon", { CanCollide = false, Name = "Core" })
	mover.PrimaryPart = core
	cyl(mover, cf, Vector3.new(0, 5.5, 1.2), "Y", 0.3, 7.5, theme.Accent, "Neon", { CanCollide = false, Transparency = 0.45 })
	cyl(mover, cf, Vector3.new(0, 5.5, 1.2), "X", 0.3, 7.5, theme.Accent, "Neon", { CanCollide = false, Transparency = 0.45 })
	return 0.8
end

-- Builds the model. Returns the Model and standY.
function EquipmentModels.Build(kind, parent, cf, theme, tier)
	local model = Instance.new("Model")
	model.Name = kind
	local s = 1 + 0.15 * (tier - 1)
	local build = builders[kind] or builders.Dumbbell
	local standY = build(model, cf, theme, s)
	model.Parent = parent
	return model, standY
end

EquipmentModels.Helpers = { add = add, cyl = cyl, ball = ball, mat = mat }

return EquipmentModels
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX16">
        <Properties>
          <string name="Name">MapBuilder</string>
          <ProtectedString name="Source">--[[
	MapBuilder - builds the entire gym world out of Parts when the server starts.

	The world layout comes from Config (areas are lined up along -Z, joined by corridors):

	      Beginner  --&gt;  corridor  --&gt;  [gate] City  --&gt;  corridor  --&gt;  [gate] Pro ...

	Every room is laid out like a real gym:
	    west  = free-weight zone (rubber floor, mirror wall, dumbbell racks, plate trees, the stations)
	    centre= turf sprint lane + the gym's own theme set-piece at the far end
	    east  = Lucky Block, the Protein Bar (supplement counter), cardio row and the locker room
	    above = steel I-beams with hanging LED light panels

	Build() returns a "world" table the services use to attach prompts:
	    world.Stations[stationId] = { Prompt = Part, Stand = Part }
	    world.Eggs[eggId]         = { Prompt = Part }      (eggs are shown as Lucky Blocks)
	    world.Gates[areaId]       = { Prompt = Part, Gate = Part }
	    world.Sell                = { { Prompt = Part }, ... }
	    world.OrbSpawns[areaId]   = { Vector3, ... }   (fallback spots)
	    world.OrbZones[areaId]    = { {X0, X1, Z0, Z1, Y}, ... }  (open floor where pickups may appear)

	Parts also get tags / attributes so the client can decorate them:
	    "GymStation" (StationId), "GymEgg" (EggId), "GymGate" (AreaId), "GymSell", "GymMover"
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("GymShared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local IconSlot = require(Shared.IconSlot)
local EquipmentModels = require(script.Parent.EquipmentModels)

local MapBuilder = {}

local H = EquipmentModels.Helpers
local add, cyl, ball, mat = H.add, H.cyl, H.ball, H.mat
local V = Vector3.new

local function darker(c, f)
	return Color3.new(c.R * f, c.G * f, c.B * f)
end

local function newFolder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- a flat sign with text on its front face
local function sign(parent, cf, size, text, textColor, bgColor, transparency, font)
	local p = add(parent, CFrame.new(), cf.Position, size, bgColor, "SmoothPlastic", { CanCollide = false, Name = "Sign", Transparency = transparency or 0 })
	p.CFrame = cf
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = font or Enum.Font.GothamBlack
	label.TextColor3 = textColor
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.06, 0)
	pad.PaddingBottom = UDim.new(0.06, 0)
	pad.Parent = label
	return p
end

local function pointLight(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = part
	return l
end

local function surfaceLight(part, face, color, range, brightness, angle)
	local l = Instance.new("SurfaceLight")
	l.Face = face
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Angle = angle or 90
	l.Shadows = false
	l.Parent = part
	return l
end

----------------------------------------------------------------------
-- Real-gym palette
----------------------------------------------------------------------
local WHITE = Color3.new(1, 1, 1)
local STEEL = Color3.fromRGB(88, 92, 102)
local STEEL_DARK = Color3.fromRGB(42, 44, 50)
local STEEL_BEAM = Color3.fromRGB(58, 60, 66)
local CHROME_C = Color3.fromRGB(200, 204, 212)
local IRON_C = Color3.fromRGB(30, 30, 34)
local RUBBER_C = Color3.fromRGB(38, 39, 43)
local SEAM_C = Color3.fromRGB(58, 60, 64)
local PAD = Color3.fromRGB(24, 24, 28)
local WOOD_C = Color3.fromRGB(176, 128, 80)
local WOOD_DARK = Color3.fromRGB(78, 54, 38)
local TURF = Color3.fromRGB(58, 118, 60)
local SAFETY_YELLOW = Color3.fromRGB(236, 196, 40)
local LEAF = Color3.fromRGB(52, 112, 56)
local LED_WHITE = Color3.fromRGB(255, 250, 238)
local MIRROR_C = Color3.fromRGB(205, 215, 222)
local BUMPER = { Color3.fromRGB(196, 42, 42), Color3.fromRGB(40, 84, 190), Color3.fromRGB(236, 196, 40), Color3.fromRGB(50, 150, 70) }
local SUPPLEMENT = {
	Color3.fromRGB(24, 24, 28), Color3.fromRGB(236, 236, 240), Color3.fromRGB(196, 40, 44),
	Color3.fromRGB(36, 88, 196), Color3.fromRGB(246, 176, 24), Color3.fromRGB(40, 150, 90),
}

local YAW = { ["+Z"] = 0, ["+X"] = math.pi / 2, ["-X"] = -math.pi / 2, ["-Z"] = math.pi }

-- floor-level CFrame at room coordinates (x, z) whose local +Z ("front") points toward `dir`
local function face(ctx, x, z, dir)
	return ctx.at(x, 0, z) * CFrame.Angles(0, YAW[dir] or 0, 0)
end

----------------------------------------------------------------------
-- Gym props (all built facing local +Z, standing on y = 0)
----------------------------------------------------------------------
-- two-tier dumbbell rack, length along local X
local function dumbbellRack(folder, cf, length)
	local n = math.max(3, math.floor(length / 2.3))
	add(folder, cf, V(0, 0.15, 0), V(length, 0.3, 3.4), STEEL_DARK, "Metal", { Name = "RackFoot" })
	for _, x in ipairs({ -length / 2 + 0.4, length / 2 - 0.4 }) do
		add(folder, cf, V(x, 2.1, 0), V(0.6, 4.2, 3), STEEL_DARK, "Metal", { Name = "RackLeg" })
	end
	for tier, y in ipairs({ 1.5, 3.5 }) do
		local z = (tier == 1) and 0.35 or -0.35
		add(folder, cf, V(0, y, z), V(length - 0.4, 0.2, 2.4), STEEL, "Metal", { Name = "RackShelf" })
		for i = 1, n do
			local x = -length / 2 + (i - 0.5) * (length / n)
			local d = 0.8 + (i / n) * 0.75 - (tier - 1) * 0.2
			local py = y + 0.1 + d / 2
			cyl(folder, cf, V(x, py, z), "Z", 2.2, 0.3, CHROME_C, "Metal", { CanCollide = false, Name = "DumbbellHandle" })
			for _, s in ipairs({ -1, 1 }) do
				cyl(folder, cf, V(x, py, z + s * 1.25), "Z", 0.55, d, IRON_C, "Metal", { CanCollide = false, Name = "DumbbellHead" })
			end
		end
	end
end

-- weight-plate tree with three levels of loaded horns
local function plateTree(folder, cf)
	add(folder, cf, V(0, 0.2, 0), V(5, 0.4, 5), STEEL_DARK, "Metal", { Name = "TreeBase" })
	add(folder, cf, V(0, 3.9, 0), V(0.8, 7.4, 0.8), STEEL_DARK, "Metal", { Name = "TreePost" })
	local tiers = {
		{ Y = 2.6, D = 4.6, Axis = "X", From = 1.8 },
		{ Y = 4.3, D = 3.4, Axis = "Z", From = 1.8 },
		{ Y = 6.4, D = 2.2, Axis = "X", From = 0.9 },
	}
	for _, t in ipairs(tiers) do
		for _, s in ipairs({ -1, 1 }) do
			local horn = t.From + 0.8
			local hornOffset = t.Axis == "X" and V(s * horn / 2, t.Y, 0) or V(0, t.Y, s * horn / 2)
			cyl(folder, cf, hornOffset, t.Axis, horn, 0.35, CHROME_C, "Metal", { CanCollide = false, Name = "Horn" })
			for k = 0, 1 do
				local d = t.From + 0.15 + k * 0.32
				local p = t.Axis == "X" and V(s * d, t.Y, 0) or V(0, t.Y, s * d)
				cyl(folder, cf, p, t.Axis, 0.28, t.D, IRON_C, "Metal", { CanCollide = false, Name = "Plate" })
			end
		end
	end
end

-- flat bench, length along local Z
local function flatBench(folder, cf)
	for _, z in ipairs({ -1.8, 1.8 }) do
		add(folder, cf, V(0, 0.95, z), V(0.5, 1.6, 0.5), STEEL_DARK, "Metal", { Name = "BenchLeg" })
		add(folder, cf, V(0, 0.15, z), V(2.4, 0.3, 0.6), STEEL_DARK, "Metal", { Name = "BenchFoot" })
	end
	add(folder, cf, V(0, 1.85, 0), V(0.6, 0.3, 4.6), STEEL, "Metal", { Name = "BenchFrame" })
	add(folder, cf, V(0, 2.25, 0), V(1.6, 0.5, 5), PAD, "Leather", { Name = "BenchPad" })
end

local function kettlebell(folder, cf, d)
	ball(folder, cf, V(0, d / 2, 0), d, IRON_C, "Metal", { CanCollide = false, Name = "Kettlebell" })
	for _, s in ipairs({ -1, 1 }) do
		add(folder, cf, V(s * d * 0.28, d * 0.98, 0), V(0.18 * d, 0.35 * d, 0.18 * d), IRON_C, "Metal", { CanCollide = false, Name = "KettlebellHorn" })
	end
	cyl(folder, cf, V(0, d * 1.14, 0), "X", d * 0.72, 0.2 * d, IRON_C, "Metal", { CanCollide = false, Name = "KettlebellHandle" })
end

-- low shelf of kettlebells, length along local X
local function kettlebellShelf(folder, cf, length)
	add(folder, cf, V(0, 0.9, 0), V(length, 0.2, 2.6), STEEL, "Metal", { Name = "KettlebellShelf" })
	for _, x in ipairs({ -length / 2 + 0.3, length / 2 - 0.3 }) do
		add(folder, cf, V(x, 0.45, 0), V(0.4, 0.9, 2.4), STEEL_DARK, "Metal", { Name = "ShelfLeg" })
	end
	local n = math.floor(length / 2.2)
	for i = 1, n do
		local x = -length / 2 + (i - 0.5) * (length / n)
		kettlebell(folder, cf * CFrame.new(x, 1, 0), 1.1 + i / n * 0.8)
	end
end

local function plyoBoxes(folder, cf)
	add(folder, cf, V(0, 1.5, 0), V(4, 3, 3.4), WOOD_C, "WoodPlanks", { Name = "PlyoBox" })
	add(folder, cf, V(4.6, 1.2, 0.3), V(3.6, 2.4, 3), WOOD_C, "WoodPlanks", { Name = "PlyoBox" })
	add(folder, cf, V(0.3, 3.9, 0), V(3.2, 1.8, 2.8), WOOD_C, "WoodPlanks", { Name = "PlyoBox" })
end

-- spin bike, rider faces local -Z
local function spinBike(folder, cf, accent)
	add(folder, cf, V(0, 0.2, 0), V(0.5, 0.4, 4.4), STEEL_DARK, "Metal", { Name = "BikeRail" })
	for _, z in ipairs({ -1.9, 1.9 }) do
		add(folder, cf, V(0, 0.18, z), V(2.2, 0.36, 0.5), STEEL_DARK, "Metal", { Name = "BikeFoot" })
	end
	cyl(folder, cf, V(0, 1.6, -1.3), "X", 0.46, 2.6, CHROME_C, "Metal", { Name = "Flywheel" })
	add(folder, cf, V(0, 2.4, -1.1), V(0.45, 4, 0.45), accent, "Metal", { Name = "BikeFrontPost" })
	add(folder, cf, V(0, 2.1, 0.9), V(0.45, 3.4, 0.45), accent, "Metal", { Name = "BikeSeatPost" })
	add(folder, cf, V(0, 3.9, 1), V(1, 0.3, 1.5), PAD, "Leather", { Name = "BikeSeat" })
	cyl(folder, cf, V(0, 4.4, -1.35), "X", 1.8, 0.3, PAD, "Rubber", { Name = "Handlebar" })
	add(folder, cf, V(0, 4.8, -1.2), V(0.9, 0.6, 0.15), Color3.fromRGB(18, 18, 22), "SmoothPlastic", { Name = "BikeConsole" })
	cyl(folder, cf, V(0, 1.4, 0), "X", 1.6, 0.6, STEEL_DARK, "Metal", { CanCollide = false, Name = "Crank" })
end

-- rowing machine, rower faces local -Z
local function rower(folder, cf)
	add(folder, cf, V(0, 0.6, 0.8), V(0.8, 0.3, 7), STEEL, "Metal", { Name = "RowerRail" })
	add(folder, cf, V(0, 0.25, 4.1), V(2, 0.5, 0.5), STEEL_DARK, "Metal", { Name = "RowerFoot" })
	add(folder, cf, V(0, 0.9, -2.9), V(2.4, 1.8, 1.4), STEEL_DARK, "Metal", { Name = "RowerFrame" })
	cyl(folder, cf, V(0, 1.6, -3), "X", 1.2, 2.6, Color3.fromRGB(22, 22, 26), "SmoothPlastic", { Name = "FanHousing" })
	add(folder, cf, V(0, 0.95, 1), V(1.2, 0.3, 1.2), PAD, "Leather", { Name = "RowerSeat" })
	add(folder, cf, V(0, 1.1, -1.8), V(2, 0.2, 1), STEEL_DARK, "Rubber", { Name = "FootPlates" })
	add(folder, cf, V(0, 2.8, -2.9), V(0.25, 2.4, 0.25), STEEL, "Metal", { Name = "MonitorArm" })
	add(folder, cf, V(0, 4, -2.7), V(1, 0.8, 0.15), Color3.fromRGB(18, 18, 22), "SmoothPlastic", { Name = "Monitor" })
end

-- row of lockers with a changing bench in front (front = local +Z)
local function lockerRow(folder, cf, n, color)
	local w = 3
	local total = n * w
	add(folder, cf, V(0, 0.4, 0), V(total, 0.8, 3), STEEL_DARK, "Metal", { Name = "LockerPlinth" })
	add(folder, cf, V(0, 10.1, 0), V(total + 0.2, 0.2, 3.2), darker(color, 0.7), "Metal", { Name = "LockerTop" })
	for i = 1, n do
		local x = -total / 2 + (i - 0.5) * w
		add(folder, cf, V(x, 5.4, 0), V(w - 0.12, 9.2, 3), color, "Metal", { Name = "Locker" })
		for v = 0, 2 do
			add(folder, cf, V(x, 8.4 + v * 0.45, 1.52), V(1.6, 0.14, 0.05), darker(color, 0.45), "SmoothPlastic", { CanCollide = false, Name = "Vent" })
		end
		add(folder, cf, V(x + 0.95, 5.2, 1.56), V(0.2, 1.1, 0.14), CHROME_C, "Metal", { CanCollide = false, Name = "Handle" })
	end
	local benchLen = total * 0.7
	add(folder, cf, V(0, 1.7, 5), V(benchLen, 0.4, 1.8), WOOD_C, "WoodPlanks", { Name = "LockerBench" })
	for _, x in ipairs({ -benchLen / 2 + 1, 0, benchLen / 2 - 1 }) do
		add(folder, cf, V(x, 0.75, 5), V(0.5, 1.5, 1.4), STEEL, "Metal", { Name = "BenchLeg" })
	end
end

local function waterFountain(folder, cf)
	local steel = Color3.fromRGB(190, 194, 200)
	add(folder, cf, V(0, 1.8, 0), V(2.6, 3.6, 1.8), steel, "Metal", { Name = "WaterFountain" })
	add(folder, cf, V(0, 3.75, 0.2), V(2.6, 0.3, 2.2), steel, "Metal", { Name = "Basin" })
	add(folder, cf, V(0, 3.92, 0.3), V(1.8, 0.05, 1.4), Color3.fromRGB(120, 124, 130), "Metal", { CanCollide = false, Name = "Drain" })
	add(folder, cf, V(0, 6.2, -0.5), V(2.2, 3.4, 0.6), Color3.fromRGB(34, 36, 42), "SmoothPlastic", { Name = "BottleFiller" })
	add(folder, cf, V(0, 6.8, -0.18), V(1.2, 0.5, 0.05), Color3.fromRGB(90, 200, 255), "Neon", { CanCollide = false, Name = "FillerDisplay" })
end

local function pottedPlant(folder, cf, scale)
	scale = scale or 1
	cyl(folder, cf, V(0, 1.2 * scale, 0), "Y", 2.4 * scale, 2.6 * scale, Color3.fromRGB(62, 62, 68), "Concrete", { Name = "Pot" })
	cyl(folder, cf, V(0, 2.42 * scale, 0), "Y", 0.1, 2.3 * scale, Color3.fromRGB(70, 50, 36), "Ground", { CanCollide = false, Name = "Soil" })
	for i = 1, 7 do
		local a = i * (math.pi * 2 / 7)
		local lean = 0.25 + (i % 3) * 0.12
		add(folder, cf * CFrame.Angles(0, a, 0), V(0.5 * scale, (2.4 + 2) * scale, 0), V(0.25, 4.2, 1.1) * scale, LEAF, "SmoothPlastic",
			{ CanCollide = false, Name = "Leaf", Rotation = CFrame.Angles(0, 0, -lean) })
	end
end

local function barbell(folder, cf, len, pd)
	cyl(folder, cf, V(0, 0, 0), "X", len, 0.35, CHROME_C, "Metal", { CanCollide = false, Name = "Bar" })
	for _, s in ipairs({ -1, 1 }) do
		for k = 0, 2 do
			cyl(folder, cf, V(s * (len / 2 - 2.2 + k * 0.45), 0, 0), "X", 0.42, pd - k * 0.5, BUMPER[k + 1], "Rubber", { CanCollide = false, Name = "BumperPlate" })
		end
		cyl(folder, cf, V(s * (len / 2 - 2.65), 0, 0), "X", 0.3, 0.75, CHROME_C, "Metal", { CanCollide = false, Name = "Collar" })
	end
end

-- a painted steel I-beam spanning local X
local function iBeam(folder, cf, length, color)
	add(folder, cf, V(0, 1.4, 0), V(length, 0.3, 1.8), color, "Metal", { CanCollide = false, Name = "BeamFlange" })
	add(folder, cf, V(0, 0, 0), V(length, 2.5, 0.35), color, "Metal", { CanCollide = false, Name = "BeamWeb" })
	add(folder, cf, V(0, -1.4, 0), V(length, 0.3, 1.8), color, "Metal", { CanCollide = false, Name = "BeamFlange" })
end

-- hanging LED light panel; `drop` = cable length above it
local function lightPanel(folder, cf, width, drop)
	for _, x in ipairs({ -width / 2 + 1, width / 2 - 1 }) do
		cyl(folder, cf, V(x, drop / 2 + 0.25, 0), "Y", drop, 0.1, STEEL_DARK, "Metal", { CanCollide = false, Name = "Cable" })
	end
	add(folder, cf, V(0, 0, 0), V(width, 0.5, 2.6), STEEL_DARK, "Metal", { CanCollide = false, Name = "LightHousing" })
	local diffuser = add(folder, cf, V(0, -0.3, 0), V(width - 0.4, 0.1, 2.2), LED_WHITE, "Neon", { CanCollide = false, Name = "LightPanel" })
	surfaceLight(diffuser, Enum.NormalId.Bottom, LED_WHITE, 38, 1.1, 120)
end

local function wallTV(folder, pos, dir, text, bg)
	local cf = CFrame.lookAt(pos, pos + dir)
	add(folder, cf, V(0, 0, 0.25), V(12.8, 7.6, 0.4), Color3.fromRGB(14, 14, 16), "SmoothPlastic", { CanCollide = false, Name = "TVBezel" })
	sign(folder, cf, V(12, 6.8, 0.1), text, WHITE, bg or Color3.fromRGB(16, 24, 40), 0)
end

local function speaker(folder, cf)
	add(folder, cf, V(0, 0, 0), V(2.2, 3.4, 2), Color3.fromRGB(22, 22, 26), "SmoothPlastic", { CanCollide = false, Name = "Speaker" })
	cyl(folder, cf, V(0, -0.5, -1.02), "Z", 0.06, 1.6, Color3.fromRGB(50, 50, 56), "Fabric", { CanCollide = false, Name = "Woofer" })
	cyl(folder, cf, V(0, 0.95, -1.02), "Z", 0.06, 0.7, Color3.fromRGB(50, 50, 56), "Fabric", { CanCollide = false, Name = "Tweeter" })
end

----------------------------------------------------------------------
-- Printed graphics (posters, banners, product labels) built from SurfaceGuis
----------------------------------------------------------------------
local function surface(part, face, pps)
	local g = Instance.new("SurfaceGui")
	g.Face = face or Enum.NormalId.Front
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps or 40
	g.LightInfluence = 0.15
	g.MaxDistance = 200
	g.Parent = part
	return g
end

-- ui("Frame"/"TextLabel", parent, props). Extra keys: Corner (UDim), Gradient ({top, bottom, rotation}),
-- Stroke ({color, thickness}). Text labels default to scaled GothamBlack, transparent background.
local function ui(class, parent, props)
	local o = Instance.new(class)
	o.BorderSizePixel = 0
	if class == "TextLabel" then
		o.BackgroundTransparency = 1
		o.Font = Enum.Font.GothamBlack
		o.TextScaled = true
		o.TextColor3 = WHITE
	end
	for k, v in pairs(props) do
		if k == "Corner" then
			local c = Instance.new("UICorner")
			c.CornerRadius = v
			c.Parent = o
		elseif k == "Gradient" then
			local gr = Instance.new("UIGradient")
			gr.Color = ColorSequence.new(v[1], v[2])
			gr.Rotation = v[3] or 90
			gr.Parent = o
		elseif k == "Stroke" then
			local st = Instance.new("UIStroke")
			st.Color = v[1]
			st.Thickness = v[2] or 2
			if class == "TextLabel" then
				st.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
			else
				st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			end
			st.Parent = o
		else
			o[k] = v
		end
	end
	o.Parent = parent
	return o
end

local POSTER_DESIGNS = {
	{ Title = "NO PAIN\nNO GAIN", Sub = "EVERY REP COUNTS", Icon = "Strength", Emoji = "💪",
		Top = Color3.fromRGB(210, 36, 44), Bottom = Color3.fromRGB(46, 8, 12) },
	{ Title = "RE-RACK\nYOUR WEIGHTS", Sub = "PUT EVERY DUMBBELL BACK", Graphic = "Dumbbell",
		Top = Color3.fromRGB(250, 206, 40), Bottom = Color3.fromRGB(214, 150, 18), Ink = Color3.fromRGB(22, 22, 24), Hazard = true },
	{ Title = "STAY\nHYDRATED", Sub = "FOUNTAIN BY THE LOCKERS", Bottle = true,
		Top = Color3.fromRGB(46, 160, 240), Bottom = Color3.fromRGB(10, 40, 110) },
	{ Title = "NEVER SKIP\nLEG DAY", Sub = "SQUATS BUILD CHAMPIONS", Graphic = "Barbell", Stamp = "LEG DAY",
		Top = Color3.fromRGB(46, 176, 96), Bottom = Color3.fromRGB(8, 50, 30) },
	{ Title = "TRAIN HARD\nSTAY HUMBLE", Sub = "REBIRTH. REPEAT.", Icon = "RebirthStar", Emoji = "⭐",
		Top = Color3.fromRGB(136, 76, 236), Bottom = Color3.fromRGB(30, 10, 72) },
	{ Title = "FEELING\nLUCKY?", Sub = "OPEN A LUCKY BLOCK", Icon = "LuckyBlock", Emoji = "❓",
		Top = Color3.fromRGB(255, 150, 40), Bottom = Color3.fromRGB(120, 40, 10) },
}

-- A printed gym poster in a black snap frame. `pos` = centre on the wall, `dir` = facing.
local function poster(folder, pos, dir, design)
	local cf = CFrame.lookAt(pos, pos + dir)
	local w, h = 9, 12
	local paper = add(folder, cf, V(0, 0, 0), V(w, h, 0.05), WHITE, "SmoothPlastic", { CanCollide = false, Name = "Poster" })
	for _, e in ipairs({ { V(0, h / 2 + 0.15, 0.05), V(w + 0.6, 0.3, 0.2) }, { V(0, -h / 2 - 0.15, 0.05), V(w + 0.6, 0.3, 0.2) },
		{ V(w / 2 + 0.15, 0, 0.05), V(0.3, h, 0.2) }, { V(-w / 2 - 0.15, 0, 0.05), V(0.3, h, 0.2) } }) do
		add(folder, cf, e[1], e[2], Color3.fromRGB(18, 18, 20), "Metal", { CanCollide = false, Name = "PosterFrame" })
	end
	local ink = design.Ink or WHITE
	local g = surface(paper, Enum.NormalId.Front, 40)
	local bg = ui("Frame", g, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Gradient = { design.Top, design.Bottom, 90 }, ClipsDescendants = true })
	-- brand strip
	local strip = ui("Frame", bg, { Size = UDim2.fromScale(1, 0.08), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45 })
	ui("TextLabel", strip, { Size = UDim2.fromScale(0.9, 0.7), Position = UDim2.fromScale(0.05, 0.15), Text = "+1 GYM GAME  •  TRAIN DAILY", TextColor3 = WHITE })
	-- burst behind the graphic
	ui("Frame", bg, { Size = UDim2.fromScale(0.72, 0.54), Position = UDim2.fromScale(0.14, 0.12), BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, Corner = UDim.new(0.5, 0) })
	ui("Frame", bg, { Size = UDim2.fromScale(0.52, 0.39), Position = UDim2.fromScale(0.24, 0.195), BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, Corner = UDim.new(0.5, 0) })
	if design.Hazard then
		-- hazard tape: staircase blocks read as diagonal stripes (rotated UI isn't clipped in Roblox)
		for _, y in ipairs({ 0.085, 0.93 }) do
			local band = ui("Frame", bg, { Size = UDim2.fromScale(1, 0.06), Position = UDim2.fromScale(0, y), BackgroundColor3 = Color3.fromRGB(22, 22, 24) })
			for i = 0, 7 do
				for k = 0, 3 do
					ui("Frame", band, { Size = UDim2.fromScale(0.07, 0.25), Position = UDim2.fromScale(i * 0.13 + k * 0.025, 0.75 - k * 0.25), BackgroundColor3 = SAFETY_YELLOW })
				end
			end
		end
	end
	local INK = Color3.fromRGB(24, 24, 28)
	if design.Graphic == "Dumbbell" then
		ui("Frame", bg, { Size = UDim2.fromScale(0.36, 0.035), Position = UDim2.fromScale(0.32, 0.37), BackgroundColor3 = Color3.fromRGB(190, 196, 206), Stroke = { INK, 3 } })
		for _, sx in ipairs({ 0.17, 0.72 }) do
			ui("Frame", bg, { Size = UDim2.fromScale(0.11, 0.22), Position = UDim2.fromScale(sx, 0.275), BackgroundColor3 = INK, Corner = UDim.new(0.2, 0), Stroke = { Color3.fromRGB(60, 60, 66), 3 } })
		end
		for _, sx in ipairs({ 0.28, 0.66 }) do
			ui("Frame", bg, { Size = UDim2.fromScale(0.06, 0.16), Position = UDim2.fromScale(sx, 0.305), BackgroundColor3 = Color3.fromRGB(60, 60, 66), Corner = UDim.new(0.2, 0), Stroke = { INK, 3 } })
		end
	elseif design.Graphic == "Barbell" then
		ui("Frame", bg, { Size = UDim2.fromScale(0.9, 0.022), Position = UDim2.fromScale(0.05, 0.38), BackgroundColor3 = Color3.fromRGB(200, 204, 212), Stroke = { INK, 2 } })
		for _, side in ipairs({ -1, 1 }) do
			for k, pl in ipairs({ { 0.06, 0.3, Color3.fromRGB(210, 40, 40) }, { 0.05, 0.24, Color3.fromRGB(40, 84, 190) }, { 0.04, 0.17, SAFETY_YELLOW } }) do
				local x = side &lt; 0 and (0.12 + (k - 1) * 0.065) or (0.88 - (k - 1) * 0.065 - pl[1])
				ui("Frame", bg, { Size = UDim2.fromScale(pl[1], pl[2]), Position = UDim2.fromScale(x, 0.391 - pl[2] / 2), BackgroundColor3 = pl[3], Corner = UDim.new(0.3, 0), Stroke = { INK, 3 } })
			end
		end
	end
	if design.Bottle then
		local b = ui("Frame", bg, { Size = UDim2.fromScale(0.24, 0.36), Position = UDim2.fromScale(0.38, 0.22), BackgroundColor3 = Color3.fromRGB(210, 240, 255), Corner = UDim.new(0.25, 0), Stroke = { Color3.fromRGB(10, 30, 70), 4 } })
		ui("Frame", b, { Size = UDim2.fromScale(1, 0.6), Position = UDim2.fromScale(0, 0.4), BackgroundColor3 = Color3.fromRGB(80, 190, 255), Corner = UDim.new(0.25, 0) })
		ui("Frame", bg, { Size = UDim2.fromScale(0.12, 0.05), Position = UDim2.fromScale(0.44, 0.175), BackgroundColor3 = Color3.fromRGB(20, 60, 140), Corner = UDim.new(0.2, 0), Stroke = { Color3.fromRGB(10, 30, 70), 3 } })
		ui("Frame", b, { Size = UDim2.fromScale(0.14, 0.7), Position = UDim2.fromScale(0.16, 0.12), BackgroundColor3 = WHITE, BackgroundTransparency = 0.4, Corner = UDim.new(0.5, 0) })
	elseif design.Icon then
		IconSlot.Make(bg, design.Icon, design.Emoji, UDim2.fromScale(0.62, 0.42), 0).Position = UDim2.fromScale(0.19, 0.16)
	end
	if design.Stamp then
		ui("TextLabel", bg, { Size = UDim2.fromScale(0.6, 0.1), Position = UDim2.fromScale(0.36, 0.44), Rotation = -14, Text = design.Stamp,
			TextColor3 = Color3.fromRGB(255, 70, 70), BackgroundColor3 = WHITE, BackgroundTransparency = 0.1, Stroke = { Color3.fromRGB(200, 30, 30), 4 } })
	end
	ui("TextLabel", bg, { Size = UDim2.fromScale(0.9, 0.24), Position = UDim2.fromScale(0.05, 0.6), Text = design.Title, TextColor3 = ink,
		Stroke = { design.Ink and WHITE or Color3.new(0, 0, 0), 2 } })
	ui("TextLabel", bg, { Size = UDim2.fromScale(0.84, 0.05), Position = UDim2.fromScale(0.08, design.Hazard and 0.86 or 0.87), Text = design.Sub,
		TextColor3 = ink, Font = Enum.Font.GothamBold, TextTransparency = 0.1 })
	-- glossy glare across the print
	ui("Frame", bg, { Size = UDim2.new(0.25, 0, 2, 0), Position = UDim2.fromScale(0.62, -0.5), Rotation = 28, BackgroundColor3 = WHITE, BackgroundTransparency = 0.9 })
end

-- Vertical square truss tower (4 chords + rungs), standing on local y = 0.
local function trussTower(folder, cf, height, width)
	local r = width / 2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, cf, V(sx * r, height / 2, sz * r), "Y", height, 0.28, CHROME_C, "Metal", { Name = "TrussChord" })
		end
	end
	for y = 1, height - 0.5, 1.8 do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, cf, V(0, y, sz * r), "X", width, 0.12, CHROME_C, "Metal", { CanCollide = false, Name = "TrussRung" })
			cyl(folder, cf, V(sz * r, y + 0.9, 0), "Z", width, 0.12, CHROME_C, "Metal", { CanCollide = false, Name = "TrussRung" })
		end
	end
	add(folder, cf, V(0, 0.15, 0), V(width + 1.2, 0.3, width + 1.2), STEEL_DARK, "Metal", { Name = "TrussBase" })
end

-- Horizontal truss beam spanning local X, centred on cf.
local function trussBeam(folder, cf, length, width)
	local r = width / 2
	for _, sy in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, cf, V(0, sy * r, sz * r), "X", length, 0.28, CHROME_C, "Metal", { CanCollide = false, Name = "TrussChord" })
		end
	end
	for x = -length / 2 + 0.9, length / 2 - 0.9, 1.8 do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(folder, cf, V(x, 0, sz * r), "Y", width, 0.12, CHROME_C, "Metal", { CanCollide = false, Name = "TrussRung" })
		end
	end
end

local STEPS = {
	{ Label = "TRAIN", Icon = "Strength", Emoji = "💪", Color = Color3.fromRGB(226, 52, 52) },
	{ Label = "EARN COINS", Icon = "Money", Emoji = "💵", Color = Color3.fromRGB(46, 170, 80) },
	{ Label = "OPEN LUCKY\nBLOCKS", Icon = "LuckyBlock", Emoji = "❓", Color = Color3.fromRGB(240, 150, 20) },
	{ Label = "UNLOCK\nGYMS", Icon = "GymMap", Emoji = "🗺️", Color = Color3.fromRGB(30, 150, 220) },
	{ Label = "REBIRTH", Icon = "RebirthStar", Emoji = "⭐", Color = Color3.fromRGB(140, 70, 230) },
}

-- The "how to play" banner: a vinyl banner strapped under an aluminium truss gantry.
local function tutorialBanner(ctx, z)
	local folder = ctx.folder
	local span, towerH, beamY = 44, 21, 21.9
	for _, sx in ipairs({ -1, 1 }) do
		trussTower(folder, ctx.at(sx * span / 2, 0, z), towerH, 1.8)
	end
	trussBeam(folder, ctx.at(0, beamY, z), span + 1.8, 1.8)

	local bw, bh = 38, 9.5
	local cf = ctx.at(0, beamY - 1.4 - bh / 2, z) * CFrame.Angles(0, math.pi, 0) -- print faces +Z (the entrance)
	local banner = add(folder, cf, V(0, 0, 0), V(bw, bh, 0.08), Color3.fromRGB(24, 26, 32), "Fabric", { CanCollide = false, Name = "Banner" })
	-- grommets + straps to the truss
	for _, gx in ipairs({ -bw / 2 + 0.5, -bw / 6, bw / 6, bw / 2 - 0.5 }) do
		cyl(folder, cf, V(gx, bh / 2 - 0.4, 0), "Z", 0.14, 0.35, CHROME_C, "Metal", { CanCollide = false, Name = "Grommet" })
		cyl(folder, cf, V(gx, bh / 2 + 0.3, 0), "Y", 1.2, 0.1, Color3.fromRGB(20, 20, 22), "Fabric", { CanCollide = false, Name = "Strap" })
	end
	for _, sy in ipairs({ -1, 1 }) do
		for _, sx in ipairs({ -1, 1 }) do
			if sy &lt; 0 then -- (the top corners already have grommets from the strap row)
				cyl(folder, cf, V(sx * (bw / 2 - 0.5), sy * (bh / 2 - 0.4), 0), "Z", 0.14, 0.35, CHROME_C, "Metal", { CanCollide = false, Name = "Grommet" })
			end
		end
		-- bungees from the side grommets to the towers
		cyl(folder, cf, V(0, sy * (bh / 2 - 0.4), 0), "X", span - 1.8, 0.06, Color3.fromRGB(20, 20, 22), "Fabric", { CanCollide = false, Name = "Bungee", Transparency = 0.2 })
	end

	local g = surface(banner, Enum.NormalId.Front, 30)
	local bg = ui("Frame", g, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Gradient = { Color3.fromRGB(40, 44, 56), Color3.fromRGB(16, 17, 22), 90 } })
	for _, y in ipairs({ 0, 0.965 }) do
		ui("Frame", bg, { Size = UDim2.fromScale(1, 0.035), Position = UDim2.fromScale(0, y), BackgroundColor3 = ctx.theme.Accent })
	end
	ui("TextLabel", bg, { Size = UDim2.fromScale(0.9, 0.15), Position = UDim2.fromScale(0.05, 0.06), Text = "HOW TO GET STRONG IN +1 GYM GAME", Stroke = { Color3.new(0, 0, 0), 2 } })
	local row = ui("Frame", bg, { Size = UDim2.fromScale(0.96, 0.7), Position = UDim2.fromScale(0.02, 0.25), BackgroundTransparency = 1 })
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.004, 0)
	layout.Parent = row
	for i, step in ipairs(STEPS) do
		local card = ui("Frame", row, { Size = UDim2.fromScale(0.168, 0.96), LayoutOrder = i * 2, BackgroundColor3 = WHITE,
			Gradient = { step.Color, step.Color:Lerp(Color3.new(0, 0, 0), 0.55), 90 }, Corner = UDim.new(0.08, 0), Stroke = { WHITE, 3 } })
		local badge = ui("Frame", card, { Size = UDim2.fromScale(0.26, 0.26), Position = UDim2.fromScale(0.04, 0.04), SizeConstraint = Enum.SizeConstraint.RelativeYY,
			BackgroundColor3 = WHITE, Corner = UDim.new(0.5, 0) })
		ui("TextLabel", badge, { Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0.1, 0.1), Text = tostring(i), TextColor3 = step.Color })
		IconSlot.Make(card, step.Icon, step.Emoji, UDim2.fromScale(0.62, 0.5), 0).Position = UDim2.fromScale(0.19, 0.1)
		ui("TextLabel", card, { Size = UDim2.fromScale(0.9, 0.3), Position = UDim2.fromScale(0.05, 0.64), Text = step.Label, Stroke = { Color3.new(0, 0, 0), 2 } })
		if i &lt; #STEPS then
			ui("TextLabel", row, { Size = UDim2.fromScale(0.03, 0.4), LayoutOrder = i * 2 + 1, Text = "›", TextColor3 = ctx.theme.Accent })
		end
	end
	-- back side: gym logo
	local back = surface(banner, Enum.NormalId.Back, 30)
	local bb = ui("Frame", back, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Gradient = { Color3.fromRGB(40, 44, 56), Color3.fromRGB(16, 17, 22), 90 } })
	IconSlot.Make(bb, "Strength", "💪", UDim2.fromScale(0.16, 0.8), 0).Position = UDim2.fromScale(0.08, 0.1)
	ui("TextLabel", bb, { Size = UDim2.fromScale(0.64, 0.5), Position = UDim2.fromScale(0.28, 0.12), Text = "+1 GYM GAME", Stroke = { Color3.new(0, 0, 0), 2 } })
	ui("TextLabel", bb, { Size = UDim2.fromScale(0.64, 0.18), Position = UDim2.fromScale(0.28, 0.66), Text = "GOOD LUCK OUT THERE, CHAMP!", TextColor3 = ctx.theme.Accent, Font = Enum.Font.GothamBold })
end

