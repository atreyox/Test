      <Item class="ModuleScript" referent="RBX6">
        <Properties>
          <string name="Name">Format</string>
          <ProtectedString name="Source">--[[
	Format (shared) - turns huge numbers into short, kid-friendly text: 1.5K, 20M, 3.2B ...
]]
local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(s)
	if string.find(s, ".", 1, true) then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

function Format.Number(n, decimals)
	decimals = decimals or 2
	if n ~= n then
		return "0"
	end
	if n == math.huge then
		return "MAX"
	end
	if n &lt; 0 then
		return "-" .. Format.Number(-n, decimals)
	end
	if n &lt; 1000 then
		if n == math.floor(n) then
			return string.format("%d", n)
		end
		return trimZeros(string.format("%." .. decimals .. "f", n))
	end
	local idx = math.floor(math.log10(n) / 3)
	if idx &gt;= #SUFFIXES then
		local exponent = math.floor(math.log10(n))
		local mantissa = n / (10 ^ exponent)
		return trimZeros(string.format("%.2f", mantissa)) .. "e" .. exponent
	end
	local scaled = n / (10 ^ (idx * 3))
	local text = trimZeros(string.format("%." .. decimals .. "f", scaled))
	if tonumber(text) &gt;= 1000 and idx + 1 &lt; #SUFFIXES then
		idx = idx + 1
		scaled = n / (10 ^ (idx * 3))
		text = trimZeros(string.format("%." .. decimals .. "f", scaled))
	end
	return text .. SUFFIXES[idx + 1]
end

-- "x1.2", "x250", "x1.5K"
function Format.Mult(n)
	return "x" .. Format.Number(n, 2)
end

-- whole number with thousands separators (for small counts like 1,234)
function Format.Commas(n)
	local s = string.format("%d", math.floor(n))
	local out = s
	while true do
		local replaced
		out, replaced = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		if replaced == 0 then
			break
		end
	end
	return out
end

function Format.Percent(p)
	if p &gt;= 10 then
		return trimZeros(string.format("%.1f", p)) .. "%"
	elseif p &gt;= 1 then
		return trimZeros(string.format("%.2f", p)) .. "%"
	end
	return trimZeros(string.format("%.3f", p)) .. "%"
end

return Format
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX7">
        <Properties>
          <string name="Name">Formulas</string>
          <ProtectedString name="Source">--[[
	Formulas (shared)
	Pure functions (no side effects). The SERVER uses them to decide real values;
	the CLIENT uses the same functions only to *display* previews.
]]
local Config = require(script.Parent.Config)
local Format = require(script.Parent.Format)

local Formulas = {}

function Formulas.Level(upgrades, id)
	return (upgrades and upgrades[id]) or 0
end

----------------------------------------------------------------------
-- Rebirth
----------------------------------------------------------------------
-- 0 rebirths = x1, 1 = x2, 2 = x4, 3 = x8 ...
function Formulas.RebirthMultiplier(rebirths)
	return 1 + rebirths * Config.Rebirth.MultiplierBase
end

-- gets harder every time
function Formulas.RebirthRequirement(rebirths)
	return Config.Rebirth.BaseRequirement * (Config.Rebirth.Growth ^ rebirths)
end

----------------------------------------------------------------------
-- Upgrades
----------------------------------------------------------------------
function Formulas.UpgradeCost(def, level)
	return math.floor(def.BaseCost * (def.Growth ^ level) + 0.5)
end

function Formulas.PowerMultiplier(upgrades)
	return 1 + Formulas.Level(upgrades, "Power") * Config.UpgradesById.Power.PerLevel
end

function Formulas.CoinMultiplier(upgrades)
	return 1 + Formulas.Level(upgrades, "CoinBoost") * Config.UpgradesById.CoinBoost.PerLevel
end

function Formulas.Luck(upgrades)
	return 1 + Formulas.Level(upgrades, "Luck") * Config.UpgradesById.Luck.PerLevel
end

function Formulas.PetSlots(upgrades)
	return Config.Game.BasePetSlots + Formulas.Level(upgrades, "PetSlots") * Config.UpgradesById.PetSlots.PerLevel
end

function Formulas.WalkSpeed(upgrades)
	return Config.Game.BaseWalkSpeed + Formulas.Level(upgrades, "Speed") * Config.UpgradesById.Speed.PerLevel
end

----------------------------------------------------------------------
-- Pets: total = 1 + sum(mult - 1).  One x2 pet -&gt; x2.  Two x2 pets -&gt; x3.
-- (Additive stacking keeps the game balanced when you own several slots.)
----------------------------------------------------------------------
function Formulas.PetMultiplier(petIds)
	local bonus = 0
	for _, id in ipairs(petIds) do
		local def = Config.PetsById[id]
		if def then
			bonus = bonus + (def.Mult - 1)
		end
	end
	return 1 + bonus
end

-- Final Strength multiplier applied to every rep.
function Formulas.StrengthMultiplier(rebirths, petMult, upgrades)
	return Formulas.RebirthMultiplier(rebirths) * petMult * Formulas.PowerMultiplier(upgrades)
end

----------------------------------------------------------------------
-- Eggs
----------------------------------------------------------------------
-- rand: function returning a float in [0,1)
function Formulas.RollPet(egg, luck, rand)
	local weights, total = {}, 0
	for i, pet in ipairs(egg.Pets) do
		local rarity = Config.Rarities[pet.Rarity]
		local w = rarity.Weight
		if rarity.Order &gt; 1 then
			w = w * luck
		end
		weights[i] = w
		total = total + w
	end
	local roll = rand() * total
	for i, pet in ipairs(egg.Pets) do
		roll = roll - weights[i]
		if roll &lt;= 0 then
			return pet
		end
	end
	return egg.Pets[1]
end

-- List of { Pet = pet, Chance = percent } for the egg UI.
function Formulas.PetChances(egg, luck)
	local total = 0
	local weights = {}
	for i, pet in ipairs(egg.Pets) do
		local rarity = Config.Rarities[pet.Rarity]
		local w = rarity.Weight
		if rarity.Order &gt; 1 then
			w = w * luck
		end
		weights[i] = w
		total = total + w
	end
	local out = {}
	for i, pet in ipairs(egg.Pets) do
		out[i] = { Pet = pet, Chance = weights[i] / total * 100 }
	end
	return out
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
-- Best (highest strength-per-rep) station in an { [stationId] = true } table.
function Formulas.BestStation(owned)
	local best
	for _, s in ipairs(Config.Stations) do
		if owned[s.Id] and (not best or s.Strength &gt; best.Strength) then
			best = s
		end
	end
	return best or Config.Stations[1]
end

----------------------------------------------------------------------
-- Quests (index counts up forever; the chain loops with bigger goals)
----------------------------------------------------------------------
function Formulas.QuestInfo(index, ownedStations, upgrades)
	local list = Config.Quests
	local n = #list
	local cycle = math.floor((index - 1) / n)
	local def = list[((index - 1) % n) + 1]
	local goal = def.Goal
	if cycle &gt; 0 then
		goal = math.max(def.Goal, Config.NiceRound(def.Goal * (Config.QuestLoopGrowth ^ cycle)))
	end
	local best = Formulas.BestStation(ownedStations or {})
	local reward = math.floor(def.RewardReps * best.Coins * Formulas.CoinMultiplier(upgrades) * (1 + cycle * 0.5))
	if reward &lt; 1 then
		reward = 1
	end
	return {
		Id = def.Id,
		Stat = def.Stat,
		Goal = goal,
		Reward = reward,
		Text = string.gsub(def.Text, "{goal}", Format.Number(goal)),
	}
end

----------------------------------------------------------------------
-- Looks: the character physically grows as you get stronger
----------------------------------------------------------------------
function Formulas.BodyScale(strength, rebirths)
	local width = 1 + math.log10(math.max(1, strength)) * 0.035 + rebirths * 0.015
	width = math.clamp(width, 1, 1.9)
	local height = 1 + (width - 1) * 0.45
	return width, height
end

return Formulas
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX8">
        <Properties>
          <string name="Name">Remotes</string>
          <ProtectedString name="Source">--[[
	Remotes (shared)
	The SERVER creates every RemoteEvent / RemoteFunction listed here on start-up.
	The CLIENT waits for them. Adding a remote = add its name to the list below.

	Clients only ever send *requests*. The server decides everything.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local FOLDER_NAME = "GymRemotes"

Remotes.Events = {
	-- client -&gt; server
	"Train", "StopTraining", "ClientReady",
	-- server -&gt; client
	"TrainResult", "TrainingState", "Notify", "Announce", "SyncState", "SyncInventory",
	"CoinPickup", "AreaUnlocked", "GateDenied", "Rebirthed", "Milestone",
	"OpenEgg", "OpenSell", "PromptEquipment",
}

Remotes.Functions = {
	"HatchEgg", "PetAction", "BuyUpgrade", "BuyEquipment", "SellStrength",
	"Rebirth", "ClaimQuest", "TeleportArea",
	-- admin panel (AdminService re-checks admin rights on every single call)
	"AdminGetState", "AdminAction",
}

local folder

function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init must be called on the server")
	folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	for _, name in ipairs(Remotes.Events) do
		if not folder:FindFirstChild(name) then
			local e = Instance.new("RemoteEvent")
			e.Name = name
			e.Parent = folder
		end
	end
	for _, name in ipairs(Remotes.Functions) do
		if not folder:FindFirstChild(name) then
			local f = Instance.new("RemoteFunction")
			f.Name = name
			f.Parent = folder
		end
	end
end

function Remotes.Get(name)
	if not folder then
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME)
	end
	if RunService:IsServer() then
		return folder:FindFirstChild(name)
	end
	return folder:WaitForChild(name)
end

return Remotes
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX9">
        <Properties>
          <string name="Name">Signal</string>
          <ProtectedString name="Source">--[[
	Signal (shared) - minimal event class used for client-side state changes.
]]
local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _nodes = {} }, Signal)
end

function Signal:Connect(fn)
	local node = { fn = fn, connected = true }
	table.insert(self._nodes, node)
	local signal = self
	local connection = { Connected = true }
	function connection:Disconnect()
		node.connected = false
		self.Connected = false
		for i, n in ipairs(signal._nodes) do
			if n == node then
				table.remove(signal._nodes, i)
				break
			end
		end
	end
	return connection
end

function Signal:Fire(...)
	local snapshot = {}
	for i, n in ipairs(self._nodes) do
		snapshot[i] = n
	end
	for _, n in ipairs(snapshot) do
		if n.connected then
			task.spawn(n.fn, ...)
		end
	end
end

return Signal
</ProtectedString>
