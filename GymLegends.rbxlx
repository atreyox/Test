-- What each equipment kind is called as an exercise (HUD workout card, station signs, buy dialog).
Config.ExerciseNames = {
	Dumbbell = "Hammer Curls", Bench = "Bench Press", Treadmill = "Running", Squat = "Shoulder Press",
	Bag = "Boxing", Deadlift = "Deadlifts", Giant = "Giant Lift", Machine = "Machine Pulls",
}

-- Which body pose to play for each equipment kind (client: TrainingController / Pose).
Config.KindPose = {
	Dumbbell = "Curl", Bench = "Press", Treadmill = "Run", Squat = "Squat",
	Bag = "Punch", Deadlift = "Deadlift", Giant = "Lift", Machine = "Pull",
}

----------------------------------------------------------------------
-- DERIVED DATA  (do not edit; built from AREAS)
----------------------------------------------------------------------
local function niceRound(x)
	if x &lt; 10 then
		return math.floor(x * 10 + 0.5) / 10
	elseif x &lt; 100 then
		return math.floor(x + 0.5)
	end
	local digits = math.floor(math.log10(x))
	local unit = 10 ^ (digits - 1) -- keep 2 significant digits
	return math.floor(x / unit + 0.5) * unit
end
Config.NiceRound = niceRound

Config.Areas = {}
Config.AreaIndex = {}     -- id -&gt; index
Config.AreasById = {}
Config.Stations = {}      -- ordered list of every station
Config.StationsById = {}
Config.Eggs = {}
Config.EggsById = {}
Config.Pets = {}          -- ordered list of every pet definition
Config.PetsById = {}

for areaIndex, a in ipairs(AREAS) do
	a.Index = areaIndex
	Config.Areas[areaIndex] = a
	Config.AreaIndex[a.Id] = areaIndex
	Config.AreasById[a.Id] = a

	-- stations
	local topCoins = 0
	a.StationIds = {}
	for tier, s in ipairs(a.Stations) do
		local strength = a.StationBase * Config.Training.TierMultipliers[tier]
		local price = niceRound(strength * Config.Training.PriceInReps[tier])
		if areaIndex == 1 and tier == 1 then
			price = 0 -- the very first station is free
		end
		local station = {
			Id = a.Id .. "_" .. tier,
			Area = a.Id,
			AreaIndex = areaIndex,
			Tier = tier,
			Kind = s[1],
			Name = s[2],
			Pose = Config.KindPose[s[1]] or "Press",
			Strength = strength,
			Coins = strength * Config.Training.CoinRatio,
			Price = price,
		}
		topCoins = math.max(topCoins, station.Coins)
		table.insert(Config.Stations, station)
		Config.StationsById[station.Id] = station
		table.insert(a.StationIds, station.Id)
	end
	a.TopCoins = topCoins
	a.OrbCoins = niceRound(topCoins * Config.Orbs.ValueInTopReps)

	-- egg + pets
	local egg = {
		Id = a.Id .. "Egg",
		Name = a.Egg,
		Area = a.Id,
		AreaIndex = areaIndex,
		Price = niceRound(topCoins * Config.Egg.PriceInTopReps[areaIndex]),
		Pets = {},
	}
	local growth = Config.PetRules.AreaGrowth ^ (areaIndex - 1)
	for r, rarityName in ipairs(Config.RarityOrder) do
		local rarity = Config.Rarities[rarityName]
		local p = a.Pets[r]
		local sat = 0.35 + 0.09 * r
		local pet = {
			Id = a.Id .. "_" .. rarityName,
			Name = p[1],
			Emoji = p[2],
			Rarity = rarityName,
			Area = a.Id,
			AreaIndex = areaIndex,
			Mult = niceRound(rarity.BaseMult * growth),
			Color = Color3.fromHSV((a.Hue + r * 0.06) % 1, math.min(sat, 0.95), 1),
			Egg = egg.Id,
		}
		table.insert(egg.Pets, pet)
		table.insert(Config.Pets, pet)
		Config.PetsById[pet.Id] = pet
	end
	table.insert(Config.Eggs, egg)
	Config.EggsById[egg.Id] = egg
	a.EggId = egg.Id
end

----------------------------------------------------------------------
-- UPGRADES (bought with Coins in the Shop panel)
----------------------------------------------------------------------
Config.Upgrades = {
	{ Id = "Power", Name = "Power Training", Icon = "💪", Desc = "+20% Strength per level", Max = 15, BaseCost = 500, Growth = 3, PerLevel = 0.2 },
	{ Id = "CoinBoost", Name = "Coin Magnet", Icon = "💵", Desc = "+15% Coins per level", Max = 15, BaseCost = 500, Growth = 3, PerLevel = 0.15 },
	{ Id = "Luck", Name = "Lucky Charm", Icon = "🍀", Desc = "+8% Lucky Block luck per level", Max = 10, BaseCost = 20000, Growth = 3, PerLevel = 0.08 },
	{ Id = "Speed", Name = "Sprint Shoes", Icon = "👟", Desc = "+1.5 walk speed per level", Max = 8, BaseCost = 5000, Growth = 3, PerLevel = 1.5 },
	{ Id = "PetSlots", Name = "Pet Slot", Icon = "🐾", Desc = "+1 equipped pet slot", Max = 5, BaseCost = 5000000, Growth = 30, PerLevel = 1 },
	{ Id = "MultiHatch", Name = "Triple Open", Icon = "❓", Desc = "Open 3 Lucky Blocks at once", Max = 1, BaseCost = 2000000, Growth = 1, PerLevel = 1 },
}
Config.UpgradesById = {}
for _, u in ipairs(Config.Upgrades) do
	Config.UpgradesById[u.Id] = u
end

----------------------------------------------------------------------
-- QUESTS  (chain; after the last one it loops with bigger goals)
--   Stat is one of: Reps, Hatches, Orbs, Sells, Upgrades, Rebirths, Areas
--   RewardReps = reward is worth this many reps of your best owned station
----------------------------------------------------------------------
Config.Quests = {
	{ Id = "q1", Text = "Train {goal} times", Stat = "Reps", Goal = 40, RewardReps = 60 },
	{ Id = "q2", Text = "Open {goal} Lucky Block", Stat = "Hatches", Goal = 1, RewardReps = 60 },
	{ Id = "q3", Text = "Collect {goal} coin orbs", Stat = "Orbs", Goal = 6, RewardReps = 80 },
	{ Id = "q4", Text = "Train {goal} times", Stat = "Reps", Goal = 150, RewardReps = 150 },
	{ Id = "q5", Text = "Buy {goal} upgrade", Stat = "Upgrades", Goal = 1, RewardReps = 100 },
	{ Id = "q6", Text = "Open {goal} Lucky Blocks", Stat = "Hatches", Goal = 5, RewardReps = 200 },
	{ Id = "q7", Text = "Unlock {goal} new gym", Stat = "Areas", Goal = 1, RewardReps = 250 },
	{ Id = "q8", Text = "Sell your Strength {goal} time", Stat = "Sells", Goal = 1, RewardReps = 120 },
	{ Id = "q9", Text = "Collect {goal} coin orbs", Stat = "Orbs", Goal = 15, RewardReps = 250 },
	{ Id = "q10", Text = "Train {goal} times", Stat = "Reps", Goal = 400, RewardReps = 400 },
	{ Id = "q11", Text = "Open {goal} Lucky Blocks", Stat = "Hatches", Goal = 15, RewardReps = 500 },
	{ Id = "q12", Text = "Rebirth {goal} time", Stat = "Rebirths", Goal = 1, RewardReps = 800 },
}
Config.QuestLoopGrowth = 1.6 -- goals are multiplied by this each time the chain loops

----------------------------------------------------------------------
-- SOUNDS  (built-in Roblox client sounds so the game works with zero uploads.
--          Swap any of these for your own "rbxassetid://123" ids.)
----------------------------------------------------------------------
Config.Sounds = {
	Rep = { Id = "rbxasset://sounds/snap.mp3", Volume = 0.35, Pitch = 1.5 },
	Crit = { Id = "rbxasset://sounds/bass.wav", Volume = 0.6, Pitch = 1.2 },
	Coin = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Pitch = 1.6 },
	Click = { Id = "rbxasset://sounds/button.wav", Volume = 0.4, Pitch = 1.2 },
	Error = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.5, Pitch = 1.0 },
	Shake = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.6, Pitch = 0.9 },
	Reveal = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Pitch = 1.0 },
	RareReveal = { Id = "rbxasset://sounds/victory.wav", Volume = 0.8, Pitch = 1.0 },
	Gate = { Id = "rbxasset://sounds/bass.wav", Volume = 0.8, Pitch = 0.7 },
	Unlock = { Id = "rbxasset://sounds/victory.wav", Volume = 0.9, Pitch = 1.0 },
	Rebirth = { Id = "rbxasset://sounds/victory.wav", Volume = 1.0, Pitch = 0.8 },
	LevelUp = { Id = "rbxasset://sounds/action_get_up.mp3", Volume = 0.7, Pitch = 1.3 },
	Equip = { Id = "rbxasset://sounds/button.wav", Volume = 0.5, Pitch = 1.5 },
	Buy = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 1.1 },
}

return Config</ProtectedString>
